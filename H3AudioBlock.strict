has firsts List(H3Conv)
has seconds List(H3Conv)
has snakes List(H3Snake)
constant Tiny = H3AudioBlock.Loaded(H3Conv.Model, "decoder.resblocks.0.")
Loaded(model Safetensors, prefix Text) Slow(H3AudioBlock)
	Tiny.firsts(2).dilation is 5
	Tiny.seconds(0).dilation is 1
	Tiny.snakes.Length is 6
	let dilated = Convolutions(model, prefix + "convs1.", true)
	H3AudioBlock(dilated, Convolutions(model, prefix + "convs2.", false), Snakes(model, prefix))
Convolutions(model Safetensors, prefix Text, dilated Boolean) Slow(List(H3Conv))
	Tiny.Convolutions(H3Conv.Model, "decoder.resblocks.1.convs1.", true)(1).kernel is 7
	for 3
		H3Conv.Loaded(model, prefix + index, dilated then 2 * index + 1 else 1)
Snakes(model Safetensors, prefix Text) Slow(List(H3Snake))
	Tiny.Snakes(H3Conv.Model, "decoder.resblocks.0.")(5).alphas.Length is 64
	for 6
		H3Snake.Loaded(model, prefix + "activations." + index + ".")
Output(signal Numbers) Slow(Numbers)
	Tiny.Output(H3Snake.Upsampled)(451).IsNearlyEqual(H3Conv.Model.Values("reference.resblocks.0")(67), 0.005)
	mutable state = signal
	for firsts
		let hidden = snakes(2 * index + 1).Output(value.Output(snakes(2 * index).Output(state)))
		state = Gpt2Block.Added(state, seconds(index).Output(hidden))
	state