has means Numbers
has deviations Numbers
has convolutions List(Convolution)
has middle List(FluxResnet)
has attention FluxAttention
has blocks List(FluxResnet)
has upsamples List(Convolution)
has normOut GroupNorm
constant Model = Safetensors("tinyvae.safetensors")
constant Tiny = FluxDecoder.Loaded("tinyvae.safetensors", 4)
constant Latent = Model.Values("latent")
constant Middle = FeatureMap(Model.Values("reference.mid.block_2"), 4, 16, Layer.Zeros(16))
constant Last = Tiny.Upsampled(Middle)
constant Ends = ("post_quant_conv", "conv_in", "conv_out")
Loaded(path Text, groups Number) Slow(FluxDecoder)
	Tiny.blocks.Length is 4
	Tiny.upsamples.Length is 1
	Tiny.deviations(0).IsNearlyEqual(0.72663, 0.0001)
	let model = Safetensors(path, 32, "decoder.")
	let latent = Safetensors(path, 32, "bn.")
	let mids = (FluxResnet.Loaded(model, "mid.block_1.", groups), FluxResnet.Loaded(model, "mid.block_2.", groups))
	let attended = FluxAttention.Loaded(model, "mid.attn_1.", groups)
	let spread = Deviations(latent.Values("running_var"))
	let normed = FluxResnet.Norm(model, "norm_out", groups)
	let ups = Blocks(model, groups)
	FluxDecoder(latent.Values("running_mean"), spread, Convolutions(model), mids, attended, ups, Upsamples(model), normed)
Deviations(variances Numbers) Numbers
	FluxDecoder.Deviations((0.0399, 3.9999)) is (0.2, 2)
	for variances
		(value + 0.0001).SquareRoot
Convolutions(model Safetensors) Slow(List(Convolution))
	Tiny.Convolutions(Safetensors("tinyvae.safetensors", 32, "decoder.")).Length is 3
	for Ends
		FluxResnet.Convolved(model, value)
Upsamples(model Safetensors) Slow(List(Convolution))
	Tiny.Upsamples(Safetensors("tinyvae.safetensors", 32, "decoder.")).First.biases(0).IsNearlyEqual(0.092754, 0.0001)
	for 8
		if model.Entry("up." + (7 - index) + ".upsample.conv.weight") is not ""
			let upsample = FluxResnet.Convolved(model, "up." + (7 - index) + ".upsample.conv")
			Convolution(upsample.Folds, upsample.biases)
Blocks(model Safetensors, groups Number) Slow(List(FluxResnet))
	Tiny.Blocks(Safetensors("tinyvae.safetensors", 32, "decoder."), 4)(2).shortcut.biases.Length is 8
	let levels = Present(model, "up.", ".block.0.conv1.weight")
	let perLevel = Present(model, "up.0.block.", ".conv1.weight")
	for levels * perLevel
		FluxResnet.Loaded(model, "up." + (levels - 1 - (index / perLevel).Floor) + ".block." + index % perLevel + ".", groups)
Present(model Safetensors, first Text, last Text) Slow(Number)
	Tiny.Present(Safetensors("tinyvae.safetensors", 32, "decoder."), "up.", ".block.0.conv1.weight") is 2
	for 8
		if model.Entry(first + index + last) is not ""
			1
Denormalized(latent Numbers) Slow(Numbers)
	Tiny.Denormalized(Latent)(0).IsNearlyEqual(1.23467, 0.0001)
	Tiny.Denormalized(Latent)(95).IsNearlyEqual(0.56166, 0.0001)
	let size = latent.Length / means.Length
	for latent
		value * deviations((index / size).Floor) + means((index / size).Floor)
Unpatchified(latent Numbers, width Number, channels Number) Slow(Numbers)
	Tiny.Unpatchified(Tiny.Denormalized(Latent), 2, 4)(0).IsNearlyEqual(1.23467, 0.0001)
	Tiny.Unpatchified(Tiny.Denormalized(Latent), 2, 4)(32).IsNearlyEqual(-0.06728, 0.0001)
	Tiny.Unpatchified(Tiny.Denormalized(Latent), 2, 4)(95).IsNearlyEqual(0.56166, 0.0001)
	let height = latent.Length / channels / 4 / width
	for latent.Length
		let position = (index / channels).Floor
		let row = (position / (2 * width)).Floor
		let source = (index % channels) * 4 + (row % 2) * 2 + position % 2
		latent((source * height + (row / 2).Floor) * width + ((position % (2 * width)) / 2).Floor)
Entered(latent Numbers, width Number) Slow(FeatureMap)
	Tiny.Entered(Latent, 2).Completed(0).IsNearlyEqual(-0.39976, 0.02)
	Tiny.Entered(Latent, 2).Completed(383).IsNearlyEqual(0.4636, 0.02)
	let channels = means.Length / 4
	let unpatchified = Unpatchified(Denormalized(latent), width, channels)
	let patches = FeatureMap(unpatchified, 2 * width, channels, Layer.Zeros(channels))
	let quantized = convolutions(0).Projected(patches)
	convolutions(1).Applied(quantized, quantized.Identity, false)
Decoded(latent Numbers, width Number) Slow(Numbers)
	Tiny.Decoded(Latent, 2)(0).IsNearlyEqual(0.7881, 0.02)
	Tiny.Decoded(Latent, 2)(96).IsNearlyEqual(0.9225, 0.02)
	Tiny.Decoded(Latent, 2)(287).IsNearlyEqual(0.47337, 0.0001)
	let entered = Entered(latent, width)
	let upsampled = Upsampled(middle(1).Output(attention.Output(middle(0).Output(entered))))
	let output = convolutions(2).Applied(upsampled, normOut.Affine(upsampled), true)
	for output.Completed
		((value + 1) / 2).Clamp
Upsampled(map FeatureMap) Slow(FeatureMap)
	Last.Applied(Tiny.normOut.Affine(Last), Activation.Linear).values(0).IsNearlyEqual(0.38452, 0.02)
	Last.Applied(Tiny.normOut.Affine(Last), Activation.Linear).values(767).IsNearlyEqual(-0.17288, 0.02)
	let perLevel = blocks.Length / (upsamples.Length + 1)
	mutable state = map
	for blocks
		state = value.Output(state)
		if index % perLevel is perLevel - 1 and index < blocks.Length - 1
			state = upsamples((index / perLevel).Floor).Doubled(state)
	state