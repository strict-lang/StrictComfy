has prompt = "prompt.txt"
has image = ""
has width = 0
has height = 0
has steps = 6
has Seed = -1
has count = 1
has lora Texts = List(Text)
has model = ""
has vae = ""
has textEncoder = ""
has models = ""
has output = "H3Image.jpg"
constant Base = "minimax_h3_image_pruned_int8_convrot.safetensors"
constant Vae = "minimax_h3_image_vae_fp16.safetensors"
constant Area = 2048
constant PromptHelp = ("UTF-8 prompt file or the prompt itself, {a|b|c} picks one of them per image; with --image an edit instruction that can name it <Picture 1>", "image (png or jpg) to edit, empty makes a new image")
constant SizeHelp = ("width in pixels, rounded to a multiple of 32, 0 for 2048 or the --image width scaled to a short side of 1024 to 2048", "height in pixels, 0 like --width")
constant StepsHelp = ("sampling steps, 6 match the model's distilled heads (ComfyUI's template), fewer are faster and rougher", "seed of every image, -1 for a random one per image", "images per run")
constant LoraHelp = List(Text) + "LoRA path[:strength] in models/loras or anywhere, repeat for more"
constant DecoderHelp = "decoder: the H3 Image VAE, p-h3-image_vae_int8_convrot.safetensors (cleaner faces, slower) or taeh3.safetensors (tiny draft), "
constant DecoderNamesHelp = "a name in models/vae or models/vae_approx or a path, empty for " + Vae
constant ModelHelp = ("H3 Image model file, a name in models/diffusion_models or a path, empty for " + Base, DecoderHelp + DecoderNamesHelp)
constant EncoderHelp = ("Qwen3-VL text encoder file, a name in models/text_encoders or a path, empty for " + H3Batch.Encoder, "ComfyUI models folder for files given by name, empty for D: or C:/ComfyUI_windows_portable/ComfyUI/models")
constant OutputHelp = List(Text) + "numbered output base (.jpg or .png), never overwritten"
constant Help = PromptHelp + SizeHelp + StepsHelp + LoraHelp + ModelHelp + EncoderHelp + OutputHelp
constant Stacked = ("--lora", "tinyqkvlora.safetensors", "--lora", "tinylora.safetensors")
constant Local = H3ImageOptions.Parsed(("--models", "."))
Checkpoint Text
	Local.Checkpoint is Error("FileNotFound:" + Base)
	H3ImageOptions.Parsed(("--model", "tinyh3image.safetensors")).Checkpoint is "tinyh3image.safetensors"
	ModelFiles(models).Located(model is "" then Base else model, "diffusion_models")
Decoder Text
	Local.Decoder is Error("FileNotFound:" + Vae)
	let folder = File(ModelFiles(models).Folder + "/vae_approx/" + vae).Exists then "vae_approx" else "vae"
	ModelFiles(models).Located(vae is "" then Vae else vae, folder)
VaeEncoder Text
	H3ImageOptions.Parsed(("--vae", "tinyh3imagevae.safetensors")).VaeEncoder is "tinyh3imagevae.safetensors"
	H3ImageOptions.Parsed(("--models", ".", "--vae", "tinytaeh3.safetensors")).VaeEncoder is Error("FileNotFound:" + Vae)
	let decoder = Decoder
	(decoder is Error) or (Taeh3Decoder.Is(decoder) is false) then decoder else ModelFiles(models).Located(Vae, "vae")
Encoder Text
	Local.Encoder is Error("FileNotFound:" + H3Batch.Encoder)
	Files.Encoder
Loras Text
	H3ImageOptions.Parsed(("--lora", "tinylora.safetensors:0.5")).Loras is "tinylora.safetensors=0.5"
	H3ImageOptions.Parsed(Stacked).Loras is "tinyqkvlora.safetensors=1;tinylora.safetensors=1"
	Local.Loras is ""
	Text.Combine(ModelFiles(models).Specs(lora), ";")
Files H3Files
	H3ImageOptions.Parsed(("--image", "a.png")).Files.Images is ("a.png")
	H3ImageOptions.Parsed(("--image", "a.png")).Files.Cropped(0) is false
	H3ImageOptions.Parsed(("--image", "a.png")).Files.vision is "off"
	H3Files(textEncoder = textEncoder, models = models, image = image, crop = false, vision = "off")
Prompted Text
	H3ImageOptions.Parsed(("--prompt", "a red fox")).Prompted is "a red fox"
	H3ImageOptions.Parsed(("--prompt", "H3ImageOptions.strict")).Prompted.StartsWith("has prompt")
	File(prompt).Exists then PromptBatch.Sample.Template(prompt) else prompt
Original Slow(Numbers)
	H3ImageOptions.Parsed(("--image", "tinyframe.png")).Original is (2, 4)
	Local.Original.Length is 0
	if image is ""
		return List(Number)
	let picture = ImageLoader(image).Loaded
	(picture.Size.Height, picture.Size.Width)
Size(original Numbers) Numbers
	Local.Size(List(Number)) is (2048, 2048)
	H3ImageOptions.Parsed(("--width", "1000")).Size(List(Number)) is (2048, 992)
	H3ImageOptions.Parsed(("--width", "512", "--height", "768")).Size((100, 100)) is (768, 512)
	Local.Size((600, 900)) is (1024, 1536)
	let fallback = original.Length is 0 then (Area, Area) else Scaled(original, 1024, 2 * 1024)
	let high = height > 0 then ComfySize.Plain.Snap(height, 32) else fallback(0)
	(high, width > 0 then ComfySize.Plain.Snap(width, 32) else fallback(1))
Vision(original Numbers) Numbers
	Local.Vision((600, 900)) is (1024, 1536)
	Local.Vision((3000, 2000)) is (1536, 1024)
	Scaled(original, 1024, 1024)
Scaled(original Numbers, low Number, high Number) Numbers
	Local.Scaled((3000, 5000), 1024, 2048) is (2048, 3424)
	Local.Scaled((1200, 1300), 1024, 2048) is (1216, 1312)
	let shortest = (original(0), original(1)).Minimum
	let scale = shortest.Clamp(low, high) / shortest
	for original
		((value * scale / 32).Round * 32, 32).Maximum
Problem Text
	Local.Problem is ""
	Local.output is "H3Image.jpg"
	H3ImageOptions.Parsed(("--steps", "0")).Problem is "--steps and --count must be at least 1"
	H3ImageOptions.Parsed(("--output", "a.gif")).Problem is "--output must end with .jpg or .png"
	H3ImageOptions.Parsed(("--image", "missing.png")).Problem is "--image missing.png was not found"
	if (steps < 1) or (count < 1)
		return "--steps and --count must be at least 1"
	if (output.Lower.EndsWith(".jpg") or output.Lower.EndsWith(".png")) is false
		return "--output must end with .jpg or .png"
	(image is "") or File(image).Exists then "" else "--image " + image + " was not found"
