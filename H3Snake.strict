has alphas Numbers
has betas Numbers
has up Numbers
has down Numbers
constant Tiny = H3Snake.Loaded(H3Conv.Model, "decoder.resblocks.0.activations.0.")
constant Single = H3Snake(List(Number) + Radians.DegreesPerRadian, (1), Tiny.up, Tiny.down)
constant Upsampled = Moss.Transposed(H3Conv.Model.Values("reference.ups.0"), 64)
constant Padding = 5
constant Offset = 15
Loaded(model Safetensors, prefix Text) Slow(H3Snake)
	Tiny.alphas.Length is 64
	Tiny.down.Length is 12
	let scales = Angles(model.Values(prefix + "act.alpha"))
	let strengths = Inverses(model.Values(prefix + "act.beta"))
	let raising = model.Values(prefix + "upsample.filter")
	H3Snake(scales, strengths, raising, model.Values(prefix + "downsample.lowpass.filter"))
Angles(values Numbers) Slow(Numbers)
	Tiny.Angles((0))(0).IsNearlyEqual(57.29578)
	for values
		value.Exponential * Radians.DegreesPerRadian
Inverses(values Numbers) Slow(Numbers)
	Tiny.Inverses((0))(0).IsNearlyEqual(1)
	Tiny.Inverses((-1000))(0) is 1000000000
	for values
		1 / (value.Exponential + 0.000000001)
Output(signal Numbers) Slow(Numbers)
	Tiny.Output(Upsampled).Length is 1280
	Tiny.Output(Upsampled)(451).IsNearlyEqual(H3Conv.Model.Values("reference.resblocks.0.activations.0")(67), 0.001)
	Lowered(Snaked(Raised(signal, alphas.Length), alphas.Length), alphas.Length)
Raised(signal Numbers, channels Number) Slow(Numbers)
	Single.Raised((1, 1, 1, 1), 1).Length is 8
	Single.Raised((1, 1, 1, 1), 1)(3).IsNearlyEqual(1, 0.01)
	let length = signal.Length / channels
	for 2 * signal.Length
		2 * Rising(signal, up, channels, index % channels, (index / channels).Floor, length)
Rising(signal Numbers, filter Numbers, channels Number, channel Number, position Number, length Number) Slow(Number)
	Single.Rising((1, 1, 1, 1), Single.up, 1, 0, 3, 4).IsNearlyEqual(0.5, 0.01)
	Single.Rising((1, 2, 4, 8, 16, 32, 64, 128), (1, 3, 5, 7), 2, 1, 2, 4) is 608
	Single.Rising((1, 2, 4, 8, 16, 32, 64, 128), (1, 3, 5, 7), 2, 1, 4, 4) is 1280
	mutable sum = 0
	let shifted = position + Offset
	let phase = shifted % 2
	for filter.Length / 2
		let tap = phase + 2 * index
		let source = ((shifted - tap) / 2 - Padding).Clamp(0, length - 1)
		sum = sum + filter(tap) * signal(source * channels + channel)
	sum
Snaked(raised Numbers, channels Number) Slow(Numbers)
	Single.Snaked((1, 0), 1)(0).IsNearlyEqual(1.708073)
	for raised
		Snake(value, Degrees(alphas(index % channels) * value), betas(index % channels))
Lowered(snaked Numbers, channels Number) Slow(Numbers)
	Single.Lowered((1, 1, 1, 1), 1).Length is 2
	Single.Lowered((1, 1, 1, 1), 1)(1).IsNearlyEqual(1, 0.01)
	let length = snaked.Length / channels
	for snaked.Length / 2
		Falling(snaked, down, channels, index % channels, (index / channels).Floor, length)
Falling(snaked Numbers, filter Numbers, channels Number, channel Number, at Number, length Number) Slow(Number)
	Single.Falling((1, 1, 1, 1), Single.down, 1, 0, 1, 4).IsNearlyEqual(1, 0.01)
	Single.Falling((1, 2, 4, 8, 16, 32, 64, 128), (1, 3, 5, 7), 2, 1, 3, 4) is 1640
	mutable sum = 0
	let start = 2 * at
	for filter
		sum = sum + value * snaked((start + index - Padding).Clamp(0, length - 1) * channels + channel)
	sum
Snake(input Number, angle Degrees, beta Number) Slow(Number)
	Tiny.Snake(1, Degrees(Radians.DegreesPerRadian), 1).IsNearlyEqual(1.708073)
	let sine = angle.Sin
	input + beta * sine * sine