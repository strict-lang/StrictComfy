has videoPatches Batch
has audioPatches Batch
has condition Batch
has curve Numbers
has inverse Numbers
has refiner List(H3Block)
has refinedNorm Numbers
has blocks List(H3Block)
has final H3Final
constant Tiny = H3.Loaded("tinyh3.safetensors")
constant Model = Safetensors("tinyh3.safetensors", 32, "reference.")
constant Prompt = Model.Values("token_refiner")
constant Forward = Tiny.Output(Model.Values("video"), Model.Values("audio"), 0.75, Prompt, H3Layout.Tiny)
Loaded(path Text) H3
	Tiny.blocks.Length is 2
	let prefix = TensorFile.Header(path).IndexOf("\"model.diffusion_model.") < 0 then "" else "model.diffusion_model."
	let model = Safetensors(path, 32, prefix)
	let halves = Safetensors(path, 16, prefix)
	let patches = MossText.Dense(model, "video_patch_proj")
	let heard = MossText.Dense(model, "audio_patch_proj")
	let projected = MossText.Dense(halves, "condition_proj")
	let refiners = Blocks(model, "token_refiner.blocks.")
	let refined = halves.Values("token_refiner.final_norm.weight")
	let layers = Blocks(model, "blocks.")
	let table = model.Values("adaln_t_table")
	H3(patches, heard, projected, table, model.Values("rope.inv_freq"), refiners, refined, layers, H3Final.Loaded(model))
Blocks(model Safetensors, prefix Text) List(H3Block)
	Tiny.Blocks(Safetensors("tinyh3.safetensors"), "blocks.").Length is 2
	for Named(TensorFile.Header(model.path), model.prefix + prefix).Length
		H3Block.Loaded(model, prefix + index + ".")
Named(header Text, prefix Text) Texts
	Tiny.Named(TensorFile.Header("tinyh3.safetensors"), "token_refiner.blocks.").Length is 2
	Tiny.Named(TensorFile.Header("tinyh3.safetensors"), "blocks.").Length is 2
	for header.Split("\"" + prefix)
		if value.Substring(0, value.IndexOf("\"")).EndsWith(".norm1.weight")
			value
Refined(context Numbers) Numbers
	Tiny.Refined(Model.Values("context"))(0).IsNearlyEqual(-0.960938, 0.03)
	Tiny.Refined(Model.Values("context"))(767).IsNearlyEqual(0.613281, 0.03)
	let words = context.Length / condition.weights.First.Length
	let unturned = H3Layout(words, 0, 0, 0, 0).Unturned
	mutable hidden = condition.Sums(context)
	for refiner
		hidden = value.Refined(hidden, unturned)
	H3Block.Normalized(hidden, refinedNorm)
Curves(times Numbers) Numbers
	Tiny.Curves(H3Layout.Tiny.Times(0.75))(2).IsNearlyEqual(0.818626, 0.001)
	Tiny.Curves(H3Layout.Tiny.Times(0.75))(15).IsNearlyEqual(0.118705, 0.001)
	let width = final.modulation.weights.First.Length
	let grid = curve.Length / width
	for times.Length * width
		let place = times((index / width).Floor).Clamp * (grid - 1)
		let low = place.Floor.Clamp(0, grid - 2)
		curve(low * width + index % width).Lerp(curve((low + 1) * width + index % width), place - low)
Patched(latent Numbers, layout H3Layout) Numbers
	Tiny.Patched((1, 2, 5, 6, 3, 4, 7, 8), H3Layout(0, 0, 1, 2, 4)) is (1, 2, 3, 4, 5, 6, 7, 8)
	Tiny.videoPatches.Sums(Tiny.Patched(Model.Values("video"), H3Layout.Tiny))(1000).IsNearlyEqual(-0.514158, 0.01)
	let channels = latent.Length / (layout.frames * layout.height * layout.width)
	for latent.Length
		let column = index % (4 * channels)
		let row = (index / (4 * channels)).Floor
		let y = (row % layout.Patches / (layout.width / 2)).Floor * 2 + (column % 4 / 2).Floor
		let x = row % layout.Patches % (layout.width / 2) * 2 + column % 2
		let plane = (column / 4).Floor * layout.frames + (row / layout.Patches).Floor
		latent((plane * layout.height + y) * layout.width + x)
Packed(sound Numbers, layout H3Layout) Numbers
	Tiny.Packed((1, 3, 2, 4), H3Layout(0, 1, 0, 0, 0)) is (1, 2, 3, 4)
	Tiny.audioPatches.Sums(Tiny.Packed(Model.Values("audio"), H3Layout.Tiny))(700).IsNearlyEqual(-0.413504, 0.01)
	let channels = sound.Length / (2 * layout.audio)
	for sound.Length
		let row = (index / channels).Floor
		sound((index % channels * 2 + (row / layout.audio).Floor) * layout.audio + row % layout.audio)
Output(latent Numbers, sound Numbers, sigma Number, text Numbers, layout H3Layout) Numbers
	Forward(0).IsNearlyEqual(1.007812, 0.05)
	Forward(100).IsNearlyEqual(-2.90625, 0.05)
	Forward(818).IsNearlyEqual(0.773438, 0.05)
	let curves = Curves(layout.Times(sigma))
	let rotation = layout.Rotations(inverse)
	let starts = layout.Rows(sigma)
	mutable hidden = text + audioPatches.Sums(Packed(sound, layout)) + videoPatches.Sums(Patched(latent, layout))
	for blocks
		hidden = value.Output(hidden, curves, starts, rotation)
	final.Output(hidden, curves, layout, sigma)