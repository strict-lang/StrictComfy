constant ReadPolls = 2000
constant Closing = "\r\nConnection: close\r\n\r\n"
constant CarriageReturn = 13
constant LineFeed = 10
Delivered(endpoint Text, body Text) Text
	let parts = endpoint.Split(":")
	if parts.Length < 2
		return "error\t" + endpoint
	let prepared = Prepared(parts(0), parts(1) to Number, body)
	let response = Posted(parts(0), parts(1) to Number, "/run", Marked(prepared))
	if response is ""
		return "error\t" + endpoint + " did not answer"
	let accepted = Json(response).get("accepted") to Text
	(accepted is "") or (accepted is "-1") then "error\tThe other StrictGen did not queue the job" else accepted
Prepared(host Text, port Number, body Text) Text
	let json = Json(body)
	let video = json.get("video") to Text
	let image = json.get("image") to Text
	let sent = video is "" then body else Rewritten(body, video, Uploaded(host, port, video))
	image is "" then sent else Rewritten(sent, image, Uploaded(host, port, image))
Uploaded(host Text, port Number, path Text) Text
	if (path is "") or (File(path).Exists is false)
		return path
	let saved = Sent(host, port, "/inbox?name=" + Path(path).FileName.text, File(path).ReadBytes)
	saved is "" then path else saved
Asked(endpoint Text, id Number) Text
	let parts = endpoint.Split(":")
	parts.Length < 2 then "error\tmissing" else Posted(parts(0), parts(1) to Number, "/job?id=" + id, "")
Saved(endpoint Text, path Text) Text
	let parts = endpoint.Split(":")
	if (parts.Length < 2) or (path is "")
		return ""
	let bytes = Gotten(parts(0), parts(1) to Number, "/file?path=" + Escaped(path))
	if bytes.Length is 0
		return ""
	Directory.Create(StrictGen.Outputs)
	let local = StrictGen.Outputs + "/" + Path(path).FileName.text
	File(local).Write(bytes)
	local
Posted(host Text, port Number, path Text, body Text) Text
	Sent(host, port, path, StrictGenHttp.Encoded(body))
Sent(host Text, port Number, path Text, payload Numbers) Text
	let header = "POST " + path + " HTTP/1.1\r\nHost: " + host + "\r\nContent-Length: " + payload.Length + Closing
	StrictGenHttp.Decoded(After(Exchanged(host, port, StrictGenHttp.Encoded(header) + payload)))
Gotten(host Text, port Number, path Text) Numbers
	After(Exchanged(host, port, StrictGenHttp.Encoded("GET " + path + " HTTP/1.1\r\nHost: " + host + Closing)))
Exchanged(host Text, port Number, bytes Numbers) Numbers
	let socket = Socket.Try(host, port, 2)
	if socket is Error
		return List(Number)
	if Socket.Send(socket, bytes) is Error
		return Socket.Close(socket) is Error then List(Number) else List(Number)
	let response = Read(socket)
	Socket.Close(socket) is Error then response else response
Read(socket Number) Numbers
	mutable bytes = List(Mutable(Number))
	for Range(0, ReadPolls)
		let pending = Socket.Pending(socket)
		if pending > 0
			bytes = bytes + Socket.Receive(socket, pending)
		if Finished(bytes)
			return bytes
		Process.Wait(0.01)
	bytes
Finished(bytes Numbers) Boolean
	let end = HeaderEnd(bytes)
	if end < 0
		return false
	let header = StrictGenHttp.Decoded(bytes.Slice(0, end)).Lower
	let start = header.IndexOf("content-length: ")
	let digits = start < 0 then "0" else header.Substring(start + 16, header.Length - start - 16)
	let length = digits.Split("\r\n").First to Number
	bytes.Length - end >= (length is Error then 0 else length)
HeaderEnd(bytes Numbers) Number
	StrictGenRemote.HeaderEnd((13, 10, 13, 10, 65)) is 4
	StrictGenRemote.HeaderEnd((13, 10)) is -1
	for bytes
		if (index + 3 < bytes.Length) and (bytes(index) is CarriageReturn) and (bytes(index + 1) is LineFeed)
			if (bytes(index + 2) is CarriageReturn) and (bytes(index + 3) is LineFeed)
				return index + 4
	-1
After(bytes Numbers) Numbers
	let end = HeaderEnd(bytes)
	end < 0 then List(Number) else bytes.Slice(end, bytes.Length - end)
Marked(body Text) Text
	StrictGenRemote.Marked("{\"a\":1}") is "{\"placed\":true,\"a\":1}"
	body.StartsWith("{") then "{\"placed\":true," + body.Substring(1, body.Length - 1) else body
Rewritten(body Text, path Text, saved Text) Text
	(saved is "") or (saved is path) then body else body.Replace(Escaped(path), Escaped(saved))
Escaped(path Text) Text
	path.Replace("\\", "\\\\").Replace("\"", "\\\"")
