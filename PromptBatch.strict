has noun Text
constant Sample = PromptBatch("Image")
constant SeedRange = 4294967296
Seeds(seed Number, count Number) Numbers
	Sample.Seeds(7, 2) is (7, 7)
	Sample.Seeds(-1, 3).Unique.Length is 3
	for count
		seed >= 0 then seed else SeedRange.Random.Floor
Template(path Text) Text slow
	Sample.Template("a red fox") is Error("FileNotFound:a_red_fox")
	if File(path).Exists is false
		return Error("FileNotFound:" + path.Replace(" ", "_"))
	Text.Combine(File(path).ReadLines, "\n").Trim
Templates(paths Texts, prompt Text) Texts slow
	Sample.Templates(List(Text) + "missing.txt", "a fox") is List(Text) + "a fox"
	Sample.Templates(List(Text) + "PromptBatch.strict", "").First.StartsWith("has noun")
	for paths
		prompt is "" then Template(value) else prompt
Prompts(templates Texts, seeds Numbers) Texts
	Sample.Prompts(List(Text) + "a", (1, 2)) is ("a", "a")
	for seeds
		prompt = Expand(templates(index % templates.Length), value)
		logger.Log(Prompting(index, seeds.Length, value, prompt))
		prompt
Prompting(index Number, count Number, seed Number, prompt Text) Text
	Sample.Prompting(1, 3, 42, "a fox") is "Image 2/3, seed 42\nPrompt: a fox"
	noun + " " + (index + 1) + "/" + count + ", seed " + seed + "\nPrompt: " + prompt
Expand(template Text, seed Number) Text
	Sample.Expand("a cat", 1) is "a cat"
	Sample.Expand("{x|x}{y|y|y} {z}", 5) is "xy z"
	Sample.Expand("a {big|small} {red|{dark|light} blue} cat", 3).EndsWith(" cat")
	Sample.Expand("a {b", 1) is Error("UnclosedBrace")
	draws = MersenneTwister.Seeded(seed).Uints(template.Count("}") + 1)
	mutable expanded = template
	for draws.Length - 1
		expanded = Chosen(expanded, draws(index))
	expanded.IndexOf("{") >= 0 then Error("UnclosedBrace") else expanded
Simplify(template Text) Text
	Sample.Simplify("a {big|small} {red|{dark|light} blue} cat") is "a big red cat"
	Sample.Simplify("a cat") is "a cat" and Sample.Simplify("a } b") is "a } b"
	mutable text = template
	for template.Count("}")
		next = text.IndexOf("}") < 0 then text else Chosen(text, 0)
		text = next is Error then text else next
	text
Show(template Text) Text
	Sample.Show("a {red|grey} fox") is "a red fox (randomized)"
	Sample.Show("a fox") is "a fox"
	Simplify(template) + (template.IndexOf("{") >= 0 then " (randomized)" else "")
Chosen(text Text, draw Number) Text
	Sample.Chosen("a {b|c} d", 1) is "a c d"
	Sample.Chosen("{x|y}", 4) is "x"
	Sample.Chosen("a } b", 0) is Error("UnmatchedBrace")
	close = text.IndexOf("}")
	open = text.Substring(0, close).LastIndexOf("{")
	if open < 0
		return Error("UnmatchedBrace")
	choices = text.Substring(open + 1, close - open - 1).Split("|")
	text.Substring(0, open) + choices(draw % choices.Length) + text.Substring(close + 1, text.Length - close - 1)
Reserve(base Text) Text slow
	Sample.Reserve("PromptBatchTest.jpg") is "PromptBatchTest0001.jpg"
	Sample.Reserve("artifacts/PromptBatchTest.png") is "artifacts/PromptBatchTest0001.png"
	NameFile(base, Free(base, 1))
Outputs(base Text, count Number) Texts slow
	Sample.Outputs("PromptBatchTest.jpg", 2) is ("PromptBatchTest0001.jpg", "PromptBatchTest0002.jpg")
	File("PromptBatchTest0001.jpg").Exists is false
	mutable number = 0
	for count
		number = Free(base, number + 1)
		NameFile(base, number)
Saving(planned Text, base Text) Text slow
	Sample.Saving("PromptBatchTest0007.jpg", "PromptBatchTest.jpg") is "PromptBatchTest0007.jpg"
	Sample.Saving("PromptBatch.strict", "PromptBatch.strict") is "PromptBatch0001.strict"
	IsTaken(planned) then Reserve(base) else planned
Free(base Text, first Number) Number slow
	Sample.Free("PromptBatchTest.jpg", 3) is 3
	Sample.Free("../Strict/NeuralNetworks/tinysplit-00001-of-0.gguf", 3) is 4
	mutable number = first
	for as long as IsTaken(NameFile(base, number))
		number = number + 1
	number
NameFile(base Text, number Number) Text
	Sample.NameFile("a.jpg", 7) is "a0007.jpg"
	dot = base.LastIndexOf(".")
	AddNumber(base.Substring(0, dot), number) + base.Substring(dot)
IsTaken(path Text) Boolean slow
	Sample.IsTaken("PromptBatch.strict")
	Sample.IsTaken("PromptBatchMissing.jpg") is false
	File(path).Exists or File(path + ".json").Exists
AddNumber(stem Text, number Number) Text
	Sample.AddNumber("a", 7) is "a0007"
	Sample.AddNumber("a", 12345) is "a12345"
	digits = number to Text
	stem + "0000".Substring(0, (4 - digits.Length).Clamp(0, 4)) + digits
