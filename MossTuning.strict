has rows Safetensors
has loras Text
constant Lora = "tinylora.safetensors"
constant Fours = MossTuning(Safetensors("tinymossint4.safetensors", 32, "layers.0.proj."), Lora)
constant Floats = MossTuning(Safetensors(MossBlock.Model.path, 32, "layers.0.proj."), Lora)
constant Unmerged = MossBlock.Loaded(Safetensors("tinymossint4.safetensors"), "layers.0.", Lora)
constant Merging = MossBlock.Loaded(MossBlock.Model, "layers.0.", Lora)
constant Output = Unmerged.Output(MossBlock.Input, MossBlock.Modulation, MossBlock.Rotation)
constant Reference = Merging.Output(MossBlock.Input, MossBlock.Modulation, MossBlock.Rotation)
Deltas Slow(List(MossLora))
	Fours.Deltas.Length is 4
	MossTuning(Fours.rows, "").Deltas.Length is 0
	Floats.Deltas.Length is 0
	MossImage(Logger).Error(Output, Reference) < 0.1
	if (loras is "") or (rows.Entry("o.weight_scale") is "") or (rows.Entry("o.comfy_quant") is not "")
		return List(MossLora)
	let qkv = Stacked("q.").Placed(0).Stacked(Stacked("k.").Placed(1)).Stacked(Stacked("v.").Placed(2))
	(qkv, Stacked("o."), Stacked("ffn_up_gate."), Stacked("ffn_down."))
Stacked(name Text) Slow(MossLora)
	Fours.Stacked("q.").rank is 8
	H3Lora(loras).Stacked(rows.prefix + name)
Merged(name Text, deltas List(MossLora)) Slow(List(Numbers))
	Fours.Merged("o", Fours.Deltas) is MossTuning(Fours.rows, "").Merged("o", List(MossLora))
	H3Lora(deltas.Length is 0 then loras else "").Merged(rows, name, rows.prefix)
Qkv(deltas List(MossLora)) Slow(List(Numbers))
	MossBlock.Tiny.attention.Length is 768
	MossTuning(Floats.rows, "").Qkv(List(MossLora)) is MossBlock.Tiny.attention
	if rows.Entry("qkv.weight") is not ""
		return Merged("qkv", deltas)
	Merged("q", deltas) + Merged("k", deltas) + Merged("v", deltas)
