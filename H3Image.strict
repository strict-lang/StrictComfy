constant OptionsOnly = "H3Image.exe takes --options only (a prompt goes into --prompt), see H3Image.exe --help"
Run(arguments Texts) Number
	H3Image.Run(List(Text) + "--help") is 0
	H3Image.Run(("--colour", "--local")) is 1 and H3Image.Run(("a", "fox")) is 1
	if "--help" is in arguments
		Help
		return 0
	if "coordinator" is in arguments
		return Coordinator.Serve is Error then Backend.Failed else 0
	given = arguments - MachineUse.Force
	if given.Length > 1 and given(0) is "encode"
		return H3ImageJob(H3ImageOptions.Parsed(given.Slice(2, given.Length - 2))).Encode(given)
	Backend.IsServing(arguments) then H3ImageServer(H3ImageServer.Backended).Run(arguments) else Unknown
Help
	H3Image.Help is not Error
	logger.Log("H3Image.exe [options] makes images with H3 Image, --image edits one\n" + H3ImageOptions.Usage)
	logger.Log("A backend keeps the models loaded for the next runs, --local runs without it, 'H3Image stop' ends it")
Unknown Number
	H3Image.Unknown is 1
	H3ImageServer.Sample.IsRefused(OptionsOnly) then 1 else 0
