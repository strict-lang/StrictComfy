has firstNorm GroupNorm
has first Convolution
has secondNorm GroupNorm
has second Convolution
has shortcut Convolution
constant Model = Safetensors("tinyvae.safetensors")
constant Middle = FluxResnet.Loaded(Model, "decoder.mid.block_1.", 4)
constant Upsampled = FeatureMap(Model.Values("reference.up.1.upsample"), 8, 16, Layer.Zeros(16))
constant Input = FeatureMap(Model.Values("reference.conv_in"), 4, 16, Layer.Zeros(16))
Loaded(model Safetensors, prefix Text, groups Number) Slow(FluxResnet)
	Middle.first.biases.Length is 16
	Middle.shortcut.biases.Length is 0
	FluxResnet.Loaded(Model, "decoder.up.0.block.0.", 4).shortcut.weights.Length is 128
	let block = Safetensors(model.path, 32, model.prefix + prefix)
	let none = Convolution(List(Number), List(Number))
	let projection = block.Entry("nin_shortcut.weight") is "" then none else Convolved(block, "nin_shortcut")
	let entry = Convolved(block, "conv1")
	FluxResnet(Norm(block, "norm1", groups), entry, Norm(block, "norm2", groups), Convolved(block, "conv2"), projection)
Output(map FeatureMap) Slow(FeatureMap)
	Middle.Output(Input).Completed(0).IsNearlyEqual(-0.64259, 0.01)
	Middle.Output(Input).Completed(128).IsNearlyEqual(-0.31808, 0.01)
	Middle.Output(Input).Completed(383).IsNearlyEqual(0.60561, 0.01)
	FluxResnet.Loaded(Model, "decoder.up.0.block.0.", 4).Output(Upsampled).Completed(256).IsNearlyEqual(-1.88429, 0.01)
	let hidden = first.Applied(map, firstNorm.Affine(map), true)
	let output = second.Applied(hidden, secondNorm.Affine(hidden), true)
	(shortcut.biases.Length is 0 then map else shortcut.Projected(map)).Plus(output)
Norm(model Safetensors, name Text, groups Number) Slow(GroupNorm)
	Middle.Norm(Model, "decoder.norm_out", 4).weights.Length is 8
	GroupNorm(model.Values(name + ".weight"), model.Values(name + ".bias"), groups)
Convolved(model Safetensors, name Text) Slow(Convolution)
	Middle.Convolved(Model, "decoder.conv_in").weights(1) is Model.Values("decoder.conv_in.weight")(9)
	Middle.Convolved(Safetensors("tinytaef2.safetensors"), "decoder.layers.6").biases is Layer.Zeros(8)
	let shape = model.Shape(name + ".weight")
	let biases = model.Entry(name + ".bias") is "" then Layer.Zeros(shape(0)) else model.Values(name + ".bias")
	Convolution(Convolution.Rearranged(model.Values(name + ".weight"), shape(1), shape(2)), biases)