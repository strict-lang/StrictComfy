has steps Number
has shift Number
constant Moss = Euler(8, 5)
Sigmas Numbers
	Moss.Sigmas.Length is 9
	Moss.Sigmas(0) is 1
	Moss.Sigmas(1).IsNearlyEqual(0.9722222)
	Moss.Sigmas(7).IsNearlyEqual(0.4166667)
	Moss.Sigmas(8) is 0
	for steps + 1
		let time = 1 - index / steps
		shift * time / (1 + (shift - 1) * time)
Stepped(latent Numbers, output Numbers, sigmas Numbers, step Number) Numbers
	Moss.Stepped((1, 2), (2, 4), Moss.Sigmas, 7)(1).IsNearlyEqual(2 - 5 / 12 * 4)
	let change = sigmas(step + 1) - sigmas(step)
	for latent
		value + change * output(index)
