has steps Number
has shift Number
constant Moss = Euler(8, 5)
constant Flow = (1, 0.931506, 0.839236, 0.703462, 0.5, 0.296538, 0.160764, 0.068494, 0)
Sigmas Numbers
	Moss.Sigmas.Length is 9
	Moss.Sigmas(0) is 1
	Moss.Sigmas(1).IsNearlyEqual(0.9722222)
	Moss.Sigmas(7).IsNearlyEqual(0.4166667)
	Moss.Sigmas(8) is 0
	Euler(3, 12).Sigmas(1).IsNearlyEqual(0.960057557)
	Euler(6, 12).Sigmas(5).IsNearlyEqual(0.70638001)
	for steps + 1
		index is steps then 0 else Shifted(1 - (index * (1000 / steps)).Floor / 1000)
Spaced(intervals Number) Numbers
	Euler(8, 12).Spaced(8)(1).IsNearlyEqual(0.9883928)
	Euler(8, 12).Spaced(8)(7).IsNearlyEqual(0.6526598)
	Euler(8, 12).Spaced(7)(7).IsNearlyEqual(0.125984251)
	Euler(1, 12).Spaced(1) is (1, 0)
	let least = Shifted(0.001)
	for steps + 1
		index is steps then 0 else Shifted(1 - index * (1 - least) / intervals)
Beta(alpha Number, beta Number) Numbers
	Euler(4, 12).Beta(0.6, 0.6)(1).IsNearlyEqual(0.982511938)
	Euler(4, 12).Beta(0.6, 0.6)(2).IsNearlyEqual(0.923360527)
	Euler(4, 12).Beta(0.5, 0.7)(3).IsNearlyEqual(0.563135028)
	let distribution = BetaDistribution(alpha, beta)
	for steps + 1
		index is steps then 0 else Shifted(((distribution.Quantile(1 - index / steps) * 999).Counted("Even") + 1) / 1000)
Quadratic Numbers
	Euler(8, 12).Quadratic(3).IsNearlyEqual(0.981249988)
	Euler(8, 12).Quadratic(6).IsNearlyEqual(0.725000024)
	Euler(1, 12).Quadratic is (1, 0)
	if steps is 1
		return (1, 0)
	let linear = (steps / 2).Floor
	let spread = (linear - 0.025 * steps) / (steps - linear) ^ 2
	let slope = 0.025 / linear - 2 * spread
	for steps + 1
		let ramp = index < linear then index * 0.025 / linear else spread / linear * (index ^ 2 + linear ^ 2) + slope * index
		index is steps then 0 else 1 - ramp
Scheduled(scheduler Number, sampler Number) Numbers
	Euler(1, 12).Scheduled(1, 2)(0).IsNearlyEqual(0.9999917)
	Euler(4, 5).Scheduled(0, 1) is Euler(4, 5).Sigmas
	Euler(4, 5).Scheduled(0, 4)(0).IsNearlyEqual(0.999979998)
	let sigmas = Schedule(scheduler)
	(sampler is 2) or (sampler is 4) then Offset(sigmas) else sigmas
Schedule(scheduler Number) Numbers
	Euler(8, 12).Schedule(2)(4).IsNearlyEqual(0.902460515)
	Euler(4, 12).Schedule(4)(3).IsNearlyEqual(0.563135028)
	Euler(8, 12).Schedule(5)(5).IsNearlyEqual(0.909375012)
	Euler(8, 12).Schedule(6)(7).IsNearlyEqual(0.468753315)
	if (scheduler is 1) or (scheduler is 2)
		return Spaced(scheduler is 1 then steps else (steps - 1).Clamp(1, steps))
	if (scheduler is 3) or (scheduler is 4)
		return scheduler is 3 then Beta(0.6, 0.6) else Beta(0.5, 0.7)
	if scheduler is 6
		return HyperFlow
	scheduler is 5 then Quadratic else Sigmas
HyperFlow Numbers
	Euler(8, 12).HyperFlow(1).IsNearlyEqual(0.993909785)
	Euler(4, 12).HyperFlow is Error("HyperFlowNeedsEightSteps")
	if steps is not 8
		return Error("HyperFlowNeedsEightSteps")
	for Flow
		Shifted(value)
Shifted(time Number) Number
	Moss.Shifted(1) is 1
	Moss.Shifted(0.5).IsNearlyEqual(5 / 6)
	shift * time / (1 + (shift - 1) * time)
Offset(sigmas Numbers) Numbers
	Euler(4, 5).Offset(Euler(4, 5).Sigmas)(0).IsNearlyEqual(0.999979998)
	Euler(4, 5).Offset(Euler(4, 5).Sigmas)(1) is 0.9375
	for sigmas
		(index is 0) and (value >= 1) then Shifted(0.9999) else value
Stepped(latent Numbers, output Numbers, sigmas Numbers, step Number, start = 0) Numbers
	Moss.Stepped((1, 2), (2, 4), Moss.Sigmas, 7)(1).IsNearlyEqual(2 - 5 / 12 * 4)
	Moss.Stepped((1, 2), (0, 2, 4), Moss.Sigmas, 7, 1)(1).IsNearlyEqual(2 - 5 / 12 * 4)
	let change = sigmas(step + 1) - sigmas(step)
	for latent
		value + change * output(start + index)
