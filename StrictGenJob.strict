has current = -1
has log = ""
has done = ""
has preview = ""
has remote = ""
has remoteId = -1
has started = 0
has times Numbers = List(Number)
has nagged = 0
constant Detached = "/c start \"StrictGen\" /MIN /D \""
constant PromptLine = "Prompt: "
constant WarmLog = "StrictGenWarm.log"
constant WarmDone = "StrictGenWarm.done"
Local(at Number) StrictGenJob
	StrictGenJob.Local(2).log is "StrictGenJob-2.log"
	StrictGenJob.Local(2).current is 2
	job = StrictGenJob(value, current = at, log = "StrictGenJob-" + at + ".log", done = "StrictGenJob-" + at + ".done")
	StrictGenJob(job, preview = "StrictGenStep-" + at + ".jpg", started = Time.Now)
Remote(at Number, endpoint Text, id Number) StrictGenJob
	StrictGenJob.Remote(1, "10.0.0.3:59139", 4).remoteId is 4
	StrictGenJob(value, current = at, remote = endpoint, remoteId = id)
Logged Texts slow
	StrictGenJob.Logged.Length is 0
	rows = current >= 0 and log is not "" and File(log).Exists then File(log).ReadLines else List(Text)
	rows.Length > 0 and rows.Last.Trim is "" then rows.Slice(0, rows.Length - 1) else rows
Timed(rows Texts) StrictGenJob
	StrictGenJob.Local(1).Timed(("a", "b")).times.Length is 2
	StrictGenJob(StrictGenJob.Local(1), times = List(Number) + 1).Timed(("a", "b")).times(0) is 1
	StrictGenJob(StrictGenJob.Local(1), started = Time.Now - 5).Timed(("a", "b")).times(1) >= 4.9
	if rows.Length <= times.Length
		return value
	now = ((Time.Now - started) * 10).Round / 10
	mutable stamped = times
	for rows.Length - times.Length
		stamped = stamped + now
	StrictGenJob(value, times = stamped)
Stamp(rows Texts) Texts
	StrictGenJob(StrictGenJob.Local(1), times = (0, 1.5)).Stamp(("a", "b")) is ("0\ta", "1.5\tb")
	for rows
		(index < times.Length then times(index) else 0) + "\t" + value
Keep(rows Texts) None slow
	StrictGenJob.Local(-9).Keep(List(Text) + "a") is not Error
	File("StrictGenJob-" + current + ".timed").Write(Stamp(rows))
HasStarted(executable Text, mode Text, command Text) Boolean slow
	words = command.Split("\n")
	arguments = mode is "h3image" then words else words + "--preview" + preview
	for (done, preview, log, "StrictGenJob-" + current + ".timed")
		File(value).Delete
	script = Process.OperatingSystem is "Windows" then "StrictGenJob.cmd" else "StrictGenJob.sh"
	File(script).Write(Script(executable, Quote(arguments), log, done))
	HasSpawned(script)
HasWarmed(executable Text, command Text) Boolean slow
	script = Process.OperatingSystem is "Windows" then "StrictGenWarm.cmd" else "StrictGenWarm.sh"
	File(script).Write(Script(executable, Quote(command.Split("\n") + "--warm"), WarmLog, WarmDone))
	HasSpawned(script)
HasSpawned(script Text) Boolean slow
	if Process.OperatingSystem is "Windows" is false
		return Process.Find("sh").Start(script) is 0
	Process.RunTool("cmd", Detached + Directory.Current + "\" cmd /c \".\\" + script + "\"").HasFailed is false
Quote(words Texts) Text
	StrictGenJob.Quote(("--prompt", "a b.txt")) is "--prompt \"a b.txt\""
	StrictGenJob.Quote(("--width", "32")) is "--width 32"
	mutable line = ""
	for words
		word = value.IndexOf(" ") < 0 then value else "\"" + value + "\""
		line = line is "" then word else line + " " + word
	line
Find(rows Texts) Texts
	StrictGenJob.Find(("Saved a.jpg in 3 ms", "Wrote b.mp4")) is ("a.jpg", "b.mp4")
	StrictGenJob.Find(List(Text) + "hello").Length is 0
	for rows
		parts = value.Split(" ")
		if parts.Length > 1 and (parts.First is "Saved" or parts.First is "Wrote")
			parts(1)
Prompts(rows Texts) Texts
	StrictGenJob.Prompts(("Image 1/1, seed 2", "Prompt: a red fox", "Saved a.jpg")) is ("a red fox")
	for rows
		if value.StartsWith(PromptLine)
			value.Substring(PromptLine.Length, value.Length - PromptLine.Length)
Existing(paths Texts) Texts slow
	StrictGenJob.Existing(("StrictGenJob.strict", "StrictGenMissing.mp4")) is ("StrictGenJob.strict")
	for paths
		if File(value).Exists
			value
Executable(name Text) Text slow
	StrictGenJob.Executable("MossImage").IndexOf("MossImage") >= 0
	folder = Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text
	suffix = Process.OperatingSystem is "Windows" then ".exe" else ""
	file = folder + "/" + name + suffix
	File(file).Exists then file else name + suffix
Program(mode Text) Text
	StrictGenJob.Program("image") is "MossImage" and StrictGenJob.Program("h3image") is "H3Image"
	StrictGenJob.Program("extend") is "H3Video"
	mode is "image" then "MossImage" else (mode is "h3image" then "H3Image" else "H3Video")
Script(executable Text, arguments Text, logFile Text, doneFile Text) Texts
	StrictGenJob.Script("MossImage.exe", "--width 32", "job.log", "job.done").First.IndexOf("MossImage.exe") >= 0
	StrictGenJob.Script("MossImage.exe", "--width 32", "job.log", "job.done").Last.IndexOf("job.done") >= 0
	("\"" + executable + "\" " + arguments + " > \"" + logFile + "\" 2>&1", "echo DONE> \"" + doneFile + "\"")
Stop(program Text) None slow
	StrictGenJob.Stop("StrictGenMissing") is not Error
	executable = Executable(program)
	if executable.StartsWith(program) is false and Process.RunTool(executable, "stop").HasFailed
		return Error("ServersNotStopped: " + program)
StopAll None slow
	Stop("MossImage")
	Stop("H3Video")
	Stop("H3Image")
