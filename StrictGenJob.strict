has current = -1
has log = ""
has done = ""
has preview = ""
has remote = ""
has remoteId = -1
has started = 0
has times Numbers = List(Number)
has nagged = 0
constant Detached = "/c start \"StrictGen\" /MIN /D \""
constant PromptLine = "Prompt: "
Local(at Number) StrictGenJob
	StrictGenJob.Local(2).log is "StrictGenJob-2.log"
	StrictGenJob.Local(2).current is 2
	let job = StrictGenJob(value, current = at, log = "StrictGenJob-" + at + ".log", done = "StrictGenJob-" + at + ".done")
	StrictGenJob(job, preview = "StrictGenStep-" + at + ".jpg", started = Time.Now)
Remote(at Number, endpoint Text, id Number) StrictGenJob
	StrictGenJob.Remote(1, "10.0.0.3:59139", 4).remoteId is 4
	StrictGenJob(value, current = at, remote = endpoint, remoteId = id)
Logged Texts
	StrictGenJob.Logged.Length is 0
	(current >= 0) and (log is not "") and File(log).Exists then File(log).ReadLines else List(Text)
Timed(rows Texts) StrictGenJob
	StrictGenJob.Local(1).Timed(("a", "b")).times.Length is 2
	StrictGenJob(StrictGenJob.Local(1), times = List(Number) + 1).Timed(("a", "b")).times(0) is 1
	StrictGenJob(StrictGenJob.Local(1), started = Time.Now - 5).Timed(("a", "b")).times(1) >= 4.9
	if rows.Length <= times.Length
		return value
	let now = ((Time.Now - started) * 10).Round / 10
	mutable stamped = times
	for rows.Length - times.Length
		stamped = stamped + now
	StrictGenJob(value, times = stamped)
Stamped(rows Texts) Texts
	StrictGenJob(StrictGenJob.Local(1), times = (0, 1.5)).Stamped(("a", "b")) is ("0\ta", "1.5\tb")
	for rows
		(index < times.Length then times(index) else 0) + "\t" + value
Kept(rows Texts) Slow(None)
	StrictGenJob.Local(-9).Kept(List(Text) + "a") is not Error
	File("StrictGenJob-" + current + ".timed").Write(Stamped(rows))
Started(executable Text, mode Text, command Text) Boolean
	let words = command.Split("\n")
	let arguments = IsPreviewed(mode, command) then words + "--preview" + preview else words
	for (done, preview, log, "StrictGenJob-" + current + ".timed")
		File(value).Delete
	let script = Process.OperatingSystem is "Windows" then "StrictGenJob.cmd" else "StrictGenJob.sh"
	File(script).Write(Script(executable, Quoted(arguments), log, done))
	Spawned(script)
Spawned(script Text) Boolean
	if (Process.OperatingSystem is "Windows") is false
		return Process.Find("sh").Started(script) is 0
	Process.RunTool("cmd", Detached + Directory.Current + "\" cmd /c \".\\" + script + "\"").Failed is false
IsPreviewed(mode Text, command Text) Boolean
	StrictGenJob.IsPreviewed("image", "--quality\nbest")
	StrictGenJob.IsPreviewed("image", "--quality\nfastest2steps") is false
	StrictGenJob.IsPreviewed("video", "--quality\nbest")
	StrictGenJob.IsPreviewed("h3image", "--steps\n6") is false
	mode is "image" then command.IndexOf("--quality\nfastest") < 0 else mode is not "h3image"
Quoted(words Texts) Text
	StrictGenJob.Quoted(("--prompt", "a b.txt")) is "--prompt \"a b.txt\""
	StrictGenJob.Quoted(("--width", "32")) is "--width 32"
	mutable line = ""
	for words
		let word = value.IndexOf(" ") < 0 then value else "\"" + value + "\""
		line = line is "" then word else line + " " + word
	line
Found(rows Texts) Texts
	StrictGenJob.Found(("Saved a.jpg in 3 ms", "Wrote b.mp4")) is ("a.jpg", "b.mp4")
	StrictGenJob.Found(List(Text) + "hello").Length is 0
	for rows
		let parts = value.Split(" ")
		if (parts.Length > 1) and ((parts.First is "Saved") or (parts.First is "Wrote"))
			parts(1)
Prompts(rows Texts) Texts
	StrictGenJob.Prompts(("Image 1/1, seed 2", "Prompt: a red fox", "Saved a.jpg")) is ("a red fox")
	for rows
		if value.StartsWith(PromptLine)
			value.Substring(PromptLine.Length, value.Length - PromptLine.Length)
Existing(paths Texts) Texts
	StrictGenJob.Existing(("StrictGenJob.strict", "StrictGenMissing.mp4")) is ("StrictGenJob.strict")
	for paths
		if File(value).Exists
			value
Executable(name Text) Text
	StrictGenJob.Executable("MossImage").IndexOf("MossImage") >= 0
	let folder = Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text
	let suffix = Process.OperatingSystem is "Windows" then ".exe" else ""
	let file = folder + "/" + name + suffix
	File(file).Exists then file else name + suffix
Program(mode Text) Text
	(StrictGenJob.Program("image") is "MossImage") and (StrictGenJob.Program("h3image") is "H3Image")
	StrictGenJob.Program("extend") is "H3Video"
	mode is "image" then "MossImage" else mode is "h3image" then "H3Image" else "H3Video"
Script(executable Text, arguments Text, logFile Text, doneFile Text) Texts
	StrictGenJob.Script("MossImage.exe", "--width 32", "job.log", "job.done").First.IndexOf("MossImage.exe") >= 0
	StrictGenJob.Script("MossImage.exe", "--width 32", "job.log", "job.done").Last.IndexOf("job.done") >= 0
	("\"" + executable + "\" " + arguments + " > \"" + logFile + "\" 2>&1", "echo DONE> \"" + doneFile + "\"")
Stopped(program Text) Slow(None)
	StrictGenJob.Stopped("StrictGenMissing") is not Error
	let executable = Executable(program)
	if (executable.StartsWith(program) is false) and Process.RunTool(executable, "stop").Failed
		return Error("ServersNotStopped: " + program)
StopAll Slow(None)
	Stopped("MossImage")
	Stopped("H3Video")
	Stopped("H3Image")
