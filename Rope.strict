has head Number
has half Number
constant Video = Rope(128, 48)
constant Model = Safetensors("tinyh3.safetensors", 32, "reference.")
constant Turning = Video.Table(H3Layout.Tiny.Positions, H3Layout.Inverse, 1)
Table(positions Numbers, inverse Numbers, scale Number) Numbers slow
	Turning(3329).IsNearlyEqual(-0.869141)
	Turning(3505).IsNearlyEqual(0.494564)
	Turning(3748).IsNearlyEqual(-0.999574)
	Turning(3812) is 0
	Video.Table((2, 0, 0), H3Layout.Inverse, 0.2617994)(128).IsNearlyEqual(-0.5)
	for positions.Length / 3 * 2 * head
		let at = index % (2 * head)
		let pair = at % head % half
		let position = positions((index / (2 * head)).Floor * 3 + (pair / inverse.Length).Floor)
		Turned(at, Degrees(Radians(scale * position * inverse(pair % inverse.Length)) to Degrees))
Turned(at Number, angle Degrees) Number
	Video.Turned(0, Degrees(60)).IsNearlyEqual(0.5)
	Video.Turned(130, Degrees(30)).IsNearlyEqual(-0.5)
	Video.Turned(180, Degrees(30)).IsNearlyEqual(0.5)
	Video.Turned(100, Degrees(30)) is 1
	Rope(64, 24).Turned(112, Degrees(30)) is 0
	let within = at % head
	if within >= 2 * half
		return at < head then 1 else 0
	at < head then angle.Cos else (within < half then -angle.Sin else angle.Sin)
Still(tokens Number) Numbers
	Video.Still(17).Length is 4352
	Video.Still(17)(129) is 0
	Video.Still(17)(257) is 1
	let period = 2 * head
	for tokens * period
		index % period < head then 1 else 0
Rotated(combined Numbers, start Number, width Number, weights Numbers, rotation Numbers, scales Numbers) BFloat16s slow
	Video.Rotated(Model.Values("blocks.0.attn.qkv_proj"), 0, 512, Turning, Turning, Turning).Length is 8704
	for combined.Length / 3
		let token = (index / width).Floor
		let within = index % head
		let first = index - within + token * 2 * width + start
		let scale = scales((first / head).Floor)
		let paired = within < half then within + half else within < 2 * half then within - half else within
		let own = combined(first + within) * weights(within) * rotation(token * 2 * head + within)
		(own + (combined(first + paired) * weights(paired) * rotation((token * 2 + 1) * head + within))) * scale