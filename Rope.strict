has head Number
has half Number
constant Video = Rope(128, 48)
constant Model = Safetensors("tinyh3.safetensors", 32, "reference.")
constant Turning = Video.Table(H3Layout.Tiny.Positions, H3Layout.Inverse, 1)
Table(positions Numbers, inverse Numbers, scale Number) Float32s slow
	Turning(3329).IsNearlyEqual(-0.869141)
	Turning(3505).IsNearlyEqual(0.494564)
	Turning(3748).IsNearlyEqual(-0.999574)
	Turning(3812) is 0
	Video.Table((2, 0, 0), H3Layout.Inverse, 0.2617994)(128).IsNearlyEqual(-0.5)
	for positions.Length / 3 * 2 * head
		at = index % (2 * head)
		pair = at % head % half
		position = positions((index / (2 * head)).Floor * 3 + (pair / inverse.Length).Floor)
		Turn(at, Degrees(Radians(scale * position * inverse(pair % inverse.Length)) to Degrees))
Turn(at Number, angle Degrees) Number
	Video.Turn(0, Degrees(60)).IsNearlyEqual(0.5)
	Video.Turn(130, Degrees(30)).IsNearlyEqual(-0.5)
	Video.Turn(180, Degrees(30)).IsNearlyEqual(0.5)
	Video.Turn(100, Degrees(30)) is 1
	Rope(64, 24).Turn(112, Degrees(30)) is 0
	within = at % head
	if within >= 2 * half
		return at < head then 1 else 0
	at < head then angle.Cos else (within < half then -angle.Sin else angle.Sin)
Still(tokens Number) Float32s
	Video.Still(17).Length is 4352
	Video.Still(17)(129) is 0
	Video.Still(17)(257) is 1
	period = 2 * head
	for tokens * period
		index % period < head then 1 else 0
Rotate(combined Numbers, start Number, width Number, weights Numbers, rotation Numbers) BFloat16s slow
	Video.Rotate(Model.Values("blocks.0.attn.qkv_proj"), 0, 512, H3Block.Tiny.queryNorm, Turning).Length is 8704
	RopeRotated(combined, start, width, weights, rotation, half, head, H3Block.Epsilon).Rotated
Even(number Number) Float32s
	Rope(4, 1).Even(2) is (2, 2, 2, 2)
	for head
		number