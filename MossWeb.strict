has logger
constant Sized = ("--width", "480", "--height", "848", "--output", "MossWeb.jpg")
Run(prompt = "prompt.safetensors", model = "moss_image_sft_4step_int4_convrot.safetensors", vae = "flux2-small-vae.safetensors")
	let options = MossOptions.Parsed(("--quality", "fastest") + Sized)
	let moss = Moss.Loaded(model, "")
	logger.Log("Moss loaded in " + Process.Elapsed.Round(1) + " s")
	let previewer = Taef2Decoder.Loaded("taef2.safetensors")
	let sampling = MossSampling(options.Sampling(logger), preview = "MossWebStep", previewer = previewer)
	let context = Safetensors(prompt, 32).Values("context")
	let decoder = FluxDecoder.Loaded(vae, 32)
	mutable line = Process.InputLine
	for as long as line is not ""
		Generated(MossBatch(logger, options), moss, sampling, context, decoder, line to Number)
		line = Process.InputLine
Generated(batch MossBatch, moss Moss, sampling MossSampling, context Numbers, decoder FluxDecoder, seed Number) Slow(Text)
	let sampled = Process.Elapsed
	let latent = batch.Sampled(moss, sampling, seed, context, "Image")
	logger.Log("Sampled in " + (Process.Elapsed - sampled).Round(1) + " s")
	let decoded = Process.Elapsed
	batch.Saved(decoder.Decoded(latent, 30), decoded, seed, "", "MossWeb.jpg")
