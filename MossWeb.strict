has logger
constant FourSteps = "moss_image_sft_4step_int4_convrot.safetensors"
constant Distilled = "moss_image_sft_dmd_int4_convrot.safetensors"
constant Encoder = ("--models", ".", "--text_encoder", "qwen3.5_9b_int4_convrot.safetensors")
constant Sample = "7 480 848 fastest taef2\ta {red|red} fox"
constant DefaultPrompt = "A cinematic, photorealistic nighttime scene of a small neighborhood convenience store on a quiet, rain-soaked street. The warmly illuminated storefront occupies the right half of the frame, while the street recedes into soft mist on the left. A lone young adult wearing a charcoal coat stands just outside the entrance beneath a transparent umbrella, seen in three-quarter rear view, gazing through the glass. Amber light reveals shelves inside and spills across the sidewalk, mingling with muted teal neon reflections in shallow puddles. Individual raindrops bead on the umbrella and catch the storefront light; fine streaks of rain remain visible against the darker street. A slightly weathered bicycle leans beside the entrance. Distant apartment windows and a few out-of-focus streetlights add depth without distracting from the figure. Eye-level wide shot, 35mm lens aesthetic, natural perspective, balanced negative space, restrained teal-and-amber color grading, realistic wet asphalt and glass textures, soft highlight bloom, subtle film grain, and gentle atmospheric depth. Quiet, intimate, and nostalgic rather than dramatic; believable lighting, with the figure clearly silhouetted against the warm window. No prominent readable lettering, logos, or watermarks."
constant Qualities = ("best", "best", "best", "fast", "faster", "fastest", "fastest2steps")
Run
	let previewer = Taef2Decoder.Loaded("taef2.safetensors")
	mutable line = Process.InputLine
	for as long as line is not ""
		line = line.StartsWith("workflow ") then Workflow(line) else Session(previewer, line)
Session(previewer Taef2Decoder, first Text) Slow(Text)
	mutable prompt = Prompt(first)
	mutable context = Encoded(prompt)
	let moss = Loaded(Model(first))
	mutable line = first
	for as long as (line is not "") and (Setup(line) is Setup(first))
		if Prompt(line) is not prompt
			prompt = Prompt(line)
			context = Encoded(prompt)
		Generated(moss, previewer, context, line)
		line = Process.InputLine
	line
Settings(line Text) Texts
	MossWeb(Logger).Settings(Sample) is ("7", "480", "848", "fastest", "taef2")
	line.Split("\t").First.Split(" ")
Prompt(line Text) Text
	MossWeb(Logger).Prompt(Sample) is "a red fox"
	PromptBatch(logger, "Image").Expanded(line.Split("\t").Last, Settings(line)(0) to Number)
Setup(line Text) Text
	MossWeb(Logger).Setup(Sample) is FourSteps
	MossWeb(Logger).Setup("7 480 848 fastest taef2\tan owl") is FourSteps
	MossWeb(Logger).Setup("workflow a.json") is "workflow a.json"
	line.StartsWith("workflow ") then line else Model(line)
Workflow(line Text) Slow(Text)
	let path = line.Split(" ").Last
	let batch = MossBatch(logger, MossOptions.Parsed(("--models", ".", "--workflow", path))).Expanded(("--models", "."))
	let options = batch.options
	let settings = options.seed + " " + options.width + " " + options.height + " " + Quality(options)
	logger.Log("Workflow: " + settings + "\t" + batch.prompted)
	Process.InputLine
Quality(options MossOptions) Text
	MossWeb(Logger).Quality(MossOptions.Parsed(("--quality", "faster"))) is "faster"
	MossWeb(Logger).Quality(MossOptions.Parsed(("--steps", "3"))) is "fastest"
	MossWeb(Logger).Quality(MossOptions.Parsed(("--steps", "6"))) is "best"
	if options.steps is 0
		return Qualities(options.quality)
	options.steps <= 2 then "fastest2steps" else (options.steps <= 4 then "fastest" else "best")
Model(line Text) Text
	MossWeb(Logger).Model("7 480 848 best taef2\ta fox") is Distilled
	MossWeb(Logger).Model("7 480 848 fastest flux2-vae\ta fox") is FourSteps
	MossWeb(Logger).Model("7 480 848 fastest2steps taef2\ta fox") is FourSteps
	MossOptions.Parsed(("--quality", Settings(line)(3))).Evaluated > 4 then Distilled else FourSteps
Encoded(prompt Text) Slow(Numbers)
	MossWeb(Logger).Encoded(DefaultPrompt).Length is 251 * 4096
	if prompt is DefaultPrompt
		return Safetensors("Content/defaultprompt.safetensors", 32).Values("context")
	let context = MossBatch(logger, MossOptions.Parsed(Encoder)).Contexts(List(Text) + prompt).First
	GpuMemory.Evicted
	context
Loaded(model Text) Slow(Moss)
	let started = Process.Elapsed
	let moss = Moss.Loaded(model, "")
	logger.Log("Moss loaded in " + (Process.Elapsed - started).Round(1) + " s")
	moss
Generated(moss Moss, previewer Taef2Decoder, context Numbers, line Text) Slow(Text)
	let words = Settings(line)
	let sized = ("--width", words(1), "--height", words(2), "--output", "MossWeb.jpg")
	let options = MossOptions.Parsed(("--quality", words(3)) + sized)
	let batch = MossBatch(logger, options)
	let sampling = MossSampling(options.Sampling(logger), preview = "MossWebStep", previewer = previewer)
	let sampled = Process.Elapsed
	let latent = batch.Sampled(moss, sampling, words(0) to Number, context, "Image")
	logger.Log("Sampled in " + (Process.Elapsed - sampled).Round(1) + " s")
	let decoded = Process.Elapsed
	batch.Saved(Decoded(latent, options.width / 16, words(4), previewer), decoded, words(0) to Number, "", "MossWeb.jpg")
Decoded(latent Numbers, width Number, decoder Text, previewer Taef2Decoder) Slow(Numbers)
	if decoder is "taef2"
		return previewer.Decoded(latent, width)
	FluxDecoder.Loaded(decoder + ".safetensors", 32).Decoded(latent, width)
