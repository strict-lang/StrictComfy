constant FourSteps = "moss_image_sft_4step_int4_convrot.safetensors"
constant Encoder = ("--models", ".", "--text_encoder", "qwen3.5_9b_int4_convrot.safetensors")
constant Sample = "7 480 848 fastest taef2 7\ta {red|red} fox"
constant Qualities = ("best", "best", "best", "fast", "faster", "fastest", "fastest2steps")
Run
	previewer = Taef2Decoder.Loaded("taef2.safetensors")
	mutable line = Process.InputLine
	for as long as line is not ""
		line = line.StartsWith("workflow ") then Workflow(line) else Session(previewer, line)
Session(previewer Taef2Decoder, first Text) Text slow
	Images(previewer, first, Encoders(first, Prompt(first)))
Images(previewer Taef2Decoder, first Text, encoders List(Qwen3)) Text slow
	mutable prompt = Prompt(first)
	mutable context = Encode(prompt, encoders, HasRoom(first))
	moss = Load(Loras(first))
	decoders = Decoders(Settings(first)(4))
	mutable line = first
	for as long as line is not "" and Setup(line) is Setup(first)
		if Prompt(line) is not prompt
			prompt = Prompt(line)
			context = Encode(prompt, encoders, HasRoom(line))
		line = Generate(moss, previewer, decoders, context, line) is "" then "" else Process.InputLine
	line
Settings(line Text) Texts
	MossWeb.Settings(Sample) is ("7", "480", "848", "fastest", "taef2", "7")
	line.Split("\t").First.Split(" ")
Prompt(line Text) Text slow
	MossWeb.Prompt(Sample) is "a red fox"
	MossWeb.Prompt(Sample + "\tloras/a.safetensors=0.5") is "a red fox"
	MossWeb.Prompt("9 480 848 fastest taef2 1\t{a|b|c|d}") is PromptBatch("Image").Expand("{a|b|c|d}", 1)
	PromptBatch.Sample.Expand(line.Split("\t")(1), Settings(line)(5) to Number)
Loras(line Text) Text
	MossWeb.Loras(Sample) is ""
	MossWeb.Loras(Sample + "\tloras/a.safetensors=0.5") is "loras/a.safetensors=0.5"
	parts = line.Split("\t")
	parts.Length > 2 then parts(2) else ""
Setup(line Text) Text
	MossWeb.Setup(Sample) is "\ttaef2"
	MossWeb.Setup("7 480 848 best taef2 7\tan owl") is MossWeb.Setup(Sample)
	MossWeb.Setup("7 480 848 fastest flux2-vae\tan owl") is "\tflux2-vae"
	MossWeb.Setup(Sample + "\tloras/a.safetensors=0.5") is "loras/a.safetensors=0.5\ttaef2"
	MossWeb.Setup("workflow a.json") is "workflow a.json"
	line.StartsWith("workflow ") then line else Loras(line) + "\t" + Settings(line)(4)
Workflow(line Text) Text slow
	path = line.Split(" ").Last
	batch = MossBatch(MossOptions.Parsed(("--models", ".", "--workflow", path))).Expanded(("--models", "."))
	options = batch.options
	settings = options.seed + " " + options.width + " " + options.height + " " + Quality(options)
	logger.Log("Workflow: " + settings + "\t" + batch.prompted)
	Process.InputLine
Quality(options MossOptions) Text
	MossWeb.Quality(MossOptions.Parsed(("--quality", "faster"))) is "faster"
	MossWeb.Quality(MossOptions.Parsed(("--steps", "2"))) is "fastest2steps"
	MossWeb.Quality(MossOptions.Parsed(("--steps", "3"))) is "fastest"
	MossWeb.Quality(MossOptions.Parsed(("--steps", "4"))) is "fastest"
	MossWeb.Quality(MossOptions.Parsed(("--steps", "6"))) is "best"
	if options.steps is 0
		return Qualities(options.QualityIndex)
	options.steps <= 2 then "fastest2steps" else (options.steps <= 4 then "fastest" else "best")
HasRoom(line Text) Boolean
	MossWeb.HasRoom(Sample) is false
	MossWeb.HasRoom("7 480 848 fastest taef2 7 0\ta fox") is false
	MossWeb.HasRoom("7 480 848 fastest taef2 7 1\ta fox")
	MossWeb.HasRoom("7 480 848 fastest taef2 7 2\ta fox")
	words = Settings(line)
	words.Length > 6 and words(6) is not "0"
KeepsEncoder(line Text) Boolean
	MossWeb.KeepsEncoder(Sample) is false
	MossWeb.KeepsEncoder("7 480 848 fastest taef2 7 1\ta fox") is false
	MossWeb.KeepsEncoder("7 480 848 fastest taef2 7 2\ta fox")
	words = Settings(line)
	words.Length > 6 and words(6) is "2"
Encoders(line Text, prompt Text) List(Qwen3) slow
	if KeepsEncoder(line) is false
		return List(Qwen3)
	batch = MossBatch(MossOptions.Parsed(Encoder))
	ids = batch.Tokenize(batch.Tokenizer, List(Text) + prompt)
	List(Qwen3) + Qwen3(batch.Encoder(batch.Pick(ids)), tokens = List(Numbers))
Context(prompt Text, encoders List(Qwen3)) Numbers slow
	batch = MossBatch(MossOptions.Parsed(Encoder))
	if encoders.Length is 0
		return batch.Contexts(List(Text) + prompt).First
	prompts = List(Text) + prompt
	started = Process.Elapsed
	ids = batch.Tokenize(batch.Tokenizer, prompts)
	encoder = batch.Reword(encoders.First, batch.Pick(ids))
	logger.Log("Text encoder loaded in " + (Process.Elapsed - started).Round(1) + " s")
	batch.Encode(encoder, ids, prompts).First
Encode(prompt Text, encoders List(Qwen3), hasRoom Boolean) Numbers slow
	if hasRoom
		GpuMemory.Trim
	else
		GpuMemory.Evict
	context = Context(prompt, encoders)
	if hasRoom
		GpuMemory.Trim
	else
		GpuMemory.Evict
	context
Load(loras Text) Moss slow
	started = Process.Elapsed
	moss = Moss.Loaded(FourSteps, loras)
	logger.Log("Moss loaded in " + (Process.Elapsed - started).Round(1) + " s")
	moss
Generate(moss Moss, previewer Taef2Decoder, decoders List(FluxDecoder), context Numbers, line Text) Text slow
	words = Settings(line)
	sized = ("--width", words(1), "--height", words(2), "--output", "MossWeb.jpg")
	options = MossOptions.Parsed(("--quality", words(3)) + sized)
	batch = MossBatch(options)
	sampling = MossSampling(options.Sampling, preview = "MossWebStep.jpg", previewer = previewer)
	latent = batch.RunSampling(moss, sampling, words(0) to Number, context, "Image")
	decoded = Process.Elapsed
	width = options.width / 16
	image = decoders.Length is 0 then previewer.Decode(latent, width) else decoders.First.Decode(latent, width)
	batch.Save(image, decoded, words(0) to Number, "", "MossWeb.jpg")
Decoders(decoder Text) List(FluxDecoder) native
	MossWeb.Decoders("taef2").Length is 0
	MossWeb.Decoders("tinymodels/tinyvae").Length is 1
	decoder is "taef2" then List(FluxDecoder) else List(FluxDecoder) + FluxDecoder.Loaded(decoder + ".safetensors", 32)
