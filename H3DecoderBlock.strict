has firstNorm Numbers
has secondNorm Numbers
has attention Batch
has output Batch
has up Batch
has down Batch
has firstScale Numbers
has secondScale Numbers
has rotated Boolean
constant Model = Safetensors("tinyh3vae.safetensors")
constant Tiny = H3DecoderBlock.Loaded(Model, "decoder.transformer_blocks.0.")
constant Decoding = Rope(64, 24)
Loaded(model Safetensors, prefix Text) Slow(H3DecoderBlock)
	Tiny.rotated is false
	let rows = Safetensors(model.path, 32, model.prefix + prefix)
	let first = rows.Values("norm1.weight")
	let second = rows.Values("norm2.weight")
	let attended = Interleaved(Projection(rows, "attn.to_qkv"))
	let projected = Projection(rows, "attn.to_out")
	let raised = Projection(rows, "ff.w1")
	let lowered = Projection(rows, "ff.w2")
	let quantized = rows.Entry("attn.to_qkv.comfy_quant") is not ""
	let scaled = rows.Values("scale1")
	H3DecoderBlock(first, second, attended, projected, raised, lowered, scaled, rows.Values("scale2"), quantized)
Projection(rows Safetensors, name Text) Slow(Batch)
	Tiny.Projection(Safetensors(Model.path, 32, "decoder.transformer_blocks.0."), "ff.w2").weights.Length is 256
	Batch(H3Block.Projection(rows, name), rows.Values(name + ".bias"))
Interleaved(batch Batch) Slow(Batch)
	Tiny.attention.biases(64) is Model.Values("decoder.transformer_blocks.0.attn.to_qkv.bias")(192)
	let order = Order(batch.weights.Length)
	Batch(Rows(batch, order), Biases(batch, order))
Order(count Number) Slow(Numbers)
	Tiny.Order(384)(64) is 192
	Tiny.Order(384)(128) is 64
	let third = count / 3
	for count
		let within = index % third
		(within / Decoding.head).Floor * 3 * Decoding.head + (index / third).Floor * Decoding.head + within % Decoding.head
Rows(batch Batch, order Numbers) Slow(List(Numbers))
	Tiny.Rows(Batch(((1), (2)), (0, 0)), (1, 0)) is ((2), (1))
	for order
		batch.weights(value)
Biases(batch Batch, order Numbers) Slow(Numbers)
	Tiny.Biases(Batch(((1), (2)), (3, 4)), (1, 0)) is (4, 3)
	for order
		batch.biases(value)
Output(input Numbers, rotation Numbers) Slow(Numbers)
	Tiny.Output(H3Decoder.Embedding, H3Decoder.Turning).Length is 8448
	let attended = Scaled(input, Attended(H3Block.Normalized(input, firstNorm), rotation), firstScale)
	Scaled(attended, Fed(H3Block.Normalized(attended, secondNorm)), secondScale)
Attended(normed Numbers, rotation Numbers) Slow(Numbers)
	Tiny.Attended(H3Decoder.Embedding, H3Decoder.Turning).Length is 8448
	let combined = Projected(attention, normed)
	let width = combined.Length / (rotation.Length / 2 / Decoding.head) / 3
	let scales = Qwen3Block.Scales(combined, Decoding.head, H3Block.Epsilon)
	let ones = Decoding.Still(1)
	let queries = Decoding.Rotated(combined, 0, width, ones, rotation, scales)
	let keys = Decoding.Rotated(combined, width, width, ones, rotation, scales)
	let values = Batch.Columns(combined, 3 * width, 2 * width, width)
	let heads = width / Decoding.head
	Projected(output, Attention(queries, keys, values, heads, heads, Decoding.head, 1, false).Merged)
Fed(normed Numbers) Slow(Numbers)
	Tiny.Fed(H3Decoder.Embedding).Length is 8448
	let expanded = Projected(up, normed)
	Projected(down, H3Block.Activated(expanded, down.weights.First.Length))
Scaled(input Numbers, update Numbers, scale Numbers) Slow(Numbers)
	Tiny.Scaled((1, 2), (3, 4), (2, 0.5)) is (7, 4)
	for input.Length
		input(index) + update(index) * scale(index % scale.Length)
Projected(batch Batch, input Numbers) Slow(Numbers)
	Tiny.Projected(Batch(((1, 2), (3, 4)), (1, 0)), (1, 1)) is (4, 7)
	rotated then batch.Sums(Convrot(input).Rotated) else batch.Sums(input)