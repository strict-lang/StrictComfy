has logger
Run(arguments Texts) Number
	let folder = Path(Process.Current.executable).PathOnly.text
	Python(arguments).Started(Quoted(folder + "/moss.py") + " " + Text.Combine(QuotedAll(arguments), " "))
Python(arguments Texts) Process
	for arguments
		if value is "--python"
			if index + 1 >= arguments.Length
				return Error("--python requires an interpreter path")
			return Process(arguments(index + 1))
	for ("D:/ComfyUI_windows_portable/python_embeded/python.exe", "C:/ComfyUI_windows_portable/python_embeded/python.exe")
		if File(value).Exists
			return Process(value)
	Process.Find(Process.OperatingSystem is "Windows" then "python" else "python3")
QuotedAll(arguments Texts) Texts
	for arguments
		Quoted(value)
Quoted(argument Text) Text
	MossCommand(Logger).Quoted("a b") is "\"a b\""
	MossCommand(Logger).Quoted("a\"b") is "\"a\\\"b\""
	MossCommand(Logger).Quoted("C:\\out\\") is "\"C:\\out\\\\\""
	mutable parts = List(Mutable(Text))
	for argument.Split("\"")
		parts.Add(DoubledTail(value))
	"\"" + Text.Combine(parts, "\\\"") + "\""
DoubledTail(text Text) Text
	MossCommand(Logger).DoubledTail("a\\\\") is "a\\\\\\\\"
	mutable result = text
	for text.Length
		if text(text.Length - index - 1) is not "\\"
			return result
		result = result + "\\"
	result
