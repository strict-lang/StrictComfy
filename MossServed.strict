has batch MossBatch
Completed(kept MossResident) Slow(MossResident)
	let options = batch.options
	let problem = options.Problem
	if problem is not ""
		batch.logger.Log(problem)
		return MossResident(kept, code = 2)
	options.Located
	let started = Process.Elapsed
	let seeds = PromptBatch(batch.logger, "Image").Seeds(options.seed, options.count)
	let template = batch.prompted is "" then batch.Templated else batch.prompted
	let prompts = PromptBatch(batch.logger, "Image").Prompts(List(Text) + template, seeds)
	Prompted(kept, seeds, prompts, started)
Prompted(kept MossResident, seeds Numbers, prompts Texts, started Number) Slow(MossResident)
	let unique = prompts.Unique
	let encoded = kept.Encoded(batch, unique)
	let contexts = encoded.Contexts(unique)
	if batch.options.output.EndsWith(".safetensors")
		Safetensors(batch.options.output).Written("context", contexts.First)
		return MossResident(encoded, code = 0)
	batch.options.files.Freed
	let sampling = encoded.Sampling(batch)
	batch.Images(sampling.mosses.First, seeds, prompts, unique, contexts)
	batch.options.files.Freed
	batch.logger.Log("Total " + (Process.Elapsed - started).Round(2) + " s for " + batch.options.count + " images")
	MossResident(sampling, code = 0)
