has batch MossBatch
Completed(kept MossResident) Slow(MossResident)
	let options = batch.options
	let problem = options.Problem is "" then options.Located else options.Problem
	if problem is not ""
		batch.logger.Log(problem)
		return MossResident(kept, code = 2)
	if options.warm
		return Warmed(kept)
	let started = Process.Elapsed
	let seeds = PromptBatch(batch.logger, "Image").Seeds(options.seed, options.count)
	let template = batch.prompted is "" then batch.Templated else batch.prompted
	Prompted(kept, seeds, PromptBatch(batch.logger, "Image").Prompts(List(Text) + template, seeds), started)
Prompted(kept MossResident, seeds Numbers, prompts Texts, started Number) Slow(MossResident)
	let encoded = kept.Encoded(batch, prompts.Unique)
	let c = encoded.Contexts(prompts.Unique)
	if batch.options.output.EndsWith(".safetensors")
		Safetensors(batch.options.output).Written("context", c.First)
		return MossResident(encoded, code = 0)
	batch.options.files.Eased
	let decoding = encoded.Sampling(batch).Decoders(batch.options.Decoder).Previewing(batch)
	let made = batch.Images(decoding, seeds, prompts, prompts.Unique, c)
	batch.options.files.Freed
	batch.logger.Log("Total " + (Process.Elapsed - started).Round(2) + " s for " + made + " images")
	MossResident(decoding, code = 0)
Warmed(kept MossResident) Slow(MossResident)
	let started = Process.Elapsed
	let encoding = kept.Switched(batch.options.files.Encoder).Tokenizing(batch).Encoding(batch, List(Numbers))
	batch.options.files.Eased
	let decoding = encoding.Sampling(batch).Decoders(batch.options.Decoder)
	batch.logger.Log("Moss is ready after " + (Process.Elapsed - started).Round(1) + " s, the next image starts at once")
	MossResident(decoding, code = 0)
