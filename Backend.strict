has logger
has resident Resident
has name Text
has coordinator = ""
constant StartSeconds = 30
constant PollSeconds = 0.2
constant CheckSeconds = 5
constant Gone = -2
constant Unserved = -1
constant Crashed = 1
constant Clean = 0
constant IdleSeconds = 900
constant LowMemory = 4294967296
constant Gigabyte = 1073741824
constant LastShare = 20
constant FreePercent = 8
constant LowDevice = 536870912
constant Stopped = -3
constant Local = "--local"
constant Serving = "serve"
constant KeepsModels = " backend, it keeps the models loaded for the next runs (--local runs without it)"
constant Nowhere = "artifacts/h3test/obj/MissingCoordinator"
constant Sample = Backend(Logger, Resident("artifacts/h3test"), "H3Video", Nowhere)
IsServing(arguments Texts) Boolean
	Backend.IsServing(List(Text))
	Backend.IsServing(("--prompt", "a.txt"))
	Backend.IsServing(List(Text) + "serve")
	Backend.IsServing(List(Text) + "stop")
	Backend.IsServing(List(Text) + "-") is false
	Backend.IsServing(("encode", "a")) is false
	let isCommand = (arguments is (Serving)) or (arguments is (Resident.Stopping))
	isCommand or (arguments.Length is 0) or (arguments(0).StartsWith("-") and (arguments(0) is not "-"))
Dispatched(arguments Texts) Number
	Sample.Dispatched(List(Text) + Local) is -1
	Sample.Dispatched(List(Text) + Resident.Stopping) is 0
	if arguments is (Resident.Stopping)
		return Forwarding(logger, resident.root, coordinator).Forwarded(List(Text) + Resident.Stopping)
	if Local is in arguments
		return -1
	mutable code = Attempted(arguments)
	mutable tries = 0
	for as long as (code is -1) and ((tries is 0) or (Port is not 0)) and (tries < StartSeconds)
		tries = tries + 1
		code = Attempted(arguments)
	(code is -1) and (Port is not 0) then Cleared else code
Attempted(arguments Texts) Number
	let isRunning = File(resident.root + Resident.Stamp).Exists
	if (isRunning is false) and IsCrowded(0, GpuMemory.HostAvailable, GpuMemory.HostTotal)
		return Unserved
	let forwarding = Forwarding(logger, resident.root)
	if (isRunning is false) and Rooted
		logger.Log("Starting the " + name + KeepsModels)
		forwarding.Started("")
	let port = Waited(StartSeconds)
	port > 0 then forwarding.Answered(resident, port, arguments) else (port is Gone then Crashed else Unserved)
Waited(seconds Number) Number
	Sample.Waited(0) is 0
	let started = Process.Elapsed
	mutable isBusy = false
	mutable polled = (0, started - CheckSeconds)
	for as long as (polled(0) is 0) and (isBusy or (Process.Elapsed - started < seconds))
		polled = Polled(polled(1))
		if (polled(0) is -1) and (isBusy is false)
			logger.Log("Waiting for the " + name + " backend to finish the run it works on")
		isBusy = polled(0) < 0
		polled = (polled(0) > 0) or (polled(0) is Gone) then polled else Paused(polled(1))
	polled(0)
Polled(checked Number) Numbers
	Sample.Polled(0) is (0, 0)
	let port = Port
	let isDue = (port < 0) and (Process.Elapsed - checked >= CheckSeconds)
	let nextCheck = isDue then Process.Elapsed else checked
	(isDue and IsGone then Cleared else port, nextCheck)
IsGone Boolean
	Sample.IsGone is false
	let stamp = File(resident.root + Resident.Stamp)
	stamp.Exists and Forwarding(logger, resident.root).IsDead(stamp.ReadLines.First to Number)
Cleared Number
	let objects = resident.root + "/obj"
	let forwarding = Forwarding(logger, resident.root)
	forwarding.Kept(objects, Forwarding.Output)
	forwarding.Kept(objects, Forwarding.Errors)
	logger.Log("The " + name + " backend stopped answering or ended without finishing its run, its output:")
	if (Printed(objects + "/server.previous.log") + Printed(objects + "/server.previous.errors.log")) is 0
		logger.Log("(nothing, see " + objects + "/server.previous*.log)")
	forwarding.Killed + Gone
Printed(path Text) Number
	Sample.Printed("missing.log") is 0
	if File(path).Exists is false
		return 0
	let lines = File(path).ReadLines - ""
	for lines
		logger.Log(value)
	lines.Length
Port Number
	Sample.Port is 0
	let stamp = File(resident.root + Resident.Stamp)
	if stamp.Exists is false
		return 0
	File(resident.root + Resident.Free).Exists then stamp.ReadLines.First to Number else -1
Paused(checked Number) Numbers
	Process.Wait(PollSeconds)
	(0, checked)
Opened Number
	Rooted then resident.Opened else 0
Rooted Boolean
	Sample.Rooted
	let parent = Path(resident.root).PathOnly.text
	let objects = resident.root + "/obj"
	if Directory.Exists(parent) is false
		Directory.Create(parent)
	if Directory.Exists(resident.root) is false
		Directory.Create(resident.root)
	if Directory.Exists(objects) is false
		Directory.Create(objects)
	Directory.Exists(parent) and Directory.Exists(resident.root) and Directory.Exists(objects)
IsWanted(idle Number, built Number) Boolean
	Sample.IsWanted(0, File(Process.Current.executable).Modified)
	Sample.IsWanted(IdleSeconds + 1, File(Process.Current.executable).Modified) is false
	Sample.IsWanted(0, 0) is false
	let hasRoom = IsOut(GpuMemory.HostAvailable, GpuMemory.HostTotal) is false
	(File(Process.Current.executable).Modified is built) and (idle < IdleSeconds) and hasRoom
IsCrowded(needed Number, available Number, total Number) Boolean
	Sample.IsCrowded(0, 10 * Gigabyte, 128 * Gigabyte)
	Sample.IsCrowded(0, 11 * Gigabyte, 128 * Gigabyte) is false
	Sample.IsCrowded(0, 2 * Gigabyte, 32 * Gigabyte)
	Sample.IsCrowded(0, 3 * Gigabyte, 32 * Gigabyte) is false
	Sample.IsCrowded(0, 0, 128 * Gigabyte) is false
	Sample.IsCrowded(16 * Gigabyte, 18 * Gigabyte, 32 * Gigabyte)
	Sample.IsCrowded(16 * Gigabyte, 19 * Gigabyte, 32 * Gigabyte) is false
	Sample.IsCrowded(40 * Gigabyte, 0, 32 * Gigabyte) is false
	(available > 0) and ((available - needed) * 100 < total * FreePercent)
IsOut(available Number, total Number) Boolean
	Sample.IsOut(3 * Gigabyte, 128 * Gigabyte)
	Sample.IsOut(5 * Gigabyte, 128 * Gigabyte) is false
	Sample.IsOut(Gigabyte, 32 * Gigabyte)
	Sample.IsOut(2 * Gigabyte, 32 * Gigabyte) is false
	Sample.IsOut(0, 128 * Gigabyte) is false
	(available > 0) and (available <= (total / LastShare < LowMemory then total / LastShare else LowMemory))
Restored(isMoved Boolean, home Text)
	Socket.Output(0)
	if isMoved
		Directory.Change(home)
Unpressed Slow(Boolean)
	Sample.Unpressed
	let available = GpuMemory.Available
	if (available > 0) and (available < LowDevice)
		GpuMemory.Yielded
	let reply = Coordinator(logger, coordinator).Sent("holding\t0\t" + GpuMemory.Held)
	if reply is "free"
		GpuMemory.Yielded
	reply is not "exit"
Freed(request Text, isGone = true) Slow(Boolean)
	Sample.Freed("broken")
	Sample.Freed("broken", false) is false
	if isGone
		GpuMemory.Yielded
	resident.Released(request)
	(Coordinator(logger, coordinator).Sent("done") is "exit") or isGone
