has firstNorm Numbers
has secondNorm Numbers
has queryNorm Numbers
has keyNorm Numbers
has attention Batch
has projection Batch
has gate Batch
has up Batch
has down Batch
constant Model = Safetensors("tinymodels/tinymoss.safetensors")
constant Tiny = MossText.Loaded(Model, "text_embedder.blocks.0.")
constant Input = Safetensors.Part(Model.Values("reference.text_embedder"), 0, 768, 1)
Loaded(model Safetensors, prefix Text) MossText slow
	Tiny.attention.weights.Length is 768
	Tiny.down.biases.Length is 256
	block = Safetensors(model.path, model.bits, model.prefix + prefix)
	first = block.Values("norm1.weight")
	second = block.Values("norm2.weight")
	queried = block.Values("q_norm.weight")
	keyed = block.Values("k_norm.weight")
	attended = Dense(block, "qkv")
	gated = Dense(block, "ffn_gate")
	raised = Dense(block, "ffn_up")
	MossText(first, second, queried, keyed, attended, Dense(block, "proj"), gated, raised, Dense(block, "ffn_down"))
Dense(block Safetensors, name Text) Batch slow
	Tiny.Dense(Safetensors(Model.path, 32, "text_embedder."), "proj").weights.First.Length is 64
	Tiny.Dense(Model, "final_linear_video").biases is (0)
	biased = block.Entry(name + ".bias") is not ""
	Batch(block.Rows(name + ".weight"), biased then block.Values(name + ".bias") else List(Number) + 0)
Output(input Numbers, rotation Numbers) Numbers native
	Tiny.Output(Input, MossBlock.Rotations(0, 0, 3, 128)).Length is 768
	normed = Qwen3Block.Normalize(input, 0, input.Length, firstNorm)
	attended = Add(input, projection.Sums(MossBlock.Merge(attention.Sums(normed), rotation, queryNorm, keyNorm)))
	fed = Qwen3Block.Normalize(attended, 0, attended.Length, secondNorm)
	Add(attended, down.Sums(Activate(up.Sums(fed), gate.Sums(fed))))
Activate(hidden Numbers, gates Numbers) Numbers slow
	Tiny.Activate((2, 1), (3, 0)) is (MossBlock.Situ(2, 3), 0)
	for hidden.Length
		MossBlock.Situ(hidden(index), gates(index))
Add(first Numbers, second Numbers) Numbers slow
	Tiny.Add((1, 2), (3, 4)) is (4, 6)
	for first.Length
		first(index) + second(index)
