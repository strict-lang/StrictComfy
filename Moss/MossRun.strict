has batch MossBatch
has kept MossResident
has sampling MossSampling
has seeds Numbers
has prompts Texts
has contexts List(Numbers)
has outputs Texts
Images Number slow
	first = Latents(0, 1)
	if GpuMemory.Available < MossFiles.Spare
		return Save(first + Latents(1, seeds.Length - 1), 0)
	mutable made = Save(first, 0)
	for Range(1, seeds.Length)
		made = made + Save(Latents(value, 1), value)
	made
Save(latents List(Numbers), start Number) Number slow
	count = latents.Length
	texts = prompts.Slice(start, count)
	batch.options.files.Ease
	batch.Decode(kept, latents, seeds.Slice(start, count), texts, outputs.Slice(start, count)).Length
Latents(start Number, count Number) List(Numbers) slow
	unique = prompts.Unique
	for Range(start, start + count)
		label = "Image " + (value + 1) + "/" + seeds.Length + " " + Path(outputs(value)).FileName.text
		shown = MossSampling(sampling, finale = value < seeds.Length - 1)
		batch.RunSampling(kept.mosses.First, shown, seeds(value), contexts(unique.Index(prompts(value))), label)