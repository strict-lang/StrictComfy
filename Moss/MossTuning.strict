has rows Safetensors
has loras Text
constant Lora = "tinymodels/tinylora.safetensors"
constant ComfyPrefix = "model.diffusion_model."
constant Fours = MossTuning(Safetensors("tinymodels/tinymossint4.safetensors", 32, "layers.0.proj."), Lora)
constant Floats = MossTuning(Safetensors(MossBlock.Model.path, 32, "layers.0.proj."), Lora)
constant Fused = MossTuning(Safetensors("tinymodels/tinymossqkv.safetensors", 32, "layers.0.proj."), "")
constant Unmerged = MossBlock.Loaded(Safetensors("tinymodels/tinymossint4.safetensors"), "layers.0.", Lora)
constant Merging = MossBlock.Loaded(MossBlock.Model, "layers.0.", Lora)
constant Output = Unmerged.Output(MossBlock.Input, MossBlock.Modulation, MossBlock.Rotation)
constant Reference = Merging.Output(MossBlock.Input, MossBlock.Modulation, MossBlock.Rotation)
Deltas List(MossLora) native
	Fours.Deltas.Length is 4
	MossTuning(Fours.rows, "").Deltas.Length is 0
	Floats.Deltas.Length is 0
	Tensors.RelativeError(Output, Reference) < 0.1
	if loras is "" or rows.Entry("o.weight_scale") is "" or rows.Entry("o.comfy_quant") is not ""
		return List(MossLora)
	qkv = Stack("q.").Placed(0).Stacked(Stack("k.").Placed(1)).Stacked(Stack("v.").Placed(2))
	(qkv, Stack("o."), Stack("ffn_up_gate."), Stack("ffn_down."))
Stack(name Text) MossLora slow
	Fours.Stack("q.").rank is 8
	LoraFiles(loras).Stack(rows.prefix.Replace(ComfyPrefix, "") + name)
Merge(name Text, deltas List(MossLora)) List(Numbers) slow
	Fours.Merge("o", Fours.Deltas) is MossTuning(Fours.rows, "").Merge("o", List(MossLora))
	LoraFiles(deltas.Length is 0 then loras else "").Merge(rows, name, rows.prefix.Replace(ComfyPrefix, ""))
Qkv(deltas List(MossLora)) List(Numbers) slow
	MossBlock.Tiny.attention.Length is 768
	MossTuning(Floats.rows, "").Qkv(List(MossLora)) is MossBlock.Tiny.attention
	Fused.Qkv(List(MossLora)) is MossBlock.Tiny.attention
	if rows.Entry("qkv.weight") is not ""
		return Merge("qkv", deltas)
	Merge("q", deltas) + Merge("k", deltas) + Merge("v", deltas)
