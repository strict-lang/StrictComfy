has backend Backend
constant MinimumRam = 17179869184
constant MinimumVram = 8589934592
constant Sample = MossServer(Backend(Resident("artifacts/mosstest"), "MossImage", Backend.Nowhere))
Root Text
	MossServer.Root.EndsWith("/artifacts/moss")
	Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text + "/artifacts/moss"
Backended Backend
	MossServer.Backended.name is "MossImage"
	Backend(Resident(Root), "MossImage")
Run(given Texts) Number slow
	if given is (Backend.Serving)
		return Served
	arguments = given - MachineUse.Force
	plain = Remote.Without(arguments)
	rest = plain - Backend.Local
	if MachineUse.IsChecked(arguments, backend.resident.root)
		if IsGranted(arguments, MachineUse.IsForced(given)) is false
			return 1
	forwarded = backend.Dispatch(plain)
	forwarded >= 0 then forwarded else Local(rest).code
Local(arguments Texts) MossResident slow
	MossServed(MossBatch(MossOptions.Parsed(arguments)).Expanded(arguments)).Complete(MossResident)
Served Number slow
	server = backend.Opened
	server is Error then Backend.Failed else Listen(server)
Listen(server Number) Number slow
	built = File(Process.Current.executable).Modified
	mutable kept = MossResident(true)
	mutable last = Process.Elapsed
	for as long as kept.code is not Backend.Stopped and backend.IsWanted(Process.Elapsed - last, built)
		socket = backend.resident.Accept(server, built, Resident.WakeSeconds)
		kept = socket is not Error then Reply(socket, kept) else kept
		last = socket is not Error then Process.Elapsed else last
		kept = backend.IsUnpressed(socket is not Error) then kept else MossResident(kept, code = Backend.Stopped)
	backend.resident.Close(server)
	Backend.Clean
Reply(socket Number, kept MossResident) MossResident slow
	resident = backend.resident
	request = resident.ReadRequest(socket)
	isStopping = resident.Arguments(request) is (Resident.Stopping)
	isRunning = resident.IsCurrent(request) and isStopping is false
	skipped = MossResident(kept, code = isStopping then Backend.Stopped else -1)
	served = isRunning then Run(socket, request, kept) else skipped
	isFailed = served is Error
	if isFailed
		GpuMemory.Evict
	closed = HasEnded(socket, isFailed then 1 else (served.code is Backend.Stopped then 0 else served.code), request)
	isFailed or closed then MossResident(true) else served
Run(socket Number, request Text, kept MossResident) MossResident slow
	home = Directory.Current
	folder = backend.resident.Folder(request)
	Directory.Change(folder)
	isMoved = folder is not home
	Socket.Output(socket)
	arguments = backend.resident.Arguments(request)
	served = MossServed(MossBatch(MossOptions.Parsed(arguments)).Expanded(arguments)).Complete(kept)
	if served is Error
		logger.Log(served to Text + "\nThe run failed, the next one loads the models again")
	unpressed = backend.IsUnpressed(true)
	backend.Restore(isMoved, home)
	unpressed then served else MossResident(kept, code = Backend.Stopped)
Ask(arguments Texts, forced Boolean) Text slow
	Sample.Ask(List(Text), false).StartsWith("need\tMossImage\t")
	use = Use(arguments, forced)
	mode = forced then "force" else "wait"
	"need\tMossImage\tMossImage\t" + MinimumRam + "\t" + use.ram + "\t" + MinimumVram + "\t" + use.vram + "\t0\t" + mode
IsGranted(arguments Texts, forced Boolean) Boolean slow
	Sample.IsGranted(List(Text), false) is not Error
	named = Remote.RunRemote(arguments)
	named is Error or named >= 0 then named is 0 else IsContinued(arguments, forced)
IsContinued(arguments Texts, forced Boolean) Boolean slow
	Sample.IsContinued(List(Text), false) is not Error
	line = Ask(arguments, forced)
	if line is ""
		return true
	reply = Coordinator(backend.coordinator).Send(line)
	sent = Remote.Send(arguments, "", reply, line)
	if sent is Error or sent >= 0
		return sent is 0
	settled = reply.StartsWith("wait") then Coordinator(backend.coordinator).Resolve(line) else reply
	if settled.StartsWith("refused")
		Use(arguments, forced).Explain(settled)
	settled.StartsWith("refused") is false and (settled is not "" or Use(arguments, forced).HasRoom)
HasEnded(socket Number, code Number, request Text) Boolean slow
	Sample.HasEnded(0, 1, "broken") is false
	if backend.resident.Finish(socket, code) is Error
		logger.Log("The MossImage client left before the result was sent, the models stay loaded")
		return backend.IsFreed(request) is Error
	backend.IsFreed(request, false)
Use(arguments Texts, forced Boolean) MachineUse slow
	Sample.Use(List(Text), true).isForced
	Sample.Use(("--local", "--remote", "AiServer"), false).isForced is false
	files = MossOptions.Parsed(Remote.Without(arguments) - Backend.Local).files
	bytes = (File(files.Checkpoint).Length, File(files.Encoder).Length)
	MachineUse.Models("MossImage", bytes(0), bytes(1), Backend.EncoderGrowth, forced)
