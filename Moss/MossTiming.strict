constant Data = Safetensors("tinymodels/tinymoss.safetensors", 32, "reference.")
Measure(step Number, before Number, latent Numbers, data Safetensors, suffix Text = "")
	MossTiming.Measure(0, Process.Elapsed - 1, (1, 2), Data) is not Error
	MossTiming.Measure(0, 0, List(Number), Data) is Error("Empty Moss latent")
	if latent.Length is 0
		return Error("Empty Moss latent")
	next = "x." + (step + 1)
	reference = data.Entry(next) is "" then "latent" else next
	compared = data.Entry(reference) is "" then "" else ", error " + Tensors.RelativeError(latent, data.Values(reference))
	logger.Log("step " + step + " " + ((Process.Elapsed - before) * 1000).Round + " ms" + compared + suffix)