has batch MossBatch
Complete(kept MossResident) MossResident slow
	options = batch.options
	problem = options.Problem is "" then options.Located else options.Problem
	if problem is not ""
		logger.Log(problem)
		return MossResident(kept, code = 2)
	if options.files.Warm
		return Warm(kept)
	started = Process.Elapsed
	seeds = PromptBatch("Image").Seeds(options.seed, options.count)
	template = batch.prompted is "" then batch.Templated else batch.prompted
	logger.Log(MossEstimate(options).Estimate(MossEstimate.Local))
	Prompt(kept, seeds, PromptBatch("Image").Prompts(List(Text) + template, seeds), started)
Prompt(kept MossResident, seeds Numbers, prompts Texts, started Number) MossResident slow
	unique = prompts.Unique
	missing = kept.Missing(unique)
	wantsImage = batch.options.output.EndsWith(".safetensors") is false
	if wantsImage and kept.IsSampling(batch) is false and missing.Length > 0
		Prefetch(List(Text) + batch.options.files.Checkpoint + LoraPaths, "Moss and its LoRAs")
	encoded = kept.Encoded(batch, unique)
	c = encoded.Contexts(unique)
	if wantsImage is false
		Safetensors(batch.options.output).Write("context", c.First)
		return MossResident(encoded, code = 0)
	PrefetchAndFree(encoded, missing.Length > 0)
	decoding = encoded.Sampling(batch).Decoders(batch.options.Decoder).Previewing(batch)
	made = batch.Images(decoding, seeds, prompts, c)
	batch.options.files.Ease
	logger.Log("Total " + (Process.Elapsed - started).Round(2) + " s for " + made + " images")
	MossResident(decoding, code = 0)
LoraPaths Texts slow
	MossServed(MossBatch.Sample).LoraPaths.Length is 0
	for batch.options.Loras is "" then List(Text) else batch.options.Loras.Split(";")
		value.Split("=").First
Prefetch(paths Texts, what Text)
	MossServed(MossBatch.Sample).Prefetch(List(Text) + "tinymodels/tinyqkvlora.safetensors", "LoRA") is not Error
	reading = ModelFiles("").Prefetching(paths, what)
	if reading is not ""
		logger.Log(reading)
PrefetchAndFree(encoded MossResident, encodedAny Boolean) slow
	MossServed(MossBatch(MossOptions(MossFiles.Local, steps = 20))).PrefetchAndFree(MossResident, false) is not Error
	if encoded.IsSampling(batch) is false or encodedAny
		batch.options.files.Freed
	else
		batch.options.files.Ease
	decoder = batch.options.Decoder
	if decoder is not Error and encoded.decoderFile is not decoder
		Prefetch(List(Text) + decoder, "the decoder")
Warm(kept MossResident) MossResident slow
	started = Process.Elapsed
	encoding = kept.Switched(batch.options.files.Encoder).Tokenizing(batch).Encoding(batch, List(Numbers))
	batch.options.files.Ease
	decoding = encoding.Sampling(batch).Decoders(batch.options.Decoder)
	logger.Log("Moss is ready after " + (Process.Elapsed - started).Round(1) + " s, the next image starts at once")
	MossResident(decoding, code = 0)
