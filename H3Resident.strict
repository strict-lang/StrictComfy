has logger
has encoders List(Qwen3) = List(Qwen3)
has encoderFile = ""
has tokenizers List(Gpt2Tokens) = List(Gpt2Tokens)
has samplers List(H3) = List(H3)
has refiners List(H3Refiner) = List(H3Refiner)
has model = ""
has decodings List(H3Decoding) = List(H3Decoding)
has vaes = ""
has code = 0
has plans List(H3Plan) = List(H3Plan)
has isCrowded = false
constant EncoderGrowth = 1.6
constant None = H3Resident(Logger)
constant Files = H3Files.Parsed(("--text_encoder", "../Strict/NeuralNetworks/tinyqwen3vl.safetensors"))
constant Encoded = H3Resident.None.Encoding(H3Resident.Files)
constant Sized = H3Options.Parsed(("--model", "tinyh3.safetensors", "--vae", "tinyh3vae.safetensors", "--audio_vae", "tinyh3audio.safetensors"))
constant Whole = H3Batch(Logger, H3Options(Sized, files = H3Files(Sized.files, textEncoder = Files.textEncoder)))
constant Sampled = H3Resident.None.Sampling("tinyh3.safetensors", "")
constant Decoders = ("tinyh3vae.safetensors", "tinyh3audio.safetensors")
Encoding(files H3Files) Slow(H3Resident)
	Encoded.encoders.Length is 1
	Encoded.Encoding(Files).encoders.First.blocks.Length is 2
	Encoded.Encoding(Files).encoderFile is Encoded.encoderFile
	if (files.Encoder is encoderFile) and (encoders.Length is 1)
		return value
	if isCrowded
		GpuMemory.Released
	H3Resident(value, encoders = List(Qwen3) + Encoder(files), encoderFile = files.Encoder)
Encoder(files H3Files) Slow(Qwen3)
	None.Encoder(Files).blocks.Length is 2
	let before = Process.Elapsed
	logger.Log("Loading text encoder " + ModelFiles("").Described(files.Encoder) + " from disk into memory")
	let encoder = H3Encoder(logger, files).Loaded
	let staying = isCrowded then "" else ", it stays loaded for the next runs"
	logger.Log("Text encoder loaded in " + (Process.Elapsed - before).Round(1) + " s" + staying)
	encoder
Tokenizing(files H3Files) Slow(H3Resident)
	H3Resident(Logger, tokenizers = List(Gpt2Tokens) + H3Encoder.Spelled).Tokenizing(Files).tokenizers.Length is 1
	if tokenizers.Length is 1
		return value
	H3Resident(value, tokenizers = List(Gpt2Tokens) + H3Encoder(logger, files).Tokenizer)
Sampling(checkpoint Text, loras Text) Slow(H3Resident)
	Sampled.samplers.First.blocks.Length is 2
	Sampled.refiners.Length is 1
	Sampled.Sampling("tinyh3.safetensors", "").model is Sampled.model
	if (Key(checkpoint, loras) is model) and (samplers.Length is 1)
		return value
	GpuMemory.Released
	let h3 = H3Video(logger).Loaded(checkpoint, loras)
	let refiner = H3Refiner.Loaded(checkpoint, loras)
	H3Resident(value, samplers = List(H3) + h3, refiners = List(H3Refiner) + refiner, model = Key(checkpoint, loras))
Trimmed(checkpoint Text, loras Text, isTight Boolean) H3Resident
	Sampled.Trimmed("tinyh3.safetensors", "", false).samplers.Length is 1
	Sampled.Trimmed("tinyh3.safetensors", "a=1", false).samplers.Length is 0
	Sampled.Trimmed("tinyh3.safetensors", "a=1", false).model is ""
	Encoded.Trimmed("tinyh3.safetensors", "", true).encoders.Length is 0
	Encoded.Trimmed("tinyh3.safetensors", "", false).encoders.Length is 1
	let isOther = (samplers.Length is 1) and (IsSampling(checkpoint, loras) is false)
	if isOther
		return Unsampled("Freeing the loaded H3 first, this run needs another model or LoRAs")
	let isDropped = isTight and (encoders.Length is 1)
	if isDropped
		logger.Log("Freeing the text encoder, little memory is left (it loads again for a new prompt)")
	isDropped then H3Resident(value, encoders = List(Qwen3), encoderFile = "") else value
Missing(files H3Files) Slow(Number)
	None.Missing(Whole.options.files) > Encoded.Missing(Whole.options.files)
	let encoder = encoders.Length is 1 then 0 else EncoderRoom(files)
	let sampler = samplers.Length is 1 then 0 else File(files.Checkpoint).Length
	let decoder = decodings.Length is 1 then 0 else File(files.Decoder).Length + File(files.Sound).Length
	encoder + sampler + decoder
EncoderRoom(files H3Files) Slow(Number)
	None.EncoderRoom(Whole.options.files) is File(Whole.options.files.Encoder).Length * EncoderGrowth
	File(files.Encoder).Length * EncoderGrowth
Crowded(batch H3Batch) Slow(H3Resident)
	Sampled.Crowded(Whole).isCrowded is false
	let options = batch.options
	let needed = H3Inputs(options).Problem is "" then Missing(options.files) else 0
	if Backend.IsCrowded(needed, GpuMemory.HostAvailable, GpuMemory.HostTotal) is false
		return H3Resident(value, plans = List(H3Plan), isCrowded = false)
	let plan = batch.Planned
	let isNew = H3Artifacts(options).Missing(plan.paths).Length > 0
	let kept = isNew then Unsampled("Freeing the loaded H3, the text encoder does not fit next to it") else value
	H3Resident(kept, encoders = List(Qwen3), encoderFile = "", plans = List(H3Plan) + plan, isCrowded = true)
Unsampled(reason Text) H3Resident
	Sampled.Unsampled("a").samplers.Length is 0
	Sampled.Unsampled("a").model is ""
	if samplers.Length is 1
		logger.Log(reason)
	H3Resident(value, samplers = List(H3), refiners = List(H3Refiner), model = "")
Key(checkpoint Text, loras Text) Text
	None.Key("a.safetensors", "b=1") is "a.safetensors|b=1"
	checkpoint + "|" + loras
IsSampling(checkpoint Text, loras Text) Boolean
	Sampled.IsSampling("tinyh3.safetensors", "")
	Sampled.IsSampling("tinyh3.safetensors", "a=1") is false
	None.IsSampling("tinyh3.safetensors", "") is false
	(Key(checkpoint, loras) is model) and (samplers.Length is 1)
Decoding(files Texts) Slow(H3Resident)
	Sampled.Decoding(Decoders).decodings.Length is 1
	Sampled.Decoding(Decoders).Decoding(Decoders).vaes is Text.Combine(Decoders, "|")
	if (Text.Combine(files, "|") is vaes) and (decodings.Length is 1)
		return value
	let decoding = H3Video(logger).Decoding(List(H3Decoding), files)
	H3Resident(value, decodings = decoding, vaes = Text.Combine(files, "|"))
