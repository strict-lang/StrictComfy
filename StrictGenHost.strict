constant Measured = "StrictGenCpu.txt"
Rows Texts slow
	StrictGenHost.Rows.Length >= 0
	File(Measured).Exists then File(Measured).ReadLines else List(Text)
Name Text slow
	StrictGenHost.Name is not Error
	rows = Rows
	variable = Process.OperatingSystem is "Windows" then "COMPUTERNAME" else "HOSTNAME"
	rows.Length > 2 then rows(2).Trim else Process.Variable(variable)
Number(row Number) Number slow
	StrictGenHost.Number(1) >= 0
	StrictGenHost.Number(99) is 0
	rows = Rows
	found = rows.Length > row then rows(row).Trim to Number else 0
	found is Error then 0 else found
Utf8Console Text slow
	StrictGenHost.Utf8Console is ""
	switched = Process.OperatingSystem is "Windows" then Process.RunTool("cmd", "/c chcp 65001").Succeeded else true
	switched then "" else ", the console could not switch to UTF-8 and shows only ASCII letters correctly"