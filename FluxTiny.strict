has entry Convolution
has blocks List(FluxTinyBlock)
has upsamples List(Convolution)
has exit Convolution
constant Model = Safetensors("tinytaef2.safetensors")
constant Layers = Safetensors("tinytaef2.safetensors", 32, "decoder.layers.")
constant Tiny = FluxTiny.Loaded("tinytaef2.safetensors")
constant Decoding = Tiny.Decoded(Model.Values("reference.latent"), 3)
constant BlockLayers = ("2.", "3.", "4.", "7.", "8.", "9.", "12.", "13.", "14.", "17.")
constant UpsampleLayers = ("6", "11", "16")
constant None = FluxTiny(Convolution(List(Number), List(Number)), List(FluxTinyBlock), List(Convolution), Convolution(List(Number), List(Number)))
Loaded(path Text) Slow(FluxTiny)
	Tiny.blocks.Length is 10
	Tiny.upsamples.Length is 3
	let model = Safetensors(path, 32, "decoder.layers.")
	FluxTiny(Convolved(model, "0"), Blocks(model), Upsamples(model), Convolved(model, "18"))
Blocks(model Safetensors) Slow(List(FluxTinyBlock))
	Tiny.Blocks(Layers)(9).expanded.biases.Length is 0
	for BlockLayers
		FluxTinyBlock.Loaded(model, value)
Upsamples(model Safetensors) Slow(List(Convolution))
	Tiny.Upsamples(Layers)(2).biases is Layer.Zeros(8)
	for UpsampleLayers
		let upsample = Convolved(model, value)
		Convolution(upsample.Folds, upsample.biases)
Convolved(model Safetensors, name Text) Slow(Convolution)
	Tiny.Convolved(Layers, "6").biases is Layer.Zeros(8)
	Tiny.Convolved(Layers, "0").weights.Length is 8 * 32 * 9
	let shape = model.Shape(name + ".weight")
	let biases = model.Entry(name + ".bias") is "" then Layer.Zeros(shape(0)) else model.Values(name + ".bias")
	Convolution(Convolution.Rearranged(model.Values(name + ".weight"), shape(1), shape(2)), biases)
Decoded(latent Numbers, width Number) Slow(Numbers)
	Decoding.Length is 4608
	Decoding(0).IsNearlyEqual(0.17667, 0.01)
	Decoding(1000).IsNearlyEqual(0.72903, 0.01)
	Decoding(4607).IsNearlyEqual(0.5846, 0.01)
	let patches = FeatureMap(Clamped(latent, width), 2 * width, 32, Layer.Zeros(32))
	let entered = entry.Applied(patches, patches.Identity, false)
	mutable state = blocks(0).Rectified(entered, entered.Identity)
	for blocks
		state = Stepped(state, index)
	let output = exit.Applied(state, state.Identity, false)
	for output.Completed
		value.Clamp
Stepped(map FeatureMap, step Number) Slow(FeatureMap)
	Tiny.Stepped(Tiny.blocks(0).Rectified(FluxTinyBlock.Pixel, FluxTinyBlock.Pixel.Identity), 2).width is 2
	let output = blocks(step).Output(map)
	(step % 3 is 2) and (step < 9) then upsamples((step / 3).Floor).Doubled(output) else output
Clamped(latent Numbers, width Number) Slow(Numbers)
	Tiny.Clamped(Model.Values("reference.latent"), 3).Length is 768
	let height = latent.Length / 128 / width
	for latent.Length
		3 * Activation.Tanh.Output(latent(FluxDecoder.Patched(index, 32, width, height)) / 3)
