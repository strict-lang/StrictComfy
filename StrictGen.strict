has logger
constant Forever = 1000000000
constant BusyWait = 0.05
constant IdleWait = 0.02
constant Preview = "StrictGenStep.jpg"
constant Shell = "StrictGen.shell.html"
constant Fallback = "<!doctype html><html><head><title>StrictGen</title></head><body><p>StrictGen.shell.html was not found beside the program.</p></body></html>"
constant LoraFilter = "LoRA (*.safetensors)|*.safetensors"
constant ModelFilter = "Model (*.safetensors;*.gguf)|*.safetensors;*.gguf"
constant MediaFilter = "Media (*.png;*.jpg;*.jpeg;*.mp4)|*.png;*.jpg;*.jpeg;*.mp4"
constant Forms = "Add-Type -AssemblyName System.Windows.Forms; "
constant Dialog = Forms + "$d = New-Object System.Windows.Forms.OpenFileDialog; $d.Filter = '"
constant Shown = "'; if ($d.ShowDialog() -eq 'OK') { $d.FileName }"
Run(arguments Texts) Number
	StrictGen(Logger).Run(List(Text) + "--help") is 0
	if "--help" is in arguments
		logger.Log("StrictGen.exe serves http://localhost:<port>, a local page for images and video")
		return 0
	Served(Port(arguments))
	0
Port(arguments Texts) Number
	StrictGen(Logger).Port(List(Text)) is 0
	StrictGen(Logger).Port(("--port", "8765")) is 8765
	let at = arguments.Index("--port")
	(at < 0) or (at + 1 >= arguments.Length) then 0 else arguments(at + 1) to Number
Served(port Number)
	StrictGen(Logger).Served(-1) is Error
	let socket = Socket.Listen(port)
	if socket is Error
		return socket
	logger.Log("StrictGen serves http://localhost:" + Socket.Port(socket))
	logger.Log("Page " + Located)
	let peers = StrictGenNet(logger).Opened(Socket.Port(socket)).Introduced
	logger.Log("Other StrictGen programs are found on UDP " + StrictGenNet.BeaconPort)
	Looped(socket, StrictGenQueue(logger), peers)
Looped(socket Number, queue StrictGenQueue, net StrictGenNet)
	StrictGen(Logger).Looped(0, StrictGenQueue.Empty, StrictGenNet.Idle) is not Error
	mutable state = queue
	mutable peers = net
	for Range(0, socket > 0 then Forever else 0)
		let waiting = Socket.Waiting(socket) is 1
		state = waiting then Answered(Socket.Accept(socket), state, peers) else state
		peers = waiting then peers else peers.Refreshed
		state = Steered(state, peers)
		peers = peers.Tick(state.IsBusy)
		if waiting is false
			Process.Wait(state.IsBusy then BusyWait else IdleWait)
Steered(queue StrictGenQueue, net StrictGenNet) StrictGenQueue
	StrictGen(Logger).Steered(StrictGenQueue.Empty, StrictGenNet.Idle).IsBusy is false
	let choice = queue.NeedsAim then net.Chosen(queue.NextMode, queue.Pin) else ""
	(choice is "" then queue else queue.Aimed(choice)).Advanced
Answered(client Number, queue StrictGenQueue, net StrictGenNet) StrictGenQueue
	if (client is Error) or (client <= 0)
		return queue
	let raw = StrictGenHttp.Received(client)
	let route = StrictGenHttp.Route(raw)
	if route is "/file"
		StrictGenHttp.SendFile(client, StrictGenHttp.Query(raw, "path"))
		return queue
	let next = (route is "/run") or (route is "/stop") then queue.Posted(route, StrictGenHttp.Body(raw)) else queue
	StrictGenHttp.Replied(client, Typed(route), Answer(route, raw, next, net))
	next
Typed(route Text) Text
	StrictGen(Logger).Typed("/status") is "application/json"
	StrictGen(Logger).Typed("/job") is "text/plain"
	StrictGen(Logger).Typed("/") is "text/html"
	let isJson = route is in ("/run", "/stop", "/import", "/status")
	let plain = route is in ("/neighbor", "/probe", "/inbox", "/job", "/pick")
	isJson then "application/json" else (plain then "text/plain" else "text/html")
Answer(route Text, raw Text, queue StrictGenQueue, net StrictGenNet) Text
	if route is "/import"
		File("StrictGenWorkflow.json").Write(StrictGenHttp.Body(raw).Split("\n"))
		return StrictGenForm.Imported("StrictGenWorkflow.json")
	if (route is "/status") or (route is "/run") or (route is "/stop")
		let status = StrictGenStats(logger).Status(queue, net)
		let accepted = route is "/run" then queue.modes.Length - 1 else -1
		return status.Substring(0, status.Length - 1) + ",\"accepted\":" + accepted + "}"
	Typed(route) is "text/plain" then Plain(route, raw, queue) else Page
Plain(route Text, raw Text, queue StrictGenQueue) Text
	if route is "/inbox"
		return Stored(StrictGenHttp.Query(raw, "name"), StrictGenHttp.Body(raw))
	if route is "/job"
		return queue.Report(StrictGenHttp.Query(raw, "id") to Number)
	if route is "/pick"
		return Picked(StrictGenHttp.Query(raw, "kind"))
	if route is "/neighbor"
		return StrictGenForm.Stepped(StrictGenHttp.Query(raw, "path"), StrictGenHttp.Query(raw, "step") to Number)
	StrictGenStats(logger).Probed(StrictGenHttp.Query(raw, "path"))
Picked(kind Text) Text
	let filter = kind is "lora" then LoraFilter else (kind is "model" then ModelFilter else MediaFilter)
	let result = Process.RunTool("powershell", "-STA -NoProfile -Command \"" + Dialog + filter + Shown + "\"")
	result.Failed then "" else result.Output.Trim
Stored(name Text, body Text) Text
	Directory.Create("StrictGenInbox")
	let path = "StrictGenInbox/" + (Process.Elapsed * 1000).Floor + "-" + (name is "" then "upload.bin" else name)
	File(path).Write(StrictGenHttp.Unhex(body))
	path
Page Text
	StrictGen(Logger).Page.IndexOf("<html") >= 0
	let found = Located
	found is "" then Fallback else Text.Combine(File(found).ReadLines, "\n")
Located Text
	StrictGen(Logger).Located.EndsWith("StrictGen.shell.html")
	let beside = Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text
	for (beside + "/" + Shell, beside + "/../../" + Shell, beside + "/../" + Shell, Shell)
		if File(value).Exists
			return value
	""
