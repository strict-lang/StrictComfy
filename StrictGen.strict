constant Forever = 1000000000
constant BusyWait = 0.02
constant IdleWait = 0.02
constant Preview = "StrictGenStep.jpg"
constant Shell = "StrictGen.shell.html"
constant Fallback = "<!doctype html><html><head><title>StrictGen</title></head><body><p>StrictGen.shell.html was not found beside the program.</p></body></html>"
constant Inputs = "input"
constant Outputs = "output"
constant DefaultPort = 8001
constant Highest = 65535
constant Usage = "StrictGen.exe [--port " + DefaultPort + "] serves a page for images and video on that port\nStrictGen.exe stop [--port n] ends it and the MossImage, H3Video and H3Image backends"
constant FixedFirst = "\nso this gets fixed first, release builds only warn and go on"
Run(arguments Texts) Number slow
	if "--help" is in arguments
		logger.Log(Usage)
		return 0
	port = Port(arguments)
	if "stop" is in arguments
		return Stopped(port) then 0 else 1
	if port < 1 or port > Highest
		logger.Log("Port " + port + " is not a port number, start with --port and a number from 1 to 65535")
		return 1
	Served(port) is Error then 1 else 0
Stopped(port Number) Boolean slow
	logger.Log("Stopping StrictGen on port " + port + " and the MossImage, H3Video and H3Image backends")
	answer = StrictGenRemote.Posted("127.0.0.1", port, "/quit", "")
	StrictGenJob.StopAll
	logger.Log(answer is "" then "No StrictGen answered on that port, the backends are stopped" else "Stopped")
	true
Port(arguments Texts) Number
	StrictGen.Port(List(Text)) is DefaultPort
	StrictGen.Port(("--port", "8765")) is 8765
	at = arguments.Index("--port")
	at < 0 or at + 1 >= arguments.Length then DefaultPort else arguments(at + 1) to Number
Served(port Number) slow
	socket = Socket.Listen(port)
	if socket is Error
		logger.Log("Port " + port + " is in use, probably by a running StrictGen; close it or start with --port <number>")
		return socket
	logger.Log("StrictGen serves http://localhost:" + Socket.Port(socket) + StrictGenHost.Utf8Console)
	logger.Log("Page " + Located)
	Directory.Create(Inputs)
	Directory.Create(Outputs)
	peers = StrictGenNet.Opened(Socket.Port(socket)).Measured.Shouted
	logger.Log("Other StrictGen programs are found on UDP " + StrictGenNet.BeaconPort)
	Looped(socket, StrictGenQueue, peers)
Looped(socket Number, queue StrictGenQueue, net StrictGenNet) slow
	StrictGen.Looped(0, StrictGenQueue.Empty, StrictGenNet.Idle) is not Error
	mutable state = queue
	mutable peers = net
	for Range(0, socket > 0 then Forever else 0)
		waiting = Socket.Waiting(socket) is 1
		peers = waiting then peers else peers.Refreshed
		state = Turned(socket, waiting, state, peers)
		if state.notice.StartsWith(StrictGenQueue.Collecting) or state.notice is StrictGenQueue.Quitting
			return Ended(state.notice)
		peers = peers.Tick(state.IsBusy)
		Process.Wait(waiting then 0 else (state.IsBusy then BusyWait else IdleWait))
Turned(socket Number, waiting Boolean, queue StrictGenQueue, net StrictGenNet) StrictGenQueue slow
	StrictGen.Turned(0, false, StrictGenQueue.Empty, StrictGenNet.Idle).IsBusy is false
	StrictGenConsole.Told(queue, Steered(waiting then Answered(Socket.Accept(socket), queue, net) else queue, net))
Ended(reason Text) Number slow
	StrictGenJob.StopAll
	if reason is StrictGenQueue.Quitting
		return Error("StrictGenStopped: " + reason)
	logger.Log(Broken(reason))
	Error("GarbageCollectionExceedsLimit")
Broken(reason Text) Text
	StrictGen.Broken("GarbageCollectionExceedsLimit: test").EndsWith(FixedFirst)
	"A backend ended with " + reason.Split(":").First + ", StrictGen stops its backends and ends here" + FixedFirst
Steered(queue StrictGenQueue, net StrictGenNet) StrictGenQueue slow
	StrictGen.Steered(StrictGenQueue.Empty, StrictGenNet.Idle).IsBusy is false
	choice = queue.NeedsAim then net.Chosen(queue.NextMode, queue.Pin) else ""
	(choice is "" then queue else queue.Aimed(choice)).Advanced
Answered(client Number, queue StrictGenQueue, net StrictGenNet) StrictGenQueue slow
	if client is Error or client <= 0
		return queue
	bytes = StrictGenHttp.Received(client)
	if IsSent(client, bytes)
		return queue
	raw = StrictGenHttp.Decoded(bytes)
	route = StrictGenHttp.Route(raw)
	if route is in ("/stop", "/quit")
		StrictGenJob.StopAll
	next = route is in ("/run", "/stop", "/quit") then queue.Posted(route, StrictGenHttp.Body(raw)) else queue
	StrictGenHttp.Replied(client, Typed(route), Answer(route, raw, next, net))
	next
IsSent(client Number, bytes Numbers) Boolean slow
	StrictGen.IsSent(0, StrictGenHttp.Encoded("GET /status HTTP/1.1\r\n\r\n")) is false
	head = StrictGenHttp.Head(bytes)
	route = StrictGenHttp.Route(head)
	if route is "/file"
		StrictGenHttp.SendFile(client, StrictGenHttp.Query(head, "path"))
	if route is "/inbox"
		StrictGenHttp.Replied(client, "text/plain", Stored(StrictGenHttp.Query(head, "name"), StrictGenHttp.Payload(bytes)))
	route is in ("/file", "/inbox")
Typed(route Text) Text
	StrictGen.Typed("/status") is "application/json"
	StrictGen.Typed("/job") is "text/plain"
	StrictGen.Typed("/outputs") is "text/plain"
	StrictGen.Typed("/") is "text/html"
	StrictGen.Typed("/inputs") is "text/plain"
	isJson = route is in ("/run", "/stop", "/import", "/status", "/warm", "/quit")
	plain = route is in ("/neighbor", "/probe", "/job", "/list", "/outputs", "/inputs", "/estimate")
	isJson then "application/json" else (plain then "text/plain" else "text/html")
Answer(route Text, raw Text, queue StrictGenQueue, net StrictGenNet) Text slow
	if route is "/import"
		File("StrictGenWorkflow.json").Write(StrictGenHttp.Body(raw).Split("\n"))
		return StrictGenForm.Imported("StrictGenWorkflow.json")
	if route is "/warm"
		return Warmed(StrictGenHttp.Body(raw), queue)
	if route is in ("/status", "/run", "/stop", "/quit")
		status = StrictGenStats.Status(queue, net)
		accepted = route is "/run" then queue.modes.Length - 1 else -1
		return status.Substring(0, status.Length - 1) + ",\"accepted\":" + accepted + "}"
	Typed(route) is "text/plain" then Plain(route, raw, queue) else Page
Warmed(body Text, queue StrictGenQueue) Text slow
	StrictGen.Warmed("{\"mode\":\"video\"}", StrictGenQueue.Empty) is "{\"warming\":false}"
	if queue.IsBusy or queue.pending.Length > 0 or Json(body).get("mode") to Text is not "image"
		return "{\"warming\":false}"
	command = Text.Combine(StrictGenForm.Arguments(body), "\n")
	"{\"warming\":" + (StrictGenJob.Warmed(StrictGenJob.Executable("MossImage"), command) then "true" else "false") + "}"
Plain(route Text, raw Text, queue StrictGenQueue) Text slow
	if route is "/job"
		return queue.Report(StrictGenHttp.Query(raw, "id") to Number)
	if route is "/outputs" or route is "/inputs"
		return Text.Combine(StrictGenFiles("").Outputs(route is "/outputs" then Outputs else Inputs), "\n")
	if route is "/list"
		files = StrictGenFiles(StrictGenHttp.Query(raw, "models"))
		return Text.Combine(files.Listed(StrictGenHttp.Query(raw, "kind")), "\n")
	if route is "/neighbor"
		return StrictGenForm.Stepped(StrictGenHttp.Query(raw, "path"), StrictGenHttp.Query(raw, "step") to Number)
	route is "/estimate" then H3Estimate.Told(raw) else StrictGenStats.Probed(StrictGenHttp.Query(raw, "path"))
Stored(name Text, bytes Numbers) Text slow
	StrictGen.Stored("a/b/upload-test.bin", (1, 2)) is "input/upload-test.bin"
	Directory.Create(Inputs)
	path = Inputs + "/" + (name is "" then "upload.bin" else Path(name.Replace("\\", "/")).FileName.text)
	File(path).Write(bytes)
	path
Page Text slow
	StrictGen.Page.IndexOf("<html") >= 0
	found = Located
	found is "" then Fallback else Text.Combine(File(found).ReadLines, "\n")
Located Text slow
	StrictGen.Located.EndsWith("StrictGen.shell.html")
	local = Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text + "/" + Shell
	File(local).Exists then local else (File(Shell).Exists then Shell else "")
