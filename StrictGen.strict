has logger
constant Forever = 1000000000
constant BusyWait = 0.02
constant IdleWait = 0.02
constant Preview = "StrictGenStep.jpg"
constant Shell = "StrictGen.shell.html"
constant Fallback = "<!doctype html><html><head><title>StrictGen</title></head><body><p>StrictGen.shell.html was not found beside the program.</p></body></html>"
constant Inputs = "input"
constant Outputs = "output"
constant DefaultPort = 8001
Run(arguments Texts) Number
	StrictGen(Logger).Run(List(Text) + "--help") is 0
	if "--help" is in arguments
		logger.Log("StrictGen.exe [--port " + DefaultPort + "] serves a page for images and video on that port")
		logger.Log("StrictGen.exe stop [--port n] ends it and the MossImage, H3Video and H3Image backends")
		return 0
	if "stop" is in arguments
		return Stopped(Port(arguments)) then 0 else 1
	Served(Port(arguments)) is Error then 1 else 0
Stopped(port Number) Boolean slow
	logger.Log("Stopping StrictGen on port " + port + " and the MossImage, H3Video and H3Image backends")
	let answer = StrictGenRemote.Posted("127.0.0.1", port, "/quit", "")
	StrictGenJob.StopAll
	logger.Log(answer is "" then "No StrictGen answered on that port, the backends are stopped" else "Stopped")
	true
Port(arguments Texts) Number
	StrictGen(Logger).Port(List(Text)) is DefaultPort
	StrictGen(Logger).Port(("--port", "8765")) is 8765
	let at = arguments.Index("--port")
	(at < 0) or (at + 1 >= arguments.Length) then DefaultPort else arguments(at + 1) to Number
Served(port Number) slow
	StrictGen(Logger).Served(-1) is Error
	let socket = Socket.Listen(port)
	if socket is Error
		logger.Log("Port " + port + " is in use, probably by a running StrictGen; close it or start with --port <number>")
		return socket
	logger.Log("StrictGen serves http://localhost:" + Socket.Port(socket))
	logger.Log("Page " + Located)
	Directory.Create(Inputs)
	Directory.Create(Outputs)
	let peers = StrictGenNet(logger).Opened(Socket.Port(socket)).Measured.Shouted
	logger.Log("Other StrictGen programs are found on UDP " + StrictGenNet.BeaconPort)
	Looped(socket, StrictGenQueue(logger), peers)
Looped(socket Number, queue StrictGenQueue, net StrictGenNet) slow
	StrictGen(Logger).Looped(0, StrictGenQueue.Empty, StrictGenNet.Idle) is not Error
	mutable state = queue
	mutable peers = net
	for Range(0, socket > 0 then Forever else 0)
		let waiting = Socket.Waiting(socket) is 1
		peers = waiting then peers else peers.Refreshed
		state = Turned(socket, waiting, state, peers)
		if state.notice.StartsWith(StrictGenQueue.Collecting) or (state.notice is StrictGenQueue.Quitting)
			return Ended(state.notice)
		peers = peers.Tick(state.IsBusy)
		if waiting is false
			Process.Wait(state.IsBusy then BusyWait else IdleWait)
Turned(socket Number, waiting Boolean, queue StrictGenQueue, net StrictGenNet) StrictGenQueue slow
	StrictGen(Logger).Turned(0, false, StrictGenQueue.Empty, StrictGenNet.Idle).IsBusy is false
	let answered = waiting then Answered(Socket.Accept(socket), queue, net) else queue
	StrictGenConsole(logger).Told(queue, Steered(answered, net))
Ended(reason Text) Number slow
	StrictGenJob.StopAll
	reason is StrictGenQueue.Quitting then Error("StrictGenStopped") else Broken(reason)
Broken(reason Text) Number
	StrictGen(Logger).Broken("GarbageCollectionExceedsLimit: test") is Error
	logger.Log("A backend ended with " + reason.Split(":").First + ", StrictGen stops its backends and ends here")
	logger.Log("so this gets fixed first, release builds only warn and go on")
	Error("GarbageCollectionExceedsLimit")
Steered(queue StrictGenQueue, net StrictGenNet) StrictGenQueue slow
	StrictGen(Logger).Steered(StrictGenQueue.Empty, StrictGenNet.Idle).IsBusy is false
	let choice = queue.NeedsAim then net.Chosen(queue.NextMode, queue.Pin) else ""
	(choice is "" then queue else queue.Aimed(choice)).Advanced
Answered(client Number, queue StrictGenQueue, net StrictGenNet) StrictGenQueue slow
	if (client is Error) or (client <= 0)
		return queue
	let bytes = StrictGenHttp.Received(client)
	if IsSent(client, bytes)
		return queue
	let raw = StrictGenHttp.Decoded(bytes)
	let route = StrictGenHttp.Route(raw)
	if route is in ("/stop", "/quit")
		StrictGenJob.StopAll
	let next = route is in ("/run", "/stop", "/quit") then queue.Posted(route, StrictGenHttp.Body(raw)) else queue
	StrictGenHttp.Replied(client, Typed(route), Answer(route, raw, next, net))
	next
IsSent(client Number, bytes Numbers) Boolean slow
	StrictGen(Logger).IsSent(0, StrictGenHttp.Encoded("GET /status HTTP/1.1\r\n\r\n")) is false
	let head = StrictGenHttp.Head(bytes)
	let route = StrictGenHttp.Route(head)
	if route is "/file"
		StrictGenHttp.SendFile(client, StrictGenHttp.Query(head, "path"))
	if route is "/inbox"
		StrictGenHttp.Replied(client, "text/plain", Stored(StrictGenHttp.Query(head, "name"), StrictGenHttp.Payload(bytes)))
	route is in ("/file", "/inbox")
Typed(route Text) Text
	StrictGen(Logger).Typed("/status") is "application/json"
	StrictGen(Logger).Typed("/job") is "text/plain"
	StrictGen(Logger).Typed("/outputs") is "text/plain"
	StrictGen(Logger).Typed("/") is "text/html"
	let isJson = route is in ("/run", "/stop", "/import", "/status", "/warm", "/quit")
	let plain = route is in ("/neighbor", "/probe", "/job", "/list", "/outputs")
	isJson then "application/json" else (plain then "text/plain" else "text/html")
Answer(route Text, raw Text, queue StrictGenQueue, net StrictGenNet) Text slow
	if route is "/import"
		File("StrictGenWorkflow.json").Write(StrictGenHttp.Body(raw).Split("\n"))
		return StrictGenForm.Imported("StrictGenWorkflow.json")
	if route is "/warm"
		return Warmed(StrictGenHttp.Body(raw), queue)
	if route is in ("/status", "/run", "/stop", "/quit")
		let status = StrictGenStats(logger).Status(queue, net)
		let accepted = route is "/run" then queue.modes.Length - 1 else -1
		return status.Substring(0, status.Length - 1) + ",\"accepted\":" + accepted + "}"
	Typed(route) is "text/plain" then Plain(route, raw, queue) else Page
Warmed(body Text, queue StrictGenQueue) Text slow
	StrictGen(Logger).Warmed("{\"mode\":\"video\"}", StrictGenQueue.Empty) is "{\"warming\":false}"
	if queue.IsBusy or (queue.pending.Length > 0) or (Json(body).get("mode") to Text is not "image")
		return "{\"warming\":false}"
	let command = Text.Combine(StrictGenForm.Arguments(body), "\n")
	"{\"warming\":" + (StrictGenJob.Warmed(StrictGenJob.Executable("MossImage"), command) then "true" else "false") + "}"
Plain(route Text, raw Text, queue StrictGenQueue) Text slow
	if route is "/job"
		return queue.Report(StrictGenHttp.Query(raw, "id") to Number)
	if route is "/outputs"
		return Text.Combine(StrictGenFiles("").Outputs(Outputs), "\n")
	if route is "/list"
		let files = StrictGenFiles(StrictGenHttp.Query(raw, "models"))
		return Text.Combine(files.Listed(StrictGenHttp.Query(raw, "kind")), "\n")
	if route is "/neighbor"
		return StrictGenForm.Stepped(StrictGenHttp.Query(raw, "path"), StrictGenHttp.Query(raw, "step") to Number)
	StrictGenStats(logger).Probed(StrictGenHttp.Query(raw, "path"))
Stored(name Text, bytes Numbers) Text slow
	StrictGen(Logger).Stored("a/b/upload-test.bin", (1, 2)) is "input/upload-test.bin"
	Directory.Create(Inputs)
	let path = Inputs + "/" + (name is "" then "upload.bin" else Path(name.Replace("\\", "/")).FileName.text)
	File(path).Write(bytes)
	path
Page Text slow
	StrictGen(Logger).Page.IndexOf("<html") >= 0
	let found = Located
	found is "" then Fallback else Text.Combine(File(found).ReadLines, "\n")
Located Text slow
	StrictGen(Logger).Located.EndsWith("StrictGen.shell.html")
	let beside = Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text
	for (beside + "/" + Shell, beside + "/../../" + Shell, beside + "/../" + Shell, Shell)
		if File(value).Exists
			return value
	""
