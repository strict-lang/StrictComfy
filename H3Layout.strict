has tags Numbers
has keyframes Numbers
has audio Number
has frames Number
has height Number
has width Number
has shift Number = 12
has routing Number = 0
constant Tiny = H3Layout((1, 1, 1), List(Number), 3, 2, 4, 4)
constant Inverse = Safetensors("tinyh3.safetensors").Values("rope.inv_freq")
constant Chunk = 32768
constant Pinned = 0.999
constant AudioShift = 3
Words Number
	Tiny.Words is 3
	tags.Length
Conditions Number
	Tiny.Conditions is 0
	H3Layout(Tiny, keyframes = (0, 5)).Conditions is 8
	keyframes.Length * Patches
Tokens Number
	Tiny.Tokens is 17
	H3Layout(Tiny, keyframes = List(Number) + 0).Tokens is 21
	Words + Conditions + 2 * audio + frames * Patches
Patches Number
	Tiny.Patches is 4
	height * width / 4
Positions Numbers
	Tiny.Positions.Length is 51
	Tiny.Positions(20) is 16
	Tiny.Positions(39).IsNearlyEqual(4.666667)
	for Tokens * 3
		Position((index / 3).Floor, index % 3)
Position(token Number, axis Number) Number
	Tiny.Position(7, 0) is 4
	H3Layout(Tiny, keyframes = List(Number) + 0).Position(6, 1) is 16
	H3Layout(Tiny, keyframes = List(Number) + 5).Position(3, 0).IsNearlyEqual(11.333333)
	H3Layout(Tiny, keyframes = List(Number) + 0).Position(17, 0).IsNearlyEqual(4.666667)
	if token < Words
		return axis is 0 then token else 0
	let row = token - Words
	if row < Conditions
		return Seen(row % Patches, axis, Words + keyframes((row / Patches).Floor) * 5 / 3)
	let heard = row - Conditions
	let seen = heard - 2 * audio
	heard < 2 * audio then Heard(heard, axis) else Seen(seen % Patches, axis, Words + FrameTime((seen / Patches).Floor))
Heard(row Number, axis Number) Number
	Tiny.Heard(3, 0) is 3
	Tiny.Heard(3, 2) is 16
	H3Layout(Tiny, height = 60, width = 104).Heard(0, 2).IsNearlyEqual(-5.064979)
	let side = row < audio then 0 else width / 2 - 1
	axis is 0 then Words + row % audio else (axis is 1 then 0 else Axis(width, height, side))
Seen(patch Number, axis Number, time Number) Number
	Tiny.Seen(0, 0, 4.5) is 4.5
	Tiny.Seen(3, 1, 0) is 16
	Tiny.Seen(1, 2, 0) is 16
	let across = width / 2
	if axis is 0
		return time
	axis is 1 then Axis(height, width, (patch / across).Floor) else Axis(width, height, patch % across)
Axis(size Number, other Number, at Number) Number
	Tiny.Axis(4, 4, 1) is 16
	Tiny.Axis(104, 60, 0).IsNearlyEqual(-5.064979)
	Tiny.Axis(60, 104, 0).IsNearlyEqual(3.847128)
	let ratio = size / (size * other).SquareRoot
	(at * ratio * 2 / size + (1 - ratio) / 2) * 32
FrameTime(frame Number) Number
	Tiny.FrameTime(0) is 0
	Tiny.FrameTime(1).IsNearlyEqual(5 / 3)
	Tiny.FrameTime(6).IsNearlyEqual(30)
	(4 * frame - 3 * ((frame + 4) / 5).Floor) * 5 / 3
Rows(sigma Number) Numbers
	Tiny.Rows(0.75)(2) is 6
	Tiny.Rows(0.75)(3) is 30
	Tiny.Rows(1)(3) is 12
	H3Layout((1, 0, 1), List(Number) + 0, 3, 2, 4, 4).Rows(0.75)(1) is 0
	H3Layout((1, 0, 1), List(Number) + 0, 3, 2, 4, 4).Rows(0.75)(3) is 36
	let times = Times(sigma)
	let seen = times.Index(1 - sigma) * 3
	let heard = (times.Index(1 - AudioSigma(sigma)) * 3 + 2) * 6
	let pinned = times.Index(1 - sigma > Pinned then 1 - sigma else Pinned) * 18
	for Tokens
		let row = index - Words - Conditions
		index < Words then (seen + tags(index)) * 6 else (row < 0 then pinned else (row < 2 * audio then heard else seen * 6))
Finals(sigma Number) Numbers
	Tiny.Finals(0.75)(3) is 2
	Tiny.Finals(0.75)(16) is 0
	Tiny.Finals(1)(3) is 0
	let times = Times(sigma)
	let heard = times.Index(1 - AudioSigma(sigma)) * 2
	let seen = times.Index(1 - sigma) * 2
	for Tokens
		let row = index - Words - Conditions
		(row >= 0) and (row < 2 * audio) then heard else seen
Times(sigma Number) Numbers
	Tiny.Times(0.75)(1).IsNearlyEqual(0.5714286)
	Tiny.Times(1).Length is 1
	H3Layout(Tiny, keyframes = List(Number) + 0).Times(0.75)(2) is Pinned
	H3Layout(Tiny, keyframes = List(Number) + 0).Times(1).Length is 2
	let streams = List(Number) + (1 - sigma) + (1 - AudioSigma(sigma))
	(keyframes.Length is 0 then streams else streams + (1 - sigma > Pinned then 1 - sigma else Pinned)).Unique.Sorted
AudioSigma(sigma Number) Number
	Tiny.AudioSigma(0.75).IsNearlyEqual(0.4285714)
	Tiny.AudioSigma(1) is 1
	H3Layout(Tiny, shift = 8).AudioSigma(0.75).IsNearlyEqual(9 / 17)
	let base = Unshifted(sigma)
	AudioShift * base / (1 + (AudioShift - 1) * base)
AudioSigmas(sigmas Numbers) Numbers
	Tiny.AudioSigmas((1, 0.75, 0)) is (1, Tiny.AudioSigma(0.75), 0)
	for sigmas
		AudioSigma(value)
Unshifted(sigma Number) Number
	Tiny.Unshifted(1) is 1
	Tiny.Unshifted(0.96).IsNearlyEqual(2 / 3)
	H3Layout(Tiny, shift = 1).Unshifted(0.3).IsNearlyEqual(0.3)
	sigma / (shift + sigma * (1 - shift))