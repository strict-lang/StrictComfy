has logger
Run(arguments Texts)
	let lora = H3Lora(arguments(1))
	mutable joining = 0
	mutable tuning = 0
	for 42
		let rows = Safetensors(arguments(0), 32, "layers." + index + ".proj.")
		for ("q", "k", "v", "o", "ffn_up_gate", "ffn_down")
			let name = value
			let stacked = lora.Stacked(rows.prefix + name + ".")
			let rotated = Convrot(stacked.down).Rotated
			let first = rotated.First
			let started = Process.Elapsed
			let joined = rotated + stacked.up + MossLora.Repeated(1 / MossLora.Gain, stacked.rank)
			let last = joined.Last
			let tuned = Process.Elapsed
			let merged = TensorFile.Tuned(rows.path, rows.Entry(name + ".weight"), rows.Entry(name + ".weight_scale"), joined)
			joining = joining + tuned - started
			tuning = tuning + Process.Elapsed - tuned + merged.Length * 0
	logger.Log("joining " + joining.Round(2) + " s, tuning " + tuning.Round(2) + " s")
