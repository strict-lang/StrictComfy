has logger
has httpPort = 0
has beacon = 0
has peers Texts = List(Text)
has total = 0
has free = 0
has ram = 0
has gpu = ""
has busy = false
has seenGpu = false
has shouted = -100
has meters = ""
has metered = -100
constant BeaconPort = 18001
constant FreshSeconds = 30
constant MossMb = 6144
constant H3Mb = 8192
constant Gigabyte = 1024
constant Query = "--query-gpu=name,memory.total,memory.free --format=csv,noheader,nounits"
constant Idle = StrictGenNet(Logger)
constant Big = "10.0.0.3\t59139\t24576\t20000\t60000\t0\tNVIDIA GeForce RTX 4090\t100"
constant Small = "10.0.0.4\t59140\t10240\t8000\t30000\t0\tNVIDIA GeForce RTX 3080\t100"
constant BusyCard = "10.0.0.3\t59139\t24576\t2000\t60000\t1\tNVIDIA GeForce RTX 4090\t100"
constant Seen = StrictGenNet(Idle, seenGpu = true)
constant Roomy = StrictGenNet(Seen, total = 10240, free = 8000)
constant Mixed = StrictGenNet(Roomy, peers = (Big, Small))
Opened(port Number) StrictGenNet
	let socket = Socket.Beacon(StrictGenNet.BeaconPort)
	if socket is Error
		logger.Log("UDP " + StrictGenNet.BeaconPort + " is already in use, this StrictGen will not see other PCs")
	StrictGenNet(value, httpPort = port, beacon = socket is Error then 0 else socket)
Measured StrictGenNet
	let result = Process.RunTool("nvidia-smi", Query)
	let parts = result.Failed then List(Text) else result.Output.Split("\n").First.Split(",")
	let named = parts.Length < 3 then "" else parts(0).Trim
	let whole = parts.Length < 3 then 0 else parts(1).Trim to Number
	let available = parts.Length < 3 then 0 else parts(2).Trim to Number
	let memory = GpuMemory.HostAvailable / 1048576
	let sized = StrictGenNet(value, gpu = named, total = whole is Error then 0 else whole, ram = memory, seenGpu = true)
	StrictGenNet(sized, free = available is Error then 0 else available)
Refreshed StrictGenNet
	if Process.Elapsed - metered <= 8
		return value
	StrictGenNet(value, meters = StrictGenStats(logger).Text, metered = Process.Elapsed).Measured
Introduced StrictGenNet
	Shouted
Shouted StrictGenNet
	if beacon <= 0
		return StrictGenNet(value, shouted = Process.Elapsed)
	let state = "\t" + ram + "\t" + (busy then "1" else "0") + "\t" + gpu
	let line = "strictgen\t" + httpPort + "\t" + total + "\t" + free + state
	if Socket.Shout(beacon, StrictGenNet.BeaconPort, StrictGenHttp.Encoded(line)) is Error
		logger.Log("Could not announce this StrictGen on the network")
	StrictGenNet(value, shouted = Process.Elapsed)
Heard StrictGenNet
	if beacon <= 0
		return value
	mutable found = value
	mutable line = Socket.Hear(beacon)
	for as long as line is not ""
		found = found.Noted(line, Process.Elapsed)
		line = Socket.Hear(beacon)
	found
Tick(isBusy Boolean) StrictGenNet
	let heard = StrictGenNet(value, busy = isBusy).Heard
	Process.Elapsed - heard.shouted >= 5 then heard.Shouted else heard
Noted(line Text, now Number) StrictGenNet
	let parts = line.Split("\t")
	if (parts.Length < 8) or (parts(1) is not "strictgen")
		return value
	let port = parts(2) to Number
	if (port is Error) or (port is httpPort)
		return value
	let peer = Text.Combine((parts(0), parts(2), parts(3), parts(4), parts(5), parts(6), parts(7)), "\t") + "\t" + now
	let known = Address(peer)
	if (known is in Addresses) is false
		logger.Log("StrictGen peer " + known + " " + parts(7) + " " + ((parts(3) to Number) / Gigabyte).Round(1) + " GB")
	StrictGenNet(value, peers = Kept(peer, known))
Addresses Texts
	for peers
		Address(value)
Kept(peer Text, address Text) Texts
	mutable kept = List(Mutable(Text))
	for peers
		if Address(value) is not address
			kept.Add(value)
	kept + peer
Address(peer Text) Text
	Idle.Address(Big) is "10.0.0.3:59139"
	let parts = peer.Split("\t")
	parts.Length < 2 then "" else parts(0) + ":" + parts(1)
Chosen(mode Text, pin Text) Text
	Idle.Chosen("image", "") is "local"
	Idle.Chosen("video", "") is "local"
	Seen.Chosen("image", "") is "none"
	Seen.Chosen("video", "") is "none"
	Mixed.Chosen("extend", "local") is "local"
	Roomy.Chosen("image", "") is "local"
	StrictGenNet(Mixed, seenGpu = false).Chosen("video", "10.0.0.4:59140") is "10.0.0.4:59140"
	if pin is "local"
		return Fits(mode, total, free) then "local" else "none"
	if (pin is not "") and (pin is not "any")
		return Pinned(mode, pin) then pin else "none"
	seenGpu is false then "local" else Automatic(mode)
Automatic(mode Text) Text
	Roomy.Automatic("video") is "local"
	Mixed.Automatic("image") is "local"
	Mixed.Automatic("video") is "10.0.0.3:59139"
	StrictGenNet(Roomy, peers = (BusyCard, Small)).Automatic("video") is "local"
	StrictGenNet(Seen, peers = List(Text) + Big).Automatic("image") is "10.0.0.3:59139"
	StrictGenNet(Seen, peers = List(Text) + BusyCard).Automatic("video") is "none"
	let video = IsLarge(mode)
	let better = video then Best(total, H3Mb) else ""
	if better is not ""
		return better
	let fallback = Fits(mode, total, free) then "local" else Best(0, video then H3Mb else MossMb)
	fallback is "" then "none" else fallback
Best(floor Number, least Number) Text
	mutable chosen = ""
	mutable largest = floor
	for peers
		let parts = value.Split("\t")
		let whole = parts.Length > 2 then parts(2) to Number else 0
		let available = parts.Length > 3 then parts(3) to Number else 0
		let recent = (parts.Last to Number is Error) or ((Process.Elapsed - (parts.Last to Number)) < FreshSeconds)
		let roomy = (whole > largest) and (whole >= least) and (available >= 4096) and recent
		if (parts.Length > 5) and (parts(5) is "0") and roomy
			largest = whole
			chosen = Address(value)
	chosen
Fits(mode Text, whole Number, available Number) Boolean
	Idle.Fits("image", 10240, 8000)
	Idle.Fits("image", 2048, 2048) is false
	Idle.Fits("video", 10240, 8000)
	Idle.Fits("video", 4096, 4000) is false
	Idle.Fits("h3image", 4096, 4000) is false
	(whole >= (IsLarge(mode) then H3Mb else MossMb)) and (available >= 4096)
IsLarge(mode Text) Boolean
	Idle.IsLarge("extend") and Idle.IsLarge("h3image")
	Idle.IsLarge("image") is false
	(mode is "video") or (mode is "extend") or (mode is "imagevideo") or (mode is "h3image")
Pinned(mode Text, address Text) Boolean
	for peers
		if Address(value) is address
			return Fits(mode, value.Split("\t")(2) to Number, value.Split("\t")(3) to Number)
	false
Labels Texts
	Idle.Labels.Length is 0
	StrictGenNet(Idle, peers = List(Text) + Big).Labels.First.StartsWith("10.0.0.3:59139")
	for peers
		let parts = value.Split("\t")
		let whole = parts.Length > 2 then (parts(2) to Number) / Gigabyte else 0
		Address(value) + "\t" + parts(6) + " " + whole.Round(1) + " GB"
