has width Number = 45
constant Reference = Safetensors("tinymoss.safetensors", 32, "reference.")
constant Decoding = Safetensors("tinyvae.safetensors", 32, "reference.")
constant Positional = "ComfyUI node backend arguments: - model loras spectrum, diagnostic arguments: dumps model lora vae"
Run(arguments Texts) Number
	if "--help" is in arguments
		logger.Log("MossImage.exe [options] makes Moss images, " + Positional + "\n" + MossOptions.Usage)
		return 0
	if arguments.Length is 4 and arguments(0) is "-"
		return Served(Loaded(arguments(1), arguments(2)), arguments(3)) then 0 else 1
	if arguments.Length is 4 and arguments(0).StartsWith("-") is false
		ComparedRun(arguments(0), arguments(1), arguments(2), arguments(3))
		return 0
	Routed(arguments)
Routed(arguments Texts) Number slow
	server = MossServer(MossServer.Backended(logger))
	if "coordinator" is in arguments
		return Coordinator.Served is Error then Backend.Failed else 0
	Backend.IsServing(arguments) then server.Ran(arguments) else server.Local(arguments).code
Loaded(model Text, lora Text) Moss slow
	MossImage.Loaded("tinymoss.safetensors", "").layers.Length is 2
	started = Process.Elapsed
	moss = Moss.Loaded(model, lora)
	logger.Log("loaded in " + (Process.Elapsed - started).Round(1) + " s")
	moss
Served(moss Moss, mode Text) Boolean slow
	mutable dumps = Process.InputLine
	for as long as dumps is not ""
		made = Generations(moss, Safetensors(dumps + "/generation.safetensors", 32), mode, dumps)
		GpuMemory.Evicted
		if MossFiles.FailedTexts(made)
			return false
		dumps = Process.InputLine
	true
Generations(moss Moss, data Safetensors, mode Text, dumps Text) Texts slow
	sampling = Configured(data, mode)
	count = GenerationCommand.Count(data)
	for count
		before = Process.Elapsed
		job = GenerationCommand.Job(data, dumps, index)
		path = dumps + "/strict-" + mode + (count > 1 then "-" + index else "") + "-latent.safetensors"
		label = "Generation " + (index + 1) + "/" + count
		latent = sampling.Sampled(moss, job.Values("noise"), job.Values("context"), label)
		Safetensors(path).Written("latent", latent)
		logger.Log("generation " + index + " in " + ((Process.Elapsed - before) * 1000).Round + " ms")
		GpuMemory.Released
		path
Configured(data Safetensors, mode Text) MossSampling
	columns = data.Shape("noise").Last
	steps = data.Values("steps").First
	guidance = data.Values("guidance").First
	span = data.Entry("span") is "" then MossSpan.Off else MossSpan(data.Values("span")(0), data.Values("span")(1))
	MossSampling(columns, steps, guidance, mode, data.Values("warmup").First, data.Values("period").First, span)
ComparedRun(dumps Text, model Text, lora Text, vae Text)
	steps = Safetensors(dumps + "/steps.safetensors", 64)
	context = Safetensors(dumps + "/conditioning.safetensors", 64).Values("context")
	sized = MossImage(steps.Shape("noise").Last)
	first = Safetensors(dumps + "/step0.safetensors", 64)
	sampled = sized.Generated(model, lora, Euler(8, 5), steps, first, context)
	logger.Log("latent error " + RelativeError(sampled, steps.Values("latent")))
	if MossFiles.FailedNumber(sized.Saved(sampled, steps, FluxDecoder.Loaded(vae, 32), dumps + "/moss-strict.png"))
		return
Generated(model Text, lora Text, euler Euler, steps Safetensors, step Safetensors, context Numbers) Numbers native
	MossImage(4).Generated("tinymoss.safetensors", "", Euler(1, 5), Reference, Reference, Moss.Context).Length > 0
	moss = Loaded(model, lora)
	MossFiles.FailedNumber(Compared(moss, step)) then List(Number) else Sampled(moss, euler, steps, context)
Saved(latent Numbers, steps Safetensors, decoder FluxDecoder, path Text) Number native
	MossImage(2).Saved(FluxDecoder.Latent, Decoding, FluxDecoder.Tiny, "") > 40
	before = Process.Elapsed
	image = decoder.Decoded(latent, width)
	psnr = FluxImage.Psnr(image, steps.Values("image"))
	logger.Log("decoded in " + ((Process.Elapsed - before) * 1000).Round + " ms, PSNR " + psnr.Round(2) + " dB")
	shape = steps.Shape("image")
	if path is not ""
		ImageSaver(path).Save(Image(Size(shape(2), shape(1)), FluxImage.Colors(image)))
	psnr
Sampled(moss Moss, euler Euler, steps Safetensors, context Numbers) Numbers native
	MossImage(4).Sampled(Moss.Tiny, Euler(1, 5), Reference, Moss.Context).Length is 256
	mutable latent = steps.Values(steps.Entry("x.0") is "" then "x" else "x.0")
	text = moss.TextEmbedded(context, context.Length / moss.textProjection.weights.First.Length)
	sigmas = euler.Sigmas
	rotation = moss.Rotation(latent, text, width)
	for euler.steps
		before = Process.Elapsed
		latent = euler.Stepped(latent, moss.Output(latent, sigmas(index), text, rotation), sigmas, index)
		MossTiming.Measured(index, before, latent, steps)
	latent
Compared(moss Moss, step Safetensors) Number native
	MossImage(4).Compared(Moss.Tiny, Reference) < 0.05
	context = step.Values("context")
	vector = moss.TimeEmbedded(step.Values("timestep").First)
	modulation = moss.blockModulation.Sums(vector)
	logger.Log("time embedding error " + RelativeError(vector, step.Values("time_embedding")))
	logger.Log("modulation error " + RelativeError(modulation, step.Values("shared_block_modulation")))
	text = moss.TextEmbedded(context, context.Length / moss.textProjection.weights.First.Length)
	video = moss.video.Sums(Moss.Transposed(step.Values("x"), moss.video.weights.First.Length))
	logger.Log("text embedder error " + RelativeError(text, step.Values("text_embedder")))
	logger.Log("video embedder error " + RelativeError(video, step.Values("video_embedder")))
	Layered(moss, step, video + text, modulation)
Layered(moss Moss, step Safetensors, hidden Numbers, modulation Numbers) Number native
	MossImage(4).Layered(Moss.Tiny, Reference, MossBlock.Input, MossBlock.Modulation) < 0.05
	text = step.Values("context").Length / moss.textProjection.weights.First.Length
	rotation = MossBlock.Rotations((hidden.Length / moss.finalNorm.Length - text) / width, width, text, 128)
	mutable state = hidden
	mutable error = 0
	for moss.layers
		state = value.Output(state, modulation, rotation)
		error = RelativeError(state, step.Values("layers." + index))
		logger.Log("layer " + index + " error " + error)
	error
RelativeError(values Numbers with value.Bits is 32, expected Numbers with value.Bits is 32) Number
	MossImage.RelativeError((1, 2), (1, 2)) is 0
	MossImage.RelativeError((2, 0), (1, 0)) is 1
	MossImage.RelativeError((3, 0), (2, 0)) is 0.5
	mutable difference = 0
	mutable size = 0
	for expected
		difference = difference + (values(index) - value) * (values(index) - value)
		size = size + value * value
	(difference / size).SquareRoot
