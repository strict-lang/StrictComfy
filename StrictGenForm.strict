constant Picture = "{\"mode\":\"image\",\"prompt\":\"a fox\",\"width\":480,\"height\":848,\"quality\":\"fastest\",\"steps\":0,\"skip\":\"off\",\"count\":1,\"seed\":-1,\"decoder\":\"taef2\"}"
constant Clip = "{\"mode\":\"extend\",\"prompt\":\"go on\",\"width\":640,\"height\":1152,\"quality\":\"fast\",\"steps\":0,\"skip\":\"5:45\",\"length\":24,\"context\":39,\"video\":\"in.mp4\",\"count\":1,\"seed\":7}"
Arguments(body Text) Texts
	StrictGenForm.Arguments(Picture) is ("--width", "480", "--height", "848", "--quality", "fastest", "--prompt", "StrictGenPrompt.txt", "--vae", "taef2.safetensors", "--skip", "off")
	StrictGenForm.Arguments(Clip) is ("--width", "640", "--height", "1152", "--quality", "fast", "--prompt", "StrictGenPrompt.txt", "--length", "24", "--context", "39", "--video", "in.mp4", "--skip", "5:45", "--seed", "7")
	let json = Json(body)
	let mode = json.get("mode") to Text
	let prompt = json.get("prompt") to Text
	File("StrictGenPrompt.txt").Write(prompt.Split("\n"))
	let sized = ("--width", json.get("width") to Text, "--height", json.get("height") to Text)
	let quality = json.get("quality") to Text
	let base = sized + (quality is "" then List(Text) else List(Text) + "--quality" + quality) + "--prompt" + "StrictGenPrompt.txt"
	base + Optional(json, mode) + Loras(json) + Remote(json)
Optional(json Json, mode Text) Texts
	StrictGenForm.Optional(Json(Picture), "image") is ("--vae", "taef2.safetensors", "--skip", "off")
	StrictGenForm.Optional(Json(Clip), "extend") is ("--length", "24", "--context", "39", "--video", "in.mp4", "--skip", "5:45")
	let video = (mode is "video") or (mode is "extend") or (mode is "imagevideo")
	let length = video then Pair("--length", json.get("length") to Text) else List(Text)
	let context = mode is "extend" then Pair("--context", json.get("context") to Text) else List(Text)
	let clip = mode is "extend" then Pair("--video", json.get("video") to Text) else List(Text)
	let image = mode is "imagevideo" then Pair("--image", json.get("image") to Text) else List(Text)
	let last = Pair("--last_image", json.get("lastImage") to Text)
	let steps = json.get("steps") to Text
	let counted = ((steps is "") or (steps is "0")) then List(Text) else Pair("--steps", steps)
	let decoder = mode is "image" then Pair("--vae", Decoder(json.get("decoder") to Text)) else Pair("--vae", json.get("vae") to Text)
	length + context + clip + image + last + counted + decoder + Pair("--audio_vae", json.get("audioVae") to Text) + Pair("--skip", json.get("skip") to Text)
Loras(json Json) Texts
	StrictGenForm.Loras(Json("{\"loras\":[{\"path\":\"a.safetensors\",\"strength\":0.5}]}")).Last is "a.safetensors:0.5"
	StrictGenForm.Loras(Json("{}")).Length is 0
	mutable words = List(Text)
	for json.get("loras").Elements
		let path = value.get("path") to Text
		if path is not ""
			words = words + "--lora" + (path + ":" + (value.get("strength") to Text))
	words
Remote(json Json) Texts
	StrictGenForm.Remote(Json("{\"remote\":\"any\"}")) is ("--remote", "any")
	StrictGenForm.Remote(Json("{\"remote\":\"\"}")).Length is 0
	StrictGenForm.Remote(Json("{}")).Length is 0
	let name = json.get("remote") to Text
	let flag = json.get("force") to Text is "true" then List(Text) + "--force" else List(Text)
	let local = json.get("local") to Text is "true" then List(Text) + "--local" else List(Text)
	(name is "" then List(Text) else List(Text) + "--remote" + name) + flag + local + More(json)
More(json Json) Texts
	StrictGenForm.More(Json("{\"seed\":7,\"guidance\":2.5,\"crop\":\"false\"}")) is ("--seed", "7", "--guidance", "2.5", "--crop=false")
	let seed = json.get("seed") to Text
	let guidance = json.get("guidance") to Text
	let count = json.get("count") to Text
	let seeded = ((seed is "") or (seed is "-1")) then "" else seed
	let guided = ((guidance is "") or (guidance is "0")) then "" else guidance
	let counted = ((count is "") or (count is "1")) then "" else count
	Pair("--seed", seeded) + Pair("--guidance", guided) + Pair("--count", counted) + Pair("--spectrum", json.get("spectrum") to Text) + Pair("--sampler", json.get("sampler") to Text) + Pair("--scheduler", json.get("scheduler") to Text) + Pair("--output", json.get("output") to Text) + Pair("--models", json.get("models") to Text) + Pair("--text_encoder", json.get("textEncoder") to Text) + Pair("--model", json.get("model") to Text) + Cropped(json) + Pair("--vision", Vision(json.get("vision") to Text))
Cropped(json Json) Texts
	StrictGenForm.Cropped(Json("{\"crop\":\"false\"}")) is ("--crop=false")
	StrictGenForm.Cropped(Json("{}")).Length is 0
	json.get("crop") to Text is "false" then List(Text) + "--crop=false" else List(Text)
Vision(text Text) Text
	StrictGenForm.Vision("768") is ""
	StrictGenForm.Vision("off") is "off"
	StrictGenForm.Vision("") is ""
	(text is "") or (text is "768") then "" else text
Decoder(name Text) Text
	StrictGenForm.Decoder("taef2") is "taef2.safetensors"
	StrictGenForm.Decoder("flux2-vae") is "flux2-vae.safetensors"
	StrictGenForm.Decoder("flux2-small-vae") is "full_encoder_small_decoder.safetensors"
	StrictGenForm.Decoder("custom.safetensors") is "custom.safetensors"
	if (name is "") or name.EndsWith(".safetensors")
		return name
	name is "flux2-small-vae" then "full_encoder_small_decoder.safetensors" else name + ".safetensors"
Pair(name Text, text Text) Texts
	StrictGenForm.Pair("--seed", "").Length is 0
	StrictGenForm.Pair("--seed", "7") is ("--seed", "7")
	text is "" then List(Text) else List(Text) + name + text
Selected(kind Text, arguments Texts) Text
	StrictGenForm.Selected("moss", List(Text)) is "image"
	StrictGenForm.Selected("h3", List(Text)) is "video"
	StrictGenForm.Selected("h3", ("--image", "a.png")) is "imagevideo"
	StrictGenForm.Selected("h3", ("--last_image", "b.png")) is "imagevideo"
	if kind is "moss"
		return "image"
	(("--image" is in arguments) or ("--last_image" is in arguments)) then "imagevideo" else "video"
Imported(path Text) Text
	StrictGenForm.Imported("tinymossworkflow.json").IndexOf("\"mode\":\"image\",") >= 0
	StrictGenForm.Imported("tinyh3strictworkflow.json").IndexOf("\"mode\":\"imagevideo\"") >= 0
	let text = Text.Combine(File(path).ReadLines, "\n")
	let h3 = (text.IndexOf("StrictH3") >= 0) or (text.IndexOf("MiniMax") >= 0) or (text.IndexOf("SamplerCustomAdvanced") >= 0)
	let arguments = h3 then H3Workflow(ComfyGraph.Read(path, H3Workflow.Known), ".").Arguments else MossWorkflow(ComfyGraph.Read(path, MossWorkflow.Known), ".").Arguments
	let mode = Selected(h3 then "h3" else "moss", arguments)
	Described(mode, arguments)
Described(mode Text, arguments Texts) Text
	StrictGenForm.Described("image", ("--width", "480", "--height", "848", "--seed", "7")).IndexOf("\"width\":480") >= 0
	let width = Taken(arguments, "--width")
	let height = Taken(arguments, "--height")
	let seed = Taken(arguments, "--seed")
	let quality = Taken(arguments, "--quality")
	let prompt = Taken(arguments, "--prompt")
	"{\"mode\":" + mode.Code + ",\"width\":" + (width is "" then "0" else width) + ",\"height\":" + (height is "" then "0" else height) + ",\"seed\":" + (seed is "" then "-1" else seed) + ",\"quality\":" + quality.Code + ",\"prompt\":" + prompt.Code + ",\"image\":" + Taken(arguments, "--image").Code + ",\"model\":" + Taken(arguments, "--model").Code + "}"
Taken(arguments Texts, name Text) Text
	StrictGenForm.Taken(("--width", "480", "--height", "848"), "--width") is "480"
	StrictGenForm.Taken(("--width", "480"), "--height") is ""
	let at = arguments.Index(name)
	(at < 0) or (at + 1 >= arguments.Length) then "" else arguments(at + 1)
Summary(body Text) Text
	StrictGenForm.Summary(Picture).StartsWith("Image a fox 480x848 fastest")
	StrictGenForm.Summary(Clip).StartsWith("Extend go on 640x1152 fast")
	let json = Json(body)
	let mode = json.get("mode") to Text
	let label = mode is "image" then "Image" else (mode is "video" then "Video" else (mode is "extend" then "Extend" else "Image to video"))
	let model = json.get("model") to Text
	label + " " + (json.get("prompt") to Text).Split("\n").First + " " + (json.get("width") to Text) + "x" + (json.get("height") to Text) + " " + (json.get("quality") to Text) + " " + (model is "" then "default" else Path(model).FileName.text)
Neighbor(paths Texts, current Text, step Number) Text
	StrictGenForm.Neighbor(("a.png", "b.png", "c.png"), "b.png", 1) is "c.png"
	StrictGenForm.Neighbor(("a.png", "b.png", "c.png"), "b.png", -1) is "a.png"
	StrictGenForm.Neighbor(("a.png", "b.png"), "a.png", -1) is "a.png"
	StrictGenForm.Neighbor(List(Text), "a.png", 1) is ""
	let files = paths.Sorted
	if files.Length is 0
		return ""
	let at = files.Index(current)
	let next = at < 0 then (step < 0 then files.Length - 1 else 0) else (at + step).Clamp(0, files.Length - 1)
	files(next)
Listed(folder Text, extensions Texts) Texts
	Text.Combine(StrictGenForm.Listed(".", List(Text) + "strict"), " ").IndexOf("StrictGenForm.strict") >= 0
	mutable files = List(Mutable(Text))
	for Directory.Files(folder)
		if extensions.Index(value.Lower.Split(".").Last) >= 0
			files.Add(value)
	files.Sorted
