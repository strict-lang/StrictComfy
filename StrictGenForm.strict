constant Picture = "{\"mode\":\"image\",\"prompt\":\"a fox\",\"width\":480,\"height\":848,\"quality\":\"fastest\",\"steps\":0,\"skip\":\"off\",\"count\":1,\"seed\":-1,\"decoder\":\"taef2\"}"
constant Clip = "{\"mode\":\"extend\",\"prompt\":\"go on\",\"width\":640,\"height\":1152,\"quality\":\"fast\",\"steps\":0,\"skip\":\"5:45\",\"length\":24,\"context\":39,\"video\":\"in.mp4\",\"count\":1,\"seed\":7}"
constant ExpectedPicture = ("--width", "480", "--height", "848", "--quality", "fastest", "--prompt", "StrictGenPrompt.txt", "--vae", "taef2.safetensors", "--skip", "off") + PictureOutput
constant ExpectedClip = ("--width", "640", "--height", "1152", "--quality", "fast", "--prompt", "StrictGenPrompt.txt", "--length", "24", "--context", "39", "--video", "in.mp4", "--skip", "5:45", "--seed", "7") + ClipOutput
constant PictureOutput = ("--output", "output/MossImage.jpg")
constant ClipOutput = ("--output", "output/H3Video.mp4")
constant Forced = "{\"force\":\"true\",\"local\":\"true\",\"seed\":7}"
Arguments(body Text) Texts slow
	StrictGenForm.Arguments(Picture) is ExpectedPicture
	StrictGenForm.Arguments(Clip) is ExpectedClip
	StrictGenForm.Arguments(StrictGenImage.Edit) is StrictGenImage.Expected
	json = Json(body)
	mode = json.get("mode") to Text
	prompt = json.get("prompt") to Text
	File("StrictGenPrompt.txt").Write(prompt.Split("\n"))
	sized = ("--width", json.get("width") to Text, "--height", json.get("height") to Text)
	if mode is "h3image"
		return sized + "--prompt" + "StrictGenPrompt.txt" + StrictGenImage.Arguments(json)
	base = sized + Pair("--quality", json.get("quality") to Text) + "--prompt" + "StrictGenPrompt.txt"
	base + Optional(json, mode) + Loras(json) + Remote(json) + StrictGenImage.Output(json, StrictGenImage.Default(mode))
Optional(json Json, mode Text) Texts slow
	StrictGenForm.Optional(Json(Picture), "image") is ("--vae", "taef2.safetensors", "--skip", "off")
	StrictGenForm.Optional(Json(Clip), "extend") is ExpectedClip.Slice(8, 8)
	video = mode is "video" or mode is "extend" or mode is "imagevideo"
	length = video then Pair("--length", json.get("length") to Text) + Switches(json) else List(Text)
	context = mode is "extend" then Pair("--context", json.get("context") to Text) else List(Text)
	clip = mode is "extend" then Pair("--video", json.get("video") to Text) else List(Text)
	still = StrictGenClip.Still(json.get("image") to Text, json.get("zoom") to Text)
	image = mode is "imagevideo" then Pair("--image", still) else List(Text)
	steps = json.get("steps") to Text
	counted = steps is "" or steps is "0" then List(Text) else Pair("--steps", steps)
	tail = Vae(json) + Pair("--audio_vae", json.get("audioVae") to Text) + Pair("--skip", json.get("skip") to Text)
	length + context + clip + image + counted + tail
Switches(json Json) Texts
	StrictGenForm.Switches(Json("{\"upscale\":true}")) is ("--upscale")
	StrictGenForm.Switches(Json("{\"upscale\":false,\"noTurbo\":true}")) is ("--no_turbo")
	StrictGenForm.Switches(Json("{}")).Length is 0
	upscale = json.get("upscale") to Text is "true" then List(Text) + "--upscale" else List(Text)
	upscale + (json.get("noTurbo") to Text is "true" then List(Text) + "--no_turbo" else List(Text))
Loras(json Json) Texts
	StrictGenForm.Loras(Json("{\"loras\":[{\"path\":\"a.safetensors\",\"strength\":0.5}]}")).Last is "a.safetensors:0.5"
	StrictGenForm.Loras(Json("{}")).Length is 0
	mutable words = List(Text)
	for json.get("loras").Elements
		path = value.get("path") to Text
		if path is not ""
			words = words + "--lora" + (path + ":" + value.get("strength") to Text)
	words
Remote(json Json) Texts
	StrictGenForm.Remote(Json("{\"remote\":\"any\"}")).Length is 0
	StrictGenForm.Remote(Json("{\"remote\":\"\"}")).Length is 0
	StrictGenForm.Remote(Json("{\"force\":\"true\"}")) is ("--force")
	StrictGenForm.Remote(Json("{\"local\":\"true\"}")) is ("--local")
	StrictGenForm.Remote(Json(Forced)) is ("--force", "--local", "--seed", "7")
	StrictGenImage.Flags(json) + More(json)
More(json Json) Texts
	StrictGenForm.More(Json("{\"seed\":7,\"guidance\":2.5}")) is ("--seed", "7", "--guidance", "2.5")
	guidance = json.get("guidance") to Text
	numbers = StrictGenImage.Read(json) + Pair("--guidance", guidance is "" or guidance is "0" then "" else guidance)
	sampling = Pair("--spectrum", json.get("spectrum") to Text) + Pair("--sampler", json.get("sampler") to Text)
	numbers + sampling + Pair("--scheduler", json.get("scheduler") to Text) + Files(json)
Files(json Json) Texts
	StrictGenForm.Files(Json("{\"output\":\"a.mp4\",\"crop\":\"false\"}")) is ("--crop=false")
	output = Pair("--models", json.get("models") to Text)
	models = Pair("--text_encoder", json.get("textEncoder") to Text) + Pair("--model", json.get("model") to Text)
	output + models + Crop(json) + Pair("--vision", Vision(json.get("vision") to Text))
Crop(json Json) Texts
	StrictGenForm.Crop(Json("{\"crop\":\"false\"}")) is ("--crop=false")
	StrictGenForm.Crop(Json("{}")).Length is 0
	json.get("crop") to Text is "false" then List(Text) + "--crop=false" else List(Text)
Vision(text Text) Text
	StrictGenForm.Vision("768") is ""
	StrictGenForm.Vision("off") is "off"
	StrictGenForm.Vision("") is ""
	text is "" or text is "768" then "" else text
Vae(json Json) Texts
	StrictGenForm.Vae(Json("{\"decoder\":\"taef2\"}")) is ("--vae", "taef2.safetensors")
	StrictGenForm.Vae(Json("{\"decoder\":\"flux2-small-vae\"}")) is ("--vae", "full_encoder_small_decoder.safetensors")
	StrictGenForm.Vae(Json("{\"vae\":\"v.safetensors\",\"decoder\":\"taef2\"}")) is ("--vae", "v.safetensors")
	StrictGenForm.Vae(Json("{\"decoder\":\"\"}")).Length is 0
	given = json.get("vae") to Text
	name = given is "" then json.get("decoder") to Text else given
	named = name is "" or name.EndsWith(".safetensors") then name else name + ".safetensors"
	Pair("--vae", named is "flux2-small-vae.safetensors" then "full_encoder_small_decoder.safetensors" else named)
Pair(name Text, text Text) Texts
	StrictGenForm.Pair("--seed", "").Length is 0
	StrictGenForm.Pair("--seed", "7") is ("--seed", "7")
	text is "" then List(Text) else List(Text) + name + text
Select(kind Text, arguments Texts) Text
	StrictGenForm.Select("moss", List(Text)) is "image"
	StrictGenForm.Select("h3", List(Text)) is "video"
	StrictGenForm.Select("h3", ("--image", "a.png")) is "imagevideo"
	StrictGenForm.Select("h3", ("--last_image", "b.png")) is "imagevideo"
	if kind is "moss"
		return "image"
	"--image" is in arguments or "--last_image" is in arguments then "imagevideo" else "video"
Import(path Text) Text slow
	StrictGenForm.Import("tinymossworkflow.json").IndexOf("\"mode\":\"image\",") >= 0
	StrictGenForm.Import("tinyh3strictworkflow.json").IndexOf("\"mode\":\"imagevideo\"") >= 0
	text = Text.Combine(File(path).ReadLines, "\n")
	isCustom = text.IndexOf("SamplerCustomAdvanced") >= 0
	h3 = text.IndexOf("StrictH3") >= 0 or text.IndexOf("MiniMax") >= 0 or isCustom
	moss = MossWorkflow(ComfyGraph.Read(path, MossWorkflow.Known), ".").Arguments
	arguments = h3 then H3Workflow(ComfyGraph.Read(path, H3Workflow.Known), ".").Arguments else moss
	Describe(Select(h3 then "h3" else "moss", arguments), arguments)
Describe(mode Text, arguments Texts) Text
	StrictGenForm.Describe("image", ("--width", "480", "--height", "848", "--seed", "7")).IndexOf("\"width\":480") >= 0
	width = Take(arguments, "--width")
	height = Take(arguments, "--height")
	seed = Take(arguments, "--seed")
	size = (width is "" then "0" else width) + ",\"height\":" + (height is "" then "0" else height)
	head = "{\"mode\":" + mode.Code + ",\"width\":" + size + ",\"seed\":" + (seed is "" then "-1" else seed)
	body = ",\"quality\":" + Take(arguments, "--quality").Code + ",\"prompt\":" + Take(arguments, "--prompt").Code
	head + body + ",\"image\":" + Take(arguments, "--image").Code + ",\"model\":" + Take(arguments, "--model").Code + "}"
Take(arguments Texts, name Text) Text
	StrictGenForm.Take(("--width", "480", "--height", "848"), "--width") is "480"
	StrictGenForm.Take(("--width", "480"), "--height") is ""
	at = arguments.Index(name)
	at < 0 or at + 1 >= arguments.Length then "" else arguments(at + 1)
Neighbor(paths Texts, current Text, step Number) Text
	StrictGenForm.Neighbor(("a.png", "b.png", "c.png"), "b.png", 1) is "c.png"
	StrictGenForm.Neighbor(("a.png", "b.png", "c.png"), "b.png", -1) is "a.png"
	StrictGenForm.Neighbor(("a.png", "b.png"), "a.png", -1) is "a.png"
	StrictGenForm.Neighbor(List(Text), "a.png", 1) is ""
	files = paths.Sorted
	if files.Length is 0
		return ""
	at = files.Index(current)
	files(at < 0 then (step < 0 then files.Length - 1 else 0) else (at + step).Clamp(0, files.Length - 1))
FindFiles(folder Text, extensions Texts) Texts slow
	Text.Combine(StrictGenForm.FindFiles(".", List(Text) + "strict"), " ").IndexOf("StrictGenForm.strict") >= 0
	mutable files = List(Mutable(Text))
	for Directory.Files(folder)
		if extensions.Index(value.Lower.Split(".").Last) >= 0
			files.Add(value)
	files.Sorted
Step(path Text, step Number) Text slow
	StrictGenForm.Step("", 1) is ""
	if path is ""
		return ""
	folder = Path(path).PathOnly.text
	extension = path.Lower.Split(".").Last
	Neighbor(FindFiles(folder is "" then "." else folder, List(Text) + extension), path, step)
