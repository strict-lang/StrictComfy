has logger
has width Number = 45
has steps Number = 8
has guidance Number = 1
has mode Text = "off"
has warmup Number = 8
has period Number = 2
has span MossSpan = MossSpan.Off
has preview = ""
has previewer = Taef2Decoder.None
has finale = false
constant Presets = ((8, 1, 0, 2), (25, 2, 0, 2), (50, 2, 0, 2), (8, 1, 3, 3), (8, 1, 2, 3), (4, 1, 2, 2), (2, 1, 0, 2))
constant Spanned = MossSpectrum(MossSpectrum.Tiny, span = MossSpan(MossSpan(6, 36), reused = 2))
constant Forecasting = MossSpectrum(MossSpectrum.Tiny, forecasts = 3)
constant Shown = 1
constant Forecaster = MossSampling(Logger, mode = "on")
Guided(positive Numbers, negative Numbers) Numbers
	MossSampling(Logger, guidance = 3).Guided((2, 4), (1, 2)) is (4, 8)
	MossSampling(Logger).Guided((2, 4), List(Number)) is (2, 4)
	if guidance is 1
		return positive
	for positive.Length
		negative(index) + guidance * (positive(index) - negative(index))
Sampled(moss Moss, noise Numbers, context Numbers, label Text) Numbers slow
	let count = context.Length / moss.textProjection.weights.First.Length
	let text = moss.TextEmbedded(context, count)
	let negative = guidance is 1 then text else moss.TextEmbedded(context * 0, count)
	Looped(moss, noise, text, negative, moss.Rotation(noise, text, width), Euler(steps, 5).Sigmas, label)
Looped(moss Moss, noise Numbers, text Numbers, negative Numbers, rotation Numbers, sigmas Numbers, label Text) Numbers slow
	let started = Process.Elapsed
	mutable previous = started
	mutable positive = State
	mutable unconditional = State
	mutable latent = noise
	for steps
		positive = positive.Advanced(moss, latent, sigmas(index), text, rotation, index)
		unconditional = Unconditioned(unconditional, moss, latent, sigmas(index), negative, rotation, index)
		latent = Euler(steps, 5).Stepped(latent, Guided(positive.output, unconditional.output), sigmas, index)
		previous = Progressed(index, started, previous, latent, positive.output, sigmas(index + 1))
	logger.Log(Summary(label, previous - started, positive))
	latent
Progressed(step Number, started Number, previous Number, latent Numbers, output Numbers, sigma Number) Number slow
	GpuMemory.Finished
	let now = Process.Elapsed
	logger.Log(Progress(step, now - previous, (now - started) / (step + 1)))
	if (preview is "") or (Previewing(step, now - previous) is false)
		return now
	let pixels = previewer.Previewed(Denoised(latent, output, sigma), width)
	let part = preview + ".part"
	ImageCodec.SaveJpeg(part, pixels, previewer.Shrunk(2 * width) * 8, MossBatch.JpegQuality)
	if File(preview).Exists
		File(preview).Delete
	File(part).Rename(preview)
	Process.Elapsed
Previewing(step Number, took = Shown) Boolean
	MossSampling(Logger).Previewing(0, 0.1) and MossSampling(Logger).Previewing(4, 0.1)
	(MossSampling(Logger).Previewing(1, 0.1) is false) and (MossSampling(Logger).Previewing(5, 0.1) is false)
	MossSampling(Logger).Previewing(6, 0.1) and MossSampling(Logger, finale = true).Previewing(7, 0.1)
	MossSampling(Logger).Previewing(1) and MossSampling(Logger).Previewing(6, 2)
	(MossSampling(Logger).Previewing(7) is false) and (MossSampling(Logger).Previewing(7, 0.1) is false)
	MossSampling(Logger, steps = 4).Previewing(2, 0.1) and (MossSampling(Logger, steps = 4).Previewing(3, 0.1) is false)
	MossSampling(Logger, steps = 2).Previewing(0, 0.1) and (MossSampling(Logger, steps = 2).Previewing(1, 0.1) is false)
	let early = (took >= Shown) or (step is 0) or (step is (steps / 2).Floor) or (step is steps - 2)
	step >= steps - 1 then finale else early
Progress(step Number, last Number, average Number) Text
	MossSampling(Logger).Progress(2, 0.1514, 0.1496) is "Step 3/8 in 151 ms, average 150 ms"
	"Step " + (step + 1) + "/" + steps + " in " + (last * 1000).Round + " ms, average " + (average * 1000).Round + " ms"
Summary(label Text, seconds Number, state MossSpectrum) Text
	MossSampling(Logger).Summary("Image 1/3 M1.jpg", 2.9774, MossSpectrum.Tiny) is "Image 1/3 M1.jpg sampled in 2977 ms"
	MossSampling(Logger).Summary("A", 1, Forecasting) is "A sampled in 1000 ms, 3 of 8 steps forecast"
	MossSampling(Logger).Summary("A", 1, Spanned) is "A sampled in 1000 ms, layers 6-36 reused in 2 steps"
	let forecast = state.forecasts > 0 then ", " + state.forecasts + " of " + steps + " steps forecast" else ""
	let layers = ", layers " + state.span.first + "-" + state.span.last + " reused in " + state.span.reused + " steps"
	label + " sampled in " + (seconds * 1000).Round + " ms" + forecast + (state.span.reused > 0 then layers else "")
Unconditioned(state MossSpectrum, moss Moss, latent Numbers, sigma Number, text Numbers, rotation Numbers, step Number) MossSpectrum
	guidance is 1 then state else state.Advanced(moss, latent, sigma, text, rotation, step)
State MossSpectrum
	MossSampling(Logger, warmup = 3).State.history.fit.degree is 2
	MossSampling(Logger, warmup = 2).State.history.fit.degree is 1
	MossSampling(Logger, warmup = 8).State.history.fit.degree is 4
	let configured = MossSpectrumImage(logger).Configured(width, mode, steps, warmup, period, (warmup - 1).Clamp(1, 4))
	MossSpectrum(configured, span = span)
Denoised(latent Numbers, output Numbers, sigma Number) Float32s
	MossSampling(Logger).Denoised((1, 2), (2, 2), 0.5) is (0, 1)
	for latent
		value - sigma * output(index)
