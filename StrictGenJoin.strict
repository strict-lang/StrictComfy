constant Sample = StrictGenJoin
constant Size = (832, 480)
constant Codec = " -c:v libx264 -crf 18 -preset faster -pix_fmt yuv420p -c:a aac -b:a 192k \""
constant Sound = "aresample=32000,aformat=sample_fmts=fltp:channel_layouts=stereo"
constant Quiet = " -f lavfi -i anullsrc=r=32000:cl=stereo"
constant Mapped = "\" -map \"[v]\" -map \"[a]\""
constant AudioStreams = "-v error -select_streams a -show_entries stream=index -of csv=p=0 \""
constant VideoSeconds = "-v error -select_streams v:0 -show_entries stream=duration -of csv=p=0 \""
constant Stamped = ",settb=AVTB,setpts=PTS-STARTPTS"
constant Overlap = 8
constant Faded = "[v1];[v0][v1]xfade=transition=fade:duration="
Fitted(size Numbers) Text
	Sample.Fitted(Size) is "fps=24,scale=480:832:force_original_aspect_ratio=increase,crop=480:832,setsar=1"
	box = size(1) + ":" + size(0)
	"fps=" + H3Format.FramesPerSecond + ",scale=" + box + ":force_original_aspect_ratio=increase,crop=" + box + ",setsar=1"
Extract(path Text, output Text, size Numbers, seconds Number) Text
	Sample.Extract("a.mp4", "a.rgb", Size, 2).StartsWith("-y -loglevel error -sseof -2 -i \"a.mp4\" -vf fps=24,")
	Sample.Extract("a.mp4", "a.rgb", Size, 2).EndsWith("-f rawvideo -pix_fmt rgb24 \"a.rgb\"")
	raw = " -f rawvideo -pix_fmt rgb24 \"" + output + "\""
	"-y -loglevel error -sseof -" + seconds + " -i \"" + path + "\" -vf " + Fitted(size) + raw
ExtractAudio(path Text, output Text, seconds Number) Text
	Sample.ExtractAudio("a.mp4", "a.pcm", 2).IndexOf("-ar 32000") > 0
	Sample.ExtractAudio("a.mp4", "a.pcm", 2).EndsWith("\"a.pcm\"")
	format = " -t " + seconds + " -ac 2 -ar " + H3Frames.SampleRate + " -f s16le \"" + output + "\""
	"-y -loglevel error -sseof -" + seconds + " -i \"" + path + "\"" + format
Concat(source Text, tail Text, output Text, size Numbers, heard Boolean) Text slow
	Sample.Concat("a.mp4", "b.mp4", "c.mp4", Size, true).StartsWith("-y -loglevel error -i \"a.mp4\" -i \"b.mp4\" -filter")
	Sample.Concat("a.mp4", "b.mp4", "c.mp4", Size, false).IndexOf(Quiet) > 0
	Sample.Concat("a.mp4", "b.mp4", "c.mp4", Size, true).EndsWith("\"c.mp4\"")
	inputs = "-y -loglevel error -i \"" + source + "\" -i \"" + tail + "\"" + (heard then "" else Quiet)
	inputs + " -filter_complex \"" + Filter(size, Lasting(source), heard) + Mapped + Codec + output + "\""
Filter(size Numbers, seconds Number, heard Boolean) Text
	Sample.Filter(Size, 3, true).StartsWith("[0:v]fps=24,")
	Sample.Filter(Size, 3, true).IndexOf("xfade=transition=fade:duration=0.333:offset=2.667[v]") > 0
	Sample.Filter(Size, 3, false).IndexOf("[2:a]atrim=duration=3,") > 0
	Sample.Filter(Size, 3, true).EndsWith("acrossfade=d=0.333[a]")
	fade = (Overlap / H3Format.FramesPerSecond).Round(3)
	video = "[0:v]" + Fitted(size) + Stamped + "[v0];[1:v]setsar=1" + Stamped + Faded
	first = (heard then "[0:a]" else "[2:a]") + "atrim=duration=" + seconds + ",apad=whole_dur=" + seconds + ","
	audio = first + Sound + ",asetpts=PTS-STARTPTS[a0];[1:a]" + Sound + ",asetpts=PTS-STARTPTS[a1];"
	video + fade + ":offset=" + (seconds - fade).Round(3) + "[v];" + audio + "[a0][a1]acrossfade=d=" + fade + "[a]"
Heard(path Text) Boolean slow
	Sample.Heard("missing-clip.mp4") is false
	streams = Process.RunTool("ffprobe", AudioStreams + path + "\"")
	if streams.Failed or streams.Output.Trim is ""
		logger.Log(path + " has no audio, the extended video starts with silence")
		return false
	true
Lasting(path Text) Number slow
	Sample.Lasting("missing-clip.mp4") is 0
	video = Process.RunTool("ffprobe", VideoSeconds + path + "\"")
	seconds = video.Failed then "" else video.Output.Trim
	seconds is "" then 0 else seconds to Number
