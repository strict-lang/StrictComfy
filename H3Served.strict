has batch H3Batch
Completed(kept H3Resident) H3Resident slow
	let options = batch.options
	let problem = H3Inputs(options).Problem
	if problem is not ""
		batch.logger.Log(problem)
		return H3Resident(kept, code = 2)
	let started = Process.Elapsed
	let plan = kept.plans.Length is 1 then kept.plans.First else batch.Planned
	let made = Videos(Contexted(kept, plan).Sampling(options.Checkpoint, options.Loras), plan)
	batch.logger.Log("Total " + (Process.Elapsed - started).Round(2) + " s for " + plan.seeds.Length + " videos")
	H3Resident(made, plans = List(H3Plan))
Videos(sampling H3Resident, plan H3Plan) H3Resident slow
	let options = batch.options
	let latents = H3Artifacts(options).Latents(plan.seeds.Length, "")
	let conditions = H3Artifacts(options).Read(plan.paths)
	let vaes = (options.files.Decoder, options.files.Sound)
	if sampling.decodings.Length is 0
		batch.Prefetched(vaes, "the VAEs")
	plan.batch.Sampled(sampling.samplers.First, sampling.refiners.First, plan, conditions, latents, true)
	options.files.Freed
	let decoding = sampling.Decoding(vaes)
	batch.DecodedWith(decoding.decodings.First, latents, plan.images)
	H3Resident(decoding, code = 0)
Contexted(kept H3Resident, plan H3Plan) H3Resident slow
	let missing = H3Artifacts(batch.options).Missing(plan.paths)
	if missing.Length is 0
		batch.logger.Log("Using cached prompt conditioning")
		return kept
	Reading(kept)
	let encoding = kept.Encoding(batch.options.files).Tokenizing(batch.options.files)
	if Encoded(encoding, plan, missing) is not missing.Length
		batch.logger.Log("The text encoder made fewer contexts than the " + missing.Length + " prompts it was given")
	if kept.isCrowded or batch.options.IsLarge
		GpuMemory.Evicted
	batch.options.files.Freed
	kept.isCrowded then H3Resident(encoding, encoders = List(Qwen3), encoderFile = "") else encoding
Reading(kept H3Resident) slow
	if kept.IsSampling(batch.options.Checkpoint, batch.options.Loras) is false
		batch.Prefetched(List(Text) + batch.options.Checkpoint + batch.LoraFiles, "H3 and its LoRAs")
Encoded(encoding H3Resident, plan H3Plan, missing Numbers) Number slow
	let options = batch.options
	Directory.Create(H3Artifacts(options).Root + "/artifacts")
	Directory.Create(H3Artifacts(options).Folder)
	let inputs = H3Inputs(options)
	let encoder = H3Encoder(batch.logger, options.files, (options.height, options.width), List(QwenVision), List(Text))
	let prompts = inputs.Picked(plan.prompts, missing)
	let images = inputs.Picked(plan.images, missing)
	let paths = inputs.Picked(plan.paths, missing)
	encoder.EncodedWith(encoding.encoders.First, encoding.tokenizers.First, prompts, images, paths)
