has logger
has backend Backend
constant MinimumRam = 17179869184
constant MinimumVram = 8589934592
constant Sample = MossServer(Logger, Backend(Logger, Resident("artifacts/mosstest"), "MossImage", Backend.Nowhere))
Root Text
	MossServer.Root.EndsWith("/artifacts/moss")
	Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text + "/artifacts/moss"
Backended(logging Logger) Backend
	MossServer.Backended(Logger).name is "MossImage"
	Backend(logging, Resident(Root), "MossImage")
Ran(given Texts) Number
	if given is (Backend.Serving)
		return Served
	let arguments = given - MachineUse.Force
	let plain = Remote(logger).Without(arguments)
	let rest = plain - Backend.Local
	if MachineUse.IsChecked(arguments, backend.resident.root)
		if Granted(arguments, MachineUse.IsForced(given)) is not 0
			return 1
	let forwarded = backend.Dispatched(plain)
	forwarded >= 0 then forwarded else Local(rest).code
Local(arguments Texts) Slow(MossResident)
	MossServed(MossBatch(logger, MossOptions.Parsed(arguments)).Expanded(arguments)).Completed(MossResident(logger))
Served Number
	let server = backend.Opened
	if server is 0
		return 1
	let built = File(Process.Current.executable).Modified
	mutable kept = MossResident(logger, true)
	mutable last = Process.Elapsed
	for as long as (kept.code is not Backend.Stopped) and backend.IsWanted(Process.Elapsed - last, built)
		let socket = backend.resident.Accepted(server, built, Resident.WakeSeconds)
		kept = socket > 0 then Replied(socket, kept) else kept
		last = socket > 0 then Process.Elapsed else last
		kept = backend.Unpressed then kept else MossResident(kept, code = Backend.Stopped)
	backend.resident.Closed(server)
Replied(socket Number, kept MossResident) Slow(MossResident)
	let resident = backend.resident
	let request = resident.Requested(socket)
	let isStopping = resident.Arguments(request) is (Resident.Stopping)
	let isRunning = resident.IsCurrent(request) and (isStopping is false)
	let skipped = MossResident(kept, code = isStopping then Backend.Stopped else -1)
	let served = isRunning then Ran(socket, request, kept) else skipped
	let isFailed = served is Error
	if isFailed
		GpuMemory.Evicted
	let closed = Ended(socket, isFailed then 1 else (served.code is Backend.Stopped then 0 else served.code), request)
	(isFailed or closed) then MossResident(logger, true) else served
Ran(socket Number, request Text, kept MossResident) Slow(MossResident)
	let home = Directory.Current
	let folder = backend.resident.Folder(request)
	Directory.Change(folder)
	let isMoved = folder is not home
	Socket.Output(socket)
	let arguments = backend.resident.Arguments(request)
	let served = MossServed(MossBatch(logger, MossOptions.Parsed(arguments)).Expanded(arguments)).Completed(kept)
	if served is Error
		logger.Log(served to Text + "\nThe run failed, the next one loads the models again")
	let unpressed = backend.Unpressed
	backend.Restored(isMoved, home)
	unpressed then served else MossResident(kept, code = Backend.Stopped)
Asked(arguments Texts, forced Boolean) Text
	Sample.Asked(List(Text), false).StartsWith("need\tMossImage\t")
	let use = Use(arguments, forced)
	let mode = forced then "force" else "wait"
	"need\tMossImage\tMossImage\t" + MinimumRam + "\t" + use.ram + "\t" + MinimumVram + "\t" + use.vram + "\t0\t" + mode
Granted(arguments Texts, forced Boolean) Slow(Number)
	Sample.Granted(List(Text), false) >= 0
	let named = Remote(logger).Named(arguments)
	named >= 0 then named else Continued(arguments, forced)
Continued(arguments Texts, forced Boolean) Slow(Number)
	Sample.Continued(List(Text), false) >= 0
	let line = Asked(arguments, forced)
	if line is ""
		return 0
	let reply = Coordinator(logger, backend.coordinator).Sent(line)
	let sent = Remote(logger).Sent(arguments, "", reply, line)
	if sent >= 0
		return sent
	let settled = reply.StartsWith("wait") then Coordinator(logger, backend.coordinator).Resolved(line) else reply
	if settled.StartsWith("refused")
		return Use(arguments, forced).Explained(settled)
	settled is "" then Use(arguments, forced).Checked else 0
Ended(socket Number, code Number, request Text) Slow(Boolean)
	Sample.Ended(0, 1, "broken")
	if backend.resident.Finished(socket, code) is Error
		logger.Log("The MossImage client left before the result was sent")
		return backend.Freed(request)
	backend.Freed(request, false)
Use(arguments Texts, forced Boolean) MachineUse
	Sample.Use(List(Text), true).isForced
	Sample.Use(("--local", "--remote", "AiServer"), false).isForced is false
	let files = MossOptions.Parsed(Remote(logger).Without(arguments) - Backend.Local).files
	let bytes = (File(files.Checkpoint).Length, File(files.Encoder).Length)
	MachineUse.Models(logger, "MossImage", bytes(0), bytes(1), H3Resident.EncoderGrowth, forced)
