has logger
has options H3Options
constant Named = "RtxVideo.py"
constant Tag = " upscaled with RTX Video Super Resolution"
constant Port = 18019
constant PollSeconds = 0.1
constant StartSeconds = 30
constant LongestSeconds = 900
constant Starting = "-NoProfile -Command Start-Process -FilePath '"
constant Quote = "\\\""
constant Tiny = RtxVideo(Logger, H3Options.Parsed(("--models", ".")))
constant Pythons = ("/../python_embeded/python.exe", "/venv/Scripts/python.exe", "/.venv/Scripts/python.exe", "/venv/bin/python", "/.venv/bin/python")
constant Packages = ("/../python_embeded/Lib/site-packages/nvvfx", "/venv/Lib/site-packages/nvvfx", "/.venv/Lib/site-packages/nvvfx", "/venv/lib", "/.venv/lib")
constant Missing = "RTX Video Super Resolution needs nvidia-vfx in ComfyUI's Python (ComfyUI_Nvidia_VFX_Nodes installs it), the video keeps its size"
Python Text slow
	Tiny.Python is ""
	let folder = ModelFiles(options.files.models).Folder
	if folder is Error
		return ""
	for Pythons
		if File(folder + "/.." + value).Exists and Directory.Exists(folder + "/.." + Packages(index))
			return folder + "/.." + value
	""
Script Text slow
	Tiny.Script.EndsWith(Named)
	let root = H3Artifacts(options).Root
	let folder = ModelFiles(options.files.models).Folder
	let installed = folder is Error then root + "/" + Named else folder + "/../custom_nodes/StrictComfy/" + Named
	for (root + "/" + Named, root + "/../../" + Named, installed)
		if File(value).Exists
			return value
	installed
IsAvailable Boolean slow
	Tiny.IsAvailable is false
	Python is not "" and File(Script).Exists
Stamp Text
	Tiny.Stamp.EndsWith("/artifacts/h3/rtxvideo.running")
	H3Artifacts(options).Folder + "/rtxvideo.running"
Warmed slow
	if IsAvailable is false or File(Stamp).Exists
		return
	let isWindows = Process.OperatingSystem is "Windows"
	let started = Process.RunTool(isWindows then "powershell" else "sh", Detached(Python, Script, isWindows))
	if started.Failed
		logger.Log("Could not start " + Python + " for RTX Video Super Resolution: " + started.error.Trim)
Detached(python Text, script Text, isWindows Boolean) Text
	Tiny.Detached("p.exe", "r.py", true).EndsWith(" \\\"" + Tiny.Stamp + "\\\"' -WindowStyle Hidden")
	Tiny.Detached("p", "r.py", false).StartsWith("-c \"nohup 'p' -I 'r.py' --serve 18019 ")
	let served = " --serve " + Port + " " + Process.Id + " "
	let quoted = Quote + script + Quote + served + Quote + Stamp + Quote
	let hidden = Starting + python + "' -ArgumentList '-I " + quoted + "' -WindowStyle Hidden"
	let shell = "' -I '" + script + "'" + served + "'" + Stamp + "' >/dev/null 2>&1 &\""
	isWindows then hidden else "-c \"nohup '" + python + shell
Ended slow
	if File(Stamp).Exists is false
		return
	if StrictGenRemote.Posted("127.0.0.1", Port, "/quit", "") is ""
		File(Stamp).Delete
Upscaled(path Text, isLast Boolean) slow
	if IsAvailable is false
		logger.Log(Missing)
		return
	logger.Log("Upscaling " + path + " 2x with RTX Video Super Resolution")
	let full = Absolute(path)
	let queued = Queued(full, File(Stamp).Exists)
	let answer = queued is "queued" then Polled("/result", full, "busy", LongestSeconds) else queued
	logger.Log(answer.StartsWith("RTX") then answer else Failed(answer))
	if isLast
		Ended
Queued(path Text, isRunning Boolean) Text slow
	Warmed
	let answer = Polled("/upscale", path, "", isRunning then PollSeconds else StartSeconds)
	if answer is not "" or isRunning is false
		return answer
	File(Stamp).Delete
	Queued(path, false)
Polled(route Text, path Text, pending Text, seconds Number) Text slow
	Tiny.Polled("/result", "a.mp4", "", 0) is ""
	mutable answer = pending
	mutable waited = 0
	for as long as answer is pending and waited < seconds
		answer = StrictGenRemote.Posted("127.0.0.1", Port, route, path)
		if answer is pending
			Process.Wait(PollSeconds)
		waited = waited + PollSeconds
	answer
Absolute(path Text) Text
	Tiny.Absolute("C:/a.mp4") is "C:/a.mp4"
	Tiny.Absolute("/a.mp4") is "/a.mp4"
	Tiny.Absolute("a.mp4").EndsWith("/a.mp4")
	path.StartsWith("/") or path.IndexOf(":") is 1 then path else Directory.Current.Replace("\\", "/") + "/" + path
Failed(error Text) Text
	Tiny.Failed("FutureWarning: pynvml\nneeds an RTX card\n").EndsWith(" keeps its size: needs an RTX card")
	let reason = error.Trim is "" then "the helper did not answer" else error.Trim.Lines.Last
	"RTX Video Super Resolution failed, the video keeps its size: " + reason
Sized(probed Text) Text
	Tiny.Sized("480,832") is "480 832"
	Tiny.Sized("960,1664\n480x832" + Tag) is "480 832"
	Tiny.Sized("960,1664\n200x832" + Tag) is "960 1664"
	Tiny.Sized("") is ""
	if probed is ""
		return ""
	let lines = probed.Lines
	let pixels = lines.First.Split(",")
	let tagged = lines.Last.EndsWith(Tag) then lines.Last.Split(" ").First.Split("x") else pixels
	let isDoubled = tagged.Length is 2 and pixels.Length is 2 and tagged(0) to Number * 2 is pixels(0) to Number
	Snapped(isDoubled then tagged else pixels)
Snapped(parts Texts) Text
	Tiny.Snapped(("33", "64")) is "32 64"
	Tiny.Snapped(List(Text) + "") is ""
	if parts.Length < 2
		return ""
	ComfySize.Plain.Snap(parts(0).Trim to Number, 32) + " " + ComfySize.Plain.Snap(parts(1).Trim to Number, 32)
