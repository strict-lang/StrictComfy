has file Safetensors
has video Numbers = List(Number)
has audio Numbers = List(Number)
has shape Numbers = List(Number)
has seed = -1
has rows Numbers = List(Number)
has keyframes Numbers = List(Number)
has pinnedVideo Numbers = List(Number)
has pinnedAudio Numbers = List(Number)
has pinFrames = 0
has pinAudio = 0
has pinTemporal = 0
has pinSpan = 0
has pinPlane = 0
constant Reference = H3Job(Safetensors("tinyh3.safetensors", 32, "reference."))
constant Noisy = H3Job(Safetensors(""), Layer.Zeros(32), Layer.Zeros(64), (2, 4, 2, 2), 3)
constant Keyframe = Safetensors("tinyh3.safetensors", 32, "reference.i2v.")
constant Latent = Keyframe.Values("keyframe")
constant Patchified = Keyframe.Values("rows")
constant Twice = (Latent, Latent)
constant Patches = Noisy.Patched(Latent, Keyframe.Shape("keyframe"), MersenneTwister.Seeded(0).Normals(384))
constant Dumped = H3Job(Safetensors("h3job.safetensors"))
Video Numbers
	Reference.Video.Length is 768
	Noisy.Video.Length is 32
	video.Length > 0 then video else file.Values(Stream("video"))
Audio Numbers
	Reference.Audio.Length is 192
	Noisy.Audio.Length is 64
	video.Length > 0 then audio else file.Values(Stream("audio"))
VideoShape Numbers
	Reference.VideoShape is (24, 2, 4, 4)
	Noisy.VideoShape is (2, 4, 2, 2)
	video.Length > 0 then shape else file.Shape(Stream("video"))
AudioShape Numbers
	Reference.AudioShape is (32, 2, 3)
	Noisy.AudioShape is (32, 2, 1)
	video.Length > 0 then (32, 2, audio.Length / 64) else file.Shape(Stream("audio"))
Stream(name Text) Text
	Reference.Stream("audio") is "audio"
	Reference.Stream("blocks") is "blocks.0"
	file.Entry(name + ".0") is "" then name else name + ".0"
Count Number
	Reference.Count is 1
	Noisy.Count is 1
	Safetensors("h3job.safetensors").Written(("sigmas", "video.noise.2"), ((1, 0.6, 0.3, 0), (0.5, -1.5))) is not Error
	Dumped.Count is 3
	video.Length > 0 then 1 else file.Entry("sigmas") is "" then 1 else file.Values("sigmas").Length - 1
Noise(stream Text, step Number) Numbers
	Reference.Noise("video", 0) is List(Number)
	Noisy.Noise("audio", 1).Length is 64
	H3Job(Noisy, seed = -1).Noise("video", 0) is List(Number)
	Dumped.Noise("video", 2) is (0.5, -1.5)
	if video.Length > 0
		return seed < 0 then List(Number) else Drawn(stream, step)
	let name = stream + ".noise." + step
	file.Entry(name) is "" then List(Number) else file.Values(name)
Drawn(stream Text, step Number) Numbers
	Noisy.Drawn("video", 0).Length is 32
	Noisy.Drawn("video", 0) is not Noisy.Drawn("video", 1)
	Noisy.Drawn("video", 1) is not Noisy.Drawn("audio", 0)
	Noisy.Drawn("video", 2) is MersenneTwister.Seeded(8).Normals(32)
	Noisy.Drawn("audio", 1) is MersenneTwister.Seeded(7).Normals(64)
	let count = stream is "video" then video.Length else audio.Length
	MersenneTwister.Seeded((seed + 2 * step + (stream is "video" then 1 else 2)) % PromptBatch.SeedRange).Normals(count)
Preview(step Number) Text
	Reference.Preview(0) is ""
	Noisy.Preview(0) is ""
	H3Job(Safetensors("h3preview.safetensors")).Preview(6) is "h3preview-step6.safetensors"
	if video.Length > 0
		return ""
	file.Entry("preview") is "" then "" else file.path.Replace(".safetensors", "-step" + step + ".safetensors")
Patched(latent Numbers, size Numbers, noise Numbers) Numbers
	Reference.Patched((0, 1, 2, 3, 4, 5, 6, 7), (1, 1, 2, 4), Layer.Zeros(8))(4).IsNearlyEqual(1.998)
	Patches(0).IsNearlyEqual(Patchified(0), 0.0001) and Patches(383).IsNearlyEqual(Patchified(383), 0.0001)
	Reference.Patched(Latent, (12, 2, 4, 4), Layer.Zeros(384))(200).IsNearlyEqual(0.999 * Latent(80))
	let columns = 4 * size(0)
	let half = size(3) / 2
	for latent.Length
		let row = (index / columns).Floor
		let column = index % columns
		let y = 2 * ((row / half).Floor % (size(2) / 2)) + (column % 4 / 2).Floor
		let x = 2 * (row % half) + column % 2
		let plane = ((column / 4).Floor * size(1) + (row / (size(2) / 2 * half)).Floor) * size(2)
		H3Layout.Pinned * latent((plane + y) * size(3) + x) + (1 - H3Layout.Pinned) * noise(index)
Rows(condition Safetensors) Numbers
	H3Job(Noisy, rows = (1, 2)).Rows(Keyframe) is (1, 2)
	Noisy.Rows(Keyframe).Length is 384
	Noisy.Rows(Reference.file) is List(Number)
	rows.Length > 0 then rows else condition.Entry("rows") is "" then List(Number) else condition.Values("rows")
Keyframes(given Numbers) Numbers
	H3Job(Noisy, keyframes = (0, 123)).Keyframes(List(Number) + 5) is (0, 123)
	Noisy.Keyframes(List(Number) + 5) is (5)
	keyframes.Length > 0 then keyframes else given
HeldVideo(latent Numbers, sigma Number) Numbers
	H3Job(Noisy, pinFrames = 0).HeldVideo((1, 2), 0.5) is (1, 2)
	pinFrames is 0 then latent else StrictGenExtend(Logger).Mixed(latent, pinnedVideo, video, pinTemporal, pinFrames, pinPlane, sigma)
HeldAudio(latent Numbers, sigma Number) Numbers
	H3Job(Noisy, pinAudio = 0).HeldAudio((3, 4), 0.5) is (3, 4)
	pinAudio is 0 then latent else StrictGenExtend(Logger).Mixed(latent, pinnedAudio, audio, pinSpan, pinAudio, 1, sigma)
Keyed(latents List(Numbers), size Numbers, base Number) Slow(Numbers)
	Reference.Keyed(List(Numbers) + Keyframe.Values("keyframe"), Keyframe.Shape("keyframe"), 0)(5) is Patches(5)
	Reference.Keyed(Twice, Keyframe.Shape("keyframe"), 0)(389) is Patches(5)
	mutable joined = List(Number)
	for latents
		joined = joined + Patched(value, size, MersenneTwister.Seeded(base).Normals(value.Length))
	joined
