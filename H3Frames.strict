has logger
constant Encoding = " -c:v libx264 -crf 18 -preset medium -pix_fmt yuv420p -c:a aac -b:a 192k -shortest "
Run(dumps Text, video Text, audio Text)
	let steps = Safetensors(dumps + "/steps.safetensors", 32)
	let started = Process.Elapsed
	let vae = H3Vae(H3Decoder.Loaded(Safetensors(video, 32)), H3Vae.Real.tile, H3Vae.Real.overlap)
	let sound = H3Audio.Loaded(Safetensors(audio, 32))
	logger.Log("loaded in " + (Process.Elapsed - started).Round(1) + " s")
	let last = steps.Values("sigmas").Length - 1
	let shape = Safetensors.Part(steps.Shape("video." + last), 1, 3, 1)
	let frames = Pictures(vae, steps.Values("video." + last), shape, steps.Values("frames"))
	File(dumps + "/strict-vae.rgb").Write(Bytes(frames))
	File(dumps + "/strict-vae.wav").Write(Wave(Heard(sound, steps.Values("audio." + last))))
	let result = Process.RunTool("ffmpeg", Arguments(steps.Shape("frames"), dumps))
	logger.Log(result.exitCode is 0 then "wrote " + dumps + "/strict-vae.mp4" else "ffmpeg failed: " + result.error)
Pictures(vae H3Vae, latent Numbers, shape Numbers, expected Numbers) Numbers
	let before = Process.Elapsed
	let frames = vae.Decoded(latent, shape)
	let psnr = FluxImage(logger).Psnr(frames, Scaled(expected))
	logger.Log("video decoded in " + (Process.Elapsed - before).Round(1) + " s, PSNR " + psnr.Round(2) + " dB")
	frames
Heard(sound H3Audio, latent Numbers) Numbers
	let before = Process.Elapsed
	let waveform = sound.Normalized(sound.Decoded(latent))
	logger.Log("audio decoded in " + ((Process.Elapsed - before) * 1000).Round + " ms")
	waveform
Scaled(bytes Numbers) Numbers
	H3Frames(Logger).Scaled((0, 255)) is (0, 1)
	for bytes
		value / 255
Bytes(frames Numbers) Bytes
	H3Frames(Logger).Bytes((0, 0.5, 1))(1) is Byte(128)
	for frames
		Byte((value * 255).Round)
Arguments(shape Numbers, dumps Text) Text
	H3Frames(Logger).Arguments((2, 4, 6, 3), "out").StartsWith("-y -loglevel error -f rawvideo -pix_fmt rgb24 -s 6x4")
	H3Frames(Logger).Arguments((2, 4, 6, 3), "out").EndsWith(" -i out/strict-vae.wav" + Encoding + "out/strict-vae.mp4")
	let path = dumps + "/strict-vae"
	let input = " -s " + shape(2) + "x" + shape(1) + " -r 24 -i " + path + ".rgb -i " + path + ".wav"
	"-y -loglevel error -f rawvideo -pix_fmt rgb24" + input + Encoding + path + ".mp4"
Wave(waveform Numbers) Bytes
	H3Frames(Logger).Wave((0, 0)).Length is 48
	for Header(waveform.Length) + Samples(waveform)
		Byte(value)
Header(count Number) Numbers
	H3Frames(Logger).Header(2).Length is 44
	H3Frames(Logger).Header(2)(4) is 40
	let format = (87, 65, 86, 69, 102, 109, 116, 32, 16, 0, 0, 0, 1, 0, 2, 0) + Little(32000, 4) + Little(128000, 4)
	(82, 73, 70, 70) + Little(36 + 2 * count, 4) + format + (4, 0, 16, 0, 100, 97, 116, 97) + Little(2 * count, 4)
Little(number Number, count Number) Numbers
	H3Frames(Logger).Little(258, 2) is (2, 1)
	for count
		(number / 256 ^ index).Floor % 256
Samples(waveform Numbers) Numbers
	H3Frames(Logger).Samples((1, -1)) is (255, 127, 1, 128)
	H3Frames(Logger).Samples((0, 0.5, 0, 0))(5) is 64
	let length = waveform.Length / 2
	for 2 * waveform.Length
		let sample = (index / 2).Floor
		let level = ((waveform(sample % 2 * length + (sample / 2).Floor) * 32767).Round + 65536) % 65536
		index % 2 is 0 then level % 256 else (level / 256).Floor