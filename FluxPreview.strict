constant Factors = (0.0058, 0.0113, 0.0073, 0.0495, 0.0443, 0.0836, -0.0099, 0.0096, 0.0644, 0.2144, 0.3009, 0.3652, 0.0166, -0.0039, -0.0054, 0.0157, 0.0103, -0.0160, -0.0398, 0.0902, -0.0235, -0.0052, 0.0095, 0.0109, -0.3527, -0.2712, -0.1666, -0.0301, -0.0356, -0.0180, -0.0107, 0.0078, 0.0013, 0.0746, 0.0090, -0.0941, 0.0156, 0.0169, 0.0070, -0.0034, -0.0040, -0.0114, 0.0032, 0.0181, 0.0080, -0.0939, -0.0008, 0.0186, 0.0018, 0.0043, 0.0104, 0.0284, 0.0056, -0.0127, -0.0024, -0.0022, -0.0030, 0.1207, -0.0026, 0.0065, 0.0128, 0.0101, 0.0142, 0.0137, -0.0072, -0.0007, 0.0095, 0.0092, -0.0059, 0.0000, -0.0077, -0.0049, -0.0465, -0.0204, -0.0312, 0.0095, 0.0012, -0.0066, 0.0290, -0.0034, 0.0025, 0.0220, 0.0169, -0.0048, -0.0332, -0.0457, -0.0468, -0.0085, 0.0389, 0.0609, -0.0076, 0.0003, -0.0043, -0.0111, -0.0460, -0.0614)
constant Bias = (-0.0329, -0.0718, -0.0851)
constant Tiny = Safetensors.Part(Factors + Factors, 0, 128, 1)
Pixels(latent Numbers, output Numbers, sigma Number, width Number) Numbers
	FluxPreview.Pixels(Tiny, Tiny, 0, 1).Length is 12
	FluxPreview.Pixels(Tiny, Tiny, 0.5, 1)(3).IsNearlyEqual(0.480138, 0.001)
	let area = latent.Length / 128
	for area * 12
		let pixel = (index / 3).Floor
		let row = (pixel / (width * 2)).Floor
		let column = pixel % (width * 2)
		let patch = (row % 2) * 2 + column % 2
		Channel(latent, output, sigma, area, (row / 2).Floor * width + (column / 2).Floor + patch * area, index % 3)
Channel(latent Numbers, output Numbers, sigma Number, area Number, start Number, color Number) Number
	FluxPreview.Channel(Tiny, Tiny, 0, 1, 0, 0).IsNearlyEqual(0.495061, 0.0001)
	FluxPreview.Channel(Tiny, Tiny, 0.5, 1, 1, 2).IsNearlyEqual(0.463856, 0.0001)
	mutable sum = Bias(color)
	for 32
		let at = start + index * 4 * area
		sum = sum + (latent(at) - sigma * output(at)) * Factors(index * 3 + color)
	((sum + 1) / 2).Clamp(0, 1)
