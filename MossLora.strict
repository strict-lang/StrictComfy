has down Batch
has up Batch
has scales Numbers
constant Unbiased = List(Number) + 0
constant Linears = ("q", "k", "v", "o", "ffn_up_gate", "ffn_down")
constant File = "tinylora.safetensors"
constant Tiny = MossLora.Loaded(File, "diffusion_model.layers.0.proj.q.")
constant Reference = Safetensors(File, 32, "reference.")
constant Layers = MossLora.Layer(File, "layers.0.")
constant Query = Reference.Values("q")
constant Zeros = MossLora.Joined(Query * 0, Query * 0, Query * 0, 256)
constant Latent = Reference.Values("x")
constant Lowered = Moss.Loaded("tinymoss.safetensors", File)
constant Words = MossLora.Lowered.TextEmbedded(Moss.Context, 3)
constant Empty = MossLora(Batch(List(Numbers), Unbiased), Batch(List(Numbers), Unbiased), List(Number))
Loaded(path Text, prefix Text, strength = 1) MossLora
	Tiny.down.weights.Length is 8
	Tiny.up.weights.Length is 256
	Tiny.up.weights.First.Length is 8
	Tiny.scales is MossLora.Repeated(2, 8)
	let file = Safetensors(path, 16, prefix)
	let peft = file.Entry("lora_A.weight") is not ""
	if (peft is false) and (file.Entry("lora_down.weight") is "")
		return Empty
	let downs = file.Rows(peft then "lora_A.weight" else "lora_down.weight")
	let scale = file.Entry("alpha") is "" then strength else strength * file.Values("alpha").First / downs.Length
	let ups = file.Rows(peft then "lora_B.weight" else "lora_up.weight")
	MossLora(Batch(downs, Unbiased), Batch(ups, Unbiased), Repeated(scale, downs.Length))
Layer(path Text, prefix Text) List(MossLora)
	MossLora.Layer(File, "layers.1.").Length is 6
	MossLora.Layer(File, "layers.1.")(5).up.weights.Length is 256
	MossLora.Layer("", "layers.1.").Length is 0
	if path is ""
		return List(MossLora)
	for Linears
		Loaded(path, "diffusion_model." + prefix + "proj." + value + ".")
Repeated(number Number, count Number) Numbers
	MossLora.Repeated(2, 3) is (2, 2, 2)
	for count
		number
Ranked(inner Numbers) Numbers
	MossLora(Tiny, scales = (2, 3)).Ranked((1, 1, 1, 1)) is (2, 3, 2, 3)
	for inner.Length
		inner(index) * scales(index % scales.Length)
Delta(input Numbers) Numbers
	Tiny.Delta(MossBlock.Input).Length is 4864
	MossImage(Logger).Error(Tiny.Delta(MossBlock.Input), Query) < 0.005
	up.Sums(Ranked(down.Sums(input)))
Applied(loras List(MossLora), linear Number, base Numbers, input Numbers) Numbers
	MossLora.Applied(List(MossLora), 0, (1, 2), (3, 4)) is (1, 2)
	MossLora.Applied(List(MossLora) + Empty, 0, (1, 2), (3, 4)) is (1, 2)
	MossImage(Logger).Error(MossLora.Applied(Layers, 0, Query, MossBlock.Input), Query * 2) < 0.005
	MossImage(Logger, 4).Compared(Lowered, Reference) < 0.02
	if loras.Length is 0
		return base
	loras(linear).down.weights.Length is 0 then base else MossText.Added(base, loras(linear).Delta(input))
Attended(loras List(MossLora), combined Numbers, normed Numbers) Numbers
	MossLora.Attended(List(MossLora), (1, 2, 3), (4)) is (1, 2, 3)
	MossImage(Logger).Error(Lowered.Output(Latent, 0.75, Words, MossBlock.Rotation), Reference.Values("output")) < 0.02
	MossLora.Attended(Layers, Zeros, MossBlock.Input)(768 + 5).IsNearlyEqual(Query(256 + 5), 0.01)
	MossLora.Attended(Layers, Zeros, MossBlock.Input)(256).IsNearlyEqual(Layers(1).Delta(MossBlock.Input)(0), 0.0001)
	if loras.Length is 0
		return combined
	let width = loras.First.up.weights.Length
	let joined = Joined(loras(0).Delta(normed), loras(1).Delta(normed), loras(2).Delta(normed), width)
	MossText.Added(combined, joined)
Stacked(other MossLora) MossLora
	Empty.Stacked(Tiny).down.weights.Length is 8
	Tiny.Stacked(Empty).up.weights.First.Length is 8
	Tiny.Stacked(Tiny).down.weights.Length is 16
	Tiny.Stacked(Tiny).up.weights.First.Length is 16
	MossImage(Logger).Error(Tiny.Stacked(Tiny).Delta(MossBlock.Input), Tiny.Delta(MossBlock.Input) * 2) < 0.0001
	if down.weights.Length is 0
		return other
	if other.down.weights.Length is 0
		return value
	let downs = Batch(down.weights + other.down.weights, Unbiased)
	MossLora(downs, Batch(Widened(up.weights, other.up.weights), Unbiased), scales + other.scales)
Flat(rows List(Numbers)) Numbers
	MossLora.Flat(((1, 2), (3, 4))) is (1, 2, 3, 4)
	let width = rows.First.Length
	for rows.Length * width
		rows((index / width).Floor)(index % width)
Widened(rows List(Numbers), more List(Numbers)) List(Numbers)
	MossLora.Widened(((1, 2), (3, 4)), ((5), (6))) is ((1, 2, 5), (3, 4, 6))
	for rows
		value + more(index)
Joined(queries Numbers, keys Numbers, values Numbers, width Number) Numbers
	MossLora.Joined((1, 2), (3, 4), (5, 6), 1) is (1, 3, 5, 2, 4, 6)
	for queries.Length * 3
		let column = index % (3 * width)
		let at = (index / (3 * width)).Floor * width + column % width
		column < width then queries(at) else (column < 2 * width then keys(at) else values(at))
