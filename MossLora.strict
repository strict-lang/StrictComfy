has down Numbers
has up Numbers
has rank Number
has columns Number
constant Gain = 64
constant Unbiased = List(Number) + 0
constant Linears = ("q", "k", "v", "o", "ffn_up_gate", "ffn_down")
constant Tiny = MossLora.Loaded("tinylora.safetensors", "diffusion_model.layers.0.proj.q.")
constant Reference = Safetensors("tinylora.safetensors", 32, "reference.")
constant Layers = MossLora.Layer("tinylora.safetensors", "layers.0.")
constant Query = Reference.Values("q")
constant Zeros = Query * 0 + Query * 0 + Query * 0
constant Latent = Reference.Values("x")
constant Lowered = Moss.Loaded("tinymoss.safetensors", "tinylora.safetensors")
constant Words = MossLora.Lowered.TextEmbedded(Moss.Context, 3)
Loaded(path Text, prefix Text, strength = 1) MossLora
	Tiny.rank is 8
	Tiny.columns is 256
	Tiny.up.Length is 2048
	let file = Safetensors(path, 32, prefix)
	let peft = file.Entry("lora_A.weight") is not ""
	let shape = file.Shape(peft then "lora_A.weight" else "lora_down.weight")
	let ratio = file.Entry("alpha") is "" then 1 else file.Values("alpha").First / shape(0)
	let downs = Packed(file.Values(peft then "lora_A.weight" else "lora_down.weight"), 1)
	let ups = Packed(file.Values(peft then "lora_B.weight" else "lora_up.weight"), Gain * strength * ratio)
	MossLora(downs, ups, shape(0), shape(1))
Packed(values Numbers, scale Number) BFloat16s
	MossLora.Packed((0.5, -1.25), 2) is (1, -2.5)
	for values
		value * scale
Layer(path Text, prefix Text) List(MossLora)
	MossLora.Layer("tinylora.safetensors", "layers.1.").Length is 6
	MossLora.Layer("tinylora.safetensors", "layers.1.")(5).up.Length is 2048
	MossLora.Layer("", "layers.1.").Length is 0
	if path is ""
		return List(MossLora)
	let items = LoadedLinears(path, prefix)
	let shared = items(0).down + items(1).down + items(2).down
	List(MossLora) + MossLora(items(0), down = shared) + items.Slice(1, 5)
LoadedLinears(path Text, prefix Text) List(MossLora)
	for Linears
		Loaded(path, "diffusion_model." + prefix + "proj." + value + ".")
DownProjected(input Numbers, total Number) Numbers
	let tokens = input.Length / columns
	Products(input, down, (1, tokens, columns, total), (0, 0, columns, 1, 0, 0, 1, columns)).Multiplied
Expanded(hidden Numbers, offset Number, stride Number) Numbers
	let tokens = hidden.Length / stride
	let outputs = up.Length / rank
	Products(hidden, up, (1, tokens, rank, outputs), (offset, 0, stride, 1, 0, 0, 1, rank)).Multiplied
Projected(input Numbers) Numbers
	Expanded(DownProjected(input, rank), 0, rank)
Delta(input Numbers) Numbers
	Tiny.Delta(MossBlock.Input).Length is 4864
	MossImage(Logger).Error(Tiny.Delta(MossBlock.Input), Query) < 0.005
	for Projected(input)
		value / Gain
Applied(loras List(MossLora), linear Number, base Numbers, input Numbers) Numbers
	MossLora.Applied(List(MossLora), 0, (1, 2), (3, 4)) is (1, 2)
	MossImage(Logger).Error(MossLora.Applied(Layers, 0, Query, MossBlock.Input), Query * 2) < 0.005
	MossLora.Applied(List(MossLora) + MossLora(Tiny, rank = 0), 0, (1, 2), (3, 4)) is (1, 2)
	MossImage(Logger, 4).Compared(Lowered, Reference) < 0.02
	if loras.Length is 0
		return base
	loras(linear).rank is 0 then base else ScaledAdded(base, loras(linear).Projected(input))
ScaledAdded(base Numbers, delta Numbers) BFloat16s
	MossLora.ScaledAdded((1, 2), (64, -128)) is (2, 0)
	for base.Length
		base(index) + delta(index) / Gain
Attended(loras List(MossLora), combined Numbers, normed Numbers) Numbers
	MossLora.Attended(List(MossLora), (1, 2, 3), (4)) is (1, 2, 3)
	MossImage(Logger).Error(Lowered.Output(Latent, 0.75, Words, MossBlock.Rotation), Reference.Values("output")) < 0.02
	MossLora.Attended(Layers, Zeros, MossBlock.Input)(768 + 5).IsNearlyEqual(Query(256 + 5), 0.01)
	MossLora.Attended(Layers, Zeros, MossBlock.Input)(256).IsNearlyEqual(Layers(1).Delta(MossBlock.Input)(0), 0.0001)
	loras.Length is 0 then combined else SharedAttended(loras, combined, normed)
SharedAttended(loras List(MossLora), combined Numbers, normed Numbers) Numbers
	let total = loras(0).rank + loras(1).rank + loras(2).rank
	let hidden = loras(0).DownProjected(normed, total)
	let queries = loras(0).Expanded(hidden, 0, total)
	let keys = loras(1).Expanded(hidden, loras(0).rank, total)
	let values = loras(2).Expanded(hidden, total - loras(2).rank, total)
	CombinedAdded(combined, queries, keys, values, loras(0).up.Length / loras(0).rank)
CombinedAdded(combined Numbers, queries Numbers, keys Numbers, values Numbers, width Number) BFloat16s
	MossLora.CombinedAdded((10, 20, 30, 40, 50, 60), (64, 128), (192, 256), (320, 384), 1) is (11, 23, 35, 42, 54, 66)
	for combined.Length
		let column = index % (3 * width)
		let at = (index / (3 * width)).Floor * width + column % width
		let delta = column < width then queries(at) else (column < 2 * width then keys(at) else values(at))
		combined(index) + delta / Gain
Stacked(other MossLora) MossLora
	MossLora(Tiny, rank = 0).Stacked(Tiny).up is Tiny.up
	Tiny.Stacked(Tiny).rank is 16
	MossImage(Logger).Error(Tiny.Stacked(Tiny).Delta(MossBlock.Input), Tiny.Delta(MossBlock.Input) * 2) < 0.0001
	if rank is 0
		return other
	MossLora(down + other.down, Widened(other), rank + other.rank, columns)
Widened(other MossLora) Numbers
	MossLora(Tiny, up = (1, 2, 3, 4), rank = 2).Widened(MossLora(Tiny, up = (5, 6), rank = 1)) is (1, 2, 5, 3, 4, 6)
	let width = rank + other.rank
	for up.Length + other.up.Length
		let row = (index / width).Floor
		let column = index % width
		column < rank then up(row * rank + column) else other.up(row * other.rank + column - rank)
Repeated(number Number, count Number) Numbers
	MossLora.Repeated(2, 3) is (2, 2, 2)
	for count
		number
