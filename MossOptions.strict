has files MossFiles
has prompt = "prompt.txt"
has quality = MossQuality.Best
has steps = 0
has guidance = 0
has spectrum = ""
has skip = "off"
has lora Texts = List(Text)
has count = 1
has seed = -1
has width = 704
has height = 1280
has output = "MossImage.jpg"
has JsonOutput = false
has preview = ""
has warm = false
constant SlowPresetsHelp = "presets of steps, guidance and Spectrum (704x1280 on a 3080): best 8 turbo steps 3.2 s, best25steps and best50steps without the turbo LoRA and cfg 2 18 s and 37 s, "
constant FastPresetsHelp = "fast and faster with Spectrum 2.0 s and 1.6 s, fastest 4 steps 1.2 s, fastest2steps 0.77 s"
constant PromptHelp = ("UTF-8 prompt file, {a|b|c} picks one of them per image, without prompt.txt the closeup street example", SlowPresetsHelp + FastPresetsHelp)
constant StepsHelp = ("sampling steps, 8 or fewer add the DMD turbo LoRA (4 or fewer moss/moss_image_sft_4step_v2.0.safetensors when installed), 0 for the ones of --quality", "classifier-free guidance (cfg), 0 for the one of --quality")
constant SpectrumHelp = ("off or spectrum<steps>_w<warmup>p<period> like spectrum8_w3p3 forecasts steps, empty for the one of --quality", "layers first:last (of 41) every other evaluated step from step 2 on reuses, like 6:36, off for none")
constant CountHelp = ("LoRA path[:strength] in models/loras or anywhere, repeat for more", "images per run, each with its own random seed and prompt choices unless --seed is given", "seed of every image, -1 for a random one per image")
constant SizeHelp = ("width in pixels, rounded down to a multiple of 32", "height in pixels, rounded down to a multiple of 32")
constant OutputHelp = ("numbered output base (.jpg or .png), never overwritten, or a .safetensors that gets the encoded prompt (context) for the browser page instead of an image", "write the settings of every image next to it as .json")
constant PreviewHelp = ("JPEG written during the sampling steps, empty for none", "only load the text encoder, Moss and the decoder into the backend, so the next image starts at once")
constant TinyModels = ("--models", ".", "--model", "tinymoss.safetensors", "--vae", "tinyvae.safetensors", "--text_encoder", "tinymoss.safetensors")
constant MissingModel = "Error: FileNotFound:a.safetensors\nnext"
constant Help = PromptHelp + StepsHelp + SpectrumHelp + CountHelp + SizeHelp + OutputHelp + PreviewHelp
Sampling(logger Logger) MossSampling
	MossOptions.Parsed(("--preview", "step.jpg")).preview is "step.jpg"
	MossOptions.Parsed(List(Text)).Sampling(Logger) is MossSampling(Logger, 44, 8, 1, "off", 5, 2)
	MossOptions.Parsed(("--quality", "fastest", "--width", "480")).Sampling(Logger).width is 30
	MossOptions.Parsed(("--quality", "fast")).Sampling(Logger) is MossSampling(Logger, 44, 8, 1, "on", 3, 3)
	MossOptions.Parsed(("--steps", "6", "--guidance", "3")).Sampling(Logger).guidance is 3
	MossOptions.Parsed(("--spectrum", "spectrum8_w3p4")).Sampling(Logger).period is 4
	MossOptions.Parsed(("--quality", "fastest2steps")).Sampling(Logger).period is 2
	let preset = MossSampling.Presets(quality)
	let spectral = Spectral(preset)
	let mode = spectral(0) > 0 then "on" else "off"
	let used = guidance > 0 then guidance else preset(1)
	MossSampling(logger, width / 16, Evaluated, used, mode, spectral(0) > 0 then spectral(0) else 5, spectral(1), Span)
Evaluated Number
	MossOptions.Parsed(("--quality", "best25steps")).Evaluated is 25
	MossOptions.Parsed(("--steps", "12")).Evaluated is 12
	MossOptions.Parsed(("--quality", "fastest2steps")).Evaluated is 2
	steps > 0 then steps else MossSampling.Presets(quality).First
Spectral(preset Numbers) Numbers
	MossOptions.Parsed(List(Text)).Spectral((8, 1, 3, 3)) is (3, 3)
	MossOptions.Parsed(("--spectrum", "off", "--quality", "fast")).Spectral((8, 1, 3, 3)) is (0, 2)
	MossOptions.Parsed(("--spectrum", "spectrum8_w2p3")).Spectral((8, 1, 0, 2)) is (2, 3)
	spectrum is "" then (preset(2), preset(3)) else spectrum is "off" then (0, 2) else Rates
Rates Numbers
	MossOptions.Parsed(("--spectrum", "spectrum8_w2p3")).Rates is (2, 3)
	MossOptions.Parsed(("--spectrum", "spectrum8_w2p3", "--steps", "6")).Rates is Error("InvalidSpectrum")
	MossOptions.Parsed(("--spectrum", "spectrum8_w9_w2p3")).Rates is Error("InvalidSpectrum")
	MossOptions.Parsed(("--spectrum", "spectrum8_w2p3p4")).Rates is Error("InvalidSpectrum")
	let parts = spectrum.Split("_w")
	let rates = parts.Last.Split("p")
	let valid = (parts.First is "spectrum" + Evaluated) and (parts.Length is 2) and (rates.Length is 2)
	valid then (rates.First to Number, rates.Last to Number) else Error("InvalidSpectrum")
Span MossSpan
	MossOptions.Parsed(List(Text)).Span is MossSpan.Off
	MossOptions.Parsed(("--skip", "6:36")).Span.last is 36
	MossOptions.Parsed(("--skip", "36:6")).Span is Error("InvalidSkip")
	MossOptions(skip = "-1:36").Span is Error("InvalidSkip") and MossOptions(skip = "6:42").Span is Error("InvalidSkip")
	MossOptions.Parsed(("--skip", "6:36:40")).Span is Error("InvalidSkip")
	if skip is "off"
		return MossSpan.Off
	let parts = skip.Split(":")
	let first = parts.First to Number
	let last = parts.Last to Number
	let valid = (parts.Length is 2) and (first >= 0) and (first < last) and (last <= MossBlock.Layers)
	valid then MossSpan(first, last) else Error("InvalidSkip")
Loras Text
	MossOptions.Parsed(("--lora", "tinylora.safetensors:0.5", "--steps", "20")).Loras is "tinylora.safetensors=0.5"
	MossOptions.Parsed(("--models", ".")).Loras is Error("FileNotFound:moss/dmd_turbo_lora.safetensors")
	MossOptions.Parsed(("--model", "tinymoss.gguf", "--models", ".")).Loras is ""
	MossOptions.Parsed(("--model", "tinymoss-dmd.safetensors", "--models", ".")).Loras is ""
	MossOptions.Parsed(("--model", "a.gguf", "--lora", "b")).Loras is Error("LorasNeedSafetensorsModel")
	if files.model.EndsWith(".gguf")
		return lora.Length is 0 then "" else Error("LorasNeedSafetensorsModel")
	let specs = Specs
	if (Evaluated > 8) or Baked or Distilled(specs)
		return Text.Combine(specs, ";")
	let installed = File(files.Folder + "/loras/" + MossFiles.FourSteps).Exists
	Text.Combine(List(Text) + (files.Located(Turbo(installed), "loras") + "=1") + specs, ";")
Baked Boolean
	MossOptions.Parsed(("--model", "moss_image_sft_4step_int4_convrot.safetensors")).Baked
	MossOptions.Parsed(("--model", "moss-image-sft-dit-int8-convrot-dmd.safetensors")).Baked
	MossOptions.Parsed(List(Text)).Baked is false
	let name = files.model.Lower
	(name.IndexOf("dmd") >= 0) or (name.IndexOf("4step") >= 0)
Turbo(installed Boolean) Text
	MossOptions.Parsed(("--steps", "4")).Turbo(true) is MossFiles.FourSteps
	MossOptions.Parsed(("--quality", "fastest2steps")).Turbo(true) is MossFiles.FourSteps
	MossOptions.Parsed(("--steps", "4")).Turbo(false) is MossFiles.Dmd
	MossOptions.Parsed(List(Text)).Turbo(true) is MossFiles.Dmd
	(Evaluated <= 4) and installed then MossFiles.FourSteps else MossFiles.Dmd
Distilled(specs Texts) Boolean
	MossOptions.Parsed(List(Text)).Distilled(("x/moss_image_sft_4step_v2.0.safetensors=1", "a=1"))
	MossOptions.Parsed(List(Text)).Distilled(("x/dmd_turbo_lora.safetensors=0"))
	MossOptions.Parsed(List(Text)).Distilled(("tinylora.safetensors=1")) is false
	MossOptions.Parsed(List(Text)).Distilled(("a/dmd_turbo", "_lora.safetensors=1")) is false
	let combined = Text.Combine(specs, ";")
	let dmd = combined.IndexOf(Path(MossFiles.Dmd).FileName.text) >= 0
	dmd or (combined.IndexOf(Path(MossFiles.FourSteps).FileName.text) >= 0)
Located Text
	MossOptions.Parsed(("--model", "a b.safetensors", "--models", ".")).Located is "Model file not found: a_b.safetensors"
	MossOptions.Parsed(TinyModels).Named("") is ""
	let model = files.Checkpoint
	let loras = Loras
	let decoder = Decoder
	let encoder = files.Encoder
	let tokenizer = files.Tokenizer
	let early = (model is Error) then (model to Text) else ((loras is Error) then (loras to Text) else "")
	let late = (decoder is Error) then (decoder to Text) else ((encoder is Error) then (encoder to Text) else "")
	Named(early + late + ((tokenizer is Error) then (tokenizer to Text) else ""))
Decoder Text
	MossOptions.Parsed(TinyModels).Decoder is "tinyvae.safetensors"
	MossOptions.Parsed(("--models", ".", "--quality", "fastest")).Decoder is Error("FileNotFound:flux2-vae.safetensors")
	quality is in (MossQuality.Fastest, MossQuality.Fastest2Steps) then files.Fast else files.Decoder
Named(problem Text) Text
	MossOptions.Parsed(List(Text)).Named("") is ""
	MossOptions.Parsed(List(Text)).Named(MissingModel) is "Model file not found: a.safetensors"
	if problem is ""
		return ""
	problem.Lines.First.Replace("Error: ", "").Replace("FileNotFound:", "Model file not found: ")
Specs Texts
	MossOptions.Parsed(("--lora", "tinylora.safetensors:0.5")).Specs is ("tinylora.safetensors=0.5")
	ModelFiles(files.models).Specs(lora)
Problem Text
	MossOptions.Parsed(List(Text)).Problem is ""
	MossOptions.Parsed(("--width", "500")).Problem is ""
	MossOptions.Parsed(("--count", "0")).Problem is "--count must be at least 1"
	MossOptions.Parsed(("--output", "a.gif")).Problem is "--output must end with .jpg, .png or .safetensors"
	MossOptions.Parsed(("--output", "prompt.safetensors")).Problem is ""
	MossOptions.Parsed(("--output", "a.png")).Problem is ""
	if count < 1
		return "--count must be at least 1"
	let valid = output.EndsWith(".jpg") or output.EndsWith(".png") or output.EndsWith(".safetensors")
	valid then "" else "--output must end with .jpg, .png or .safetensors"
Fitted MossOptions
	MossOptions.Parsed(("--width", "720", "--height", "1280")).Fitted.width is 704
	MossOptions.Parsed(("--width", "720", "--height", "1280")).Fitted.height is 1280
	MossOptions.Parsed(("--width", "500")).Fitted.width is 480
	MossOptions.Parsed(("--width", "0")).Fitted.width is 32
	MossOptions.Parsed(("--height", "500")).Fitted.height is 480
	MossOptions(value, width = ComfySize.Plain.Snap(width, 32), height = ComfySize.Plain.Snap(height, 32))
