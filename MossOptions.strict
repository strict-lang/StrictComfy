has prompt = "prompt.txt"
has quality = MossQuality.Best
has steps = 0
has guidance = 0
has skip = "off"
has lora Texts = List(Text)
has count = 1
has seed = -1
has width = 720
has height = 1280
has output = "MossImage.jpg"
has JsonOutput = false
has model = ""
has models = ""
constant Help = ("UTF-8 prompt file, {a|b|c} picks one of them per image", "presets of steps, guidance and Spectrum (720x1280 on a 3080): best 8 turbo steps 3.2 s, best25steps and best50steps without the turbo LoRA and cfg 2 18 s and 37 s, fast and faster with Spectrum 2.0 s and 1.6 s, fastest 4 steps 1.2 s, fastest2steps 0.77 s", "sampling steps, 8 or fewer add the DMD turbo LoRA, 0 for the ones of --quality", "classifier-free guidance (cfg), 0 for the one of --quality", "layers first:last (of 41) every other evaluated step from step 2 on reuses, like 6:36, off for none", "LoRA path[:strength] in models/loras or anywhere, repeat for more", "images per run, each with its own seed and prompt choices", "seed of the first image, the others follow from it, -1 for a random one", "width in pixels, a multiple of 16", "height in pixels, a multiple of 16", "numbered output base (.jpg or .png), never overwritten", "write the settings of every image next to it as .json", "Moss int8 Convrot model in models/diffusion_models or anywhere", "ComfyUI models folder, empty for D: or C:/ComfyUI_windows_portable/ComfyUI/models")
Sampling(logger Logger) MossSampling
	MossOptions.Parsed(List(Text)).Sampling(Logger).steps is 8
	MossOptions.Parsed(List(Text)).Sampling(Logger).mode is "off"
	MossOptions.Parsed(("--quality", "fastest", "--width", "480")).Sampling(Logger).width is 30
	MossOptions.Parsed(("--quality", "fast")).Sampling(Logger).period is 3
	MossOptions.Parsed(("--steps", "6", "--guidance", "3")).Sampling(Logger).guidance is 3
	let preset = MossSampling.Presets(quality)
	let mode = preset(2) > 0 then "on" else "off"
	let used = guidance > 0 then guidance else preset(1)
	let warmup = preset(2) > 0 then preset(2) else 5
	MossSampling(logger, width / 16, Evaluated, used, mode, warmup, preset(3), Span)
Evaluated Number
	MossOptions.Parsed(("--quality", "best25steps")).Evaluated is 25
	MossOptions.Parsed(("--steps", "12")).Evaluated is 12
	steps > 0 then steps else MossSampling.Presets(quality)(0)
Span MossSpan
	MossOptions.Parsed(List(Text)).Span is MossSpan.Off
	MossOptions.Parsed(("--skip", "6:36")).Span.last is 36
	MossOptions.Parsed(("--skip", "36:6")).Span is Error("InvalidSkip")
	if skip is "off"
		return MossSpan.Off
	let parts = skip.Split(":")
	let first = parts.First to Number
	let last = parts.Last to Number
	let valid = (parts.Length is 2) and (first >= 0) and (first < last) and (last <= 41)
	valid then MossSpan(first, last) else Error("InvalidSkip")
Folder Text
	MossOptions.Parsed(("--models", ".")).Folder is "."
	if models is not ""
		return models
	for ("D:/ComfyUI_windows_portable/ComfyUI/models", "C:/ComfyUI_windows_portable/ComfyUI/models")
		if Directory.Exists(value)
			return value
	Error("ModelsFolderNotFound")
Located(name Text, folder Text) Text
	MossOptions.Parsed(List(Text)).Located("tinymoss.safetensors", "diffusion_models") is "tinymoss.safetensors"
	MossOptions.Parsed(("--models", ".")).Located("x.y", "loras") is Error("FileNotFound:x.y")
	if File(name).Exists
		return name
	let inside = Folder + "/" + folder + "/" + name
	File(inside).Exists then inside else Error("FileNotFound:" + name.Replace(" ", "_"))
Checkpoint Text
	MossOptions.Parsed(("--model", "tinymoss.safetensors")).Checkpoint is "tinymoss.safetensors"
	Located(model is "" then "moss-image-sft-dit-int8-convrot.safetensors" else model, "diffusion_models")
Loras Text
	MossOptions.Parsed(("--lora", "tinylora.safetensors:0.5", "--steps", "20")).Loras is "tinylora.safetensors=0.5"
	MossOptions.Parsed(("--models", ".")).Loras is Error("FileNotFound:moss/dmd_turbo_lora.safetensors")
	let specs = Specs
	let turbo = (Evaluated <= 8) and (Text.Combine(specs, ";").IndexOf("dmd_turbo_lora.safetensors") < 0)
	let added = turbo then List(Text) + (Located("moss/dmd_turbo_lora.safetensors", "loras") + "=1") else List(Text)
	Text.Combine(added + specs, ";")
Specs Texts
	MossOptions.Parsed(("--lora", "tinylora.safetensors:0.5")).Specs is ("tinylora.safetensors=0.5")
	for lora
		Spec(value)
Spec(text Text) Text
	MossOptions.Parsed(List(Text)).Spec("tinylora.safetensors") is "tinylora.safetensors=1"
	MossOptions.Parsed(List(Text)).Spec("tinylora.safetensors:0.25") is "tinylora.safetensors=0.25"
	let at = text.LastIndexOf(":")
	let strength = at > 1 then text.Substring(at + 1, text.Length - at - 1) else ""
	let numeric = (strength is not "") and ((strength to Number) to Text is strength)
	Located(numeric then text.Substring(0, at) else text, "loras") + "=" + (numeric then strength else "1")
Problem Text
	MossOptions.Parsed(List(Text)).Problem is ""
	MossOptions.Parsed(("--width", "500")).Problem is "--width and --height must be positive multiples of 16"
	MossOptions.Parsed(("--count", "0")).Problem is "--count must be at least 1"
	MossOptions.Parsed(("--output", "a.gif")).Problem is "--output must end with .jpg or .png"
	if (width < 16) or (height < 16) or (width % 16 is not 0) or (height % 16 is not 0)
		return "--width and --height must be positive multiples of 16"
	if count < 1
		return "--count must be at least 1"
	output.EndsWith(".jpg") or output.EndsWith(".png") then "" else "--output must end with .jpg or .png"
