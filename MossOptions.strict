has files MossFiles
has prompt = "prompt.txt"
has quality = MossQuality.Best
has steps = 0
has guidance = 0
has spectrum = ""
has skip = "off"
has lora Texts = List(Text)
has count = 1
has seed = -1
has width = 720
has height = 1280
has output = "MossImage.jpg"
has JsonOutput = false
constant Help = ("UTF-8 prompt file, {a|b|c} picks one of them per image", "presets of steps, guidance and Spectrum (720x1280 on a 3080): best 8 turbo steps 3.2 s, best25steps and best50steps without the turbo LoRA and cfg 2 18 s and 37 s, fast and faster with Spectrum 2.0 s and 1.6 s, fastest 4 steps 1.2 s, fastest2steps 0.77 s", "sampling steps, 8 or fewer add the DMD turbo LoRA (4 or fewer moss/moss_image_sft_4step_v2.0.safetensors when installed), 0 for the ones of --quality", "classifier-free guidance (cfg), 0 for the one of --quality", "off or spectrum<steps>_w<warmup>p<period> like spectrum8_w3p3 forecasts steps, empty for the one of --quality", "layers first:last (of 41) every other evaluated step from step 2 on reuses, like 6:36, off for none", "LoRA path[:strength] in models/loras or anywhere, repeat for more", "images per run, each with its own random seed and prompt choices unless --seed is given", "seed of every image, -1 for a random one per image", "width in pixels, a multiple of 16", "height in pixels, a multiple of 16", "numbered output base (.jpg or .png), never overwritten", "write the settings of every image next to it as .json")
Sampling(logger Logger) MossSampling
	MossOptions.Parsed(List(Text)).Sampling(Logger).steps is 8
	MossOptions.Parsed(List(Text)).Sampling(Logger).mode is "off"
	MossOptions.Parsed(("--quality", "fastest", "--width", "480")).Sampling(Logger).width is 30
	MossOptions.Parsed(("--quality", "fast")).Sampling(Logger).period is 3
	MossOptions.Parsed(("--steps", "6", "--guidance", "3")).Sampling(Logger).guidance is 3
	MossOptions.Parsed(("--spectrum", "spectrum8_w3p4")).Sampling(Logger).period is 4
	let preset = MossSampling.Presets(quality)
	let spectral = Spectral(preset)
	let mode = spectral(0) > 0 then "on" else "off"
	let used = guidance > 0 then guidance else preset(1)
	MossSampling(logger, width / 16, Evaluated, used, mode, spectral(0) > 0 then spectral(0) else 5, spectral(1), Span)
Evaluated Number
	MossOptions.Parsed(("--quality", "best25steps")).Evaluated is 25
	MossOptions.Parsed(("--steps", "12")).Evaluated is 12
	steps > 0 then steps else MossSampling.Presets(quality)(0)
Spectral(preset Numbers) Numbers
	MossOptions.Parsed(List(Text)).Spectral((8, 1, 3, 3)) is (3, 3)
	MossOptions.Parsed(("--spectrum", "off", "--quality", "fast")).Spectral((8, 1, 3, 3)) is (0, 2)
	MossOptions.Parsed(("--spectrum", "spectrum8_w2p3", "--steps", "6")).Spectral((8, 1, 0, 2)) is Error("InvalidSpectrum")
	if spectrum is ""
		return (preset(2), preset(3))
	if spectrum is "off"
		return (0, 2)
	let parts = spectrum.Split("_w")
	let rates = parts.Last.Split("p")
	let valid = (parts.First is "spectrum" + Evaluated) and (parts.Length is 2) and (rates.Length is 2)
	valid then (rates.First to Number, rates.Last to Number) else Error("InvalidSpectrum")
Span MossSpan
	MossOptions.Parsed(List(Text)).Span is MossSpan.Off
	MossOptions.Parsed(("--skip", "6:36")).Span.last is 36
	MossOptions.Parsed(("--skip", "36:6")).Span is Error("InvalidSkip")
	if skip is "off"
		return MossSpan.Off
	let parts = skip.Split(":")
	let first = parts.First to Number
	let last = parts.Last to Number
	let valid = (parts.Length is 2) and (first >= 0) and (first < last) and (last <= 41)
	valid then MossSpan(first, last) else Error("InvalidSkip")
Loras Text
	MossOptions.Parsed(("--lora", "tinylora.safetensors:0.5", "--steps", "20")).Loras is "tinylora.safetensors=0.5"
	MossOptions.Parsed(("--models", ".")).Loras is Error("FileNotFound:moss/dmd_turbo_lora.safetensors")
	MossOptions.Parsed(("--model", "tinymoss.gguf", "--models", ".")).Loras is ""
	MossOptions.Parsed(("--model", "tinymoss-dmd.safetensors", "--models", ".")).Loras is ""
	MossOptions.Parsed(("--model", "a.gguf", "--lora", "b")).Loras is Error("LorasNeedSafetensorsModel")
	if files.model.EndsWith(".gguf")
		return lora.Length is 0 then "" else Error("LorasNeedSafetensorsModel")
	let specs = Specs
	if (Evaluated > 8) or (files.model.Lower.IndexOf("dmd") >= 0) or Distilled(specs)
		return Text.Combine(specs, ";")
	let installed = File(files.Folder + "/loras/" + MossFiles.FourSteps).Exists
	Text.Combine(List(Text) + (files.Located(Turbo(installed), "loras") + "=1") + specs, ";")
Turbo(installed Boolean) Text
	MossOptions.Parsed(("--steps", "4")).Turbo(true) is MossFiles.FourSteps
	MossOptions.Parsed(("--quality", "fastest2steps")).Turbo(true) is MossFiles.FourSteps
	MossOptions.Parsed(("--steps", "4")).Turbo(false) is MossFiles.Dmd
	MossOptions.Parsed(List(Text)).Turbo(true) is MossFiles.Dmd
	(Evaluated <= 4) and installed then MossFiles.FourSteps else MossFiles.Dmd
Distilled(specs Texts) Boolean
	MossOptions.Parsed(List(Text)).Distilled(("x/moss_image_sft_4step_v2.0.safetensors=1", "a=1"))
	MossOptions.Parsed(List(Text)).Distilled(("x/dmd_turbo_lora.safetensors=0"))
	MossOptions.Parsed(List(Text)).Distilled(("tinylora.safetensors=1")) is false
	let combined = Text.Combine(specs, ";")
	let dmd = combined.IndexOf(Path(MossFiles.Dmd).FileName.text) >= 0
	dmd or (combined.IndexOf(Path(MossFiles.FourSteps).FileName.text) >= 0)
Located Texts
	MossOptions.Parsed(("--model", "a b.safetensors", "--models", ".")).Located is Error("FileNotFound:a_b.safetensors")
	(files.Checkpoint, Loras, files.Decoder, files.Encoder, files.Tokenizer)
Specs Texts
	MossOptions.Parsed(("--lora", "tinylora.safetensors:0.5")).Specs is ("tinylora.safetensors=0.5")
	ModelFiles(files.models).Specs(lora)
Problem Text
	MossOptions.Parsed(List(Text)).Problem is ""
	MossOptions.Parsed(("--width", "500")).Problem is "--width and --height must be positive multiples of 16"
	MossOptions.Parsed(("--count", "0")).Problem is "--count must be at least 1"
	MossOptions.Parsed(("--output", "a.gif")).Problem is "--output must end with .jpg or .png"
	if (width < 16) or (height < 16) or (width % 16 is not 0) or (height % 16 is not 0)
		return "--width and --height must be positive multiples of 16"
	if count < 1
		return "--count must be at least 1"
	output.EndsWith(".jpg") or output.EndsWith(".png") then "" else "--output must end with .jpg or .png"
