has model = ""
has vae = ""
has textEncoder = ""
has models = ""
has workflow = ""
has Warm = false
constant FourSteps = "moss/moss_image_sft_4step_v2.0.safetensors"
constant Spare = 4294967296
constant Dmd = "moss/dmd_turbo_lora.safetensors"
constant ModelKindsHelp = "Moss int8 Convrot model file or a 4 bit .gguf (LoRAs merged, like moss_image_sft_turbo-Q4_K_M.gguf for 8 steps), "
constant ModelNamesHelp = "a name in models/diffusion_models or a path, empty for moss-image-sft-dit-int8-convrot.safetensors"
constant DecoderKindsHelp = "image decoder: the Flux 2 VAE flux2-vae.safetensors, taef2.safetensors (tiny, 0.1 s faster per 720p image) or the FLUX.2 small decoder (its full_encoder_small_decoder.safetensors), "
constant DecoderNamesHelp = "a name in models/vae or models/vae_approx or a path, empty for flux2-vae.safetensors (taef2.safetensors from models/vae_approx with fastest and fastest2steps or without the Flux 2 VAE)"
constant EncoderKindsHelp = "Qwen3.5 9B text encoder file (int8 Convrot or a .gguf like Qwen3.5-9B-Q4_K_M.gguf), a name in models/text_encoders or a path, "
constant EncoderNamesHelp = "empty for qwen3.5_9b_int8_convrot.safetensors; its tokenizer folder qwen35_tokenizer is used from next to it, else from ComfyUI"
constant ModelHelp = (ModelKindsHelp + ModelNamesHelp, DecoderKindsHelp + DecoderNamesHelp, EncoderKindsHelp + EncoderNamesHelp)
constant FolderHelp = List(Text) + "ComfyUI models folder for files given by name, empty for D: or C:/ComfyUI_windows_portable/ComfyUI/models"
constant WorkflowHelp = List(Text) + "ComfyUI image workflow (.json saved in ComfyUI, a path or a name in user/default/workflows) whose model, LoRAs, prompt, size, seed and steps this run uses, options after it change them"
constant WarmHelp = List(Text) + "only load the text encoder, Moss and the decoder into the backend, the next image starts at once"
constant Help = ModelHelp + FolderHelp + WorkflowHelp + WarmHelp
constant Encoding = MossFiles.Parsed(("--model", "tinymoss.safetensors", "--text_encoder", "tinymoss.safetensors", "--models", "."))
constant Local = MossFiles.Parsed(("--model", "tinymoss.safetensors", "--vae", "tinyvae.safetensors", "--models", "."))
Folder Text slow
	Local.Folder is "."
	ModelFiles(models).Folder
Located(name Text, folder Text) Text slow
	Local.Located("tinymoss.safetensors", "diffusion_models") is "tinymoss.safetensors"
	Local.Located("x.y", "loras") is Error("FileNotFound:x.y")
	ModelFiles(models).Located(name, folder)
Checkpoint Text slow
	Local.Checkpoint is "tinymoss.safetensors"
	MossFiles.Parsed(("--models", ".")).Checkpoint is Error("FileNotFound:moss-image-sft-dit-int8-convrot.safetensors")
	MossFiles.Parsed(("--models", "web", "--model", "h3_preview.js")).Checkpoint is Error("FileNotFound:h3_preview.js")
	Located(model is "" then "moss-image-sft-dit-int8-convrot.safetensors" else model, "diffusion_models")
Decoder Text slow
	Local.Decoder is "tinyvae.safetensors"
	MossFiles.Parsed(("--models", ".")).Decoder is Error("FileNotFound:flux2-vae.safetensors")
	if vae is not ""
		return Located(vae, File(Folder + "/vae_approx/" + vae).Exists then "vae_approx" else "vae")
	let full = Located("flux2-vae.safetensors", "vae")
	(full is Error) and File(Tiny).Exists then Tiny else full
Tiny Text slow
	Local.Tiny is "./vae_approx/taef2.safetensors"
	Folder + "/vae_approx/taef2.safetensors"
Fast Text slow
	Local.Fast is "tinyvae.safetensors"
	MossFiles.Parsed(("--models", ".")).Fast is Error("FileNotFound:flux2-vae.safetensors")
	(vae is "") and File(Tiny).Exists then Tiny else Decoder
Encoder Text slow
	Local.Encoder is Error("FileNotFound:qwen3.5_9b_int8_convrot.safetensors")
	MossFiles.Parsed(("--text_encoder", "tinymoss.safetensors", "--models", ".")).Encoder is "tinymoss.safetensors"
	MossFiles.Parsed(("--models", "web", "--text_encoder", "h3_preview.js")).Encoder is Error("FileNotFound:h3_preview.js")
	Located(textEncoder is "" then "qwen3.5_9b_int8_convrot.safetensors" else textEncoder, "text_encoders")
Tokenizer Text slow
	MossFiles.Parsed(("--text_encoder", "tinymoss.safetensors", "--models", ".")).Tokenizer is Error("TokenizerNotFound")
	let beside = Path(Encoder).PathOnly.text
	let next = (beside is "" then "." else beside) + "/qwen35_tokenizer"
	if Directory.Exists(next)
		return next
	let installed = ModelFiles(models).ComfyUI + "/comfy/text_encoders/qwen35_tokenizer"
	Directory.Exists(installed) then installed else Error("TokenizerNotFound")
Workflow Text slow
	MossFiles.Parsed(("--workflow", "tinymossworkflow.json")).Workflow is "tinymossworkflow.json"
	MossFiles.Parsed(("--models", ".", "--workflow", "a.json")).Workflow is "./../user/default/workflows/a.json"
	ModelFiles(models).Workflow(workflow)
Freed slow
	Encoding.Freed is not Error
	if GpuMemory.Held + GpuMemory.Available > File(Checkpoint).Length + File(Encoder).Length
		GpuMemory.Released
	else
		GpuMemory.Evicted
Eased slow
	Encoding.Eased is not Error
	if GpuMemory.Available < Spare
		Freed
FailedNumber(number Number) Boolean
	MossFiles.FailedNumber(Error("x"))
	MossFiles.FailedNumber(0) is false
	number is Error
FailedTexts(texts Texts) Boolean
	MossFiles.FailedTexts(Error("x"))
	MossFiles.FailedTexts(List(Text)) is false
	texts is Error
