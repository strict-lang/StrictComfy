has video Batch
has textProjection Batch
has texts List(MossText)
has timeIn Batch
has timeOut Batch
has blockModulation Batch
has layers List(MossBlock)
has finalNorm Numbers
has final Batch
has headModulation Batch
constant Tiny = Moss.Loaded("tinymoss.safetensors", "")
constant Model = Safetensors("tinymoss.safetensors")
constant Context = Model.Values("reference.context")
constant Forward = Moss.Tiny.Output(Model.Values("reference.x"), 0.75, Moss.Tiny.TextEmbedded(Context, 3), MossBlock.Rotation)
constant Denses = ("video_embedder", "text_embedder.proj", "time_embedding.0", "time_embedding.2", "shared_block_modulation", "final_linear_video", "video_head_modulation")
Loaded(path Text, lora Text) Slow(Moss)
	Tiny.layers.Length is 2
	Tiny.texts.Length is 2
	Moss.Loaded("tinymoss.gguf", "").layers.Length is 2
	Moss.Loaded("tinymossint4.safetensors", "").layers.Length is 2
	Moss.Loaded("tinymossqkv.safetensors", "tinylora.safetensors").layers(0).attention(300)(5).IsNearlyEqual(-0.069, 0.003)
	if path.EndsWith(".gguf")
		return MossGguf(path).Loaded
	let model = Safetensors(path, BFloat16.SafetensorsBits)
	let dense = Dense(model)
	let normed = model.Values("final_norm_video.weight")
	Moss(dense(0), dense(1), Texts(model), dense(2), dense(3), dense(4), Layers(model, lora), normed, dense(5), dense(6))
Layers(model Safetensors, lora Text) Slow(List(MossBlock))
	Tiny.Layers(Model, "").Length is 2
	Tiny.Layers(Safetensors("tinyvae.safetensors"), "") is Error("NoMossLayersFound:tinyvae.safetensors")
	let count = TensorFile.Header(model.path).Split(".proj.o.weight\"").Length - 1
	if count is 0
		return Error("NoMossLayersFound:" + Path(model.path).FileName.text)
	let label = lora is "" then "Loading Moss" else "Loading Moss and applying LoRAs"
	let completion = Completion(Logger, label, count, Process.Elapsed)
	for count
		let block = MossBlock.Loaded(model, "layers." + index + ".", lora)
		completion.Report(index + 1)
		block
Texts(model Safetensors) Slow(List(MossText))
	Tiny.Texts(Model).Length is 2
	for 2
		MossText.Loaded(model, "text_embedder.blocks." + index + ".")
Dense(model Safetensors) Slow(List(Batch))
	Tiny.Dense(Model).Length is 7
	for Denses
		MossText.Dense(model, value)
TimeEmbedded(sigma Number) Slow(Numbers)
	Tiny.TimeEmbedded(0.75)(0).IsNearlyEqual(-0.2324, 0.01)
	Tiny.TimeEmbedded(0.75)(255).IsNearlyEqual(-0.0747, 0.01)
	Tiny.blockModulation.Sums(Tiny.TimeEmbedded(0.75))(0).IsNearlyEqual(0.3438, 0.01)
	timeOut.Sums(Silu(timeIn.Sums(Sinusoid(Brain(Brain(sigma) * 1000), 256))))
Sinusoid(time Number, count Number) Numbers
	Moss.Sinusoid(0, 4) is (1, 1, 0, 0)
	Moss.Sinusoid(1, 4)(3).IsNearlyEqual(0.0099998)
	let half = count / 2
	for count
		let angle = Degrees(Radians(time * (-(index % half) * 10000.Logarithm / half).Exponential) to Degrees)
		index < half then angle.Cos else angle.Sin
Silu(values Numbers) Numbers
	Moss.Silu((0, 1)) is (0, 0.7310585786300049)
	for values
		value / (1 + (-value).Exponential)
Brain(number Number) Number
	Moss.Brain(750) is 752
	Moss.Brain(0.9722222) is 0.97265625
	Moss.Brain(972.65625) is 972
	Moss.Brain(0) is 0
	number is 0 then 0 else number.Stepped(2 ^ ((number.Absolute.Logarithm / 2.Logarithm).Floor - 7))
Output(latent Numbers, sigma Number, text Numbers, rotation Numbers) Slow(Numbers)
	Forward(0).IsNearlyEqual(-1.9609, 0.05)
	Forward(5).IsNearlyEqual(-0.5156, 0.05)
	Forward(255).IsNearlyEqual(-0.1289, 0.05)
	let vector = TimeEmbedded(sigma)
	Head(Features(latent, text, rotation, vector), vector)
Rotation(latent Numbers, text Numbers, width Number) Slow(Float32s)
	Tiny.Rotation(Model.Values("reference.x"), Tiny.TextEmbedded(Context, 3), 4) is MossBlock.Rotation
	let count = latent.Length / video.weights.First.Length
	MossBlock.Rotations(count / width, width, text.Length / finalNorm.Length, 128)
Features(latent Numbers, text Numbers, rotation Numbers, vector Numbers) Numbers
	Ran(Embedded(latent, text), blockModulation.Sums(vector), rotation, latent, 0, layers.Length)
Embedded(latent Numbers, text Numbers) Numbers
	video.Sums(Transposed(latent, video.weights.First.Length)) + text
Head(image Numbers, vector Numbers) Numbers
	let count = image.Length / finalNorm.Length
	Transposed(final.Sums(MossBlock.Modulated(image, finalNorm, headModulation.Sums(vector), 0)), count)
TextEmbedded(context Numbers, text Number) Slow(Numbers)
	Tiny.TextEmbedded(Context, 3)(0).IsNearlyEqual(0.0557, 0.02)
	Tiny.TextEmbedded(Context, 3)(767).IsNearlyEqual(0.7422, 0.02)
	let rotation = MossBlock.Rotations(0, 0, text, 128)
	mutable hidden = textProjection.Sums(context)
	for texts
		hidden = value.Output(hidden, rotation)
	hidden
Ran(hidden Numbers, modulation Numbers, rotation Numbers, latent Numbers, first Number, last Number) Slow(Numbers)
	Tiny.video.Sums(Moss.Transposed(Model.Values("reference.x"), 16))(4095).IsNearlyEqual(-0.9805, 0.02)
	Tiny.Ran(MossBlock.Input, MossBlock.Modulation, MossBlock.Rotation, Context, 1, 1) is MossBlock.Input
	let kept = latent.Length / video.weights.First.Length * finalNorm.Length
	mutable state = hidden
	for last - first
		let layer = layers(first + index)
		let cropping = first + index is layers.Length - 1
		state = cropping then layer.Cropped(state, modulation, rotation, kept) else layer.Output(state, modulation, rotation)
	state
Transposed(values Numbers, rows Number) Numbers
	Moss.Transposed((1, 2, 3, 4, 5, 6), 2) is (1, 4, 2, 5, 3, 6)
	let columns = values.Length / rows
	for values.Length
		values((index % rows) * columns + (index / rows).Floor)
