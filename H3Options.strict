has files H3Files
has prompt = "prompt.txt"
has quality = H3Quality.Best
has steps = 0
has skip = "5:45"
has sampler = "euler"
has scheduler = "simple"
has lora Texts = List(Text)
has count = 0
has seed = -1
has width = 480
has height = 832
has length = 124
has output = "H3Video.mp4"
constant Help = ("UTF-8 prompt file, {a|b|c} picks one of them per video, or a folder of .txt prompts: an image uses the one of its name, else the next in sorted order", "presets of model, steps, attention and Spectrum (124 frames at 480x832 on a 4090): best the model with the turbo LoRA of ComfyUI's H3 template (minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors in models/loras, left out above 8 steps or with a model or LoRA named turbo) 8 steps 14 s, fast with routed attention 11 s, faster with Spectrum 7.1 s, fastest4steps 4 routed turbo steps 6.4 s, fastest2steps the TaoMate LoRA instead 2 routed steps 4.5 s", "sampling steps, 0 for the ones of --quality", "blocks first:last (of 50) every other evaluated step after the first two reuses, like 5:45, 10:40 or 15:35, off for none", "euler, res_multistep, er_sde, euler_ancestral, dpmpp_2m_sde, gradient_estimation or lcm (the last four but gradient_estimation add noise every step)", "simple, sgm_uniform, normal, beta, beta57, linear_quadratic or hyperflow (HyperFlow's 8 step grid)", "LoRA path[:strength] in models/loras or anywhere, repeat for more", "videos per run, each with its own random seed and prompt choices unless --seed is given, 0 for one per image of an --image folder (or prompt of a --prompt folder), else 1; a folder makes N random ones", "seed of every video, -1 for a random one per video", "width in pixels, a multiple of 16", "height in pixels, a multiple of 16", "frames at 24 fps, snapped up to 17k+5 like ComfyUI (124 is 5.2 s)", "numbered output base (.mp4), never overwritten")
Preset Numbers
	H3Options.Parsed(List(Text)).Preset is (8, 0, 0)
	H3Options.Parsed(("--quality", "faster")).Preset is (8, 1, 2)
	H3Options.Parsed(("--quality", "fastest2steps")).Preset is (2, 1, 0)
	((8, 0, 0), (8, 1, 0), (8, 1, 2), (4, 1, 0), (2, 1, 0))(quality)
Evaluated Number
	H3Options.Parsed(("--quality", "fastest4steps")).Evaluated is 4
	H3Options.Parsed(("--steps", "6")).Evaluated is 6
	steps > 0 then steps else Preset(0)
Numbers Numbers
	H3Options.Parsed(List(Text)).Numbers is (8, 12, 0, 1, 1, 0, 5, 45, 0, 0)
	H3Options.Parsed(("--quality", "faster", "--steps", "6", "--skip", "off", "--sampler", "lcm")).Numbers(2) is 2
	H3Options.Parsed(("--quality", "faster", "--steps", "6", "--skip", "off", "--sampler", "lcm")).Numbers(8) is 6
	H3Options.Parsed(("--scheduler", "beta57")).Numbers(9) is 4
	H3Options.Parsed(("--scheduler", "hyperflow")).Numbers(9) is 6
	let preset = Preset
	let blocks = Skipped
	(Evaluated, 12, preset(2), 1, 1, preset(1), blocks(0), blocks(1), Samplers.Index(sampler), Schedulers.Index(scheduler))
Skipped Numbers
	H3Options.Parsed(List(Text)).Skipped is (5, 45)
	H3Options.Parsed(("--skip", "off")).Skipped is (0, 0)
	H3Options.Parsed(("--skip", "45:5")).Skipped is Error("InvalidSkip")
	H3Options(skip = "-1:45").Skipped is Error("InvalidSkip") and H3Options(skip = "5:51").Skipped is Error("InvalidSkip")
	H3Options.Parsed(("--skip", "5:45:49")).Skipped is Error("InvalidSkip")
	if skip is "off"
		return (0, 0)
	let parts = skip.Split(":")
	let first = parts.First to Number
	let last = parts.Last to Number
	let valid = (parts.Length is 2) and (first >= 0) and (first < last) and (last <= 50)
	valid then (first, last) else Error("InvalidSkip")
Samplers Texts
	H3Options.Parsed(List(Text)).Samplers(2) is "er_sde"
	("euler", "res_multistep", "er_sde", "euler_ancestral", "dpmpp_2m_sde", "gradient_estimation", "lcm")
Schedulers Texts
	H3Options.Parsed(List(Text)).Schedulers(5) is "linear_quadratic"
	("simple", "sgm_uniform", "normal", "beta", "beta57", "linear_quadratic", "hyperflow")
IsNoisy Boolean
	H3Options.Parsed(("--sampler", "lcm")).IsNoisy
	H3Options.Parsed(("--sampler", "gradient_estimation")).IsNoisy is false
	sampler is in ("er_sde", "euler_ancestral", "dpmpp_2m_sde", "lcm")
Problem Text
	H3Options.Parsed(List(Text)).Problem is ""
	H3Options.Parsed(("--width", "500")).Problem is "--width and --height must be positive multiples of 16"
	H3Options.Parsed(("--sampler", "heun")).Problem.StartsWith("--sampler must be one of euler, ")
	H3Options.Parsed(("--count", "-1")).Problem is "--count must not be negative and --length at least 5"
	H3Options.Parsed(("--length", "4")).Problem is "--count must not be negative and --length at least 5"
	H3Options.Parsed(("--height", "500")).Problem is "--width and --height must be positive multiples of 16"
	H3Options(width = 0).Problem.StartsWith("--width") and H3Options(height = 0).Problem.StartsWith("--width")
	if (width < 16) or (height < 16) or (width % 16 is not 0) or (height % 16 is not 0)
		return "--width and --height must be positive multiples of 16"
	if (count < 0) or (length < 5)
		return "--count must not be negative and --length at least 5"
	Unsupported
Unsupported Text
	H3Options.Parsed(List(Text)).Unsupported is ""
	H3Options.Parsed(("--sampler", "heun")).Unsupported.StartsWith("--sampler must be one of euler, ")
	H3Options.Parsed(("--scheduler", "karras")).Unsupported.StartsWith("--scheduler must be one of simple, ")
	H3Options.Parsed(("--output", "a.gif")).Unsupported is "--output must end with .mp4"
	if sampler is not in Samplers
		return "--sampler must be one of " + Text.Combine(Samplers, ", ")
	if scheduler is not in Schedulers
		return "--scheduler must be one of " + Text.Combine(Schedulers, ", ")
	output.EndsWith(".mp4") then "" else "--output must end with .mp4"
Checkpoint Text
	H3Options.Parsed(("--models", ".")).Checkpoint is Error("FileNotFound:" + H3Video.Base)
	H3Options.Parsed(("--model", "tinyh3.safetensors")).Checkpoint is "tinyh3.safetensors"
	files.Checkpoint
Loras Text
	H3Options.Parsed(("--lora", "tinylora.safetensors:0.5", "--steps", "20")).Loras is "tinylora.safetensors=0.5"
	H3Options.Parsed(("--models", ".", "--quality", "fastest2steps")).Loras is Error
	H3Options.Parsed(("--models", ".")).Loras is Error("FileNotFound:" + H3Video.Turbo)
	H3Options.Parsed(("--models", ".", "--model", "a_Turbo_8step.safetensors")).Loras is ""
	let local = ModelFiles(files.models)
	let given = local.Specs(lora)
	if quality is H3Quality.Fastest2Steps
		return Text.Combine(List(Text) + (local.Located(H3Video.TaoMate, "loras") + "=1") + given, ";")
	let turbo = (files.model + Text.Combine(given, ";")).Lower.IndexOf("turbo") >= 0
	let nested = File(local.Folder + "/loras/h3/" + H3Video.Turbo).Exists then "h3/" + H3Video.Turbo else H3Video.Turbo
	let added = (Evaluated > 8) or turbo then List(Text) else List(Text) + (local.Located(nested, "loras") + "=1")
	Text.Combine(added + given, ";")
Shapes Numbers
	H3Options.Parsed(List(Text)).Shapes is (37, 52, 30, 207)
	H3Options.Parsed(("--length", "5", "--width", "32", "--height", "32")).Shapes is (2, 2, 2, 8)
	H3Options.Parsed(("--length", "125")).Shapes(0) is 42
	let frames = ((length - 5) / 17).Ceiling * 17 + 5
	((frames - 5) / 17 * 5 + 2, height / 16, width / 16, (frames / 24 * 40).Round)
