has files H3Files
has prompt = "prompt.txt"
has quality = H3Quality.Fast
has steps = 0
has skip = ""
has sampler = "euler"
has scheduler = "simple"
has lora Texts = List(Text)
has count = 0
has seed = -1
has width = 640
has height = 1152
has length = 124
has output = "H3Video.mp4"
constant LargeClip = 60000000
constant BestPresetHelp = "presets of model, steps, attention and Spectrum (124 frames at 640x1152 on a 4090): best the model with the turbo LoRA of ComfyUI's H3 template ("
constant TurboPresetHelp = "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors in models/loras, left out above 8 steps or with a model or LoRA named turbo) 8 steps 14 s, "
constant FastPresetsHelp = "fast with routed attention 11 s, faster with Spectrum 7.1 s, fastest4steps and fastest2steps 4 or 2 routed steps with the TaoMate 3 step LoRA instead (or a given turbo LoRA) 6.4 s and 4.5 s"
constant PromptHelp = ("UTF-8 prompt file, {a|b|c} picks one of them per video, or a folder of .txt prompts: an image uses the one of its name, else the next in sorted order", BestPresetHelp + TurboPresetHelp + FastPresetsHelp)
constant StepsHelp = ("sampling steps, 0 for the ones of --quality", "blocks first:last (of 50) every other evaluated step after the first two reuses, like 5:45, 10:40 or 15:35, off for none; best uses off unless --skip is set")
constant SamplerHelp = List(Text) + "euler, res_multistep, er_sde, euler_ancestral, dpmpp_2m_sde, gradient_estimation or lcm (the last four but gradient_estimation add noise every step)"
constant SchedulerHelp = ("simple, sgm_uniform, normal, beta, beta57, linear_quadratic or hyperflow (HyperFlow's 8 step grid)", "LoRA path[:strength] in models/loras or anywhere, repeat for more")
constant CountHelp = List(Text) + "videos per run, each with its own random seed and prompt choices unless --seed is given, 0 for one per image of an --image folder (or prompt of a --prompt folder), else 1; a folder makes N random ones"
constant SeedHelp = ("seed of every video, -1 for a random one per video", "width in pixels, rounded down to a multiple of 32", "height in pixels, rounded down to a multiple of 32")
constant OutputHelp = ("frames at 24 fps, snapped up to 17k+5 like ComfyUI (124 is 5.2 s)", "numbered output base (.mp4), never overwritten")
constant Help = PromptHelp + StepsHelp + SamplerHelp + SchedulerHelp + CountHelp + SeedHelp + OutputHelp
constant FourStepArguments = ("--quality", "fastest4steps")
constant TurboArguments = ("--lora", "a_turbo.safetensors")
constant TurboNames = ("--lora", "h3/a_Turbo_v4.safetensors:1", "--lora", "8step.safetensors", "--lora", "b_8step.safetensors")
constant GivenTurbo = "a_turbo.safetensors=1"
constant GivenTaoMate = "x_taomate.safetensors=1"
constant Miscounted = "--count must not be negative and --length at least 5"
Preset Numbers
	H3Options.Parsed(List(Text)).Preset is (8, 1, 0)
	H3Options.Parsed(("--quality", "faster")).Preset is (8, 1, 2)
	H3Options.Parsed(("--quality", "fastest2steps")).Preset is (2, 1, 0)
	((8, 0, 0), (8, 1, 0), (8, 1, 2), (4, 1, 0), (2, 1, 0))(quality)
Evaluated Number
	H3Options.Parsed(("--quality", "fastest4steps")).Evaluated is 4
	H3Options.Parsed(("--steps", "6")).Evaluated is 6
	steps > 0 then steps else Preset.First
Numbers Numbers
	H3Options.Parsed(List(Text)).Numbers is (8, 12, 0, 1, 1, 1, 5, 45, 0, 0)
	H3Options.Parsed(("--quality", "faster", "--steps", "6", "--skip", "off", "--sampler", "lcm")).Numbers(2) is 2
	H3Options.Parsed(("--quality", "faster", "--steps", "6", "--skip", "off", "--sampler", "lcm")).Numbers(8) is 6
	H3Options.Parsed(("--scheduler", "beta57")).Numbers(9) is 4
	H3Options.Parsed(("--scheduler", "hyperflow")).Numbers(9) is 6
	let preset = Preset
	let blocks = Skipped
	let indices = (Samplers.Index(sampler), Schedulers.Index(scheduler))
	(Evaluated, H3Format.Shift, preset(2), 1, 1, preset(1), blocks(0), blocks(1)) + indices
Skipped Numbers
	H3Options.Parsed(List(Text)).Skipped is (5, 45)
	H3Options.Parsed(("--quality", "best")).Skipped is (0, 0)
	H3Options.Parsed(("--skip", "45:5")).Skipped is Error("InvalidSkip")
	H3Options.Parsed(("--quality", "best", "--skip", "5:45")).Skipped is (5, 45)
	let used = skip is "" then (quality is H3Quality.Best then "off" else "5:45") else skip
	if used is "off"
		return (0, 0)
	let parts = used.Split(":")
	let first = parts.First to Number
	let last = parts.Last to Number
	let valid = (parts.Length is 2) and (first >= 0) and (first < last) and (last <= H3Format.Blocks)
	valid then (first, last) else Error("InvalidSkip")
Samplers Texts
	H3Options.Parsed(List(Text)).Samplers(2) is "er_sde"
	("euler", "res_multistep", "er_sde", "euler_ancestral", "dpmpp_2m_sde", "gradient_estimation", "lcm")
Schedulers Texts
	H3Options.Parsed(List(Text)).Schedulers(5) is "linear_quadratic"
	("simple", "sgm_uniform", "normal", "beta", "beta57", "linear_quadratic", "hyperflow")
IsNoisy Boolean
	H3Options.Parsed(("--sampler", "lcm")).IsNoisy
	H3Options.Parsed(("--sampler", "gradient_estimation")).IsNoisy is false
	sampler is in ("er_sde", "euler_ancestral", "dpmpp_2m_sde", "lcm")
Problem Text
	H3Options.Parsed(List(Text)).Problem is ""
	H3Options.Parsed(("--width", "500")).Problem is ""
	H3Options.Parsed(("--sampler", "heun")).Problem.StartsWith("--sampler must be one of euler, ")
	H3Options.Parsed(("--count", "-1")).Problem is Miscounted and H3Options.Parsed(("--length", "4")).Problem is Miscounted
	H3Options.Parsed(("--width", "720")).Fitted.width is 704
	H3Options.Parsed(("--height", "500")).Fitted.height is 480
	H3Options(width = 10).Fitted.width is 32 and H3Options(height = 10).Fitted.height is 32
	if (count < 0) or (length < 5)
		return Miscounted
	Unsupported
Unsupported Text
	H3Options.Parsed(List(Text)).Unsupported is ""
	H3Options.Parsed(("--sampler", "heun")).Unsupported.StartsWith("--sampler must be one of euler, ")
	H3Options.Parsed(("--output", "a.gif")).Unsupported is "--output must end with .mp4"
	H3Options.Parsed(FourStepArguments + TurboArguments).Unsupported is ""
	let unlisted = Unlisted
	if unlisted is not ""
		return unlisted
	output.EndsWith(".mp4") then "" else "--output must end with .mp4"
Unlisted Text
	H3Options.Parsed(List(Text)).Unlisted is ""
	H3Options.Parsed(("--sampler", "heun")).Unlisted.StartsWith("--sampler must be one of euler, ")
	H3Options.Parsed(("--scheduler", "karras")).Unlisted.StartsWith("--scheduler must be one of simple, ")
	if sampler is not in Samplers
		return "--sampler must be one of " + Text.Combine(Samplers, ", ")
	if scheduler is not in Schedulers
		return "--scheduler must be one of " + Text.Combine(Schedulers, ", ")
	""
IsFew Boolean
	H3Options.Parsed(("--quality", "fastest4steps")).IsFew
	H3Options.Parsed(("--quality", "fastest2steps")).IsFew and (H3Options.Parsed(List(Text)).IsFew is false)
	(quality is H3Quality.Fastest4Steps) or (quality is H3Quality.Fastest2Steps)
Turbos Texts
	H3Options.Parsed(TurboNames).Turbos.Length is 3
	H3Options.Parsed(("--lora", "h3/minimax_h3_taomate_3step.safetensors")).Turbos.Length is 0
	H3Options.Parsed(("--lora", "turbo.safetensors")).Turbos.Length is 1
	for lora
		let name = Path(value).FileName.text.Lower
		if (name.IndexOf("turbo") >= 0) or (name.IndexOf("8step") >= 0)
			value
IsLarge Boolean
	H3Options.Parsed(("--width", "384", "--height", "640")).IsLarge is false
	H3Options.Parsed(("--length", "53")).IsLarge is false
	H3Options.Parsed(List(Text)).IsLarge
	H3Options.Parsed(("--length", "294")).IsLarge
	H3Options.Parsed(("--width", "704", "--height", "1280")).IsLarge
	width * height * length >= LargeClip
Checkpoint Text
	H3Options.Parsed(("--models", ".")).Checkpoint is Error("FileNotFound:" + H3Video.Base)
	H3Options.Parsed(("--model", "tinyh3.safetensors")).Checkpoint is "tinyh3.safetensors"
	files.Checkpoint
Loras Text
	H3Options.Parsed(("--lora", "tinylora.safetensors:0.5", "--steps", "20")).Loras is "tinylora.safetensors=0.5"
	H3Options.Parsed(("--models", ".", "--quality", "fastest2steps")).Loras is Error
	H3Options.Parsed(("--models", ".")).Loras is Error("FileNotFound:" + H3Video.Turbo)
	H3Options.Parsed(("--models", ".", "--model", "a_Turbo_8step.safetensors")).Loras is ""
	let local = ModelFiles(files.models)
	let given = local.Specs(lora)
	if IsFew
		return Few(local, given)
	let turbo = (files.model + Text.Combine(given, ";")).Lower.IndexOf("turbo") >= 0
	let nested = File(local.Folder + "/loras/h3/" + H3Video.Turbo).Exists then "h3/" + H3Video.Turbo else H3Video.Turbo
	let added = (Evaluated > 8) or turbo then List(Text) else List(Text) + (local.Located(nested, "loras") + "=1")
	Text.Combine(added + given, ";")
Few(local ModelFiles, given Texts) Text
	H3Options.Parsed(FourStepArguments).Few(ModelFiles("."), List(Text) + GivenTaoMate) is GivenTaoMate
	H3Options.Parsed(("--quality", "fastest4steps")).Few(ModelFiles("."), List(Text) + "a.safetensors=1") is Error
	H3Options.Parsed(FourStepArguments + TurboArguments).Few(ModelFiles("."), List(Text) + GivenTurbo) is GivenTurbo
	let isGiven = (Turbos.Length > 0) or (Text.Combine(given, ";").Lower.IndexOf("taomate") >= 0)
	let added = isGiven then List(Text) else List(Text) + (local.Located(H3Video.TaoMate, "loras") + "=1")
	Text.Combine(added + given, ";")
Shapes Numbers
	H3Options.Parsed(List(Text)).Shapes is (37, 72, 40, 207)
	H3Options.Parsed(("--length", "5", "--width", "32", "--height", "32")).Shapes is (2, 2, 2, 8)
	H3Options.Parsed(("--length", "125")).Shapes(0) is 42
	let frames = ((length - 5) / H3Format.FrameGroup).Ceiling * H3Format.FrameGroup + 5
	let audio = (frames / H3Format.FramesPerSecond * H3Format.AudioPerSecond).Round
	let fitted = Fitted
	((frames - 5) / H3Format.FrameGroup * 5 + 2, fitted.height / 16, fitted.width / 16, audio)
Fitted H3Options
	H3Options.Parsed(("--width", "720", "--height", "1280")).Fitted.width is 704
	H3Options.Parsed(("--length", "5", "--width", "720")).Fitted.Problem is ""
	H3Options.Parsed(("--width", "368")).Fitted.width is 352
	let wide = ComfySize.Plain.Snap(width, 32)
	let high = ComfySize.Plain.Snap(height, 32)
	H3Options(value, width = wide, height = high)
