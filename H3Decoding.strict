has vae H3Vae
has sound H3Audio
has tinies List(Taeh3Decoder) = List(Taeh3Decoder)
constant Tiny = H3Decoding(H3Vae.Tiny, H3Audio.Tiny)
constant Fast = H3Decoding.Loaded(Taeh3Decoder.Path, "tinymodels/tinyh3audio.safetensors")
constant Latent = H3Vae.Model.Values("latent") + H3Audio.Latent
constant FastLatent = Taeh3Decoder.Latent + Taeh3Decoder.Latent + H3Audio.Latent
constant Both = Tiny.Decode(Latent, (12, 3, 4))
Loaded(video Text, audio Text) H3Decoding native
	Fast.tinies.Length is 1 and Tiny.tinies.Length is 0
	audioVae = H3Audio.Loaded(Safetensors(audio, 32))
	if Taeh3Decoder.IsTaeh3(video)
		return H3Decoding(H3Vae(H3Decoder.None, H3Tiles.Real), audioVae, List(Taeh3Decoder) + Taeh3Decoder.Loaded(video))
	H3Decoding(H3Vae(H3Decoder.Loaded(Safetensors(video, 32)), H3Tiles.Real), audioVae)
Decode(latent Numbers, shape Numbers) List(Numbers) native
	Both(0).Length is H3Vae.Pixels.Length and MossImage.RelativeError(Both(0), H3Vae.Pixels) < 0.00001
	Both(1) is H3Audio.Tiny.Normalize(H3Audio.Waveform)
	Fast.Decode(FastLatent, (2, 2, 3))(0).Length is 5 * Taeh3Decoder.Pixels.Length
	count = H3Format.Channels * shape(0) * shape(1) * shape(2)
	video = latent.Slice(0, count)
	frames = tinies.Length is 1 then tinies.First.Frames(video, shape) else vae.Decode(video, shape)
	(frames, sound.Normalize(sound.Decode(latent.Slice(count, latent.Length - count))))
Tiled(tiling H3Tiles) H3Decoding
	Tiny.Tiled(H3Tiles.Lean).vae.tiling is H3Tiles.Lean
	Tiny.Tiled(H3Tiles.Lean).vae.decoder is Tiny.vae.decoder
	H3Decoding(H3Vae(vae.decoder, tiling), sound, tinies)
Shapes(conditions List(Safetensors)) List(Numbers)
	Safetensors("tinymodels/h3decode.safetensors").Write(("video", "decode"), ((1, 2, 3), List(Number) + 1)) is not Error
	Tiny.Shapes(List(Safetensors) + Safetensors("tinymodels/h3decode.safetensors")).First is (3)
	Tiny.Shapes(List(Safetensors) + H3Video.Reference).First.Length is 0
	for conditions
		value.Entry("decode") is "" then List(Number) else H3Job(value).VideoShape
Write(file Text, shape Numbers, index Number) None native
	Safetensors("tinymodels/h3test-latent.safetensors").Write("latent", Latent) is not Error
	Tiny.Write("h3test", (24, 12, 3, 4), 0) is not Error
	File("h3test-decoded.rgb").Length is 359424
	Safetensors("tinymodels/h3test-decoded.safetensors", 32).Values("audio") is Both(1)
	before = Process.Elapsed
	decoded = Decode(Safetensors(file + "-latent.safetensors", 32).Values("latent"), shape.Slice(1, 3))
	File(file + "-decoded.rgb").Write(H3Frames.Bytes(decoded(0)))
	Safetensors(file + "-decoded.safetensors").Write("audio", decoded(1))
	logger.Log("decoded " + index + " in " + ((Process.Elapsed - before) * 1000).Round + " ms")
