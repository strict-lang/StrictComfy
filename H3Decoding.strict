has logger
has vae H3Vae
has sound H3Audio
constant Tiny = H3Decoding(Logger, H3Vae.Tiny, H3Audio.Tiny)
constant Latent = H3Vae.Model.Values("latent") + H3Audio.Latent
constant Both = Tiny.Decoded(Latent, (12, 3, 4))
Decoded(latent Numbers, shape Numbers) Slow(List(Numbers))
	(Both(0).Length is H3Vae.Pixels.Length) and (MossImage(Logger).RelativeError(Both(0), H3Vae.Pixels) < 0.00001)
	Both(1) is H3Audio.Tiny.Normalized(H3Audio.Waveform)
	let count = H3Format.Channels * shape(0) * shape(1) * shape(2)
	let frames = vae.Decoded(latent.Slice(0, count), shape)
	(frames, sound.Normalized(sound.Decoded(latent.Slice(count, latent.Length - count))))
Tiled(tiling H3Tiles) H3Decoding
	Tiny.Tiled(H3Tiles.Lean).vae.tiling is H3Tiles.Lean
	Tiny.Tiled(H3Tiles.Lean).vae.decoder is Tiny.vae.decoder
	H3Decoding(logger, H3Vae(vae.decoder, tiling), sound)
Shapes(conditions List(Safetensors)) List(Numbers)
	Safetensors("h3decode.safetensors").Written(("video", "decode"), ((1, 2, 3), List(Number) + 1)) is not Error
	Tiny.Shapes(List(Safetensors) + Safetensors("h3decode.safetensors")).First is (3)
	Tiny.Shapes(List(Safetensors) + H3Video.Reference).First.Length is 0
	for conditions
		value.Entry("decode") is "" then List(Number) else H3Job(value).VideoShape
Written(file Text, shape Numbers, index Number) Slow(Number)
	Safetensors("h3test-latent.safetensors").Written("latent", Latent) is not Error
	Tiny.Written("h3test", (24, 12, 3, 4), 0) is not Error
	File("h3test-decoded.rgb").Length is 359424
	Safetensors("h3test-decoded.safetensors", 32).Values("audio") is Both(1)
	let before = Process.Elapsed
	let decoded = Decoded(Safetensors(file + "-latent.safetensors", 32).Values("latent"), shape.Slice(1, 3))
	File(file + "-decoded.rgb").Write(H3Frames(logger).Bytes(decoded(0)))
	Safetensors(file + "-decoded.safetensors").Written("audio", decoded(1))
	logger.Log("decoded " + index + " in " + ((Process.Elapsed - before) * 1000).Round + " ms")
	File(file + "-decoded.safetensors").Length
