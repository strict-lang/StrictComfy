has attentionNorm Numbers
has feedNorm Numbers
has queryNorm Numbers
has keyNorm Numbers
has attention List(Numbers)
has output List(Numbers)
has expansion List(Numbers)
has reduction List(Numbers)
has adaln Batch
constant Model = Safetensors("tinyh3.safetensors")
constant Tiny = H3Block.Loaded(Model, "blocks.0.")
constant Input = Model.Values("reference.blocks.0.input")
constant Qkv = Model.Values("reference.blocks.0.attn.qkv_proj")
constant Layered = Tiny.Output(Input, Model.Values("reference.t_emb"), H3Layout.Tiny.Rows(0.75), H3Layout.Turning)
constant Epsilon = 0.00001
Loaded(model Safetensors, prefix Text) H3Block
	Tiny.attention.Length is 1536
	H3Block.Loaded(Model, "token_refiner.blocks.0.").adaln.weights.Length is 0
	let rows = Safetensors(model.path, 16, model.prefix + prefix)
	let first = rows.Values("norm1.weight")
	let second = rows.Values("norm2.weight")
	let queried = rows.Values("attn.q_norm.weight")
	let keyed = rows.Values("attn.k_norm.weight")
	let attended = Projection(rows, "attn.qkv_proj")
	let projected = Projection(rows, "attn.out_proj")
	let expanded = Projection(rows, "mlp.fc1")
	let reduced = Projection(rows, "mlp.fc2")
	H3Block(first, second, queried, keyed, attended, projected, expanded, reduced, Curved(model, prefix))
Projection(rows Safetensors, name Text) List(Numbers)
	Tiny.Projection(Safetensors(Model.path, 16, "token_refiner.blocks.0."), "mlp.fc2").Length is 256
	rows.Entry(name + ".comfy_quant") is "" then rows.Rows(name + ".weight") else rows.Quantized(name)
Curved(model Safetensors, prefix Text) Batch
	Tiny.Curved(Model, "blocks.1.").biases.Length is 4608
	let curves = Safetensors(model.path, 32, model.prefix + prefix)
	if curves.Entry("adaln_proj.linear.weight") is ""
		return Batch(List(Numbers), MossLora.Unbiased)
	MossText.Dense(curves, "adaln_proj.linear")
Output(input Numbers, curves Numbers, starts Numbers, rotation Numbers) Numbers
	Layered(0).IsNearlyEqual(-1.015625, 0.03)
	Layered(2309).IsNearlyEqual(0.40625, 0.03)
	Layered(4351).IsNearlyEqual(0.304688, 0.03)
	let modulation = adaln.Sums(curves)
	let normed = Modulated(input, attentionNorm, modulation, starts, 0)
	let attended = Gated(input, Attended(normed, rotation), modulation, starts, 2)
	Gated(attended, FedForward(Modulated(attended, feedNorm, modulation, starts, 3)), modulation, starts, 5)
Refined(input Numbers, rotation Numbers) Numbers
	H3Block.Loaded(Model, "token_refiner.blocks.0.").Refined(Input, H3Layout.Tiny.Unturned).Length is 4352
	let combined = Batch(attention, MossLora.Unbiased).Sums(Normalized(input, attentionNorm))
	let attended = MossText.Added(input, Batch(output, MossLora.Unbiased).Sums(Merged(combined, rotation)))
	let expanded = Batch(expansion, MossLora.Unbiased).Sums(Normalized(attended, feedNorm))
	MossText.Added(attended, Batch(reduction, MossLora.Unbiased).Sums(Activated(expanded, reduction.First.Length)))
Attended(normed Numbers, rotation Numbers) Numbers
	Tiny.Attended(Model.Values("reference.blocks.0.attn.input"), H3Layout.Turning)(0).IsNearlyEqual(-0.328125, 0.03)
	Tiny.Attended(Model.Values("reference.blocks.0.attn.input"), H3Layout.Turning)(3079).IsNearlyEqual(-0.205078, 0.03)
	let merged = Merged(Batch(attention, MossLora.Unbiased).Sums(Convrot(normed).Rotated), rotation)
	Batch(output, MossLora.Unbiased).Sums(Convrot(merged).Rotated)
Merged(combined Numbers, rotation Numbers) Numbers
	Tiny.Merged(Qkv, H3Layout.Turning)(0).IsNearlyEqual(-0.519531, 0.02)
	Tiny.Merged(Qkv, H3Layout.Turning)(4611).IsNearlyEqual(-0.022339, 0.02)
	Tiny.Merged(Qkv, H3Layout.Turning)(8703).IsNearlyEqual(0.490234, 0.02)
	let size = queryNorm.Length
	let width = combined.Length / (rotation.Length / 2 / size) / 3
	let scales = Qwen3Block.Scales(combined, size, Epsilon)
	let queries = Rotated(combined, 0, width, queryNorm, rotation, scales)
	let keys = Rotated(combined, width, width, keyNorm, rotation, scales)
	let values = Batch.Columns(combined, 3 * width, 2 * width, width)
	Attention(queries, keys, values, width / size, width / size, size, 1, false).Merged
Rotated(combined Numbers, start Number, width Number, weights Numbers, rotation Numbers, scales Numbers) Numbers
	Tiny.Rotated(Qkv, 0, 512, Tiny.queryNorm, H3Layout.Turning, Qkv).Length is 8704
	let size = weights.Length
	for combined.Length / 3
		let token = (index / width).Floor
		let within = index % size
		let first = index - within + token * 2 * width + start
		let paired = within < 2 * H3Layout.Half then (within + H3Layout.Half) % (2 * H3Layout.Half) else within
		let own = combined(first + within) * weights(within) * rotation(token * 2 * size + within)
		let other = combined(first + paired) * weights(paired) * rotation((token * 2 + 1) * size + within)
		(own + other) * scales((first / size).Floor)
FedForward(normed Numbers) Numbers
	Tiny.FedForward(Model.Values("reference.blocks.0.mlp.input"))(0).IsNearlyEqual(0.046875, 0.02)
	Tiny.FedForward(Model.Values("reference.blocks.0.mlp.input"))(2309).IsNearlyEqual(-1.125, 0.03)
	let expanded = Batch(expansion, MossLora.Unbiased).Sums(Convrot(normed).Rotated)
	let activated = Activated(expanded, reduction.First.Length)
	Batch(reduction, MossLora.Unbiased).Sums(Convrot(activated).Rotated)
Activated(expanded Numbers, width Number) Numbers
	Tiny.Activated((2, 1, 3, 0), 1)(0).IsNearlyEqual(1.761594)
	Tiny.Activated((2, 1, 3, 0), 1)(1) is 0
	for expanded.Length / 2
		let first = (index / width).Floor * 2 * width + index % width
		let gate = expanded(first)
		gate / (1 + (0 - gate).Exponential) * expanded(first + width)
Normalized(input Numbers, weights Numbers) Numbers
	Tiny.Normalized((3, 4), (1, 2))(1).IsNearlyEqual(2.262742)
	let width = weights.Length
	let scales = Qwen3Block.Scales(input, width, Epsilon)
	for input.Length
		input(index) * scales((index / width).Floor) * weights(index % width)
Modulated(input Numbers, weights Numbers, modulation Numbers, starts Numbers, part Number) Numbers
	Tiny.Modulated((3, 4), (1, 2), (0.5, 0, 0, 1), List(Number) + 0, 0)(1).IsNearlyEqual(4.525483)
	Tiny.Modulated((3, 4), (1, 2), (9, 9, 0.5, 0, 0, 1), List(Number) + 1, 0)(0).IsNearlyEqual(1.348528)
	let width = weights.Length
	let scales = Qwen3Block.Scales(input, width, Epsilon)
	for input.Length
		let token = (index / width).Floor
		let at = (starts(token) + part) * width + index % width
		input(index) * scales(token) * weights(index % width) * (1 + modulation(at + width)) + modulation(at)
Gated(input Numbers, update Numbers, modulation Numbers, starts Numbers, part Number) Numbers
	H3Block(Tiny, attentionNorm = (1, 1)).Gated((1, 2), (3, 4), (0, 0, 0, 0, 2, 3), List(Number) + 0, 2) is (7, 14)
	let width = attentionNorm.Length
	for input.Length
		input(index) + update(index) * modulation((starts((index / width).Floor) + part) * width + index % width)