has attentionNorm Numbers
has feedNorm Numbers
has queryNorm Numbers
has keyNorm Numbers
has attention List(Numbers)
has output List(Numbers)
has expansion List(Numbers)
has reduction List(Numbers)
has adaln Batch
has deltas List(MossLora) = List(MossLora)
constant Model = Safetensors("tinymodels/tinyh3.safetensors")
constant Tiny = H3Block.Loaded(Model, "blocks.0.")
constant Input = Model.Values("reference.blocks.0.input")
constant Layered = Tiny.Output(Input, Model.Values("reference.t_emb"), H3Layout.Tiny.Rows(0.75), Rope.Turning)
constant Epsilon = 0.00001
Loaded(model Safetensors, prefix Text, loras = "") H3Block slow
	Tiny.attention.Length is 1536
	rows = Safetensors(model.path, 16, model.prefix + prefix)
	first = H3Lora(loras).Values(model, prefix + "norm1")
	second = H3Lora(loras).Values(model, prefix + "norm2")
	queried = model.Values(prefix + "attn.q_norm.weight")
	keyed = model.Values(prefix + "attn.k_norm.weight")
	qkv = (H3Ahead(loras).Start(rows, "attn.out_proj"), Merge(rows, "attn.qkv_proj", loras, prefix, List(Numbers)))
	projected = (H3Ahead(loras).Start(rows, "mlp.fc1"), Merge(rows, "attn.out_proj", loras, prefix, qkv(0)))
	expanded = (H3Ahead(loras).Start(rows, "mlp.fc2"), Merge(rows, "mlp.fc1", loras, prefix, projected(0)))
	reduced = Merge(rows, "mlp.fc2", loras, prefix, expanded(0))
	curved = Curve(model, prefix, loras)
	H3Block(first, second, queried, keyed, qkv(1), projected(1), expanded(1), reduced, curved, Deltas(rows, loras, prefix))
Deltas(rows Safetensors, loras Text, prefix Text) List(MossLora) slow
	H3Lora.Block.deltas.Length is 0
	H3Block.Loaded(Model, "token_refiner.blocks.0.", H3Lora.Half.loras).deltas.Length is 4
	rows.Entry("attn.qkv_proj.comfy_quant") is "" then H3Lora(loras).Tuning(prefix) else List(MossLora)
Projection(rows Safetensors, name Text) List(Numbers) slow
	Tiny.Projection(Safetensors(Model.path, 16, "token_refiner.blocks.0."), "mlp.fc2").Length is 256
	rows.Entry(name + ".comfy_quant") is "" then rows.Rows(name + ".weight") else rows.Quantize(name)
Merge(rows Safetensors, name Text, loras Text, prefix Text, prepared List(Numbers)) List(Numbers) native
	Tiny.Merge(Safetensors(Model.path, 16), "blocks.0.mlp.fc2", "", "", List(Numbers)) is Tiny.reduction
	H3Lora.Block.attention is not Tiny.attention
	MossImage.RelativeError(H3Lora.Layered, H3Lora.Reference.Values("blocks.0")) < 0.02
	if rows.Entry(name + ".comfy_quant") is ""
		return Projection(rows, name)
	H3Ahead(loras).Prepare(rows, name, prefix, prepared)
Curve(model Safetensors, prefix Text, loras = "") Batch slow
	Tiny.Curve(Model, "blocks.1.").biases.Length is 4608
	H3Block.Loaded(Model, "token_refiner.blocks.0.").adaln.weights.Length is 0
	if model.Entry(prefix + "adaln_proj.linear.weight") is ""
		return Batch(List(Numbers), Layer.Unbiased)
	H3Lora(loras).Dense(model, prefix + "adaln_proj.linear")
Output(input Numbers, curves Numbers, starts Numbers, rotation Numbers, routing = 0, exact = 0) Numbers slow
	Layered(0).IsNearlyEqual(-1.015625, 0.03)
	Layered(2309).IsNearlyEqual(0.40625, 0.03)
	Layered(4351).IsNearlyEqual(0.304688, 0.03)
	modulation = adaln.Sums(curves)
	normed = Modulate(input, attentionNorm, modulation, starts, 0)
	attended = Gate(input, Attend(normed, rotation, routing, exact), modulation, starts, 2)
	fed = FedForward(Modulate(attended, feedNorm, modulation, starts, 3), H3Layout.Chunk)
	Gate(attended, fed, modulation, starts, 5)
Refine(input Numbers, rotation Numbers, rotated Boolean) Numbers native
	H3Block.Loaded(Model, "token_refiner.blocks.0.").Refine(Input, Rope.Turning, false).Length is 4352
	merged = Heads(Project(0, attention, Normalize(input, attentionNorm), rotated), rotation).Merged
	attended = MossText.Add(input, Project(1, output, merged, rotated))
	expanded = Project(2, expansion, Normalize(attended, feedNorm), rotated)
	MossText.Add(attended, Project(3, reduction, Activate(expanded, reduction.First.Length), rotated))
Project(linear Number, rows List(Numbers), input Numbers, rotated = true) Numbers native
	Tiny.Project(0, Tiny.attention, Model.Values("reference.blocks.0.attn.input"))(0).IsNearlyEqual(-1.71875, 0.03)
	Tiny.Project(0, Tiny.attention, Model.Values("reference.blocks.0.attn.input"))(1000).IsNearlyEqual(-1.046875, 0.03)
	MossLora.Apply(deltas, linear, Batch(rows, Layer.Unbiased).Sums(Convrot(input).Apply(rotated)), input)
Attend(normed Numbers, rotation Numbers, routing = 0, exact = 0) Numbers native
	Tiny.Attend(Model.Values("reference.blocks.0.attn.input"), Rope.Turning)(0).IsNearlyEqual(-0.328125, 0.03)
	Tiny.Attend(Model.Values("reference.blocks.0.attn.input"), Rope.Turning)(3079).IsNearlyEqual(-0.205078, 0.03)
	merged = Attending(Convrot(normed).Rotated, rotation, routing, exact)
	Batch(output, Layer.Unbiased).Sums(Convrot(merged).Rotated)
Attending(input Numbers, rotation Numbers, routing Number, exact Number) Numbers slow
	Open(input, rotation, routing, exact).Merged
Open(input Numbers, rotation Numbers, routing Number, exact Number) Attention slow
	Heads(Batch(attention, Layer.Unbiased).Sums(input), rotation, routing, exact)
Heads(combined Numbers, rotation Numbers, routing = 0, exact = 0) Attention native
	Tiny.Heads(Model.Values("reference.blocks.0.attn.qkv_proj"), Rope.Turning).Merged(0).IsNearlyEqual(-0.519531, 0.02)
	Tiny.Heads(Model.Values("reference.blocks.0.attn.qkv_proj"), Rope.Turning).Merged(4611).IsNearlyEqual(-0.022339, 0.02)
	Tiny.Heads(Model.Values("reference.blocks.0.attn.qkv_proj"), Rope.Turning).Merged(8703).IsNearlyEqual(0.490234, 0.02)
	size = queryNorm.Length
	width = combined.Length / (rotation.Length / 2 / size) / 3
	queries = Rope.Video.Rotate(combined, 0, width, queryNorm, rotation)
	keys = Rope.Video.Rotate(combined, width, width, keyNorm, rotation)
	values = Batch.Columns(combined, 3 * width, 2 * width, width)
	Attention(queries, keys, values, width / size, width / size, size, 1, false, 0, 0, true, routing, exact)
FedForward(normed Numbers, chunk Number) Numbers native
	Tiny.FedForward(Model.Values("reference.blocks.0.mlp.input"), H3Layout.Chunk)(2309).IsNearlyEqual(-1.125, 0.03)
	Tiny.FedForward(Model.Values("reference.blocks.0.mlp.input"), 5)(2309).IsNearlyEqual(-1.125, 0.03)
	width = attentionNorm.Length
	tokens = normed.Length / width
	if tokens <= chunk
		return Fed(normed)
	mutable fed = List(Number)
	for ((tokens - 1) / chunk).Floor + 1
		first = index * chunk
		count = tokens - first < chunk then tokens - first else chunk
		fed = fed + Fed(Safetensors.Part(normed, first * width, count * width, 1))
	fed
Fed(normed Numbers) Numbers native
	Tiny.Fed(Model.Values("reference.blocks.0.mlp.input"))(0).IsNearlyEqual(0.046875, 0.02)
	activated = Batch(expansion, Layer.Unbiased).Gate(Convrot(normed).Rotated)
	Batch(reduction, Layer.Unbiased).Sums(Convrot(activated).Rotated)
Activate(expanded Numbers, width Number) BFloat16s slow
	Tiny.Activate((2, 1, 3, 0), 1)(0).IsNearlyEqual(1.761594)
	Tiny.Activate((2, 1, 3, 0), 1)(1) is 0
	for expanded.Length / 2
		first = (index / width).Floor * 2 * width + index % width
		gate = expanded(first)
		gate / (1 + (-gate).Exponential) * expanded(first + width)
Normalize(input Numbers, weights Numbers) Numbers slow
	Tiny.Normalize((3, 4), (1, 2))(1).IsNearlyEqual(2.262742)
	RowModulated(input, weights, List(Number), List(Number), 0, Epsilon).Modulated
Modulate(input Numbers, weights Numbers, modulation Numbers, starts Numbers, part Number) BFloat16s slow
	Tiny.Modulate((3, 4), (1, 2), (0.5, 0, 0, 1), List(Number) + 0, 0)(1).IsNearlyEqual(4.525483)
	Tiny.Modulate((3, 4), (1, 2), (9, 9, 0.5, 0, 0, 1), List(Number) + 1, 0)(0).IsNearlyEqual(1.348528)
	RowModulated(input, weights, modulation, starts, part, Epsilon).Modulated
Gate(input Numbers, update Numbers, modulation Numbers, starts Numbers, part Number) BFloat16s slow
	H3Block(Tiny, attentionNorm = (1, 1)).Gate((1, 2), (3, 4), (0, 0, 0, 0, 2, 3), List(Number) + 0, 2) is (7, 14)
	width = attentionNorm.Length
	for input.Length
		input(index) + update(index) * modulation((starts((index / width).Floor) + part) * width + index % width)