has model Safetensors
has problem = ""
constant Tiny = H3AudioEncoder.Loaded(H3Conv.Model)
constant Rates = (2, 4, 4, 5, 5)
constant Dilations = (1, 3, 9)
constant SamplesPerFrame = 800
constant TripleChannels = 6144
Loaded(weights Safetensors) H3AudioEncoder
	H3AudioEncoder.Loaded(H3Conv.Model).problem is "NoAudioEncoder"
	if weights.Entry("encoder.block.0.weight") is ""
		return H3AudioEncoder(weights, problem = "NoAudioEncoder")
	H3AudioEncoder(weights)
Encode(waveform Numbers, frames Number) Numbers slow
	Tiny.Encode((1, -1), 4) is Error("NoAudioEncoder")
	if problem is not ""
		return Error(problem)
	wanted = frames * SamplesPerFrame
	half = waveform.Length / 2
	left = Side(Fit(waveform.Slice(0, half), wanted))
	right = Side(Fit(waveform.Slice(half, half), wanted))
	Interleave(Normalize(left, frames), Normalize(right, frames), frames)
Snake(signal Numbers, alpha Numbers) Numbers
	H3AudioEncoder.Snake(0, 1) is (0)
	H3AudioEncoder.Snake(1, 2).First.IsNearlyEqual(1.4134109, 0.0001)
	channels = alpha.Length
	for signal.Length
		raw = alpha(index % channels)
		scale = raw is 0 then 1 else raw
		wave = (Radians(scale * signal(index)) to Degrees).Sin.number
		signal(index) + wave * wave / scale
Down(signal Numbers, weights Numbers, biases Numbers, stride Number, channels Number) Numbers
	H3AudioEncoder.Down((1, 2, 3, 4, 5, 6, 7, 8), (0, 0, 0, 0), 5, 2, 1) is (5, 5, 5, 5)
	H3AudioEncoder.Down((1, 2, 3, 4), (0, 1), 0, 2, 1) is (1, 3, 0)
	H3AudioEncoder.Down((1, 9, 2, 8, 3, 7, 4, 6), (1, 0), 0, 2, 2) is (0, 2, 4)
	outputs = biases.Length
	kernel = weights.Length / outputs / channels
	time = signal.Length / channels
	pad = ((stride + 1) / 2).Floor
	for (((time + 2 * pad - kernel) / stride).Floor + 1) * outputs
		Dot(signal, weights, biases, stride, channels, kernel, pad, time, (index / outputs).Floor, index % outputs)
Dot(signal Numbers, weights Numbers, biases Numbers, stride Number, channels Number, kernel Number, pad Number, time Number, at Number, output Number) Number
	H3AudioEncoder.Dot((1, 2), (0, 0), 4, 2, 1, 2, 1, 2, 0, 0) is 4
	H3AudioEncoder.Dot((3, 4), (0, 5), 1, 2, 1, 2, 1, 2, 0, 0) is 16
	H3AudioEncoder.Dot((1, 2, 3, 4), (3, 4), 1, 1, 2, 1, 0, 2, 0, 0) is 12
	mutable sum = biases(output)
	for kernel * channels
		tap = (index / channels).Floor
		input = index % channels
		place = at * stride + tap - pad
		inside = place >= 0 and place < time
		weight = (output * channels + input) * kernel + tap
		sum = sum + (inside then signal(place * channels + input) * weights(weight) else 0)
	sum
Fit(samples Numbers, count Number) Numbers
	H3AudioEncoder.Fit((1, 2, 3), 2) is (2, 3)
	H3AudioEncoder.Fit((9, 8, 7), 1) is (7)
	H3AudioEncoder.Fit(1, 3) is (0, 0, 1)
	drop = samples.Length - count
	drop >= 0 then samples.Slice(drop, count) else Layer.Zeros(-drop) + samples
Side(samples Numbers) Numbers slow
	mutable state = H3Conv.Loaded(model, "encoder.block.0", 1).Output(samples)
	for Rates
		state = Block(state, index + 1, value)
	state = Snake(state, model.Values("encoder.block.6.alpha"))
	Project(H3Conv.Loaded(model, "encoder.block.7", 1).Output(state))
Block(signal Numbers, block Number, stride Number) Numbers slow
	mutable state = signal
	for Dilations
		prefix = "encoder.block." + block + ".block." + index + ".block."
		first = Snake(state, model.Values(prefix + "0.alpha"))
		second = Snake(H3Conv.Loaded(model, prefix + "1", value).Output(first), model.Values(prefix + "2.alpha"))
		state = Gpt2Block.Add(state, H3Conv.Loaded(model, prefix + "3", 1).Output(second))
	name = "encoder.block." + block + ".block.4"
	snake = Snake(state, model.Values("encoder.block." + block + ".block.3.alpha"))
	Down(snake, model.Values(name + ".weight"), model.Values(name + ".bias"), stride, 64 * 2 ^ (block - 1))
Project(signal Numbers) Numbers slow
	reduced = Linear(Gpt2Block.Add(signal, Attend(Norm(signal, "pre_block.norm1", 2048))), "pre_block.proj")
	normed = Norm(reduced, "pre_block.norm2", 32)
	widened = Gpt2Block.Add(Linear(normed, "pre_block.mlp.w0"), Linear(normed, "pre_block.mlp.w1"))
	Linear(Gpt2Block.Add(reduced, Linear(widened, "pre_block.mlp.w2")), "mean_proj")
Norm(signal Numbers, name Text, channels Number) Numbers
	weight = model.Values(name + ".weight")
	bias = model.Values(name + ".bias")
	for signal.Length
		shift = Shift(signal, (index / channels).Floor * channels, channels)
		(signal(index) - shift(0)) / shift(1) * weight(index % channels) + bias(index % channels)
Shift(signal Numbers with value.Bits is 32, start Number, channels Number) Numbers
	mutable sum = 0
	mutable square = 0
	for channels
		sum = sum + signal(start + index)
	mean = sum / channels
	for channels
		square = square + (signal(start + index) - mean) * (signal(start + index) - mean)
	(mean, (square / channels + 0.00001).SquareRoot)
Attend(signal Numbers) Numbers slow
	biased = Biase(H3Conv(model.Values("pre_block.attn.qkv.weight"), Layer.Zeros(TripleChannels), 1, 1).Output(signal))
	time = signal.Length / 2048
	for signal.Length
		Weight(biased, time, (index / 2048).Floor, index % 2048)
Biase(mixed Numbers) Numbers
	query = model.Values("pre_block.attn.q_bias")
	seen = model.Values("pre_block.attn.v_bias")
	for mixed.Length
		channel = index % TripleChannels
		extra = channel < 2048 then query(channel) else (channel >= 4096 then seen(channel - 4096) else 0)
		mixed(index) + extra
Weight(mixed Numbers, time Number, at Number, channel Number) Number
	mutable sum = 0
	mutable weight = 0
	for time
		share = Score(mixed, at, index).Exponential
		weight = weight + share
		sum = sum + share * mixed(index * TripleChannels + 4096 + channel)
	sum / (weight + 0.000000001)
Score(mixed Numbers, at Number, other Number) Number
	first = at * TripleChannels
	second = other * TripleChannels + 2048
	mutable sum = 0
	for 2048
		sum = sum + mixed(first + index) * mixed(second + index)
	sum / 2048.SquareRoot
Linear(signal Numbers, name Text) Numbers slow
	shape = model.Shape(name + ".weight")
	kernel = shape.Length > 2 then shape.Last else 1
	bias = model.Entry(name + ".bias") is "" then Layer.Zeros(shape(0)) else model.Values(name + ".bias")
	H3Conv(model.Values(name + ".weight"), bias, kernel, 1).Output(signal)
Normalize(side Numbers, frames Number) Numbers
	mean = model.Values("latents_mean")
	deviation = model.Values("latents_std")
	have = side.Length / 32
	for 32 * frames
		channel = (index / frames).Floor
		time = index % frames
		step = have >= frames then have - frames + time else time.Clamp(0, have - 1)
		(side(step * 32 + channel) - mean(channel)) / deviation(channel)
Interleave(left Numbers, right Numbers, frames Number) Numbers
	for 32 * 2 * frames
		time = index % frames
		row = (index / frames).Floor
		channel = (row / 2).Floor
		row % 2 is 0 then left(channel * frames + time) else right(channel * frames + time)
