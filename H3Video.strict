has logger
constant Reference = Safetensors("tinyh3.safetensors", 32, "reference.")
constant Shapes = Safetensors("tinyh3.safetensors", 32)
constant Keyed = Safetensors("tinyh3.safetensors", 32, "reference.i2v.")
constant Tiny = H3Video(Logger)
constant Solved = Solver(1, Euler(4, 12).Sigmas, H3Video.Reference.Values("video"))
constant Turbo = "Minimax_H3_FL2VA_PRUNED_Turbo_8step_v1.0_768p_comfyui_INT8_.safetensors"
constant Base = "minimax_h3_fl2va_pruned_int8_convrot.safetensors"
constant Positional = "dumps model name loras steps shift period warmup degree routing first last sampler scheduler"
Run(arguments Texts) Number
	if "--help" is in arguments
		logger.Log("H3Video.exe [options] makes H3 videos with sound, diagnostic arguments: " + Positional)
		logger.Log(H3Options.Usage)
		return 0
	if (arguments.Length is 0) or (arguments(0).StartsWith("-") and (arguments(0) is not "-"))
		return H3Batch(logger, H3Options.Parsed(arguments)).Run
	if arguments.Length < 2
		logger.Log("--help or: " + Positional)
		return 2
	Diagnosed(arguments)
Diagnosed(arguments Texts) Number
	let loras = GenerationCommand.Option(arguments, 3, "")
	if arguments(0) is "-"
		return Served(Loaded(arguments(1), loras), H3Refiner.Loaded(arguments(1), loras), arguments)
	let conditions = Conditions(arguments(0))
	let texts = H3Refiner.Loaded(arguments(1), loras).Texts(conditions)
	Generations(Loaded(arguments(1), loras), conditions, texts, arguments(0), arguments)
	0
Served(h3 H3, refiner H3Refiner, arguments Texts) Number
	mutable dumps = Process.InputLine
	for as long as dumps is not ""
		let conditions = Conditions(dumps)
		Generations(h3, conditions, refiner.Texts(conditions), dumps, arguments)
		dumps = Process.InputLine
	0
Numbered(arguments Texts) Numbers
	H3Video(Logger).Numbered(("dumps", "model", "name", "", "3")) is (3, 12, 0, 1, 1, 0, 0, 0, 0, 0)
	for (0, 12, 0, 1, 1, 0, 0, 0, 0, 0)
		arguments.Length > index + 4 then arguments(index + 4) to Number else value
Loaded(model Text, loras Text) Slow(H3)
	H3Video(Logger).Loaded("tinyh3.safetensors", "").blocks.Length is 2
	let started = Process.Elapsed
	let h3 = H3.Loaded(model, loras)
	logger.Log("loaded in " + (Process.Elapsed - started).Round(1) + " s" + H3Lora(loras).Report)
	h3
Conditions(dumps Text) List(Safetensors)
	H3Video(Logger).Conditions(".").Length is 1
	let data = Safetensors(dumps + "/generation.safetensors", 32)
	if File(data.path).Exists is false
		return List(Safetensors) + Safetensors(dumps + "/conditioning.safetensors", 64)
	for GenerationCommand.Count(data)
		GenerationCommand.Job(data, dumps, index)
Generations(h3 H3, conditions List(Safetensors), texts List(Numbers), dumps Text, arguments Texts) None
	let numbers = Numbered(arguments)
	let name = GenerationCommand.Option(arguments, 2, "strict")
	for conditions
		let before = Process.Elapsed
		let sampled = Generated(h3, value, H3Job(Steps(dumps, value)), texts(index), numbers, dumps)
		let file = value.Entry("video") is "" then name else name + "-" + index
		Safetensors(dumps + "/" + file + "-latent.safetensors").Written("latent", sampled)
		if index is conditions.Length - 1
			GpuMemory.Evicted
		else
			GpuMemory.Released
		logger.Log("generation " + index + " in " + ((Process.Elapsed - before) * 1000).Round + " ms")
Steps(dumps Text, condition Safetensors) Slow(Safetensors)
	H3Video(Logger).Steps("", Reference) is Reference
	condition.Entry("video") is "" then Safetensors(dumps + "/steps.safetensors", 64) else condition
Generated(h3 H3, condition Safetensors, job H3Job, text Numbers, numbers Numbers, dumps Text) Slow(Numbers)
	Tiny.Generated(H3.Tiny, Keyed, H3Job.Reference, H3.Prompt, (1, 12, 0, 1, 1, 0, 0, 0, 1, 1), "").Length is 960
	let shaped = Layout(job.VideoShape, job.AudioShape, condition)
	let keyframes = job.Keyframes(shaped.keyframes)
	let layout = H3Layout(shaped, keyframes = keyframes, shift = numbers(1), routing = numbers(5))
	let rows = job.Rows(condition)
	if File(dumps + "/step0.safetensors").Exists
		Compared(h3, Safetensors(dumps + "/step0.safetensors", 32), text, layout, 1)
	let count = numbers(0) is 0 then job.Count else numbers(0)
	let span = H3Span(numbers(6), numbers(7))
	let spectrum = H3Spectrum(count, SpectralFit(numbers(4), 0.1, 0.5), numbers(2), numbers(3), span = span)
	let sigmas = Euler(count, numbers(1)).Scheduled(numbers(9), numbers(8))
	Sampled(h3, job, text, layout, rows, spectrum, Solver(numbers(8), sigmas, job.Video))
Layout(video Numbers, audio Numbers, condition Safetensors) Slow(H3Layout)
	H3Video(Logger).Layout(Shapes.Shape("reference.video"), Shapes.Shape("reference.audio"), Keyed).Tokens is 17
	H3Video(Logger).Layout(Shapes.Shape("reference.video"), Shapes.Shape("reference.audio"), Keyed).tags(1) is 0
	let keyframes = condition.Entry("keyframes") is "" then List(Number) else condition.Values("keyframes")
	H3Layout(condition.Values("tags"), keyframes, audio.Last, video(1), video(2), video(3))
Compared(h3 H3, first Safetensors, text Numbers, layout H3Layout, sigma Number) Slow(Number)
	H3Video(Logger).Compared(H3.Tiny, Reference, H3.Prompt, H3Layout.Tiny, 0.75) < 0.05
	let curves = h3.Curves(layout.Times(sigma))
	let named = first.Entry("text") is "" then "token_refiner" else "text"
	logger.Log("refined text error " + MossImage(logger).Error(text, first.Values(named)))
	logger.Log("curve rows error " + MossImage(logger).Error(curves, first.Values("t_emb")))
	Layered(h3, first, curves, layout, sigma)
Layered(h3 H3, first Safetensors, curves Numbers, layout H3Layout, sigma Number) Slow(Number)
	H3Video(Logger).Layered(H3.Tiny, Reference, Reference.Values("t_emb"), H3Layout.Tiny, 0.75) < 0.05
	let rotation = h3.Rotation(layout)
	let starts = layout.Rows(sigma)
	mutable state = first.Values("blocks.0.input")
	mutable error = 0
	for h3.blocks
		state = value.Output(state, curves, starts, rotation, h3.Routed(layout.routing, index), h3.Leading(layout))
		let name = "blocks." + index
		if first.Entry(name) is not ""
			error = MossImage(logger).Error(state, first.Values(name))
			logger.Log("block " + index + " error " + error)
	error
Sampled(h3 H3, job H3Job, text Numbers, layout H3Layout, conditions Numbers, spectrum H3Spectrum, solver Solver) Slow(Numbers)
	Tiny.Sampled(H3.Tiny, H3Job.Reference, H3.Prompt, H3Layout.Tiny, List(Number), H3Spectrum.Tiny, Solved).Length is 960
	let rotation = h3.Rotation(layout)
	mutable seen = solver
	mutable heard = Solver(seen, sigmas = layout.AudioSigmas(seen.sigmas), latent = job.Audio)
	mutable state = spectrum
	for spectrum.steps
		let before = Process.Elapsed
		state = state.Advanced(h3, seen.latent, heard.latent, solver.sigmas(index), text, layout, conditions, rotation, index)
		seen = state.Stepped(seen, index, job)
		heard = heard.Stepped(state.output, index, seen.latent.Length, job.Noise("audio", index))
		logger.Log(Progress(job, index, state, seen.latent, heard.latent, before))
	seen.latent + heard.latent
Progress(job H3Job, step Number, state H3Spectrum, video Numbers, audio Numbers, before Number) Slow(Text)
	Tiny.Progress(H3Job.Reference, 0, H3Spectrum.Tiny, (1, 2), (3, 4), Process.Elapsed).EndsWith(" ms, forecasts 0")
	let took = ((Process.Elapsed - before) * 1000).Round
	"step " + step + " " + took + " ms, forecasts " + state.forecasts + Errors(job, step + 1, state.steps, video, audio)
Errors(job H3Job, step Number, count Number, video Numbers, audio Numbers) Slow(Text)
	H3Video(Logger).Errors(H3Job.Reference, 1, 1, (1, 2), (3, 4)) is ""
	H3Video(Logger).Errors(H3Job.Noisy, 1, 1, (1, 2), (3, 4)) is ""
	if job.video.Length > 0
		return ""
	if (job.file.Entry("video." + step) is "") or (job.Count is not count)
		return ""
	let seen = MossImage(logger).Error(video, job.file.Values("video." + step))
	", video error " + seen + ", audio error " + MossImage(logger).Error(audio, job.file.Values("audio." + step))