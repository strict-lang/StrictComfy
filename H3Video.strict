has logger
constant Reference = Safetensors("tinyh3.safetensors", 32, "reference.")
constant Shapes = Safetensors("tinyh3.safetensors", 32)
constant Keyed = Safetensors("tinyh3.safetensors", 32, "reference.i2v.")
constant Tiny = H3Video(Logger)
constant Solved = Solver(1, Euler(4, 12).Sigmas, H3Video.Reference.Values("video"))
constant Base = "minimax_h3_fl2va_pruned_int8_convrot.safetensors"
constant Turbo = "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors"
constant TaoMate = "h3/minimax_h3_taomate_3step_lora_avg_rank_19_bf16.safetensors"
constant Decoders = H3Video(Logger).Decoding(List(H3Decoding), ("tinyh3vae.safetensors", "tinyh3audio.safetensors")).First
constant Positional = "dumps model name loras steps shift period warmup degree routing first last sampler scheduler"
Run(arguments Texts) Number
	if "--help" is in arguments
		Help
		return 0
	if (arguments.Length > 1) and (arguments(0) is "encode")
		return H3Encoding(logger, arguments).Encoded
	if (arguments.Length > 1) and (arguments(0) is "--commands")
		return H3Commands(logger, arguments(1), arguments.Slice(2, arguments.Length - 2)).Completed then 0 else 1
	if Backend.IsServing(arguments)
		return H3Client(logger, H3Server.Root).Ran(arguments)
	if "coordinator" is in arguments
		return Coordinator(logger).Served
	arguments.Length < 2 then 2 else (Diagnosed(arguments) then 0 else 1)
Diagnosed(arguments Texts) Boolean
	let loras = GenerationCommand.Option(arguments, 3, "")
	if arguments(0) is "-"
		Served(Loaded(arguments(1), loras), H3Refiner.Loaded(arguments(1), loras), arguments)
		return true
	let conditions = Conditions(arguments(0))
	let texts = H3Refiner.Loaded(arguments(1), loras).Texts(conditions)
	Generations(Loaded(arguments(1), loras), conditions, texts, arguments(0), arguments).Length > 0
Served(h3 H3, refiner H3Refiner, arguments Texts)
	mutable decodings = List(H3Decoding)
	mutable dumps = Process.InputLine
	for as long as dumps is not ""
		decodings = Job(h3, refiner, decodings, dumps, arguments)
		dumps = Process.InputLine
Job(h3 H3, refiner H3Refiner, loaded List(H3Decoding), dumps Text, arguments Texts) Slow(List(H3Decoding))
	let conditions = Conditions(dumps)
	let files = Generations(h3, conditions, refiner.Texts(conditions), dumps, arguments)
	H3Files.Parsed(("--model", arguments(1))).Freed
	mutable decodings = loaded
	for files
		if conditions(index).Entry("decode") is not ""
			decodings = Decoding(decodings, arguments.Slice(Positional.Split(" ").Length, 2))
			decodings.First.Written(value, decodings.First.Shapes(conditions)(index), index)
	GpuMemory.Evicted
	decodings
Decoding(loaded List(H3Decoding), vaes Texts) Slow(List(H3Decoding))
	Tiny.Decoding(List(H3Decoding) + Decoders, ("missing.safetensors", "missing.safetensors")).Length is 1
	Decoders.vae.tiling is H3Tiles.Real
	Decoders.Decoded(H3Decoding.Latent, (12, 3, 4))(1)(5000).IsNearlyEqual(H3Decoding.Both(1)(5000), 0.001)
	if loaded.Length > 0
		return loaded
	let before = Process.Elapsed
	let files = ModelFiles("")
	logger.Log("Loading video VAE " + files.Described(vaes(0)) + " and audio VAE " + files.Described(vaes(1)))
	let decoding = H3Decoding.Loaded(logger, vaes(0), vaes(1))
	logger.Log("Video and audio VAE loaded in " + (Process.Elapsed - before).Round(1) + " s")
	List(H3Decoding) + decoding
Numbered(arguments Texts) Numbers
	H3Video(Logger).Numbered(("dumps", "model", "name", "", "3")) is (3, 12, 0, 1, 1, 0, 0, 0, 0, 0)
	for (0, H3Format.Shift, 0, 1, 1, 0, 0, 0, 0, 0)
		arguments.Length > index + 4 then arguments(index + 4) to Number else value
Loaded(model Text, loras Text) Slow(H3)
	H3Video(Logger).Loaded("tinyh3.safetensors", "").blocks.Length is 2
	let started = Process.Elapsed
	logger.Log(Loading(model, loras))
	let h3 = H3.Loaded(model, loras)
	logger.Log("H3 loaded in " + (Process.Elapsed - started).Round(1) + " s" + H3Lora(loras).Report)
	h3
Loading(model Text, loras Text) Text
	H3Video(Logger).Loading("tinyh3.safetensors", "") is "Loading H3 tinyh3.safetensors (0 GB) from disk into memory"
	H3Video(Logger).Loading("tinyh3.safetensors", "a/b.safetensors=1;c=0.5").EndsWith("b.safetensors, c on the GPU")
	let loading = "Loading H3 " + ModelFiles("").Described(model) + " from disk into memory"
	if loras is ""
		return loading
	mutable names = List(Text)
	for loras.Split(";")
		names = names + Path(value.Split("=").First).FileName.text
	loading + " and applying the LoRAs " + Text.Combine(names, ", ") + " on the GPU"
Conditions(dumps Text) List(Safetensors)
	H3Video(Logger).Conditions(".").Length is 1
	let data = Safetensors(dumps + "/generation.safetensors", 32)
	if File(data.path).Exists is false
		return List(Safetensors) + Safetensors(dumps + "/conditioning.safetensors", 64)
	for GenerationCommand.Count(data)
		GenerationCommand.Job(data, dumps, index)
Generations(h3 H3, conditions List(Safetensors), texts List(Numbers), dumps Text, arguments Texts) Slow(Texts)
	let numbers = Numbered(arguments)
	let name = GenerationCommand.Option(arguments, 2, "strict")
	for conditions
		let before = Process.Elapsed
		let steps = value.Entry("video") is "" then Safetensors(dumps + "/steps.safetensors", 64) else value
		let sampled = Generated(h3, value, H3Job(steps), texts(index), numbers, dumps)
		let file = dumps + "/" + (value.Entry("video") is "" then name else name + "-" + index)
		Safetensors(file + "-latent.safetensors").Written("latent", sampled)
		logger.Log("generation " + index + " in " + ((Process.Elapsed - before) * 1000).Round + " ms")
		GpuMemory.Released
		file
Generated(h3 H3, condition Safetensors, job H3Job, text Numbers, numbers Numbers, dumps Text) Slow(Numbers)
	Tiny.Generated(H3.Tiny, Keyed, H3Job.Reference, H3.Prompt, (1, 12, 0, 1, 1, 0, 0, 0, 1, 1), "").Length is 960
	let shaped = Layout(job.VideoShape, job.AudioShape, condition)
	let keyframes = job.Keyframes(shaped.keyframes)
	let layout = H3Layout(shaped, keyframes = keyframes, shift = numbers(1), routing = numbers(5))
	let rows = job.Rows(condition)
	if File(dumps + "/step0.safetensors").Exists
		logger.Log("step 0 error " + Compared(h3, Safetensors(dumps + "/step0.safetensors", 32), text, layout, 1))
	let count = numbers(0) is 0 then job.Count else numbers(0)
	let span = H3Span(numbers(6), numbers(7))
	let spectrum = H3Spectrum(count, SpectralFit(numbers(4), 0.1, 0.5), numbers(2), numbers(3), span = span)
	let sigmas = Euler(count, numbers(1)).Scheduled(numbers(9), numbers(8))
	Sampled(h3, job, text, layout, rows, spectrum, Solver(numbers(8), sigmas, job.Video))
Layout(video Numbers, audio Numbers, condition Safetensors) Slow(H3Layout)
	H3Video(Logger).Layout(Shapes.Shape("reference.video"), Shapes.Shape("reference.audio"), Keyed).Tokens is 17
	H3Video(Logger).Layout(Shapes.Shape("reference.video"), Shapes.Shape("reference.audio"), Keyed).tags(1) is 0
	let keyframes = condition.Entry("keyframes") is "" then List(Number) else condition.Values("keyframes")
	H3Layout(condition.Values("tags"), keyframes, audio.Last, video(1), video(2), video(3))
Compared(h3 H3, first Safetensors, text Numbers, layout H3Layout, sigma Number) Slow(Number)
	H3Video(Logger).Compared(H3.Tiny, Reference, H3.Prompt, H3Layout.Tiny, 0.75) < 0.05
	let curves = h3.Curves(layout.Times(sigma))
	let named = first.Entry("text") is "" then "token_refiner" else "text"
	logger.Log("refined text error " + MossImage(logger).RelativeError(text, first.Values(named)))
	logger.Log("curve rows error " + MossImage(logger).RelativeError(curves, first.Values("t_emb")))
	Layered(h3, first, curves, layout, sigma)
Layered(h3 H3, first Safetensors, curves Numbers, layout H3Layout, sigma Number) Slow(Number)
	H3Video(Logger).Layered(H3.Tiny, Reference, Reference.Values("t_emb"), H3Layout.Tiny, 0.75) < 0.05
	let rotation = h3.Rotation(layout)
	let starts = layout.Rows(sigma)
	mutable state = first.Values("blocks.0.input")
	mutable error = 0
	for h3.blocks
		state = value.Output(state, curves, starts, rotation, h3.Routed(layout.routing, index), h3.Leading(layout))
		let name = "blocks." + index
		if first.Entry(name) is not ""
			error = MossImage(logger).RelativeError(state, first.Values(name))
			logger.Log("block " + index + " error " + error)
	error
Sampled(h3 H3, job H3Job, text Numbers, layout H3Layout, conditions Numbers, spectrum H3Spectrum, solver Solver) Slow(Numbers)
	Tiny.Sampled(H3.Tiny, H3Job.Reference, H3.Prompt, H3Layout.Tiny, List(Number), H3Spectrum.Tiny, Solved).Length is 960
	let rotation = h3.Rotation(layout)
	mutable seen = job.HeldVideo(solver, 0)
	mutable heard = job.HeldAudio(Solver(seen, sigmas = layout.AudioSigmas(seen.sigmas), latent = job.Audio), 0)
	mutable state = spectrum
	mutable steps = H3StepLog(logger, job).Started
	for spectrum.steps
		state = state.Advanced(h3, seen.latent, heard.latent, solver.sigmas(index), text, layout, conditions, rotation, index)
		seen = job.HeldVideo(state.Stepped(seen, index, job), index + 1)
		heard = job.HeldAudio(heard.Stepped(state.output, index, seen.latent.Length, job.Noise("audio", index)), index + 1)
		steps = steps.Stepped(index, state, seen, heard.latent)
	seen.latent + heard.latent
Help
	H3Video(Logger).Help is not Error
	logger.Log("H3Video.exe [options] makes H3 videos with sound, diagnostic arguments: " + Positional)
	logger.Log(H3Options.Usage)
	logger.Log("H3Video.exe --commands commands.txt [options] makes the videos of every line of commands.txt")
	logger.Log("(its options after these, # for comments), loading the text encoder, H3 and the VAEs once for all")
