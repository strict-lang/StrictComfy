constant Positional = "dumps model name loras steps shift period warmup degree routing first last sampler scheduler"
Run(arguments Texts) Number
	if "--help" is in arguments
		Help
		return 0
	if arguments.Length > 1 and arguments(0) is "encode"
		return H3Encoding(arguments).Encoded
	if arguments.Length > 1 and arguments(0) is "--commands"
		return H3Commands(arguments(1), arguments.Slice(2, arguments.Length - 2)).IsCompleted then 0 else 1
	Route(arguments)
Route(arguments Texts) Number slow
	if Backend.IsServing(arguments)
		return H3Client(H3Server.Root).Run(arguments)
	if "coordinator" is in arguments
		return Coordinator.Serve is Error then Backend.Failed else 0
	arguments.Length < 2 then 2 else (IsDiagnosed(arguments) then 0 else 1)
IsDiagnosed(arguments Texts) Boolean slow
	loras = GenerationCommand.Option(arguments, 3, "")
	if arguments(0) is "-"
		Serve(H3Sampling.Load(arguments(1), loras), H3Refiner.Loaded(arguments(1), loras), arguments)
		return true
	conditions = Conditions(arguments(0))
	texts = H3Refiner.Loaded(arguments(1), loras).Texts(conditions)
	Generations(H3Sampling.Load(arguments(1), loras), conditions, texts, arguments(0), arguments).Length > 0
Serve(h3 H3, refiner H3Refiner, arguments Texts) slow
	mutable decodings = List(H3Decoding)
	mutable dumps = Process.InputLine
	for as long as dumps is not ""
		decodings = Job(h3, refiner, decodings, dumps, arguments)
		dumps = Process.InputLine
Job(h3 H3, refiner H3Refiner, loaded List(H3Decoding), dumps Text, arguments Texts) List(H3Decoding) slow
	conditions = Conditions(dumps)
	files = Generations(h3, conditions, refiner.Texts(conditions), dumps, arguments)
	H3Files.Parsed(("--model", arguments(1))).Freed
	mutable decodings = loaded
	for files
		if conditions(index).Entry("decode") is not ""
			decodings = H3Sampling.Decoding(decodings, arguments.Slice(Positional.Split(" ").Length, 2))
			decodings.First.Write(value, decodings.First.Shapes(conditions)(index), index)
	GpuMemory.Evict
	decodings
ParseNumbers(arguments Texts) Numbers
	H3Video.ParseNumbers(("dumps", "model", "name", "", "3")) is (3, 12, 0, 1, 1, 0, 0, 0, 0, 0)
	for (0, H3Format.Shift, 0, 1, 1, 0, 0, 0, 0, 0)
		arguments.Length > index + 4 then arguments(index + 4) to Number else value
Conditions(dumps Text) List(Safetensors) slow
	H3Video.Conditions(".").Length is 1
	data = Safetensors(dumps + "/generation.safetensors", 32)
	if File(data.path).Exists is false
		return List(Safetensors) + Safetensors(dumps + "/conditioning.safetensors", 64)
	for GenerationCommand.Count(data)
		GenerationCommand.Job(data, dumps, index)
Generations(h3 H3, conditions List(Safetensors), texts List(Numbers), dumps Text, arguments Texts) Texts slow
	numbers = ParseNumbers(arguments)
	name = GenerationCommand.Option(arguments, 2, "strict")
	for conditions
		before = Process.Elapsed
		steps = value.Entry("video") is "" then Safetensors(dumps + "/steps.safetensors", 64) else value
		sampled = H3Sampling.Generate(h3, value, H3Job(steps), texts(index), numbers, dumps)
		file = dumps + "/" + (value.Entry("video") is "" then name else name + "-" + index)
		Safetensors(file + "-latent.safetensors").Write("latent", sampled)
		logger.Log("generation " + index + " in " + ((Process.Elapsed - before) * 1000).Round + " ms")
		GpuMemory.Trim
		file
Help
	H3Video.Help is not Error
	logger.Log("H3Video.exe [options] makes H3 videos with sound, diagnostic arguments: " + Positional)
	logger.Log(H3Options.Usage)
	logger.Log("H3Video.exe --commands commands.txt [options] makes the videos of every line of commands.txt")
	logger.Log("(its options after these, # for comments), loading the text encoder, H3 and the VAEs once for all")
