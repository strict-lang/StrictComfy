has logger
constant Reference = Safetensors("tinyh3.safetensors", 32, "reference.")
constant Shapes = Safetensors("tinyh3.safetensors", 32)
constant Keyed = Safetensors("tinyh3.safetensors", 32, "reference.i2v.")
Run(arguments Texts) Number
	if (arguments.Length is 0) or (arguments(0).StartsWith("-") and (arguments(0) is not "-"))
		return GenerationCommand(logger).Run("h3", arguments)
	if arguments.Length < 2
		logger.Log("Use --help, or diagnostic arguments: dumps model name loras steps shift period warmup degree routing")
		return 2
	let loras = GenerationCommand(logger).Option(arguments, 3, "")
	if arguments(0) is "-"
		return Served(Loaded(arguments(1), loras), H3Refiner.Loaded(arguments(1), loras), arguments)
	let conditions = Conditions(arguments(0))
	let texts = H3Refiner.Loaded(arguments(1), loras).Texts(conditions)
	Generations(Loaded(arguments(1), loras), conditions, texts, arguments(0), arguments)
	0
Served(h3 H3, refiner H3Refiner, arguments Texts) Number
	mutable dumps = Process.InputLine
	for as long as dumps is not ""
		let conditions = Conditions(dumps)
		Generations(h3, conditions, refiner.Texts(conditions), dumps, arguments)
		dumps = Process.InputLine
	0
Numbered(arguments Texts) Numbers
	H3Video(Logger).Numbered(("dumps", "model", "name", "", "3")) is (3, 12, 0, 1, 1, 0)
	for (0, 12, 0, 1, 1, 0)
		arguments.Length > index + 4 then arguments(index + 4) to Number else value
Loaded(model Text, loras Text) Slow(H3)
	H3Video(Logger).Loaded("tinyh3.safetensors", "").blocks.Length is 2
	let started = Process.Elapsed
	let h3 = H3.Loaded(model, loras)
	logger.Log("loaded in " + (Process.Elapsed - started).Round(1) + " s" + H3Lora(loras).Report)
	h3
Conditions(dumps Text) List(Safetensors)
	H3Video(Logger).Conditions(".").Length is 1
	let data = Safetensors(dumps + "/generation.safetensors", 32)
	if File(data.path).Exists is false
		return List(Safetensors) + Safetensors(dumps + "/conditioning.safetensors", 64)
	for GenerationCommand(logger).Count(data)
		GenerationCommand(logger).Job(data, dumps, index)
Generations(h3 H3, conditions List(Safetensors), texts List(Numbers), dumps Text, arguments Texts) None
	let numbers = Numbered(arguments)
	let name = GenerationCommand(logger).Option(arguments, 2, "strict")
	for conditions
		let before = Process.Elapsed
		let sampled = Generated(h3, value, Steps(dumps, value), texts(index), numbers, dumps)
		let file = value.Entry("video") is "" then name else name + "-" + index
		Safetensors(dumps + "/" + file + "-latent.safetensors").Written("latent", sampled)
		if (arguments(0) is "-") and (index is conditions.Length - 1)
			GpuMemory.Evicted
		else
			GpuMemory.Released
		logger.Log("generation " + index + " in " + ((Process.Elapsed - before) * 1000).Round + " ms")
Steps(dumps Text, condition Safetensors) Safetensors
	H3Video(Logger).Steps("", Reference) is Reference
	condition.Entry("video") is "" then Safetensors(dumps + "/steps.safetensors", 64) else condition
Generated(h3 H3, condition Safetensors, steps Safetensors, text Numbers, numbers Numbers, dumps Text) Slow(Numbers)
	H3Video(Logger).Generated(H3.Tiny, Keyed, Reference, H3.Prompt, (1, 12, 0, 1, 1, 0), "").Length is 960
	let video = steps.Shape(Stream(steps, "video"))
	let shaped = Layout(video, steps.Shape(Stream(steps, "audio")), condition)
	let layout = H3Layout(shaped, shift = numbers(1), routing = numbers(5))
	let conditions = condition.Entry("rows") is "" then List(Number) else condition.Values("rows")
	if File(dumps + "/step0.safetensors").Exists
		Compared(h3, Safetensors(dumps + "/step0.safetensors", 32), text, layout, 1)
	let count = numbers(0) is 0 then Count(steps) else numbers(0)
	let spectrum = H3Spectrum(count, SpectralFit(numbers(4), 0.1, 0.5), numbers(2), numbers(3))
	Sampled(h3, steps, text, layout, conditions, spectrum)
Stream(steps Safetensors, name Text) Text
	H3Video(Logger).Stream(Reference, "audio") is "audio"
	steps.Entry(name + ".0") is "" then name else name + ".0"
Layout(video Numbers, audio Numbers, condition Safetensors) H3Layout
	H3Video(Logger).Layout(Shapes.Shape("reference.video"), Shapes.Shape("reference.audio"), Keyed).Tokens is 17
	H3Video(Logger).Layout(Shapes.Shape("reference.video"), Shapes.Shape("reference.audio"), Keyed).tags(1) is 0
	let keyframes = condition.Entry("keyframes") is "" then List(Number) else condition.Values("keyframes")
	H3Layout(condition.Values("tags"), keyframes, audio.Last, video(1), video(2), video(3))
Count(steps Safetensors) Number
	H3Video(Logger).Count(Reference) is 1
	steps.Entry("sigmas") is "" then 1 else steps.Values("sigmas").Length - 1
Compared(h3 H3, first Safetensors, text Numbers, layout H3Layout, sigma Number) Slow(Number)
	H3Video(Logger).Compared(H3.Tiny, Reference, H3.Prompt, H3Layout.Tiny, 0.75) < 0.05
	let curves = h3.Curves(layout.Times(sigma))
	let named = first.Entry("text") is "" then "token_refiner" else "text"
	logger.Log("refined text error " + MossImage(logger).Error(text, first.Values(named)))
	logger.Log("curve rows error " + MossImage(logger).Error(curves, first.Values("t_emb")))
	Layered(h3, first, curves, layout, sigma)
Layered(h3 H3, first Safetensors, curves Numbers, layout H3Layout, sigma Number) Slow(Number)
	H3Video(Logger).Layered(H3.Tiny, Reference, Reference.Values("t_emb"), H3Layout.Tiny, 0.75) < 0.05
	let rotation = Rope.Video.Table(layout.Positions, h3.inverse, 1)
	let starts = layout.Rows(sigma)
	mutable state = first.Values("blocks.0.input")
	mutable error = 0
	for h3.blocks
		state = value.Output(state, curves, starts, rotation, h3.Routed(layout.routing, index), h3.Leading(layout))
		let name = "blocks." + index
		if first.Entry(name) is not ""
			error = MossImage(logger).Error(state, first.Values(name))
			logger.Log("block " + index + " error " + error)
	error
Sampled(h3 H3, steps Safetensors, text Numbers, layout H3Layout, conditions Numbers, spectrum H3Spectrum) Slow(Numbers)
	H3Video(Logger).Sampled(H3.Tiny, Reference, H3.Prompt, H3Layout.Tiny, List(Number), H3Spectrum.Tiny).Length is 960
	let sigmas = Euler(spectrum.steps, layout.shift).Sigmas
	mutable video = steps.Values(Stream(steps, "video"))
	mutable audio = steps.Values(Stream(steps, "audio"))
	mutable state = spectrum
	for spectrum.steps
		let before = Process.Elapsed
		state = state.Advanced(h3, video, audio, sigmas(index), text, layout, conditions, index)
		video = state.Stepped(video, sigmas, index, steps)
		audio = Euler.Stepped(audio, state.output, layout.AudioSigmas(sigmas), index, video.Length)
		logger.Log(Progress(steps, index, state, video, audio, before))
	video + audio
Progress(steps Safetensors, step Number, state H3Spectrum, video Numbers, audio Numbers, before Number) Text
	H3Video(Logger).Progress(Reference, 0, H3Spectrum.Tiny, (1, 2), (3, 4), Process.Elapsed).EndsWith(" ms, forecasts 0")
	let took = ((Process.Elapsed - before) * 1000).Round
	"step " + step + " " + took + " ms, forecasts " + state.forecasts + Errors(steps, step + 1, state.steps, video, audio)
Errors(steps Safetensors, step Number, count Number, video Numbers, audio Numbers) Text
	H3Video(Logger).Errors(Reference, 1, 1, (1, 2), (3, 4)) is ""
	if (steps.Entry("video." + step) is "") or (Count(steps) is not count)
		return ""
	let seen = MossImage(logger).Error(video, steps.Values("video." + step))
	", video error " + seen + ", audio error " + MossImage(logger).Error(audio, steps.Values("audio." + step))