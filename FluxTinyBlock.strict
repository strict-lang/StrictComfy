has first Convolution
has second Convolution
has third Convolution
has expanded Convolution
has norm GroupNorm
has reduced Convolution
constant Model = Safetensors("tinytaef2.safetensors", 32, "decoder.layers.")
constant Pooled = FluxTinyBlock.Loaded(Model, "2.")
constant Square = FeatureMap((1, -2, 3, -4), 2, 1, List(Number) + 0)
constant Pixel = FeatureMap((1, 1, 1, 1, 1, 1, 1, 1), 1, 8, Layer.Zeros(8))
Loaded(model Safetensors, prefix Text) Slow(FluxTinyBlock)
	Pooled.expanded.biases.Length is 32
	FluxTinyBlock.Loaded(Model, "7.").expanded.biases.Length is 0
	let block = Safetensors(model.path, 32, model.prefix + prefix)
	let parts = Convolutions(block)
	FluxTinyBlock(parts(0), parts(1), parts(2), parts(3), Norm(block), parts(4))
Convolutions(block Safetensors) Slow(List(Convolution))
	Pooled.Convolutions(Safetensors(Model.path, 32, "decoder.layers.7.")).Last.biases.Length is 0
	let none = Convolution(List(Number), List(Number))
	for ("conv.0", "conv.2", "conv.4", "pool.0", "pool.3")
		block.Entry(value + ".weight") is "" then none else FluxTiny.Convolved(block, value)
Norm(block Safetensors) Slow(GroupNorm)
	Pooled.Norm(Safetensors(Model.path, 32, "decoder.layers.2.")).weights.Length is 32
	if block.Entry("pool.1.weight") is ""
		return GroupNorm(List(Number), List(Number), 4)
	GroupNorm(block.Values("pool.1.weight"), block.Values("pool.1.bias"), 4)
Output(map FeatureMap) Slow(FeatureMap)
	Pooled.Output(Pixel).values.Length is 8
	let input = expanded.biases.Length is 0 then map else map.Plus(Context(map))
	let entered = first.Applied(input, input.Identity, false)
	let activated = Rectified(entered, entered.Identity)
	let middle = second.Applied(activated, activated.Identity, false)
	let rectified = Rectified(middle, middle.Identity)
	let summed = third.Applied(rectified, rectified.Identity, false).Plus(input)
	Rectified(summed, summed.Identity)
Context(map FeatureMap) Slow(FeatureMap)
	Pooled.Context(Pixel).values.Length is 8
	let wide = expanded.Projected(map)
	reduced.Projected(Rectified(wide, norm.Affine(wide)))
Rectified(map FeatureMap, affine Numbers) FeatureMap
	Pooled.Rectified(Square, (2, 1)).values is (3, 0, 7, 0)
	FeatureMap(Positives(map, affine), map.width, map.channels, Layer.Zeros(map.channels))
Positives(features FeatureMap, affine Numbers) BFloat16s
	Pooled.Positives(Square, (2, 1)) is (3, 0, 7, 0)
	let channels = features.channels
	for features.values
		let sum = value * affine(index % channels) + affine(channels + index % channels)
		sum > 0 then sum else 0
