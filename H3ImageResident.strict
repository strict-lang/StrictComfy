has logger
has isKept = false
has encoders List(Qwen3) = List(Qwen3)
has encoderFile = ""
has tokenizers List(Gpt2Tokens) = List(Gpt2Tokens)
has models List(H3ImageModel) = List(H3ImageModel)
has refiners List(H3Refiner) = List(H3Refiner)
has model = ""
has vae = H3ImageVae.None
has visions List(QwenVision) = List(QwenVision)
has references List(Numbers) = List(Numbers)
has referenceKey = ""
has code = 0
constant Tiny = H3ImageOptions.Parsed(("--model", "tinyh3image.safetensors", "--vae", "tinyh3imagevae.safetensors"))
constant TinyFiles = H3Files.Parsed(("--text_encoder", "../Strict/NeuralNetworks/tinyqwen3vl.safetensors"))
constant Freeing = "Freeing the text encoder"
constant None = H3ImageResident(Logger)
constant Kept = H3ImageResident(Logger, true)
constant Sampled = Kept.Sampling(Tiny)
constant Encoded = Kept.Encoding(TinyFiles)
constant Crowded = Backend.IsCrowded(File(Tiny.Checkpoint).Length, GpuMemory.HostAvailable, GpuMemory.HostTotal)
Sampling(options H3ImageOptions) H3ImageResident slow
	(Sampled.models.Length is 1) and (Sampled.refiners.Length is 1)
	Sampled.Sampling(Tiny).model is Sampled.model
	let key = options.Checkpoint + "|" + options.Loras
	if (key is model) and (models.Length is 1)
		logger.Log("Using the loaded H3 Image " + options.Checkpoint)
		return value
	GpuMemory.Released
	let loaded = Loaded(options)
	let refiner = H3Refiner.Loaded(options.Checkpoint, options.Loras)
	H3ImageResident(value, models = List(H3ImageModel) + loaded, refiners = List(H3Refiner) + refiner, model = key)
Loaded(options H3ImageOptions) H3ImageModel slow
	None.Loaded(Tiny).heads.Length is 6
	let started = Process.Elapsed
	logger.Log("Loading H3 Image " + ModelFiles("").Described(options.Checkpoint) + " from disk into memory")
	let loaded = H3ImageModel.Loaded(options.Checkpoint, options.Loras)
	let report = H3Lora(options.Loras).Report + Staying
	logger.Log("H3 Image loaded in " + (Process.Elapsed - started).Round(1) + " s" + report)
	loaded
Decoding(path Text) H3ImageResident slow
	Sampled.Decoding(Tiny.Decoder).vae.decoders.Length is 1
	Sampled.Decoding(Tiny.Decoder).Decoding(Tiny.Decoder).vae.decoderFile is Tiny.Decoder
	if vae.IsDecoding(path)
		return value
	logger.Log("Loading the H3 Image decoder " + ModelFiles("").Described(path) + Staying)
	H3ImageResident(value, vae = vae.Decoding(path))
Picturing(path Text) H3ImageResident slow
	Sampled.Picturing(H3VaeEncoder.Model.path).vae.pictures.Length is 1
	if vae.IsPicturing(path)
		return value
	logger.Log("Loading the H3 Image VAE encoder" + Staying)
	H3ImageResident(value, vae = vae.Picturing(path))
Referencing(image H3Image) H3ImageResident slow
	Sampled.Referencing(H3Image.Tiny).references.Length is 0
	Sampled.Referencing(H3Image.Tiny).vae.pictures.Length is 0
	let path = image.options.image
	let file = File(path)
	let key = path is "" then "" else image.options.VaeEncoder + "|" + path + "|" + file.Length + "|" + file.Modified
	if key is referenceKey
		return value
	if key is ""
		return H3ImageResident(value, references = List(Numbers), referenceKey = "")
	let picturing = Picturing(image.options.VaeEncoder)
	H3ImageResident(picturing, references = image.Referenced(picturing.vae.pictures.First), referenceKey = key)
Seeing(files H3Files) H3ImageResident slow
	Encoded.Seeing(TinyFiles).visions.Length is 0
	if (files.Images.Length is 0) or (visions.Length is 1)
		return value
	logger.Log("Loading the vision encoder of " + ModelFiles("").Described(files.Encoder) + Staying)
	let vision = QwenVision.Loaded(Safetensors(files.Encoder, 32, "visual."), 16, H3Qwen.Deepstacks)
	H3ImageResident(value, visions = List(QwenVision) + vision)
Encoding(files H3Files) H3ImageResident slow
	(Encoded.encoders.Length is 1) and (Encoded.tokenizers.Length is 1)
	Encoded.Encoding(TinyFiles).encoderFile is Encoded.encoderFile
	if (files.Encoder is encoderFile) and (encoders.Length is 1)
		return value
	let started = Process.Elapsed
	logger.Log("Loading text encoder " + ModelFiles("").Described(files.Encoder) + " from disk into memory")
	let encoder = H3Encoder(logger, files)
	let loaded = encoder.Loaded
	logger.Log("Text encoder loaded in " + (Process.Elapsed - started).Round(1) + " s" + Staying)
	let encoded = H3ImageResident(value, encoders = List(Qwen3) + loaded, encoderFile = files.Encoder)
	H3ImageResident(encoded, tokenizers = List(Gpt2Tokens) + encoder.Tokenizer, visions = List(QwenVision))
Trimmed(options H3ImageOptions) H3ImageResident slow
	Encoded.Trimmed(Tiny).encoders.Length is (Crowded then 0 else 1)
	H3ImageResident(Encoded, isKept = false).Trimmed(Tiny).encoders.Length is 0
	if GpuMemory.Held + GpuMemory.Available < File(options.Checkpoint).Length + File(encoderFile).Length
		GpuMemory.Evicted
	let needed = models.Length is 1 then 0 else File(options.Checkpoint).Length
	let isCrowded = Backend.IsCrowded(needed, GpuMemory.HostAvailable, GpuMemory.HostTotal)
	if (encoders.Length is 0) or (isKept and (isCrowded is false))
		return value
	logger.Log(isKept then "Freeing the text encoder, little memory is left, it loads again for a new prompt" else Freeing)
	H3ImageResident(value, encoders = List(Qwen3), encoderFile = "", visions = List(QwenVision))
Staying Text
	Kept.Staying.StartsWith(", it stays")
	H3ImageResident(Logger).Staying is ""
	isKept then ", it stays loaded for the next runs" else ""
