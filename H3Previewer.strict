has path Text
has decoders List(Taeh3Decoder)
constant None = H3Previewer("", List(Taeh3Decoder))
constant Frames = 8
constant Tiny = H3Previewer("artifacts/h3previewer-test.jpg", List(Taeh3Decoder) + Taeh3Decoder.Tiny)
constant Shape = (24, 2, 2, 3)
constant Clip = Taeh3Decoder.Latent + Taeh3Decoder.Latent
Loaded(file Text, models Text) Slow(H3Previewer)
	H3Previewer.Loaded("", ".").decoders.Length is 0
	H3Previewer.Loaded("a.jpg", ".").decoders.Length is 0
	if file is ""
		return None
	let tiny = ModelFiles(models).Located("taeh3.safetensors", "vae_approx")
	if (tiny is Error) or (Taeh3Decoder.Is(tiny) is false)
		return None
	H3Previewer(file, List(Taeh3Decoder) + Taeh3Decoder.Loaded(tiny))
Written(latent Numbers, shape Numbers) Slow(None)
	Tiny.Written(Clip, Shape) is not Error
	File(Tiny.path).Exists
	if (decoders.Length is 0) or (latent.Length is 0)
		return
	let picked = Picked(shape(1))
	let frames = Decoded(latent, shape, picked)
	let part = path + ".part"
	let wide = picked.Length * shape(3) * 16
	ImageCodec.SaveJpeg(part, Strip(frames, shape(2) * 16, shape(3) * 16), wide, MossBatch.JpegQuality)
	if File(path).Exists
		File(path).Delete
	File(part).Rename(path)
Decoded(latent Numbers, shape Numbers, picked Numbers) Slow(List(Numbers))
	Tiny.Decoded(Clip, Shape, (0, 1)).Length is 2
	for picked
		decoders.First.Decoded(Frame(latent, shape, value), shape(3))
Picked(count Number) Numbers
	Tiny.Picked(2) is (0, 1)
	(Tiny.Picked(31).Length is Frames) and (Tiny.Picked(31).Last is 27)
	let used = count.Clamp(1, Frames)
	for used
		(index * count / used).Floor
Frame(latent Numbers, shape Numbers, frame Number) Numbers
	Tiny.Frame((1, 2, 3, 4), (2, 2, 1, 1), 1) is (2, 4)
	let plane = shape(2) * shape(3)
	for shape(0) * plane
		latent(((index / plane).Floor * shape(1) + frame) * plane + index % plane)
Strip(frames List(Numbers), height Number, width Number) Numbers
	Tiny.Strip(((1, 2, 3), (4, 5, 6)), 1, 1) is (1, 2, 3, 4, 5, 6)
	let plane = height * width
	let wide = frames.Length * width
	for 3 * plane * frames.Length
		let pixel = (index / 3).Floor
		let column = pixel % wide
		frames((column / width).Floor)(index % 3 * plane + (pixel / wide).Floor * width + column % width)
