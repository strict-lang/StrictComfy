has logger
has file Text
has arguments Texts
constant Sample = H3Commands(Logger, "tinyh3commands.txt", ("--models", "."))
constant Sized = "--length 5 --width 32 --height 32"
constant Unsized = "--width and --height must be positive multiples of 32"
Completed Number
	let lines = Lines
	if lines.Length is 0
		logger.Log("No commands in " + file + ", write the H3Video options of one batch of videos per line (# for comments)")
		return 2
	let batches = Batches(lines)
	let problem = Problem(batches)
	if problem is not ""
		logger.Log(problem)
		return 2
	Generated(batches, lines.Length)
Generated(batches List(H3Batch), count Number) Slow(Number)
	let started = Process.Elapsed
	let plans = Planned(batches)
	Encoded(plans)
	let first = plans.First.batch
	first.Prefetched((first.options.files.Decoder, first.options.files.Sound), "the VAEs")
	let videos = Sampled(plans)
	let made = Decoded(plans)
	let commands = count is 1 then " command" else " commands"
	logger.Log("Total " + (Process.Elapsed - started).Round(2) + " s for " + videos + " videos from " + count + commands)
	made
Lines Texts
	Sample.Lines is (Sized + " --seed 7", Sized + " --prompt \"a b.txt\"")
	H3Commands(Logger, "missing.txt", List(Text)).Lines is Error("FileNotFound:missing.txt")
	if File(file).Exists is false
		return Error("FileNotFound:" + file)
	for File(file).ReadLines
		if (value.Trim is not "") and (value.Trim.StartsWith("#") is false)
			value.Trim
Batches(lines Texts) Slow(List(H3Batch))
	Sample.Batches(Sample.Lines).Last.options.prompt is "a b.txt"
	Sample.Batches(Sample.Lines).First.options.seed is 7
	for lines
		let words = arguments + CommandWords.Words(value)
		H3Batch(logger, H3Options.Parsed(words)).Expanded(words)
Problem(batches List(H3Batch)) Text
	Sample.Problem(Sample.Batches(Sample.Lines)) is ""
	Sample.Problem(Sample.Batches(List(Text) + "--width 30")) is "Command 1: " + Unsized
	for batches
		let problem = H3Inputs(value.options).Problem
		if problem is not ""
			return "Command " + (index + 1) + ": " + problem
	""
Planned(batches List(H3Batch)) Slow(List(H3Plan))
	for batches
		logger.Log("Command " + (index + 1) + "/" + batches.Length + ": " + Text.Combine(value.commandLine, " "))
		value.Planned
Encoded(plans List(H3Plan)) Slow(Number)
	mutable keys = List(Text)
	mutable encoded = 0
	for plans
		let key = Encoding(value)
		if key is not in keys
			keys = keys + key
			encoded = encoded + EncodedWith(plans, key)
	encoded
Encoding(plan H3Plan) Text
	let options = plan.batch.options
	let pictures = (options.files.lastImage is not "") or (Text.Combine(plan.images, "") is not "")
	let size = " " + options.width + "x" + options.height + " " + options.files.lastImage
	options.files.Encoder + (pictures then size else "")
Merged(plans List(H3Plan), key Text) H3Plan
	mutable prompts = List(Text)
	mutable images = List(Text)
	mutable paths = List(Text)
	for plans
		if Encoding(value) is key
			prompts = prompts + value.prompts
			images = images + value.images
			paths = paths + value.paths
	H3Plan(First(plans, key, true).batch, List(Number), images, prompts, paths)
EncodedWith(plans List(H3Plan), key Text) Slow(Number)
	let merged = Merged(plans, key)
	let batch = merged.batch
	let missing = H3Artifacts(batch.options).Missing(merged.paths)
	if missing.Length is 0
		return 0
	let inputs = H3Inputs(batch.options)
	let prompts = inputs.Picked(merged.prompts, missing)
	batch.Encoded(prompts, inputs.Picked(merged.images, missing), inputs.Picked(merged.paths, missing))
First(plans List(H3Plan), key Text, isEncoding Boolean) H3Plan
	for plans
		if (isEncoding then Encoding(value) else Model(value)) is key
			return value
	Error("NoPlanFor:" + key)
Model(plan H3Plan) Text
	plan.batch.options.Checkpoint + ";" + plan.batch.options.Loras
Sampled(plans List(H3Plan)) Slow(Number)
	mutable models = List(Text)
	mutable videos = 0
	for plans
		let model = Model(value)
		if model is not in models
			models = models + model
			videos = videos + SampledWith(plans, model)
	videos
SampledWith(plans List(H3Plan), model Text) Slow(Number)
	let options = First(plans, model, false).batch.options
	let h3 = H3Video(logger).Loaded(options.Checkpoint, options.Loras)
	let refiner = H3Refiner.Loaded(options.Checkpoint, options.Loras)
	mutable videos = 0
	for plans
		if Model(value) is model
			logger.Log("Command " + (index + 1) + "/" + plans.Length)
			let latents = H3Artifacts(value.batch.options).Latents(value.seeds.Length, Prefix(index))
			let conditions = H3Artifacts(value.batch.options).Read(value.paths)
			videos = videos + value.batch.Sampled(h3, refiner, value, conditions, latents, videos is 0)
	GpuMemory.Evicted
	videos
Decoded(plans List(H3Plan)) Slow(Number)
	mutable decodings = List(H3Decoding)
	mutable vaes = ""
	for plans
		let options = value.batch.options
		let wanted = options.files.Decoder + ";" + options.files.Sound
		if wanted is not vaes
			decodings = H3Video(logger).Decoding(List(H3Decoding), (options.files.Decoder, options.files.Sound))
			vaes = wanted
		logger.Log("Command " + (index + 1) + "/" + plans.Length)
		let latents = H3Artifacts(options).Latents(value.seeds.Length, Prefix(index))
		value.batch.DecodedWith(decodings.First, latents, value.images)
	0
Prefix(index Number) Text
	Sample.Prefix(3) is "c3-"
	"c" + index + "-"
