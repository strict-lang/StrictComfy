Count(data Safetensors) Number
	GenerationCommand.Count(MossImage.Reference) is 1
	let key = data.Entry("jobs") is "" then "runs" else "jobs"
	let count = data.Entry(key) is "" then 1 else data.Values(key).First
	if (count < 1) or (count.Floor is not count)
		return Error("Invalid generation count")
	count
Job(data Safetensors, dumps Text, index Number) Safetensors
	GenerationCommand.Job(MossImage.Reference, "", 0).path is "tinymoss.safetensors"
	data.Entry("jobs") is "" then data else Safetensors(dumps + "/generation-" + index + ".safetensors", 32)
Option(arguments Texts, index Number, default Text) Text
	GenerationCommand.Option(("a", "b"), 1, "c") is "b"
	GenerationCommand.Option(("a", "b"), 2, "c") is "c"
	arguments.Length > index then arguments(index) else default
