has encoder H3VaeEncoder
has tiling H3Tiles
constant Tiny = H3Picture(H3VaeEncoder.Tiny, H3Tiles.Tiny)
constant Image = H3VaeEncoder.Model.Values("reference.image")
constant Reference = H3VaeEncoder.Model.Values("reference.latent")
constant Latent = Tiny.Encoded(Image, (48, 64))
Encoded(image Numbers, size Numbers) Slow(Numbers)
	Latent.Length is 288
	Latent(0).IsNearlyEqual(Reference(0), 0.01)
	Latent(5).IsNearlyEqual(Reference(5), 0.01)
	Latent(18).IsNearlyEqual(Reference(18), 0.01)
	Latent(287).IsNearlyEqual(Reference(287), 0.01)
	let ys = tiling.Starts(size(0))
	let xs = tiling.Starts(size(1))
	Blended(Moments(image, size, ys, xs), ys, xs, size)
Moments(image Numbers, size Numbers, ys Numbers, xs Numbers) Slow(List(Numbers))
	Tiny.Moments(Image, (48, 64), (0, 16), (0, 16, 32)).Length is 6
	let tall = tiling.Length(size(0))
	let wide = tiling.Length(size(1))
	for ys.Length * xs.Length
		let box = (ys((index / xs.Length).Floor), tall, xs(index % xs.Length), wide)
		encoder.Moments(encoder.Pixels(image, size, box, H3Vae.Mean + H3Vae.Deviation)).Completed
Blended(moments List(Numbers), ys Numbers, xs Numbers, size Numbers) Slow(Numbers)
	let plane = size(0) * size(1) / 256
	let tall = tiling.Length(size(0)) / 16
	let wide = tiling.Length(size(1)) / 16
	for 24 * plane
		let row = (index % plane / (size(1) / 16)).Floor
		let column = index % (size(1) / 16)
		let above = tiling.Owner(ys, row * 16)
		let left = tiling.Owner(xs, column * 16)
		let place = (above, left, row - ys(above) / 16, column - xs(left) / 16, (index / plane).Floor)
		Value(moments, place, (xs.Length, tall, wide, Extent(ys, above, tall), Extent(xs, left, wide)))
Value(moments List(Numbers), place Numbers, extents Numbers) Number
	let tile = place(0) * extents(0) + place(1)
	let own = moments(tile)((place(2) * extents(2) + place(3)) * 48 + place(4))
	let upper = place(0) > 0 and place(2) < extents(3)
	let higherRow = extents(1) - extents(3) + place(2)
	let higher = upper then moments(tile - extents(0))((higherRow * extents(2) + place(3)) * 48 + place(4)) else 0
	let vertical = upper then higher * (1 - place(2) / extents(3)) + own * place(2) / extents(3) else own
	let leftward = place(1) > 0 and place(3) < extents(4)
	let besideColumn = extents(2) - extents(4) + place(3)
	let beside = leftward then moments(tile - 1)((place(2) * extents(2) + besideColumn) * 48 + place(4)) else 0
	let blended = leftward then beside * (1 - place(3) / extents(4)) + vertical * place(3) / extents(4) else vertical
	(blended - encoder.Means(place(4))) / encoder.Deviations(place(4))
Extent(starts Numbers, at Number, size Number) Number
	Tiny.Extent((0, 16), 1, 2) is 1
	Tiny.Extent((0, 16), 0, 2) is 0
	at > 0 then (starts(at - 1) + size * 16 - starts(at)) / 16 else 0
