has loras Text
constant File = "tinyh3lora.safetensors"
constant Half = H3Lora(File + "=0.5")
constant Quarters = H3Lora(File + "=0.25;" + File + "=0.25")
constant Reference = Safetensors(File, 32, "reference.")
constant Normed = Reference.Values("blocks.0.attn.input")
constant Linears = ("attn.qkv_proj", "attn.out_proj", "mlp.fc1", "mlp.fc2")
constant Block = H3Block.Loaded(H3Block.Model, "blocks.0.", Half.loras)
constant Input = Reference.Values("blocks.0.input")
constant Layered = Block.Output(Input, H3.Model.Values("t_emb"), H3Layout.Tiny.Rows(0.75), Rope.Turning)
constant Refined = Reference.Values("token_refiner")
constant Tuned = H3.Loaded("tinyh3.safetensors", Half.loras)
constant Outputs = Reference.Values("video_output") + Reference.Values("audio_output")
constant Forward = Tuned.Output(H3Spectrum.Video, H3Spectrum.Audio, 0.75, Refined, H3Layout.Tiny, List(Number), H3.Turned)
Tuning(prefix Text) Slow(List(MossLora))
	H3Lora("").Tuning("blocks.0.").Length is 0
	Half.Tuning("blocks.1.")(3).rank is 5
	H3Lora(File).Tuning("blocks.1.")(3).up.Length is 256 * 5
	MossImage(Logger).Error(Quarters.Tuning("blocks.0.")(0).Delta(Normed), Reference.Values("qkv")) < 0.005
	if loras is ""
		return List(MossLora)
	for Linears
		Stacked(prefix + value + ".")
Stacked(name Text) Slow(MossLora)
	Half.Stacked("blocks.0.mlp.fc1.").rank is 2
	Half.Stacked("blocks.1.mlp.fc2.").up is H3Lora(File).Stacked("blocks.1.mlp.fc2.").up * 0.5
	Half.Stacked("blocks.0.adaln_proj.linear.").rank is 0
	mutable stacked = MossLora(List(Number), List(Number), 0, 0)
	for loras.Split(";")
		let parts = value.Split("=")
		let strength = parts.Length is 1 then 1 else parts.Last to Number
		let prefix = Prefixed(TensorFile.Header(parts.First), name)
		if prefix is not ""
			stacked = stacked.Stacked(MossLora.Loaded(parts.First, prefix, strength))
	stacked
Prefixed(header Text, name Text) Text
	Half.Prefixed("\"diffusion_model.b.fc1.lora_A.weight\"", "b.fc1.") is "diffusion_model.b.fc1."
	Half.Prefixed("\"lora_unet_b_fc1.lora_down.weight\"", "b.fc1.") is "lora_unet_b_fc1."
	Half.Prefixed("\"b.fc1.lora_down.weight\"", "b.fc1.") is "b.fc1."
	Half.Prefixed("\"b.fc1.alpha\"", "b.fc1.") is ""
	let kohya = "lora_unet_" + name.Substring(0, name.Length - 1).Replace(".", "_") + "."
	for ("diffusion_model." + name, name, kohya)
		if header.IndexOf("\"" + value + "lora_") >= 0
			return value
	""
Report Text
	H3Lora("").Report is ""
	Half.Report is ", tinyh3lora.safetensors applies 35 of its 43 tensors"
	if loras is ""
		return ""
	mutable report = ""
	for loras.Split(";")
		let path = value.Split("=").First
		let header = TensorFile.Header(path)
		let applied = ", " + path + " applies " + Applied(header)
		report = report + applied + " of its " + (header.Split("\"dtype\"").Length - 1) + " tensors"
	report
Applied(header Text) Number
	Half.Applied("\"b.mlp.fc1.lora_A.weight\":{},\"b.mlp.fc1.alpha\":{},\"b.norm1.diff\"") is 2
	Half.Applied("\"lora_unet_b_mlp_fc1.lora_down.weight\":{},\"lora_unet_b_mlp_fc1.alpha\":{}") is 2
	mutable count = 0
	for Linears
		count = count + Counted(header, "." + value + ".") + Counted(header, "_" + value.Replace(".", "_") + ".")
	count
Counted(header Text, module Text) Number
	Half.Counted("\"a.b.lora_A\",\"a.b.alpha\",\"a.c.alpha\"", ".b.") is 2
	header.Split(module + "lora_").Length + header.Split(module + "alpha").Length - 2
