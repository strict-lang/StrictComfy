has loras Text
constant Flow = H3Lora("tinyhyperflow.safetensors")
constant Half = H3Lora("tinyh3lora.safetensors=0.5")
constant Quarters = H3Lora("tinyh3lora.safetensors=0.25;tinyh3lora.safetensors=0.25")
constant Reference = Safetensors("tinyh3lora.safetensors", 32, "reference.")
constant Normed = Reference.Values("blocks.0.attn.input")
constant Linears = ("attn.qkv_proj", "attn.out_proj", "mlp.fc1", "mlp.fc2")
constant Floats = ("video_patch_proj", "audio_patch_proj", "condition_proj", "final_layer.video_out", "final_layer.audio_out")
constant Block = H3Block.Loaded(H3Block.Model, "blocks.0.", Half.loras)
constant Input = Reference.Values("blocks.0.input")
constant Layered = Block.Output(Input, H3.Model.Values("t_emb"), H3Layout.Tiny.Rows(0.75), Rope.Turning)
constant Refined = Reference.Values("token_refiner")
constant Tuned = H3.Loaded("tinyh3.safetensors", Half.loras)
constant Outputs = Reference.Values("video_output") + Reference.Values("audio_output")
constant Forward = Tuned.Output(H3Spectrum.Video, H3Spectrum.Audio, 0.75, Refined, H3Layout.Tiny, List(Number), H3.Turned)
Tuning(prefix Text) Slow(List(MossLora))
	H3Lora("").Tuning("blocks.0.").Length is 0
	Half.Tuning("blocks.1.")(3).rank is 5
	H3Lora(Reference.path).Tuning("blocks.1.")(3).up.Length is 256 * 5
	MossImage(Logger).Error(Quarters.Tuning("blocks.0.")(0).Delta(Normed), Reference.Values("qkv")) < 0.005
	if loras is ""
		return List(MossLora)
	for Linears
		Stacked(prefix + value + ".")
Stacked(name Text) Slow(MossLora)
	Half.Stacked("blocks.0.mlp.fc1.").rank is 2
	Half.Stacked("blocks.1.mlp.fc2.").up(1) * 2 is H3Lora(Reference.path).Stacked("blocks.1.mlp.fc2.").up(1)
	Half.Stacked("blocks.0.adaln_proj.linear.").rank is 0
	H3Lora("tinyqkvlora.safetensors").Stacked("layers.0.proj.k.").up is MossLora.Tiny.up * 2
	H3Lora("").Stacked("blocks.0.mlp.fc1.").rank is 0
	if loras is ""
		return MossLora.None
	mutable stacked = MossLora.None
	for loras.Split(";")
		stacked = stacked.Stacked(Found(value.Split("=").First, name, Strength(value)))
	stacked
Strength(entry Text) Number
	Half.Strength("a.safetensors=0.25") is 0.25
	Half.Strength("a.safetensors") is 1
	let parts = entry.Split("=")
	parts.Length is 1 then 1 else parts.Last to Number
Found(path Text, name Text, strength Number) Slow(MossLora)
	(Half.Found(Flow.loras, "f.o.", 1).rank is 0) and (Half.Found(Flow.loras, "f.k.", 1).up is (128))
	(Half.Found(Flow.loras, "o.", 1).up is (64, 128)) and (Half.Found(Flow.loras, "a.mlp.fc1.", 1).up is (128, 64))
	Half.Found(Reference.path, "blocks.0.mlp.fc1.", 1).up(0) is -5.78125
	let header = TensorFile.Header(path)
	let prefix = Prefixed(header, name)
	if prefix is not ""
		return Swapped(MossLora.Loaded(path, prefix, strength), name.EndsWith("mlp.fc1.") and IsFlipped(header))
	if name.EndsWith(".qkv.")
		return Fused(path, name, strength)
	let part = (".q.", ".k.", ".v.").Index(name.Substring(name.Length - 3, 3))
	let fused = part < 0 then "" else Prefixed(header, name.Substring(0, name.Length - 2) + "qkv.")
	fused is "" then MossLora.None else MossLora.Loaded(path, fused, strength).Third(part)
Fused(path Text, name Text, strength Number) Slow(MossLora)
	Half.Fused("tinylora.safetensors", "layers.0.proj.qkv.", 1).rank is 24
	Half.Fused("tinylora.safetensors", "layers.0.proj.qkv.", 1).up.Length is 768 * 24
	let base = name.Substring(0, name.Length - 4)
	let query = Found(path, base + "q.", strength).Placed(0)
	query.Stacked(Found(path, base + "k.", strength).Placed(1)).Stacked(Found(path, base + "v.", strength).Placed(2))
IsFlipped(header Text) Boolean
	Half.IsFlipped("\"hyperflow\":\"true\"")
	Half.IsFlipped("\"hyperflow\":\"true\",\"hyperflow_fc1_layout\":\"gate_value\"") is false
	Half.IsFlipped("") is false
	(header.IndexOf("\"hyperflow\":\"true\"") >= 0) and (header.IndexOf("\"hyperflow_fc1_layout\":\"gate_value\"") < 0)
Swapped(lora MossLora, flipped Boolean) MossLora
	Half.Swapped(MossLora(MossLora.Tiny, up = (1, 2, 3, 4)), true).up is (3, 4, 1, 2)
	Half.Swapped(MossLora.Tiny, false) is MossLora.Tiny
	if flipped is false
		return lora
	let half = lora.up.Length / 2
	MossLora(lora, up = lora.up.Slice(half, half) + lora.up.Slice(0, half))
Merged(rows Safetensors, name Text, prefix Text) Slow(List(Numbers))
	H3Lora("").Merged(Safetensors("tinymoss.safetensors", 32, "layers.0.proj."), "o", "") is MossBlock.Tiny.output
	MossImage(Logger, 4).Compared(MossLora.Lowered, MossLora.Reference) < 0.02
	MossImage(Logger).Error(MossLora.Output, MossLora.Reference.Values("output")) < 0.02
	MossImage(Logger).Error(MossLora.FoursOutput, MossBlock.Layered) < 0.1
	let lora = Stacked(prefix + name + ".")
	if lora.rank is 0
		return rows.Quantized(name)
	rows.Tuned(name, Convrot(lora.down).Rotated, lora.up, MossLora.Repeated(1 / MossLora.Gain, lora.rank))
Dense(weights Safetensors, name Text) Slow(Batch)
	H3Lora("").Dense(H3Block.Model, "video_patch_proj") is MossText.Dense(H3Block.Model, "video_patch_proj")
	Half.Dense(H3Block.Model, "video_patch_proj").biases is not MossText.Dense(H3Block.Model, "video_patch_proj").biases
	let batch = MossText.Dense(weights, name)
	loras is "" then batch else Batch(Weighted(weights, batch.weights, name), Changed(name, "diff_b", batch.biases))
Optional(weights Safetensors, name Text) Slow(Batch)
	H3Lora("").Optional(H3Block.Model, "audio").weights.Length is 0
	H3Lora("").Optional(H3Block.Model, "video_patch_proj") is Dense(H3Block.Model, "video_patch_proj")
	weights.Entry(name + ".weight") is "" then Batch(List(Numbers), Layer.Unbiased) else Dense(weights, name)
Values(weights Safetensors, name Text) Slow(Numbers)
	Half.Values(H3Block.Model, "blocks.1.norm1") is H3Block.Model.Values("blocks.1.norm1.weight")
	Half.Values(H3Block.Model, "blocks.0.norm1") is not H3Block.Model.Values("blocks.0.norm1.weight")
	Changed(name, "diff", weights.Values(name + ".weight"))
Weighted(weights Safetensors, rows List(Numbers), name Text) Slow(List(Numbers))
	(Flow.Weighted(Reference, ((1, 2), (3, 4)), "o")(1)(0) is 5) and (Flow.Weighted(Reference, ((1), (3)), "p")(1)(0) is 3)
	Flow.Weighted(Safetensors(Flow.loras), ((0, 0), (0, 0)), "adaln_proj.linear") is ((11, 22), (33, 44))
	let width = rows.First.Length
	let lora = Stacked(name + ".")
	let fits = lora.rank > 0 and lora.down.Length is lora.rank * width and lora.up.Length is lora.rank * rows.Length
	let delta = Changed(name, "diff", fits then lora.Dense else List(Number))
	if delta.Length is 0
		return rows
	if name.EndsWith("adaln_proj.linear")
		return TensorFile.Shaped(MossText.Added(weights.Values(name + ".weight"), delta), width)
	for rows
		MossText.Added(value, delta.Slice(index * width, width))
Changed(module Text, suffix Text, base = List(Number)) Slow(Numbers)
	Half.Changed("missing", "diff").Length is 0
	Half.Changed("video_patch_proj", "diff_b")(0) is 0.07177734375
	Quarters.Changed("video_patch_proj", "diff_b") is Half.Changed("video_patch_proj", "diff_b")
	H3Lora("").Changed("video_patch_proj", "diff_b", (1, 2)) is (1, 2)
	mutable sum = base
	for loras.Split(";")
		let path = value.Split("=").First
		let prefix = loras is "" then "" else Prefixed(TensorFile.Header(path), module + ".", suffix + "\"")
		if prefix is not ""
			let current = Safetensors(path, 32, prefix).Values(suffix) * Strength(value)
			sum = sum.Length is 0 then current else MossText.Added(sum, current)
	sum
Prefixed(header Text, name Text, suffix = "lora_") Text
	Half.Prefixed("\"diffusion_model.b.fc1.lora_A.weight\"", "b.fc1.") is "diffusion_model.b.fc1."
	Half.Prefixed("\"lora_unet_b_fc1.lora_down.weight\"", "b.fc1.") is "lora_unet_b_fc1."
	Half.Prefixed("\"b.fc1.alpha\"", "b.fc1.") is ""
	Half.Prefixed("\"b.norm1.diff_b\"", "b.norm1.", "diff\"") is ""
	(Half.Prefixed("\"b.fc1.lora_A\"", "b.fc1.") is "b.fc1.") and (Half.Prefixed("\"x.b.fc1.lora_A\"", "b.fc1.") is "")
	for ("diffusion_model." + name, name, "lora_unet_" + name.Substring(0, name.Length - 1).Replace(".", "_") + ".")
		if header.IndexOf("\"" + value + suffix) >= 0
			return value
	""
Report Text
	H3Lora("").Report is ""
	Half.Report is ", tinyh3lora.safetensors applies 53 of its 61 tensors"
	if loras is ""
		return ""
	mutable report = ""
	for loras.Split(";")
		let path = value.Split("=").First
		let header = TensorFile.Header(path)
		let applied = ", " + path + " applies " + Applied(header)
		report = report + applied + " of its " + (header.Split("\"dtype\"").Length - 1) + " tensors"
	report
Applied(header Text) Number
	Half.Applied("\"b.mlp.fc1.lora_A.weight\":{},\"b.mlp.fc1.alpha\":{},\"b.norm1.diff\"") is 3
	Half.Applied("\"lora_unet_b_mlp_fc1.lora_down.weight\":{},\"lora_unet_b_mlp_fc1.alpha\":{}") is 2
	Half.Applied("\"audio_out.lora_A.weight\",\"b.norm.diff\",\"final_layer.norm.diff\",\"condition_proj.diff_b\"") is 2
	Half.Applied("\"video_patch_proj.lora_A.weight\":{},\"video_patch_proj.alpha\":{}") is 2
	Half.Applied("\"final_layer.adaln_proj.linear.lora_A.weight\":{},\"b.adaln_proj.linear.lora_B.weight\"") is 2
	mutable count = 0
	for Linears + "adaln_proj.linear"
		count = count + Counted(header, "." + value + ".") + Counted(header, "_" + value.Replace(".", "_") + ".")
	for Floats
		count = count + Counted(header, value + ".") + header.Split(value + ".diff").Length - 1
	count + Norms(header)
Norms(header Text) Number
	Half.Norms("\"b.norm1.diff\",\"b.norm2.diff\",\"final_layer.norm.diff\",\"x.adaln_proj.linear.diff_b\"") is 4
	Half.Norms("\"b.norm.diff\"") is 0
	mutable count = 0
	for (".norm1.diff\"", ".norm2.diff\"", "final_layer.norm.diff\"", "adaln_proj.linear.diff_b\"")
		count = count + header.Split(value).Length - 1
	count
Counted(header Text, module Text) Number
	Half.Counted("\"a.b.lora_A\",\"a.b.alpha\",\"a.c.alpha\"", ".b.") is 2
	header.Split(module + "lora_").Length + header.Split(module + "alpha").Length - 2
