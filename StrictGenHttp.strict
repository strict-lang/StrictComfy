constant ReceivePolls = 500
constant HeadBytes = 8192
constant Escapes = ("%20", " ", "%2F", "/", "%5C", "\\", "%3A", ":", "%2C", ",", "%26", "&", "%23", "#", "%5B", "[", "%5D", "]", "%2B", "+", "%3D", "=", "%40", "@", "%3B", ";", "%27", "'", "%25", "%")
constant OkHeader = "HTTP/1.1 200 OK\r\nContent-Type: "
constant Open = "\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n"
Route(raw Text) Text
	StrictGenHttp.Route("GET /status HTTP/1.1\r\n\r\n") is "/status"
	StrictGenHttp.Route("GET /file?path=a.jpg HTTP/1.1\r\n\r\n") is "/file"
	StrictGenHttp.Route("GET") is "/"
	let parts = raw.Split("\r\n").First.Split(" ")
	let target = parts.Length > 1 then parts(1) else "/"
	let question = target.IndexOf("?")
	question < 0 then target else target.Substring(0, question)
Query(raw Text, name Text) Text
	StrictGenHttp.Query("GET /file?path=a.jpg HTTP/1.1\r\n\r\n", "path") is "a.jpg"
	StrictGenHttp.Query("GET /file?path=a+b.jpg HTTP/1.1\r\n\r\n", "path") is "a b.jpg"
	let target = raw.Split("\r\n").First.Split(" ")
	let full = target.Length > 1 then target(1) else ""
	let question = full.IndexOf("?")
	for (question < 0 then "" else full.Substring(question + 1, full.Length - question - 1)).Split("&")
		if value.StartsWith(name + "=")
			return Unescaped(value.Substring(name.Length + 1, value.Length - name.Length - 1))
	""
Unescaped(text Text) Text
	StrictGenHttp.Unescaped("a+b%2Cc%26d%25") is "a b,c&d%"
	StrictGenHttp.Unescaped("x%2Fy%5Bz%5D") is "x/y[z]"
	mutable result = text.Replace("+", " ")
	for Range(0, Escapes.Length / 2)
		result = result.Replace(Escapes(index * 2), Escapes(index * 2 + 1))
	result
Body(raw Text) Text
	StrictGenHttp.Body("POST /run HTTP/1.1\r\n\r\n{\"a\":1}") is "{\"a\":1}"
	StrictGenHttp.Body("GET / HTTP/1.1\r\n\r\n") is ""
	let separator = raw.IndexOf("\r\n\r\n")
	separator < 0 then "" else raw.Substring(separator + 4, raw.Length - separator - 4)
Received(client Number) Numbers slow
	if (client is Error) or (client <= 0)
		return List(Number)
	mutable bytes = List(Mutable(Number))
	mutable idle = 0
	for as long as (idle < ReceivePolls) and (IsComplete(bytes) is false)
		let pending = Socket.Pending(client)
		if pending > 0
			bytes = bytes + Socket.Receive(client, pending)
		idle = pending > 0 then 0 else idle + 1
		if pending <= 0
			Process.Wait(0.01)
	bytes
Head(bytes Numbers) Text
	StrictGenHttp.Head(StrictGenHttp.Encoded("GET / HTTP/1.1\r\n\r\nab")) is "GET / HTTP/1.1\r\n\r\n"
	StrictGenHttp.Head(StrictGenHttp.Encoded("GET / HT")) is ""
	let start = Decoded(bytes.Slice(0, bytes.Length.Clamp(0, HeadBytes)))
	let separator = start.IndexOf("\r\n\r\n")
	separator < 0 then "" else start.Substring(0, separator + 4)
IsComplete(bytes Numbers) Boolean
	StrictGenHttp.IsComplete(StrictGenHttp.Encoded("GET / HTTP/1.1\r\n\r\n"))
	StrictGenHttp.IsComplete(StrictGenHttp.Encoded("POST / HTTP/1.1\r\nContent-Length: 2\r\n\r\nab"))
	StrictGenHttp.IsComplete(StrictGenHttp.Encoded("POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nab")) is false
	let head = Head(bytes)
	if head is ""
		return false
	let start = head.Lower.IndexOf("content-length: ")
	let length = start < 0 then 0 else head.Substring(start + 16, head.Length - start - 16).Split("\r\n").First to Number
	bytes.Length - head.Length >= length
Payload(bytes Numbers) Numbers
	StrictGenHttp.Payload(StrictGenHttp.Encoded("POST / HTTP/1.1\r\n\r\nab")) is (97, 98)
	let head = Head(bytes)
	bytes.Slice(head.Length, bytes.Length - head.Length)
Replied(client Number, kind Text, body Text) slow
	let payload = Encoded(body)
	Socket.Send(client, Encoded(OkHeader + kind + "\r\nContent-Length: " + payload.Length + Open) + payload)
	Socket.Close(client)
SendFile(client Number, path Text) slow
	if (path is "") or (File(path).Exists is false)
		Replied(client, "text/plain", "missing")
		return
	let payload = File(path).ReadBytes
	let changing = (path.IndexOf("StrictGenStep") >= 0) or path.StartsWith(StrictGen.Inputs)
	let cache = changing then "no-store" else "public, max-age=86400"
	let length = "\r\nContent-Length: " + payload.Length + "\r\nConnection: close\r\nCache-Control: " + cache + "\r\n\r\n"
	Socket.Send(client, Encoded(OkHeader + Kind(path) + length) + payload)
	Socket.Close(client)
Kind(path Text) Text
	StrictGenHttp.Kind("a.jpg") is "image/jpeg"
	StrictGenHttp.Kind("a.mp4") is "video/mp4"
	StrictGenHttp.Kind("a.png") is "image/png"
	(StrictGenHttp.Kind("a.jpeg") is "image/jpeg") and (StrictGenHttp.Kind("a.bin") is "application/octet-stream")
	let extension = path.Lower.Split(".").Last
	let image = (extension is "jpg") or (extension is "jpeg") then "image/jpeg" else "application/octet-stream"
	extension is "png" then "image/png" else (extension is "mp4" then "video/mp4" else image)
Encoded(text Text) Numbers
	StrictGenHttp.Encoded("Ab") is (65, 98)
	for text
		value.number
Decoded(bytes Numbers) Text
	StrictGenHttp.Decoded((65, 98)) is "Ab"
	Text.Combine(Letters(bytes), "")
Letters(bytes Numbers) Texts
	StrictGenHttp.Letters((65, 98)) is ("A", "b")
	for bytes
		Character(value) to Text
