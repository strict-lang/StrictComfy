has logger
has options H3Options
has pictured List(Numbers) = List(Numbers)
has prompt = ""
has commandLine Texts = List(Text)
constant Sample = H3Batch(Logger, H3Options.Parsed(("--models", ".", "--length", "5", "--width", "32", "--height", "32")))
constant Workflowed = H3Batch(Logger, H3Options.Parsed(("--models", ".", "--workflow", "tinyh3strictworkflow.json")))
constant Encoder = "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
Completed Number
	let inputs = H3Inputs(options)
	let problem = inputs.Problem
	if problem is not ""
		logger.Log(problem)
		return 2
	let started = Process.Elapsed
	let seeds = PromptBatch(logger, "Video").Seeds(options.seed, inputs.Count)
	let made = Made(seeds, inputs.Chosen(inputs.Paired, seeds))
	logger.Log("Total " + (Process.Elapsed - started).Round(2) + " s for " + seeds.Length + " videos")
	made
Made(seeds Numbers, chosen List(Texts)) Slow(Number)
	let inputs = H3Inputs(options)
	let batch = PromptBatch(logger, "Video")
	let images = inputs.Column(chosen, 0)
	let prompts = batch.Prompts(batch.Templates(inputs.Column(chosen, 1), prompt), seeds)
	let paths = Cached(prompts, images)
	H3Batch(logger, options, Pictured(images)).Videos(seeds, images, paths, Conditions(prompts, images, paths))
Conditions(prompts Texts, images Texts, paths Texts) Slow(List(Safetensors))
	let missing = Missing(paths)
	let inputs = H3Inputs(options)
	if missing.Length is 0
		logger.Log("Using cached prompt conditioning")
	else
		Encoded(inputs.Picked(prompts, missing), inputs.Picked(images, missing), inputs.Picked(paths, missing))
	if Missing(paths).Length > 0
		return Error("TextEncoderFailed")
	for paths.Unique
		Safetensors(value, 32)
Cached(prompts Texts, images Texts) Texts
	Sample.Cached(List(Text) + "a", List(Text) + "").First.EndsWith(".safetensors")
	Sample.Cached(("a", "b"), ("", "")).First is not Sample.Cached(("a", "b"), ("", "")).Last
	Sample.Cached(("a", "a"), ("", "tinyframe.png")).First is not Sample.Cached(("a", "a"), ("", "tinyframe.png")).Last
	let named = options.files.textEncoder is "" then Encoder else options.files.textEncoder
	for prompts
		let identity = named + Text.Combine(Pictures(images(index)), "") + "\n"
		Folder + "/context-" + HashCode(identity + value).number + "-" + value.Length + ".safetensors"
Pictures(image Text) Texts
	Sample.Pictures("").Length is 0
	Sample.Pictures("H3Batch.strict").First.StartsWith(" H3Batch.strict ")
	for (image, options.files.lastImage)
		if value is not ""
			" " + value + " " + File(value).Length + " " + options.width + "x" + options.height
Missing(paths Texts) Numbers
	Sample.Missing(List(Text) + "H3Batch.strict").Length is 0
	Sample.Missing(("H3Batch.strict", "H3BatchMissing.safetensors", "H3BatchMissing.safetensors")) is (1)
	for paths
		if (File(value).Exists is false) and (paths.Index(value) is index)
			index
Encoded(prompts Texts, images Texts, paths Texts) Slow(Number)
	let encoding = H3Encoding(logger, commandLine)
	Directory.Create(Root + "/artifacts")
	Directory.Create(Folder)
	encoding.Started(prompts, images, paths)
Videos(seeds Numbers, images Texts, paths Texts, conditions List(Safetensors)) Slow(Number)
	let h3 = H3Video(logger).Loaded(options.Checkpoint, options.Loras)
	let texts = H3Refiner.Loaded(options.Checkpoint, options.Loras).Texts(conditions)
	let latents = Latents(seeds.Length)
	for seeds
		let before = Process.Elapsed
		let at = paths.Unique.Index(paths(index))
		let keyframes = H3Inputs(options).Keyframes(pictured, images(index), images)
		Safetensors(latents(index)).Written("latent", Generated(h3, conditions(at), texts(at), value, keyframes))
		GpuMemory.Released
		logger.Log("Video " + (index + 1) + " sampled in " + ((Process.Elapsed - before) * 1000).Round + " ms")
	GpuMemory.Evicted
	Decoded(latents, images)
Generated(h3 H3, condition Safetensors, text Numbers, seed Number, keyframes List(Numbers)) Slow(Numbers)
	let shapes = options.Shapes
	let count = 24 * shapes(0) * shapes(1) * shapes(2)
	let noise = MersenneTwister.Seeded(seed).Normals(count + 64 * shapes(3))
	let audio = noise.Slice(count, noise.Length - count)
	let shape = (24, shapes(0), shapes(1), shapes(2))
	let job = H3Job(Safetensors(""), noise.Slice(0, count), audio, shape, options.IsNoisy then seed else -1)
	let rows = job.Keyed(keyframes, (24, 1, shapes(1), shapes(2)), seed)
	let keyed = H3Job(job, rows = rows, keyframes = H3Inputs(options).Indices)
	H3Video(logger).Generated(h3, condition, keyed, text, options.Numbers, "")
Latents(count Number) Texts
	Sample.Latents(2).Last.EndsWith("/latent-1.safetensors")
	for count
		Folder + "/latent-" + index + ".safetensors"
Decoded(latents Texts, images Texts) Slow(Number)
	let decoding = H3Video(logger).Decoding(List(H3Decoding), (options.files.Decoder, options.files.Sound)).First
	for latents
		Saved(decoding, Safetensors(value, 32).Values("latent"), H3Inputs(options).Output(images(index)))
	0
Saved(decoding H3Decoding, latent Numbers, output Text) Slow(Number)
	let before = Process.Elapsed
	let shapes = options.Shapes
	let decoded = decoding.Decoded(latent, shapes.Slice(0, 3))
	logger.Log("Video decoded in " + (Process.Elapsed - before).Round(1) + " s")
	let path = PromptBatch(logger, "Video").Reserved(output)
	H3Frames(logger).Saved(decoded(0), decoded(1), (shapes(1) * 16, shapes(2) * 16), path)
Folder Text
	Sample.Folder.EndsWith("/artifacts/h3")
	Root + "/artifacts/h3"
Root Text
	Sample.Root.Length > 0
	Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text
Pictured(images Texts) Slow(List(Numbers))
	Sample.Pictured(List(Text) + "").Length is 0
	let firsts = H3Inputs(options).Firsts(images)
	let count = firsts.Length + (options.files.lastImage is "" then 0 else 1)
	if count is 0
		return List(Numbers)
	let size = (options.height, options.width)
	logger.Log("Encoding " + count + " keyframe images")
	let picture = H3Picture(H3VaeEncoder.Loaded(Safetensors(options.files.Decoder, 32)), H3Tiles.Real)
	for firsts + options.files.lastImage
		if value is not ""
			picture.Encoded(picture.Frame(value, size, options.files.Cropped(index < firsts.Length then 0 else 1)), size)
Expanded(arguments Texts) Slow(H3Batch)
	Sample.Expanded(List(Text)).prompt is ""
	Workflowed.Expanded(("--models", ".", "--length", "22")).options.length is 22
	Workflowed.Expanded(("--models", ".", "--length", "22")).prompt is "a fox"
	if options.files.workflow is ""
		return H3Batch(logger, options, List(Numbers), "", arguments)
	let workflow = H3Workflow(ComfyGraph.Read(options.files.Workflow, H3Workflow.Known), options.files.ComfyUI)
	let settings = workflow.Arguments
	logger.Log("Workflow settings: " + Text.Combine(settings, " "))
	logger.Log("Skipped nodes (not needed or unsupported): " + Text.Combine(workflow.graph.Skipped, ", "))
	let prompted = "--prompt" is in arguments then "" else workflow.Prompt
	H3Batch(logger, H3Options.Parsed(settings + arguments), pictured, prompted, arguments)
