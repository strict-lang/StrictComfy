has logger
has options H3Options
has pictured List(Numbers) = List(Numbers)
has prompt = ""
has commandLine Texts = List(Text)
has motion StrictGenExtend = StrictGenExtend.None
constant Sample = H3Batch(Logger, H3Options.Parsed(("--models", ".", "--length", "5", "--width", "32", "--height", "32")))
constant Workflowed = H3Batch(Logger, H3Options.Parsed(("--models", ".", "--workflow", "tinyh3strictworkflow.json")))
constant Encoder = "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
constant Keyframed = H3Batch(Logger, H3Options.Parsed(("--models", ".", "--last_image", "tinyframe.png")))
constant Loraed = H3Batch(Logger, H3Options.Parsed(("--models", ".", "--lora", "tinylora.safetensors:0.5", "--lora", "tinyqkvlora.safetensors", "--steps", "20")))
constant Turbo = H3Batch(Logger, H3Options.Parsed(("--models", ".", "--model", "a_Turbo_8step.safetensors")))
constant Vae = "FileNotFound:minimax_h3_video_vae_int8_convrot.safetensors"
constant Longer = ("--models", ".", "--length", "22")
Completed Boolean slow
	let ready = H3Batch(logger, Noted, pictured, prompt, commandLine)
	let problem = H3Inputs(ready.options).Problem
	if problem is not ""
		logger.Log(problem)
		return false
	let started = Process.Elapsed
	let plan = ready.Planned
	plan.batch.Videos(plan, ready.Conditions(plan.prompts, plan.images, plan.paths))
	logger.Log("Total " + (Process.Elapsed - started).Round(2) + " s for " + plan.seeds.Length + " videos")
	true
Noted H3Options
	H3Batch(Logger, H3Options.Parsed(("--width", "720"))).Noted.width is 704
	let fitted = options.Fitted
	if (fitted.width is options.width) and (fitted.height is options.height)
		return fitted
	logger.Log("H3 size " + options.width + "x" + options.height + " changed to " + fitted.width + "x" + fitted.height)
	fitted
Planned H3Plan slow
	let inputs = H3Inputs(options)
	let batch = PromptBatch(logger, "Video")
	let seeds = batch.Seeds(options.seed, inputs.Count)
	let chosen = inputs.Chosen(inputs.Paired, seeds)
	let images = inputs.Column(chosen, 0)
	let prompts = batch.Prompts(batch.Templates(inputs.Column(chosen, 1), prompt), seeds)
	let framed = H3Batch(logger, options, Pictured(images), prompt, commandLine)
	H3Plan(framed, seeds, images, prompts, H3Artifacts(options).Cached(prompts, images))
Conditions(prompts Texts, images Texts, paths Texts) List(Safetensors) slow
	let artifacts = H3Artifacts(options)
	let missing = artifacts.Missing(paths)
	let inputs = H3Inputs(options)
	if missing.Length is 0
		logger.Log("Using cached prompt conditioning")
		return artifacts.Read(paths)
	let code = Encoded(inputs.Picked(prompts, missing), inputs.Picked(images, missing), inputs.Picked(paths, missing))
	code is 0 then artifacts.Read(paths) else Error("TextEncoderFailed")
Encoded(prompts Texts, images Texts, paths Texts) Number slow
	let encoding = H3Encoding(logger, commandLine)
	Directory.Create(H3Artifacts(options).Root + "/artifacts")
	Directory.Create(H3Artifacts(options).Folder)
	encoding.Started(prompts, images, paths)
Videos(plan H3Plan, conditions List(Safetensors)) None slow
	let batch = Armed
	if batch.motion.problem is not ""
		return Error(batch.motion.problem)
	let h3 = H3Video(logger).Loaded(options.Checkpoint, options.Loras)
	let refiner = H3Refiner.Loaded(options.Checkpoint, options.Loras)
	let latents = H3Artifacts(options).Latents(plan.seeds.Length, "")
	batch.Prefetched((options.files.Decoder, options.files.Sound), "the VAEs")
	batch.Sampled(h3, refiner, plan, conditions, latents, true)
	options.files.Freed
	Decoded(latents, plan.images)
LoraFiles Texts slow
	Loraed.LoraFiles is ("tinylora.safetensors", "tinyqkvlora.safetensors")
	Turbo.LoraFiles.Length is 0
	let loras = options.Loras
	if loras is ""
		return List(Text)
	for loras.Split(";")
		value.Split("=").First
Prefetched(paths Texts, what Text)
	Sample.Prefetched(List(Text) + "tinyqkvlora.safetensors", "LoRA") is not Error
	logger.Log(ModelFiles("").Prefetching(paths, what))
Sampled(h3 H3, refiner H3Refiner, plan H3Plan, conditions List(Safetensors), latents Texts, uploading Boolean) slow
	let texts = refiner.Texts(conditions)
	for plan.seeds
		let before = Process.Elapsed
		logger.Log(Sampling(index, plan.seeds.Length, uploading and (index is 0)))
		let at = plan.paths.Unique.Index(plan.paths(index))
		let keyframes = H3Inputs(options).Keyframes(pictured, plan.images(index), plan.images)
		Safetensors(latents(index)).Written("latent", Generated(h3, conditions(at), texts(at), value, keyframes))
		logger.Log("Video " + (index + 1) + " sampled in " + ((Process.Elapsed - before) * 1000).Round + " ms")
		GpuMemory.Finished
Sampling(index Number, count Number, uploading Boolean) Text
	Sample.Sampling(0, 2, true) is "Sampling video 1/2 with 8 steps, the first one uploads H3 into GPU VRAM"
	Sample.Sampling(1, 2, false) is "Sampling video 2/2 with 8 steps"
	let sampling = "Sampling video " + (index + 1) + "/" + count + " with " + options.Evaluated + " steps"
	uploading then sampling + ", the first one uploads H3 into GPU VRAM" else sampling
Generated(h3 H3, condition Safetensors, text Numbers, seed Number, keyframes List(Numbers)) Numbers slow
	let shapes = options.Shapes
	let count = H3Format.Channels * shapes(0) * shapes(1) * shapes(2)
	let noise = MersenneTwister.Seeded(seed).Normals(count + 64 * shapes(3))
	let audio = noise.Slice(count, noise.Length - count)
	let shape = (H3Format.Channels, shapes(0), shapes(1), shapes(2))
	let job = H3Job(Safetensors(""), noise.Slice(0, count), audio, shape, options.IsNoisy then seed else -1)
	let rows = job.Keyed(keyframes + motion.Latents, (H3Format.Channels, 1, shapes(1), shapes(2)), seed)
	let previewer = H3Previewer.Loaded(options.preview, options.files.models)
	let indices = H3Inputs(options).Indices + motion.Starts
	let heard = StrictGenExtend(motion, frames = 0)
	let keyed = H3Job(job, rows = rows, keyframes = indices, motion = heard, previewer = previewer)
	H3Video(logger).Generated(h3, condition, keyed, text, options.Numbers, "")
Decoded(latents Texts, images Texts) slow
	let decoding = H3Video(logger).Decoding(List(H3Decoding), (options.files.Decoder, options.files.Sound)).First
	DecodedWith(decoding, latents, images)
DecodedWith(decoding H3Decoding, latents Texts, images Texts) slow
	for latents
		logger.Log("Decoding video " + (index + 1) + "/" + latents.Length)
		Saved(decoding, Safetensors(value, 32).Values("latent"), H3Inputs(options).Output(images(index)))
Saved(decoding H3Decoding, latent Numbers, output Text) slow
	let before = Process.Elapsed
	let shapes = options.Shapes
	let decoded = decoding.Tiled(options.Tiling).Decoded(latent, shapes.Slice(0, 3))
	logger.Log("Video decoded in " + (Process.Elapsed - before).Round(1) + " s")
	let path = PromptBatch(logger, "Video").Reserved(output)
	StrictGenExtend(logger).Kept(path, latent, shapes, options.Clip, H3Artifacts(options).Folder)
	if Joined(decoded, (shapes(1) * 16, shapes(2) * 16), path) is Error
		if File(path).Length is 0
			File(path).Delete
		return Error("VideoNotWritten")
Joined(decoded List(Numbers), size Numbers, path Text) slow
	let video = options.files.video
	if video is ""
		return H3Frames(logger).Saved(decoded(0), decoded(1), size, path)
	StrictGenClip(logger).Appended(video, decoded(0), decoded(1), size, options.files.context, path)
Armed H3Batch slow
	let files = options.files
	if files.video is ""
		return value
	let extend = StrictGenExtend(logger)
	let size = (options.height, options.width)
	let head = extend.Head(files.video, files.context, size, (files.VaeEncoder, files.Sound), H3Artifacts(options).Folder)
	H3Batch(value, motion = head)
Pictured(images Texts) List(Numbers) slow
	Sample.Pictured(List(Text) + "").Length is 0
	Keyframed.Pictured(List(Text) + "") is Error(Vae) and Keyframed.Pictured(List(Text) + "tinyframe.png") is Error(Vae)
	let firsts = H3Inputs(options).Firsts(images)
	let count = firsts.Length + (options.files.lastImage is "" then 0 else 1)
	if count is 0
		return List(Numbers)
	let size = (options.height, options.width)
	logger.Log("Encoding " + count + " keyframe images")
	let picture = H3Picture(H3VaeEncoder.Loaded(Safetensors(options.files.VaeEncoder, 32)), H3Tiles.Real)
	for firsts + options.files.lastImage
		if value is not ""
			picture.Encoded(picture.Frame(value, size, options.files.Cropped(index < firsts.Length then 0 else 1)), size)
Expanded(arguments Texts) H3Batch slow
	Sample.Expanded(List(Text)).prompt is ""
	Workflowed.Expanded(Longer).options.length is 22 and Workflowed.Expanded(Longer).prompt is "a fox"
	Workflowed.Expanded(("--models", ".", "--prompt", "b.txt")).prompt is ""
	if options.files.workflow is ""
		return H3Batch(logger, Noted, List(Numbers), "", arguments)
	let workflow = H3Workflow(ComfyGraph.Read(options.files.Workflow, H3Workflow.Known), options.files.ComfyUI)
	let settings = workflow.Arguments
	logger.Log("Workflow settings: " + Text.Combine(settings, " "))
	logger.Log("Skipped nodes (not needed or unsupported): " + Text.Combine(workflow.graph.Skipped, ", "))
	let prompted = "--prompt" is in arguments then "" else workflow.Prompt
	H3Batch(logger, H3Batch(logger, H3Options.Parsed(settings + arguments)).Noted, pictured, prompted, arguments)
