has logger
has root Text
constant StartSeconds = 30
constant PollSeconds = 0.2
constant Room = 51539607552
constant Local = "--local"
constant Serving = "serve"
constant Sample = H3Client(Logger, "artifacts/h3test")
IsServing(arguments Texts) Boolean
	H3Client.IsServing(List(Text))
	H3Client.IsServing(("--prompt", "a.txt"))
	H3Client.IsServing(List(Text) + "serve")
	H3Client.IsServing(List(Text) + "stop")
	H3Client.IsServing(List(Text) + "-") is false
	H3Client.IsServing(("encode", "a")) is false
	let isCommand = (arguments is (Serving)) or (arguments is (Resident.Stopping))
	isCommand or (arguments.Length is 0) or (arguments(0).StartsWith("-") and (arguments(0) is not "-"))
Ran(arguments Texts) Number
	if arguments is (Serving)
		return H3Server(logger, Resident(root)).Served
	if arguments is (Resident.Stopping)
		return Stopped
	let rest = arguments - Local
	let forwarded = Local is in arguments then -1 else Forwarded(arguments)
	forwarded >= 0 then forwarded else H3Batch(logger, H3Options.Parsed(rest)).Expanded(rest).Completed
Forwarded(arguments Texts) Number
	let first = Attempted(arguments)
	first is -1 then Attempted(arguments) else first
Attempted(arguments Texts) Number
	let isRunning = File(root + Resident.Stamp).Exists
	if (isRunning is false) and (HasRoom is false)
		return -1
	if isRunning is false
		logger.Log("Starting the H3Video backend, it keeps the models loaded for the next runs (--local runs without it)")
		Forwarding(logger, root).Started
	let port = Waited(StartSeconds)
	port > 0 then Forwarding(logger, root).Answered(port, arguments) else -1
Waited(seconds Number) Number
	Sample.Waited(0) is 0
	let started = Process.Elapsed
	mutable isBusy = false
	mutable port = 0
	for as long as (port is 0) and (isBusy or (Process.Elapsed - started < seconds))
		port = Port
		if (port < 0) and (isBusy is false)
			logger.Log("Waiting for the H3Video backend to finish the run it works on")
		isBusy = port < 0
		port = port > 0 then port else Paused
	port
Port Number
	Sample.Port is 0
	let stamp = File(root + Resident.Stamp)
	if stamp.Exists is false
		return 0
	File(root + Resident.Free).Exists then stamp.ReadLines.First to Number else -1
Paused Number
	Process.Wait(PollSeconds)
	0
HasRoom Boolean
	Sample.HasRoom is (GpuMemory.HostAvailable is 0) or (GpuMemory.HostAvailable >= Room)
	let available = GpuMemory.HostAvailable
	(available is 0) or (available >= Room)
Stopped Number
	Sample.Stopped is 0
	Forwarding(logger, root).Forwarded(List(Text) + Resident.Stopping)
