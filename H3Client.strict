has logger
has root Text
Ran(arguments Texts) Number
	if arguments is (Backend.Serving)
		return H3Server(logger, Backended).Served
	let forwarded = Backended.Dispatched(arguments)
	let rest = arguments - Backend.Local
	forwarded >= 0 then forwarded else H3Batch(logger, H3Options.Parsed(rest)).Expanded(rest).Completed
Backended Backend
	H3Client(Logger, "artifacts/h3test").Backended.name is "H3Video"
	Backend(logger, Resident(root), "H3Video")
