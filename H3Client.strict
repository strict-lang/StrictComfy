has logger
has root Text
has coordinator = ""
constant MinimumRam = 68719476736
constant MinimumVram = 10737418240
constant QualityChoices = "--quality must be best, fast, faster, fastest4steps or fastest2steps"
constant Sample = H3Client(Logger, "artifacts/h3test", Backend.Nowhere)
Ran(given Texts) Number
	if given is (Backend.Serving)
		return H3Server(logger, Backended).Served
	let arguments = given - MachineUse.Force
	let plain = Remote(logger).Without(arguments)
	let rest = plain - Backend.Local
	if Unparsed(rest) is not ""
		return Refused(Unparsed(rest))
	if MachineUse.IsChecked(arguments, root)
		if Granted(arguments, MachineUse.IsForced(given)) is not 0
			return 1
	let forwarded = Backended.Dispatched(plain)
	forwarded >= 0 then forwarded else H3Batch(logger, H3Options.Parsed(rest)).Expanded(rest).Completed
Backended Backend
	Sample.Backended.name is "H3Video"
	Backend(logger, Resident(root), "H3Video", coordinator)
Asked(arguments Texts, forced Boolean) Text
	Sample.Asked(List(Text), false).StartsWith("need\tH3Video\t")
	let use = Use(arguments, forced)
	let mode = forced then "force" else "wait"
	"need\tH3Video\tH3Video\t" + MinimumRam + "\t" + use.ram + "\t" + MinimumVram + "\t" + use.vram + "\t0\t" + mode
Granted(arguments Texts, forced Boolean) Slow(Number)
	Sample.Granted(List(Text), false) >= 0
	let named = Remote(logger).Named(arguments)
	named >= 0 then named else Continued(arguments, forced)
Continued(arguments Texts, forced Boolean) Slow(Number)
	Sample.Continued(List(Text), false) >= 0
	let line = Asked(arguments, forced)
	if line is ""
		return 0
	let reply = Coordinator(logger, coordinator).Sent(line)
	let sent = Remote(logger).Sent(arguments, "", reply, line)
	if sent >= 0
		return sent
	let settled = reply.StartsWith("wait") then Coordinator(logger, coordinator).Resolved(line) else reply
	if settled.StartsWith("refused")
		return Use(arguments, forced).Explained(settled)
	settled is "" then Use(arguments, forced).Checked else 0
Refused(reply Text) Number
	Sample.Refused("refused\tH3Video") is 1
	logger.Log(reply)
	1
Use(arguments Texts, forced Boolean) MachineUse
	Sample.Use(List(Text), true).isForced
	let files = Options(arguments).files
	let bytes = (File(files.Checkpoint).Length, File(files.Encoder).Length)
	MachineUse.Models(logger, "H3Video", bytes(0), bytes(1), H3Resident.EncoderGrowth, forced)
Unparsed(arguments Texts) Text
	Sample.Unparsed(List(Text)) is ""
	Sample.Unparsed(List(Text) + "stop") is ""
	Sample.Unparsed(("--quality", "fastest")) is QualityChoices
	Sample.Unparsed(("--colour", "red")) is "--colour is not an option of H3Video, see H3Video --help"
	Sample.Unparsed(("--count", "many")) is "--count must be a number"
	let parsed = H3Options.Parsed(arguments)
	(parsed is Error) then Explained((parsed to Text).Lines.First.Replace("Error: ", "")) else ""
Explained(problem Text) Text
	Sample.Explained("UnknownChoice:--quality") is QualityChoices
	Sample.Explained("InvalidNumber:--count") is "--count must be a number"
	Sample.Explained("UnknownOption:--colour").StartsWith("--colour is not an option")
	Sample.Explained("Odd") is "Odd"
	let option = problem.Split(":").Last
	if problem.StartsWith("InvalidNumber:")
		return option + " must be a number"
	if problem.StartsWith("UnknownChoice:")
		return QualityChoices
	problem.StartsWith("UnknownOption:") then option + " is not an option of H3Video, see H3Video --help" else problem
Options(arguments Texts) H3Options
	Sample.Options(("--local", "--remote", "AiServer", "--steps", "6")).steps is 6
	H3Options.Parsed(Remote(logger).Without(arguments) - Backend.Local)
