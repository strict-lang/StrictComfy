has logger
has modes Texts = List(Text)
has commands Texts = List(Text)
has lines Texts = List(Text)
has pending Numbers = List(Number)
has results Texts = List(Text)
has captions Texts = List(Text)
has bodies Texts = List(Text)
has pins Texts = List(Text)
has outcomes Texts = List(Text)
has aim = ""
has notice = ""
has job = StrictGenJob
has finished = 0
has halted = false
constant Empty = StrictGenQueue(Logger)
Added(mode Text, command Texts, line Text, body Text = "", pin Text = "") StrictGenQueue
	Empty.Added("image", ("--width", "32"), "Image fox 32x32 fastest m").modes.Length is 1
	Empty.Added("image", ("--width", "32"), "fox").Added("video", ("--length", "24"), "owl").pending.Length is 2
	Empty.Added("image", ("--width", "32"), "Image fox").Cleared.pending.Length is 0
	let queued = StrictGenQueue(value, modes = modes + mode, commands = commands + Text.Combine(command, "\n"))
	let kept = StrictGenQueue(queued, bodies = bodies + body, pins = pins + pin, outcomes = outcomes + "")
	StrictGenQueue(kept, lines = lines + line, pending = pending + (modes.Length), halted = false)
Cleared StrictGenQueue
	Empty.Added("image", ("--width", "32"), "Image fox").Cleared.pending.Length is 0
	Empty.Added("image", ("--width", "32"), "Image fox").Cleared.halted
	StrictGenQueue(value, pending = List(Number), halted = true)
Posted(route Text, body Text) Slow(StrictGenQueue)
	Empty.Posted("/run", StrictGenForm.Picture).pending.Length is 1
	Empty.Added("image", ("--width", "32"), "fox").Posted("/stop", "").pending.Length is 0
	if route is "/run"
		let json = Json(body)
		let pin = json.get("placed") to Text is "true" then "local" else json.get("remote") to Text
		if job.current < 0
			File("StrictGenJob.log").Delete
		let added = Added(json.get("mode") to Text, StrictGenForm.Arguments(body), StrictGenForm.Summary(body), body, pin)
		return StrictGenQueue(added, notice = "Run started", aim = (pin is "local" then "local" else added.aim))
	StrictGenJob.StopAll
	Cleared
Advanced StrictGenQueue
	Empty.Advanced.job.current is -1
	job.current >= 0 then Polled else (pending.Length is 0) or halted or (aim is "") then value else Launch
Launch StrictGenQueue
	if aim is ""
		return value
	if aim is "none"
		return Refused("No StrictGen on the network can run this")
	if aim.IndexOf(":") >= 0
		return Sent(aim)
	let index = pending.First
	let executable = StrictGenJob.Executable(StrictGenJob.Program(modes(index)))
	let local = StrictGenJob.Local(index)
	if local.Started(executable, modes(index), commands(index)) is false
		return Refused("Could not start " + executable)
	StrictGenQueue(value, pending = pending.Slice(1, pending.Length - 1), job = local, aim = "")
Refused(reason Text) StrictGenQueue
	let left = pending.Slice(1, pending.Length - 1)
	let outcome = Noted(pending.First, "error\t" + reason)
	StrictGenQueue(value, pending = left, aim = "", finished = finished + 1, notice = reason, outcomes = outcome)
Sent(endpoint Text) StrictGenQueue
	let index = pending.First
	let id = StrictGenRemote.Delivered(endpoint, bodies.Length > index then bodies(index) else "")
	if (id is "") or id.StartsWith("error")
		return Refused(id is "" then "The other StrictGen did not answer" else id)
	let remote = StrictGenJob.Remote(index, endpoint, id to Number)
	StrictGenQueue(value, pending = pending.Slice(1, pending.Length - 1), job = remote, aim = "")
Polled StrictGenQueue
	if job.remote is not ""
		return Remote
	let rows = job.Logged
	if (job.done is "") or (File(job.done).Exists is false)
		return StrictGenQueue(value, job = job.Timed(rows))
	let paths = job.Existing(job.Found(rows))
	job.Timed(rows).Kept(rows)
	File(job.done).Delete
	let caption = paths.Length is 0 then "The run finished without an output file" else lines(job.current)
	Finished(paths, caption, job.Prompts(rows))
Remote StrictGenQueue
	let answer = StrictGenRemote.Asked(job.remote, job.remoteId)
	let kind = answer.Split("\t").First
	if (answer is "wait") or (kind is "wait") or (answer is "")
		return value
	if kind is "error"
		return Finished(List(Text), answer, List(Text))
	let path = StrictGenRemote.Saved(job.remote, answer.Split("\t").Last)
	if path is ""
		return Finished(List(Text), "The other StrictGen sent no file", List(Text))
	Finished(List(Text) + path, lines(job.current), List(Text))
Finished(paths Texts, caption Text, prompts Texts) StrictGenQueue
	let empty = paths.Length is 0
	let recorded = Noted(job.current, empty then "error\t" + caption else "file\t" + paths.Last)
	let shown = Captions(paths, caption, prompts)
	let made = StrictGenQueue(value, results = results + paths, captions = shown, outcomes = recorded)
	let done = StrictGenQueue(made, job = StrictGenJob, finished = finished + 1, notice = (empty then caption else notice))
	halted then done else done.Advanced
Captions(paths Texts, caption Text, prompts Texts) Texts
	mutable kept = captions
	for paths
		kept = kept + (index < prompts.Length then prompts(index) else caption)
	kept
IsBusy Boolean
	Empty.IsBusy is false
	job.current >= 0
NeedsAim Boolean
	Empty.NeedsAim is false
	(pending.Length > 0) and (job.current < 0) and (aim is "") and (halted is false)
NextMode Text
	Empty.NextMode is ""
	Empty.Added("video", ("--length", "24"), "owl").NextMode is "video"
	pending.Length is 0 then "" else modes(pending.First)
Pin Text
	Empty.Pin is ""
	Empty.Added("video", ("--length", "24"), "owl", "", "local").Pin is "local"
	(pending.Length is 0) or (pins.Length <= pending.First) then "" else pins(pending.First)
Aimed(target Text) StrictGenQueue
	Empty.Aimed("local").aim is "local"
	StrictGenQueue(value, aim = target)
Report(id Number) Text
	Empty.Report(0) is "error\tmissing"
	Empty.Added("image", ("--width", "32"), "fox").Report(0) is "wait"
	if (id < 0) or (id >= modes.Length)
		return "error\tmissing"
	if (id is job.current) or (id is in pending) or (outcomes.Length <= id)
		return "wait"
	outcomes(id) is "" then "wait" else outcomes(id)
Noted(at Number, text Text) Texts
	mutable items = List(Mutable(Text))
	for Range(0, modes.Length)
		items.Add(at is index then text else (outcomes.Length > index then outcomes(index) else ""))
	items
