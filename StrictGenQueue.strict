has logger
has modes Texts = List(Text)
has commands Texts = List(Text)
has lines Texts = List(Text)
has pending Numbers = List(Number)
has results Texts = List(Text)
has captions Texts = List(Text)
has bodies Texts = List(Text)
has pins Texts = List(Text)
has outcomes Texts = List(Text)
has aim = ""
has remote = ""
has remoteId = -1
has notice = ""
has jobLog = ""
has jobDone = ""
has jobPreview = ""
has current = -1
has finished = 0
has halted = false
constant Empty = StrictGenQueue(Logger)
Added(mode Text, command Texts, line Text, body Text = "", pin Text = "") StrictGenQueue
	Empty.Added("image", ("--width", "32"), "Image fox 32x32 fastest m").modes.Length is 1
	Empty.Added("image", ("--width", "32"), "fox").Added("video", ("--length", "24"), "owl").pending.Length is 2
	Empty.Added("image", ("--width", "32"), "Image fox").Cleared.pending.Length is 0
	let queued = StrictGenQueue(value, modes = modes + mode, commands = commands + Text.Combine(command, "\n"), bodies = bodies + body, pins = pins + pin, outcomes = outcomes + "")
	StrictGenQueue(queued, lines = lines + line, pending = pending + (modes.Length), halted = false)
Cleared StrictGenQueue
	Empty.Added("image", ("--width", "32"), "Image fox").Cleared.pending.Length is 0
	Empty.Added("image", ("--width", "32"), "Image fox").Cleared.halted
	StrictGenQueue(value, pending = List(Number), halted = true)
Posted(route Text, body Text) Slow(StrictGenQueue)
	Empty.Posted("/run", StrictGenForm.Picture).pending.Length is 1
	Empty.Added("image", ("--width", "32"), "fox").Posted("/stop", "").pending.Length is 0
	if route is "/run"
		let json = Json(body)
		let pin = json.get("placed") to Text is "true" then "local" else json.get("remote") to Text
		if current < 0
			File("StrictGenJob.log").Delete
		let added = Added(json.get("mode") to Text, StrictGenForm.Arguments(body), StrictGenForm.Summary(body), body, pin)
		let marked = StrictGenQueue(added, notice = "Run started")
		return pin is "local" then marked.Aimed("local") else marked
	let stopped = Cleared
	stopped.StopAll
	stopped
Position Text
	Empty.Position is "run 0 · queue 0 · done 0"
	Empty.Added("image", ("--width", "32"), "Image fox").Position is "run 0 · queue 1 · done 0"
	"run " + (current < 0 then 0 else 1) + " · queue " + pending.Length + " · done " + finished
Waiting Texts
	Empty.Waiting.Length is 0
	Empty.Added("image", ("--width", "32"), "Image fox").Waiting is ("Image fox")
	for (current < 0 then pending else List(Number) + current + pending)
		lines(value)
Recent Texts
	Empty.Recent.Length is 0
	results.Reverse
Quoted(words Texts) Text
	Empty.Quoted(("--prompt", "a b.txt")) is "--prompt \"a b.txt\""
	Empty.Quoted(("--width", "32")) is "--width 32"
	mutable line = ""
	for words
		let word = value.IndexOf(" ") < 0 then value else "\"" + value + "\""
		line = line is "" then word else line + " " + word
	line
Found(rows Texts) Texts
	Empty.Found(("Saved a.jpg in 3 ms", "Wrote b.mp4")) is ("a.jpg", "b.mp4")
	Empty.Found(List(Text) + "hello").Length is 0
	for rows
		let parts = value.Split(" ")
		if (parts.Length > 1) and ((parts.First is "Saved") or (parts.First is "Wrote"))
			parts(1)
Existing(paths Texts) Texts
	Empty.Existing(("StrictGenQueue.strict", "StrictGenMissing.mp4")) is ("StrictGenQueue.strict")
	for paths
		if File(value).Exists
			value
IsPreviewed(index Number) Boolean
	Empty.Added("image", ("--quality", "best"), "fox").IsPreviewed(0)
	Empty.Added("image", ("--quality", "fastest2steps"), "fox").IsPreviewed(0) is false
	Empty.Added("video", ("--quality", "best"), "owl").IsPreviewed(0) is false
	(modes(index) is "image") and (commands(index).IndexOf("--quality\nfastest") < 0)
Executable(name Text) Text
	Empty.Executable("MossImage").IndexOf("MossImage") >= 0
	let folder = Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text
	let suffix = Process.OperatingSystem is "Windows" then ".exe" else ""
	let file = folder + "/" + name + suffix
	File(file).Exists then file else name + suffix
Script(executable Text, arguments Text, log Text, done Text) Texts
	Empty.Script("MossImage.exe", "--width 32", "job.log", "job.done").First.IndexOf("MossImage.exe") >= 0
	Empty.Script("MossImage.exe", "--width 32", "job.log", "job.done").Last.IndexOf("job.done") >= 0
	("\"" + executable + "\" " + arguments + " > \"" + log + "\" 2>&1", "echo DONE> \"" + done + "\"")
Stopped(program Text) Slow(None)
	Empty.Stopped("StrictGenMissing") is not Error
	let executable = Executable(program)
	if (executable.StartsWith(program) is false) and Process.RunTool(executable, "stop").Failed
		return Error("ServersNotStopped: " + program)
StopAll Slow(None)
	Stopped("MossImage")
	Stopped("H3Video")
	Stopped("H3Image")
Advanced StrictGenQueue
	Empty.Advanced.current is -1
	current >= 0 then Polled else (pending.Length is 0) or halted or (aim is "") then value else Launch
Launch StrictGenQueue
	if aim is ""
		return value
	if aim is "none"
		return Refused("No StrictGen on the network can run this")
	if aim.IndexOf(":") >= 0
		return Sent(aim)
	let index = pending.First
	let mode = modes(index)
	let words = commands(index).Split("\n")
	let preview = "StrictGenStep-" + index + ".jpg"
	let log = "StrictGenJob-" + index + ".log"
	let done = "StrictGenJob-" + index + ".done"
	let previewed = IsPreviewed(index) then words + "--preview" + preview else words
	File(done).Delete
	File(preview).Delete
	let executable = Executable(Program(mode))
	let script = Process.OperatingSystem is "Windows" then "StrictGenJob.cmd" else "StrictGenJob.sh"
	File(script).Write(Script(executable, Quoted(previewed), log, done))
	let started = Started(script)
	if started is false
		return Refused("Could not start " + executable)
	StrictGenQueue(value, pending = pending.Slice(1, pending.Length - 1), current = index, aim = "", jobLog = log, jobDone = done, jobPreview = preview)
Program(mode Text) Text
	(Empty.Program("image") is "MossImage") and (Empty.Program("h3image") is "H3Image")
	Empty.Program("extend") is "H3Video"
	mode is "image" then "MossImage" else mode is "h3image" then "H3Image" else "H3Video"
Refused(reason Text) StrictGenQueue
	let index = pending.First
	let left = pending.Slice(1, pending.Length - 1)
	StrictGenQueue(value, pending = left, aim = "", finished = finished + 1, notice = reason, outcomes = Noted(index, "error\t" + reason))
Sent(endpoint Text) StrictGenQueue
	let index = pending.First
	let id = StrictGenNet(logger).Delivered(endpoint, bodies.Length > index then bodies(index) else "")
	if (id is "") or id.StartsWith("error")
		return Refused(id is "" then "The other StrictGen did not answer" else id)
	StrictGenQueue(value, pending = pending.Slice(1, pending.Length - 1), current = index, remote = endpoint, remoteId = id to Number, aim = "")
Started(script Text) Boolean
	let isWindows = Process.OperatingSystem is "Windows"
	if isWindows is false
		return Process.Find("sh").Started(script) is 0
	let result = Process.RunTool("cmd", "/c start \"StrictGen\" /MIN /D \"" + Directory.Current + "\" cmd /c \".\\" + script + "\"")
	result.Failed is false
Polled StrictGenQueue
	if remote is not ""
		return Remote
	if (jobDone is "") or (File(jobDone).Exists is false)
		return value
	let paths = Existing(Found(File(jobLog).Exists then File(jobLog).ReadLines else List(Text)))
	File(jobDone).Delete
	Finished(paths, paths.Length is 0 then "The run finished without an output file" else lines(current))
Remote StrictGenQueue
	let answer = StrictGenNet(logger).Asked(remote, remoteId)
	let kind = answer.Split("\t").First
	if (answer is "wait") or (kind is "wait") or (answer is "")
		return value
	if kind is "error"
		return Finished(List(Text), answer)
	let path = StrictGenNet(logger).Saved(remote, answer.Split("\t").Last)
	Finished(path is "" then List(Text) else List(Text) + path, path is "" then "The other StrictGen sent no file" else lines(current))
Finished(paths Texts, caption Text) StrictGenQueue
	let note = paths.Length is 0 then caption else notice
	let recorded = paths.Length is 0 then "error\t" + caption else "file\t" + paths.Last
	let done = StrictGenQueue(value, current = -1, remote = "", remoteId = -1, finished = finished + 1, results = results + paths, captions = Captions(paths, caption), outcomes = Noted(current, recorded), notice = note, jobLog = "", jobDone = "", jobPreview = "")
	halted then done else done.Advanced
Captions(paths Texts, caption Text) Texts
	mutable kept = captions
	for paths
		kept = kept + caption
	kept
IsBusy Boolean
	Empty.IsBusy is false
	current >= 0
NeedsAim Boolean
	Empty.NeedsAim is false
	(pending.Length > 0) and (current < 0) and (aim is "") and (halted is false)
NextMode Text
	Empty.NextMode is ""
	Empty.Added("video", ("--length", "24"), "owl").NextMode is "video"
	pending.Length is 0 then "" else modes(pending.First)
Pin Text
	Empty.Pin is ""
	Empty.Added("video", ("--length", "24"), "owl", "", "local").Pin is "local"
	(pending.Length is 0) or (pins.Length <= pending.First) then "" else pins(pending.First)
Aimed(target Text) StrictGenQueue
	Empty.Aimed("local").aim is "local"
	StrictGenQueue(value, aim = target)
Report(id Number) Text
	Empty.Report(0) is "error\tmissing"
	Empty.Added("image", ("--width", "32"), "fox").Report(0) is "wait"
	if (id < 0) or (id >= modes.Length)
		return "error\tmissing"
	(id is current) or (id is in pending) then "wait" else (outcomes.Length > id then (outcomes(id) is "" then "wait" else outcomes(id)) else "wait")
Noted(at Number, text Text) Texts
	mutable items = List(Mutable(Text))
	for Range(0, modes.Length)
		items.Add(at is index then text else (outcomes.Length > index then outcomes(index) else ""))
	items
