has batch MossBatch
has decoder Generic
Saved(latents List(Numbers), seeds Numbers, prompts Texts, outputs Texts) Texts slow
	for seeds
		started = Process.Elapsed
		image = decoder.Decoded(latents(index), batch.options.width / 16)
		decoded = Process.Elapsed
		batch.Saved(image, decoded, value, prompts(index), outputs(index), decoded - started)
