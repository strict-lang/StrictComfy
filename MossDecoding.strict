has batch MossBatch
has decoder Generic
Saved(latents List(Numbers), seeds Numbers, prompts Texts, outputs Texts) Slow(Texts)
	for seeds
		let started = Process.Elapsed
		let image = decoder.Decoded(latents(index), batch.options.width / 16)
		let decoded = Process.Elapsed
		batch.Saved(image, decoded, value, prompts(index), outputs(index), decoded - started)
