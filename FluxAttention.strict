has norm GroupNorm
has combined Convolution
has projection Convolution
constant Model = Safetensors("tinyvae.safetensors")
constant Middle = FluxAttention.Loaded(Model, "decoder.mid.attn_1.", 4)
constant Input = FeatureMap(Model.Values("reference.mid.block_1"), 4, 16, Layer.Zeros(16))
Loaded(model Safetensors, prefix Text, groups Number) FluxAttention
	Middle.combined.weights.Length is 768
	Middle.combined.biases.Length is 48
	let block = Safetensors(model.path, 32, model.prefix + prefix)
	let weights = block.Values("q.weight") + block.Values("k.weight") + block.Values("v.weight")
	let biases = block.Values("q.bias") + block.Values("k.bias") + block.Values("v.bias")
	let output = FluxResnet.Convolved(block, "proj_out")
	FluxAttention(FluxResnet.Norm(block, "norm", groups), Convolution(weights, biases), output)
Output(map FeatureMap) FeatureMap
	Middle.Output(Input).Completed(0).IsNearlyEqual(-0.70551, 0.0001)
	Middle.Output(Input).Completed(128).IsNearlyEqual(-0.39508, 0.0001)
	Middle.Output(Input).Completed(383).IsNearlyEqual(1.27711, 0.0001)
	let size = map.channels
	let mixed = combined.Projected(map.Applied(norm.Affine(map), false))
	let attended = FeatureMap(Attended(mixed), map.width, size, Safetensors.Part(combined.biases, 2 * size, size, 1))
	map.Plus(projection.Projected(attended))
Attended(mixed FeatureMap) Numbers
	Middle.Attended(FeatureMap((1, 0, 3, 0, 1, 5), 1, 3, (0, 0, 0))).Length is 2
	let size = mixed.channels / 3
	let positions = mixed.values.Length / mixed.channels
	let shape = (1, positions, size, positions)
	let queried = Products(Queries(mixed), mixed.values, shape, (0, 0, size, 1, size, 0, 1, 3 * size))
	let shares = Softmax.Shares(queried.Multiplied, positions)
	let strides = (0, 0, positions, 1, 2 * size, 0, 3 * size, 1)
	Products(shares, mixed.values, (1, positions, positions, size), strides).Multiplied
Queries(mixed FeatureMap) Numbers
	Middle.Queries(FeatureMap((1, 2, 3), 1, 3, (0, 0, 0)))(0).IsNearlyEqual(0.869149)
	let size = mixed.channels / 3
	for mixed.values.Length / 3
		let position = (index / size).Floor
		(mixed.values(position * 3 * size + index % size) + combined.biases(index % size)) / size.SquareRoot