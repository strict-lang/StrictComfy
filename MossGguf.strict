has path Text
constant Tiny = MossGguf("tinymoss.gguf")
constant Opened = Tiny.Loaded
constant Forward = Opened.Output(Moss.Model.Values("reference.x"), 0.75, Opened.TextEmbedded(Moss.Context, 3), MossBlock.Rotation)
Loaded Slow(Moss)
	Opened.texts.Length is 2
	Forward(5).IsNearlyEqual(-0.5156, 0.05)
	Forward(255).IsNearlyEqual(-0.1289, 0.05)
	let model = Gguf(path, 16)
	let dense = Dense(model)
	let normed = model.Values("final_norm_video.weight")
	let layers = Blocks(Gguf(path, 4))
	Moss(dense(0), dense(1), Texts(model), dense(2), dense(3), dense(4), layers, normed, dense(5), dense(6))
Dense(model Gguf) Slow(List(Batch))
	Tiny.Dense(Gguf("tinymoss.gguf")).Length is 7
	for Moss.Denses
		Batched(model, value)
Batched(model Gguf, name Text) Slow(Batch)
	Tiny.Batched(Gguf("tinymoss.gguf"), "final_linear_video").biases is (0)
	Tiny.Batched(Gguf("tinymoss.gguf"), "video_embedder").weights.First.Length is 16
	Tiny.Batched(Gguf("tinymoss.gguf"), "video_embedder").biases.Length is 256
	Tiny.Batched(Gguf("tinymoss.gguf"), "final_linear_video").biases.Length is 1
	let biased = model.Shape(name + ".bias").Length > 0
	Batch(model.Rows(name + ".weight"), biased then model.Values(name + ".bias") else List(Number) + 0)
Texts(model Gguf) Slow(List(MossText))
	Tiny.Texts(Gguf("tinymoss.gguf")).Length is 2
	for 2
		Text(model, "text_embedder.blocks." + index + ".")
Text(model Gguf, prefix Text) Slow(MossText)
	Tiny.Text(Gguf("tinymoss.gguf"), "text_embedder.blocks.0.").down.biases.Length is 256
	let norms = Norms(model, prefix, "norm1", "norm2")
	let headNorms = Norms(model, prefix, "q_norm", "k_norm")
	let attended = Batched(model, prefix + "qkv")
	let projected = Batched(model, prefix + "proj")
	let gated = Batched(model, prefix + "ffn_gate")
	let raised = Batched(model, prefix + "ffn_up")
	let down = Batched(model, prefix + "ffn_down")
	MossText(norms(0), norms(1), headNorms(0), headNorms(1), attended, projected, gated, raised, down)
Blocks(model Gguf) Slow(List(MossBlock))
	Tiny.Blocks(Gguf("tinymoss.gguf", 4)).Length is 2
	for 64
		if model.Shape("layers." + index + ".norm1.weight").Length > 0
			Block(model, "layers." + index + ".")
Block(model Gguf, prefix Text) Slow(MossBlock)
	Tiny.Block(Gguf("tinymoss.gguf"), "layers.0.").rotated is false
	Tiny.Block(Gguf("tinymoss.gguf"), "layers.0.").attention.Length is 768
	Tiny.Block(Gguf("tinymoss.gguf"), "layers.0.").norms.Length is 4
	let rows = prefix + "proj."
	let norms = Norms(model, prefix, "norm1", "norm2")
	let headNorms = Norms(model, prefix, "q_norm", "k_norm")
	let expanded = model.Rows(rows + "ffn_up_gate.weight")
	let reduced = model.Rows(rows + "ffn_down.weight")
	let output = model.Rows(rows + "o.weight")
	let attended = model.Rows(rows + "qkv.weight")
	MossBlock((norms(0), norms(1), headNorms(0), headNorms(1)), attended, output, expanded, reduced, false)
Norms(model Gguf, prefix Text, first Text, second Text) Slow(List(Numbers))
	Tiny.Norms(Gguf("tinymoss.gguf"), "layers.0.", "q_norm", "k_norm").First.Length is 128
	Tiny.Norms(Gguf("tinymoss.gguf"), "layers.0.", "norm1", "q_norm").Length is 2
	Tiny.Norms(Gguf("tinymoss.gguf"), "layers.0.", "norm1", "q_norm").Last.Length is 128
	(model.Values(prefix + first + ".weight"), model.Values(prefix + second + ".weight"))
