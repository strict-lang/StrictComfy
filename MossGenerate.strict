has logger
Run(dumps Text, model Text, lora Text, vae Text, mode Text, adapter Text)
	if dumps is "-"
		Served(Loaded(model, lora, adapter), mode, adapter)
	else
		let data = Safetensors(dumps + "/generation.safetensors", 32)
		let sampling = Configured(data, mode)
		let latents = Latents(Loaded(model, lora, adapter), sampling, data, dumps, adapter)
		GpuMemory.Released
		Published(latents, sampling, Decoders(vae), data, dumps)
Loaded(model Text, lora Text, adapter Text) Moss
	let before = Process.Elapsed
	let moss = Adapted(Moss.Loaded(model, lora), adapter)
	logger.Log("loaded in " + (Process.Elapsed - before).Round(3) + " s")
	moss
Served(moss Moss, mode Text, adapter Text) None
	mutable dumps = Process.InputLine
	for as long as dumps is not ""
		let data = Safetensors(dumps + "/generation.safetensors", 32)
		let sampling = Configured(data, mode)
		Published(Latents(moss, sampling, data, dumps, adapter), sampling, List(FluxDecoder), data, dumps)
		dumps = Process.InputLine
Latents(moss Moss, sampling MossSampling, data Safetensors, dumps Text, adapter Text) List(Numbers)
	for GenerationCommand(logger).Count(data)
		Generated(moss, sampling, GenerationCommand(logger).Job(data, dumps, index), adapter)
Configured(data Safetensors, mode Text) MossSampling
	let width = data.Shape("noise").Last
	let steps = data.Values("steps").First
	let guidance = data.Values("guidance").First
	MossSampling(logger, width, steps, guidance, mode, data.Values("warmup").First, data.Values("period").First)
Generated(moss Moss, sampling MossSampling, data Safetensors, adapter Text) Numbers
	let noise = data.Values("noise")
	let context = data.Values("context")
	let before = Process.Elapsed
	let latent = Sampled(moss, sampling, noise, context, adapter)
	logger.Log("sample " + latent.First + ", sampling " + ((Process.Elapsed - before) * 1000).Round + " ms")
	GpuMemory.Released
	latent
Sampled(moss Moss, sampling MossSampling, noise Numbers, context Numbers, adapter Text) Numbers
	if adapter is ""
		return sampling.Sampled(moss, noise, context)
	sampling.Dataspace(moss, noise, context, Safetensors(adapter + "/dataspace.safetensors", 32))
Adapted(moss Moss, adapter Text) Moss
	if adapter is ""
		return moss
	let time = Safetensors(adapter + "/time_embedding.safetensors", 32)
	let first = MossText.Dense(time, "time_embedding.0")
	let second = MossText.Dense(time, "time_embedding.2")
	let block = Batch(moss.blockModulation.weights, time.Values("shared_block_modulation.bias"))
	let head = Batch(moss.headModulation.weights, time.Values("video_head_modulation.bias"))
	Moss(moss, timeIn = first, timeOut = second, blockModulation = block, headModulation = head)
Published(latents List(Numbers), sampling MossSampling, decoders List(FluxDecoder), data Safetensors, dumps Text) None
	for latents
		let before = Process.Elapsed
		let suffix = latents.Length > 1 then "-" + index else ""
		let path = dumps + "/strict-" + sampling.mode + suffix + Extension(data, decoders.Length)
		Published(value, sampling.width, decoders, path, GenerationCommand(logger).Job(data, dumps, index))
		logger.Log("generation " + index + " in " + ((Process.Elapsed - before) * 1000).Round + " ms")
Decoders(vae Text) Slow(List(FluxDecoder))
	MossGenerate(Logger).Decoders("").Length is 0
	MossGenerate(Logger).Decoders("tinyvae.safetensors").Length is 1
	if vae is ""
		return List(FluxDecoder)
	List(FluxDecoder) + FluxDecoder.Loaded(vae, 32)
Extension(data Safetensors, decoders Number) Text
	MossGenerate(Logger).Extension(MossImage.Reference, 1).Length is 4
	MossGenerate(Logger).Extension(MossImage.Reference, 0) is "-latent.safetensors"
	if decoders is 0
		return "-latent.safetensors"
	let jpeg = data.Entry("jpeg") is "" then Process.OperatingSystem is "Windows" else data.Values("jpeg").First is 1
	jpeg then ".jpg" else ".png"
Published(latent Numbers, width Number, decoders List(FluxDecoder), path Text, data Safetensors) None
	if decoders.Length is 0
		Safetensors(path).Written("latent", latent)
	else
		Saved(latent, width, decoders.First, path, data)
Saved(latent Numbers, width Number, decoder FluxDecoder, path Text, data Safetensors) None
	let before = Process.Elapsed
	let image = decoder.Decoded(latent, width)
	logger.Log("decode " + image.First + " in " + ((Process.Elapsed - before) * 1000).Round + " ms")
	let writing = Process.Elapsed
	if path.EndsWith(".jpg")
		ImageCodec.SaveJpeg(path, image, width * 16, data.Entry("quality") is "" then 85 else data.Values("quality").First)
	else
		SavedPng(image, width * 16, path, data)
	logger.Log("save in " + ((Process.Elapsed - writing) * 1000).Round + " ms")
	logger.Log("decoded and saved in " + ((Process.Elapsed - before) * 1000).Round + " ms")
SavedPng(image Numbers, width Number, path Text, data Safetensors) None
	let compressed = data.Entry("compressed") is "" then false else data.Values("compressed").First is 1
	let pixels = FluxImage(logger).Colors(image)
	ImageSaver(path, compressed).Save(Image(Size(width, image.Length / (3 * width)), pixels))
