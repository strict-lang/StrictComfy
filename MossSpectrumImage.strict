has logger
constant Tiny = MossSpectrum(Logger, 4, 1, 1)
constant Image = MossSpectrumImage(Logger)
Sampled(moss Moss, spectrum MossSpectrum, data Safetensors, euler Euler, context Numbers) Slow(Numbers)
	MossSpectrumImage(Logger).Sampled(Moss.Tiny, Tiny, MossImage.Reference, Euler(1, 5), Moss.Context).Length is 256
	let text = moss.TextEmbedded(context, context.Length / moss.textProjection.weights.First.Length)
	let sigmas = euler.Sigmas
	mutable current = spectrum
	mutable latent = data.Values(data.Entry("x.0") is "" then "x" else "x.0")
	let rotation = moss.Rotation(latent, text, spectrum.width)
	for euler.steps
		let before = Process.Elapsed
		current = current.Advanced(moss, latent, sigmas(index), text, rotation, index)
		latent = euler.Stepped(latent, current.output, sigmas, index)
		MossTiming(logger).Measured(index, before, latent, data, ", forecasts " + current.forecasts)
	latent
Run(dumps Text, model Text, lora Text, vae Text, mode Text, steps Number, warmup Number, period Number, degree Number)
	let data = Safetensors(dumps + "/steps.safetensors", 64)
	let latent = Generated(dumps, model, lora, mode, steps, warmup, period, degree)
	logger.Log("latent error " + MossImage(logger).RelativeError(latent, data.Values("latent")))
	let sized = MossImage(logger, data.Shape("noise").Last)
	sized.Saved(latent, data, FluxDecoder.Loaded(vae, 32), dumps + "/moss-spectrum-" + mode + ".png")
Generated(dumps Text, model Text, lora Text, mode Text, steps Number, warmup Number, period Number, degree Number) Numbers
	let data = Safetensors(dumps + "/steps.safetensors", 64)
	let context = Safetensors(dumps + "/conditioning.safetensors", 64).Values("context")
	let width = data.Shape("noise").Last
	let spectrum = Configured(width, mode, steps, warmup, period, degree)
	let before = Process.Elapsed
	let moss = Moss.Loaded(model, lora)
	let compared = MossImage(logger, width).Compared(moss, Safetensors(dumps + "/step0.safetensors", 64))
	logger.Log("loaded in " + (Process.Elapsed - before).Round(1) + " s, compared " + compared)
	Sampled(moss, spectrum, data, Euler(steps, 5), context)
Configured(width Number, mode Text, steps Number, warmup Number, period Number, degree Number) MossSpectrum
	Image.Configured(4, "on", 8, 3, 2, 2).history.maximum is 4 and Image.Configured(4, "off", 1, 0, 2, 2).steps is 1
	Image.Configured(4, "shadow", 8, 3, 2, 2).mode is "shadow" and Image.Configured(4, "on", 8, -1, 2, 2) is Error
	Image.Configured(4, "on", 8, 3, 2, 5) is Error and Image.Configured(4, "x", 8, 3, 2, 2) is Error
	Image.Configured(4, "on", 8, 3, 1, 2) is Error and Image.Configured(4, "on", 0, 3, 2, 2) is Error
	let fit = SpectralFit(degree, 0.1, 0.5)
	if (fit.IsValid is false) or (mode is not in ("off", "shadow", "on"))
		return Error("Invalid Spectrum configuration")
	if (IsCount(period, 2) and IsCount(steps, 1)) is false
		return Error("Invalid Spectrum schedule")
	if IsCount(warmup, 0) is false
		return Error("Invalid Spectrum warmup")
	MossSpectrum(logger, width, steps, warmup, period, mode, SpectralHistory(fit = fit, maximum = degree + 2))
IsCount(number Number, minimum Number) Boolean
	Image.IsCount(2, 2) and Image.IsCount(0, 0)
	Image.IsCount(1, 2) is false
	Image.IsCount(2.5, 2) is false
	(number >= minimum) and (number.Floor is number)