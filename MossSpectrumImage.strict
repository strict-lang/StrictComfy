constant Tiny = MossSpectrum(4, 1, 1)
Sample(moss Moss, spectrum MossSpectrum, data Safetensors, euler Euler, context Numbers) Numbers native
	MossSpectrumImage.Sample(Moss.Tiny, Tiny, MossImage.Reference, Euler(1, 5), Moss.Context).Length is 256
	text = moss.TextEmbedded(context, context.Length / moss.textProjection.weights.First.Length)
	sigmas = euler.Sigmas
	mutable current = spectrum
	mutable latent = data.Values(data.Entry("x.0") is "" then "x" else "x.0")
	rotation = moss.Rotation(latent, text, spectrum.width)
	for euler.steps
		before = Process.Elapsed
		current = current.Advanced(moss, latent, sigmas(index), text, rotation, index)
		latent = euler.Step(latent, current.output, sigmas, index)
		MossTiming.Measure(index, before, latent, data, ", forecasts " + current.forecasts)
	latent
Run(dumps Text, model Text, lora Text, vae Text, mode Text, steps Number, warmup Number, period Number, degree Number)
	data = Safetensors(dumps + "/steps.safetensors", 64)
	latent = Generate(dumps, model, lora, mode, steps, warmup, period, degree)
	logger.Log("latent error " + Tensors.RelativeError(latent, data.Values("latent")))
	sized = MossImage(data.Shape("noise").Last)
	path = dumps + "/moss-spectrum-" + mode + ".png"
	if MossFiles.IsFailedNumber(sized.Save(latent, data, FluxDecoder.Loaded(vae, 32), path))
		logger.Log("Saving the Moss spectrum image failed")
Generate(dumps Text, model Text, lora Text, mode Text, steps Number, warmup Number, period Number, degree Number) Numbers
	data = Safetensors(dumps + "/steps.safetensors", 64)
	context = Safetensors(dumps + "/conditioning.safetensors", 64).Values("context")
	width = data.Shape("noise").Last
	spectrum = MossSpectrum.Configured(width, mode, steps, warmup, period, degree)
	before = Process.Elapsed
	moss = Moss.Loaded(model, lora)
	compared = MossImage(width).Compare(moss, Safetensors(dumps + "/step0.safetensors", 64))
	logger.Log("loaded in " + (Process.Elapsed - before).Round(1) + " s, compared " + compared)
	Sample(moss, spectrum, data, Euler(steps, 5), context)