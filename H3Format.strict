constant Channels = 24
constant FramesPerSecond = 24
constant AudioPerSecond = 40
constant FrameGroup = 17
constant Blocks = 50
constant Shift = 12
constant Registers = 5
constant DoubledBlocks = 0.76
constant EarlyRouting = 0.7
constant LateRouting = 0.455
Grouped(count Number) Number
	H3Format.Grouped(5) is 5
	H3Format.Grouped(120) is 107
	H3Format.Grouped(124) is 124
	H3Format.Grouped(125) is 124
	((count - 5) / FrameGroup).Floor.Clamp(0, count) * FrameGroup + 5
