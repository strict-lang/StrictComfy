has logger
has files H3Files
has frame Numbers = (832, 480)
has visions List(QwenVision) = List(QwenVision)
has prefetched Texts = List(Text)
constant Tiny = H3Encoder(Logger, H3Files.Parsed(("--text_encoder", "../Strict/NeuralNetworks/tinyqwen3vl.safetensors")))
constant Written = "artifacts/h3encoder.tmp"
constant Both = H3Encoder(Logger, H3Files.Parsed(("--image", "a.png", "--last_image", "b.png")))
Encoded(prompts Texts, images Texts, paths Texts) Slow(Number)
	let before = Process.Elapsed
	logger.Log("Loading text encoder " + ModelFiles("").Described(files.Encoder) + " from disk into memory")
	let tokens = Gpt2Tokens.Folder(files.ComfyUI + "/comfy/text_encoders/qwen25_tokenizer")
	let encoder = Loaded
	let loaded = H3Encoder(logger, files, frame, Visions)
	logger.Log("Text encoder loaded in " + (Process.Elapsed - before).Round(1) + " s")
	let reading = ModelFiles("").Prefetching(prefetched, "H3 and its LoRAs")
	if reading is not ""
		logger.Log(reading + " while encoding")
	loaded.Contexts(encoder, Tokens(tokens, prompts), images, paths, Pictures(Labels(tokens))).Length
Loaded Slow(Qwen3)
	Tiny.Loaded.blocks.Length is 2
	QwenSafetensors(Safetensors(files.Encoder, 32, "model."), 0, 0, 0, "Loading text encoder").Loaded(5000000)
Visions Slow(List(QwenVision))
	Tiny.Visions.Length is 0
	for files.Images.Length.Clamp(0, 1)
		QwenVision.Loaded(Safetensors(files.Encoder, 32, "visual."), 16, (8, 16, 24))
Contexts(encoder Qwen3, chosen List(Numbers), images Texts, paths Texts, pictures List(Numbers)) Slow(Numbers)
	Tiny.Contexts(Tiny.Loaded, List(Numbers) + (1, 2, 3), List(Text) + "", List(Text) + Written, List(Numbers)) is (195)
	Safetensors(Written).Values("context")(100).IsNearlyEqual(2.307147, 0.02)
	Safetensors(Written).Values("tags") is (1, 1, 1)
	for paths
		let before = Process.Elapsed
		let texts = Texts(pictures, chosen(index))
		let prompt = "prompt " + (index + 1) + "/" + paths.Length
		logger.Log("Encoding " + prompt + " on the GPU" + (index is 0 then ", uploading the text encoder into VRAM" else ""))
		let hidden = Hidden(Qwen3(encoder, progress = "Encoding " + prompt), texts, images(index))
		logger.Log("Encoded " + prompt + " in " + (Process.Elapsed - before).Round(1) + " s")
		let tags = Tags(texts, hidden.Length / encoder.norm.Length)
		Safetensors(value).Written(("context", "tags"), (hidden, tags))
Texts(pictures List(Numbers), chosen Numbers) List(Numbers)
	Tiny.Texts(List(Numbers), (1, 2)) is List(Numbers) + (1, 2)
	Tiny.Texts(List(Numbers) + (5, 151652), (1, 2)) is ((5, 151652), (151653, 1, 2))
	pictures.Length is 0 then List(Numbers) + chosen else pictures + (List(Number) + 151653 + chosen)
Hidden(encoder Qwen3, texts List(Numbers), image Text) Slow(Numbers)
	Tiny.Hidden(Tiny.Loaded, List(Numbers) + (1, 2, 3), "").Length is 192
	if texts.Length is 1
		return encoder.Prefilled(texts.First, 0).hidden
	Qwen3Images(encoder, visions.First).Prefilled(texts, Frames(image), frame(0), frame(1)).hidden
Frames(image Text) Slow(List(Numbers))
	Tiny.Frames("").Length is 0
	for (image, files.lastImage)
		if value is not ""
			H3Picture.Frame(value, frame, index is 1)
Pictures(labels List(Numbers)) List(Numbers)
	Both.Pictures(((1, 2), (3, 4)))(1) is (151653, 3, 4, 151652)
	for labels
		(index is 0 then List(Number) else List(Number) + 151653) + value + 151652
Labels(tokens Gpt2Tokens) List(Numbers)
	Tiny.Labels(Gpt2Tokens.Folder("../Strict/NeuralNetworks/tinytokens")).Length is 0
	for files.Images
		tokens.Encoded("<Picture " + (index + 1) + ">: ")
Tokens(tokens Gpt2Tokens, prompts Texts) List(Numbers)
	Tiny.Tokens(Gpt2Tokens.Folder("../Strict/NeuralNetworks/tinytokens"), ("ab", "")) is ((3), (151643))
	for prompts
		let chosen = tokens.Encoded(value)
		chosen.Length is 0 then List(Number) + 151643 else chosen
Tags(texts List(Numbers), total Number) Numbers
	Tiny.Tags(List(Numbers) + (5, 6), 2) is (1, 1)
	Tiny.Tags(((7, 151652), (151653, 8)), 6) is (1, 0, 0, 0, 0, 1)
	let images = texts.Length - 1
	mutable text = 0
	for texts
		text = text + value.Length
	let size = images is 0 then 0 else (total - text) / images
	mutable tags = List(Number)
	for texts
		tags = tags + Marked(value) + Vision(index < images then size else 0)
	tags
Marked(tokens Numbers) Numbers
	Tiny.Marked((7, 151652, 151653)) is (1, 0, 0)
	for tokens
		value is in (151652, 151653) then 0 else 1
Vision(count Number) Numbers
	Tiny.Vision(2) is (0, 0)
	for count
		0
