has logger
has isKept = false
has encoders List(Qwen3) = List(Qwen3)
has encoderFile = ""
has tokenizers List(Gpt2Tokens) = List(Gpt2Tokens)
has prompts List(Text) = List(Text)
has contexts List(Numbers) = List(Numbers)
has mosses List(Moss) = List(Moss)
has model = ""
has taefs List(Taef2Decoder) = List(Taef2Decoder)
has fluxes List(FluxDecoder) = List(FluxDecoder)
has decoderFile = ""
has code = 0
has previewers List(Taef2Decoder) = List(Taef2Decoder)
constant MostPrompts = 100
constant Spelled = MossResident(Logger, tokenizers = List(Gpt2Tokens) + H3Encoder.Spelled)
constant Unloaded = MossResident(Logger, taefs = List(Taef2Decoder) + Taef2Decoder.None, decoderFile = "tinytaef2.safetensors")
constant Cached = MossResident(Logger, true, prompts = ("a", "b"), contexts = ((1, 2), (3, 4)))
Missing(unique Texts) Texts
	Cached.Missing(("b", "c", "a")) is ("c")
	MossResident(Logger).Missing(("a", "b")) is ("a", "b")
	for unique
		if (value is in prompts) is false
			value
Contexts(unique Texts) List(Numbers)
	Cached.Contexts(("b", "a")) is ((3, 4), (1, 2))
	for unique
		contexts(prompts.Index(value))
Encoded(batch MossBatch, unique Texts) MossResident slow
	let known = Switched(batch.options.files.Encoder)
	let missing = known.Missing(unique)
	if missing.Length is 0
		logger.Log("Using the cached prompt conditioning, the text encoder is not needed")
		return known
	known.Extended(batch, missing)
Switched(file Text) MossResident
	Cached.Switched("").prompts.Length is 2
	Cached.Switched("a.safetensors").encoderFile is "a.safetensors"
	Cached.Switched("a.safetensors").prompts.Length is 0
	if file is encoderFile
		return value
	let emptied = MossResident(value, encoders = List(Qwen3), encoderFile = file, tokenizers = List(Gpt2Tokens))
	MossResident(emptied, prompts = List(Text), contexts = List(Numbers))
Extended(batch MossBatch, missing Texts) MossResident slow
	let tokenizing = Tokenizing(batch)
	let ids = batch.Tokenized(tokenizing.tokenizers.First, missing)
	let encoding = tokenizing.Encoding(batch, ids)
	let encoded = batch.Encoded(encoding.encoders.First, ids, missing)
	let isFull = prompts.Length + missing.Length > MostPrompts
	let kept = isFull then List(Text) else prompts
	let keptContexts = isFull then List(Numbers) else contexts
	let staying = isKept and (encoding.IsCrowded(batch) is false) then encoding.encoders else List(Qwen3)
	MossResident(encoding, encoders = staying, prompts = kept + missing, contexts = keptContexts + encoded)
IsCrowded(batch MossBatch) Boolean slow
	Spelled.IsCrowded(MossBatch.Sample) is false
	let needed = mosses.Length is 1 then 0 else File(batch.options.files.Checkpoint).Length
	Backend.IsCrowded(needed, GpuMemory.HostAvailable, GpuMemory.HostTotal)
Tokenizing(batch MossBatch) MossResident slow
	Spelled.Tokenizing(MossBatch.Sample).tokenizers.Length is 1
	tokenizers.Length is 1 then value else MossResident(value, tokenizers = List(Gpt2Tokens) + batch.Tokenizer)
Encoding(batch MossBatch, ids List(Numbers)) MossResident slow
	if encoders.Length is 1
		return value
	let before = Process.Elapsed
	let encoder = batch.Encoder(isKept then List(Number) else batch.Picked(ids))
	let staying = isKept then ", it stays loaded for the next runs" else ""
	logger.Log("Text encoder loaded in " + (Process.Elapsed - before).Round(1) + " s" + staying)
	MossResident(value, encoders = List(Qwen3) + encoder)
Sampling(batch MossBatch) MossResident slow
	let options = batch.options
	let loras = options.Loras
	let key = options.files.Checkpoint + "|" + loras
	if (key is model) and (mosses.Length is 1)
		logger.Log("Using the loaded Moss " + options.files.Checkpoint)
		return value
	let before = Process.Elapsed
	logger.Log(batch.Loading(loras))
	let moss = Moss.Loaded(options.files.Checkpoint, loras)
	let staying = isKept then ", it stays loaded for the next runs" else ""
	logger.Log("Moss loaded in " + (Process.Elapsed - before).Round(1) + " s" + staying)
	MossResident(value, mosses = List(Moss) + moss, model = key)
Previewing(batch MossBatch) MossResident slow
	MossResident(Logger).Previewing(MossBatch.Sample).previewers.Length is 0
	if (batch.options.preview is "") or (previewers.Length is 1)
		return value
	let path = ModelFiles(batch.options.files.models).Located("taef2.safetensors", "vae_approx")
	path is Error then value else MossResident(value, previewers = List(Taef2Decoder) + Taef2Decoder.Loaded(path))
Decoders(path Text) MossResident slow
	MossResident(Logger).Decoders("tinytaef2.safetensors").taefs is (List(Taef2Decoder) + Taef2Decoder.Tiny)
	Unloaded.Decoders("tinytaef2.safetensors").taefs.First is Taef2Decoder.None
	Unloaded.Decoders("tinyvae.safetensors").fluxes.Length is 1
	Unloaded.Decoders("tinyvae.safetensors").taefs.Length is 0
	if path is decoderFile
		return value
	let emptied = MossResident(value, taefs = List(Taef2Decoder), fluxes = List(FluxDecoder), decoderFile = path)
	if Taef2Decoder.Is(path)
		return MossResident(emptied, taefs = List(Taef2Decoder) + Taef2Decoder.Loaded(path))
	MossResident(emptied, fluxes = List(FluxDecoder) + FluxDecoder.Loaded(path, 32))
