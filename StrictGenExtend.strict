has problem = ""
has video Numbers = List(Number)
has audio Numbers = List(Number)
has frames = 0
has sound = 0
has tall = 0
has wide = 0
constant Contexts = (22, 39, 90)
constant None = StrictGenExtend
constant Sample = StrictGenExtend
constant SampleAudio = 40
constant SampleAudioStart = 11
constant SamplePixels = 44
constant Last = "/last.latent.safetensors"
constant Note = "/last.latent.txt"
Total(context Number, added Number) Number
	Sample.Total(22, 24) is 39
	Sample.Total(22, 124) is 141
	Sample.Total(39, 5) is 39
	H3Format.Group(context + added)
LatentCount(length Number) Number
	Sample.LatentCount(22) is 7
	Sample.LatentCount(39) is 12
	Sample.LatentCount(90) is 27
	(H3Format.Group(length) - 5) / H3Format.FrameGroup * 5 + 2
AudioCount(length Number) Number
	Sample.AudioCount(22) is 37
	Sample.AudioCount(39) is 65
	Sample.AudioCount(90) is 150
	(length / H3Format.FramesPerSecond * H3Format.AudioPerSecond).Round
SoundDrop(context Number) Number
	Sample.SoundDrop(22) is 29333
	(context / H3Format.FramesPerSecond * H3Frames.SampleRate).Round
LatentPath(path Text) Text
	Sample.LatentPath("a.mp4") is "a.latent.safetensors"
	Sample.LatentPath("dir/b.MP4") is "dir/b.latent.safetensors"
	dot = path.LastIndexOf(".")
	(dot < 0 then path else path.Substring(0, dot)) + ".latent.safetensors"
Ramp(count Number, start Number) Numbers
	Sample.Ramp(3, 1) is (1, 2, 3)
	for count
		start + index
Prepare Text
	Sample.Prepare is "strictgen-tail.latent.safetensors"
	numbers = Ramp(10, 1) + Ramp(SampleAudio, SampleAudioStart)
	shape = (1, 10, 1, 1, SampleAudio, SamplePixels)
	Safetensors("strictgen-tail.latent.safetensors").Write(("latent", "shape"), (numbers, shape))
	"strictgen-tail.latent.safetensors"
Tail(values Numbers, temporal Number, keep Number, plane Number) Numbers
	Sample.Tail((1, 2, 3, 4, 5, 6, 7, 8), 4, 2, 1) is (3, 4, 7, 8)
	Sample.Tail((1, 2, 3, 4, 5, 6, 7, 8), 4, 2, 2) is (5, 6, 7, 8)
	window = keep * plane
	for values.Length / temporal / plane * window
		at = index % plane
		time = (index / plane).Floor % keep
		values(((index / window).Floor * temporal + temporal - keep + time) * plane + at)
FromLatent(path Text, context Number) StrictGenExtend
	Sample.Prepare is "strictgen-tail.latent.safetensors" and Sample.FromLatent(Sample.Prepare, 22).video.Last is 10
	data = Safetensors(path, 32)
	shape = data.Values("shape")
	kept = LatentCount(context)
	heard = AudioCount(context)
	if shape(1).Round < kept or shape(4).Round < heard or shape(5).Round < context
		return StrictGenExtend(value, problem = "ShortLatent")
	count = shape(0).Round * shape(1).Round * shape(2).Round * shape(3).Round
	latent = data.Values("latent")
	seen = Tail(latent.Slice(0, count), shape(1).Round, kept, shape(2).Round * shape(3).Round)
	listened = Tail(latent.Slice(count, latent.Length - count), shape(4).Round, heard, 1)
	StrictGenExtend("", seen, listened, kept, heard, shape(2).Round, shape(3).Round)
Head(path Text, context Number, size Numbers, vaes Texts, folder Text = "") StrictGenExtend slow
	Sample.Prepare is "strictgen-tail.latent.safetensors"
	Sample.Head("strictgen-tail.mp4", 22, (16, 16), ("", "")).frames is 7
	Sample.Head("missing-clip.mp4", 22, (16, 16), ("", "")).problem is "missing-clip.mp4 could not be read as a video"
	beside = LatentPath(path)
	saved = File(beside).Exists then beside else Remember(path, folder)
	read = saved is "" then StrictGenExtend(value, problem = "Missing") else FromLatent(saved, context)
	fits = read.problem is "" and read.tall * 16 is size(0) and read.wide * 16 is size(1)
	made = fits then read else FromMedia(path, context, size, vaes)
	fits and saved is beside then made else made.Written(beside, context)
FromMedia(path Text, context Number, size Numbers, vaes Texts) StrictGenExtend slow
	rgb = StrictGenClip.TailRgb(path, context, size(1), size(0))
	if rgb is Error
		return StrictGenExtend(value, problem = path + " could not be read as a video")
	logger.Log("Encoding the last " + context + " frames of " + path + " with the H3 video VAE")
	started = Process.Elapsed
	clip = H3Clip(H3ClipEncoder.Loaded(Safetensors(vaes(0), 32)), H3Tiles.Real)
	pictured = clip.Encode(clip.Frames(rgb, context, size(1), size(0)), size)
	waveform = StrictGenClip.TailPcm(path, context / H3Format.FramesPerSecond + 1)
	heard = H3AudioEncoder.Loaded(Safetensors(vaes(1), 32)).Encode(waveform, AudioCount(context))
	logger.Log("Encoded the video context in " + (Process.Elapsed - started).Round(1) + " s")
	StrictGenExtend("", pictured, heard, LatentCount(context), AudioCount(context), size(0) / 16, size(1) / 16)
Starts Numbers
	StrictGenExtend(Sample, frames = 7).Starts is (0, 1, 5, 9, 13, 17, 18)
	None.Starts.Length is 0
	for frames
		4 * index - 3 * ((index + 4) / 5).Floor
Latents List(Numbers)
	StrictGenExtend(Sample, video = Ramp(48, 0), frames = 2, tall = 1, wide = 1).Latents.Length is 2
	StrictGenExtend(Sample, video = Ramp(48, 0), frames = 2, tall = 1, wide = 1).Latents(1)(1) is 3
	for frames
		Latent(index)
Latent(at Number) Numbers
	StrictGenExtend(Sample, video = Ramp(48, 0), frames = 2, tall = 1, wide = 1).Latent(0)(2) is 4
	plane = tall * wide
	for H3Format.Channels * plane
		video(((index / plane).Floor * frames + at) * plane + index % plane)
Written(path Text, context Number) StrictGenExtend slow
	StrictGenExtend(Sample, problem = "Missing").Written("unwritten.latent.safetensors", 22).problem is "Missing"
	if problem is not ""
		return value
	shape = (H3Format.Channels, frames, tall, wide, sound, context)
	Safetensors(path).Write(("latent", "shape"), (video + audio, shape))
	logger.Log("Kept the video context in " + path + " for the next extends")
	value
Mix(latent Numbers, clean Numbers, noise Numbers, temporal Number, keep Number, plane Number, sigma Number) Numbers
	Sample.Mix((1, 2, 3, 4), (30, 40), (1, 2, 3, 4), 4, 2, 1, 0) is (30, 40, 3, 4)
	Sample.Mix((1, 2, 3, 4), (30, 40), (10, 20, 3, 4), 4, 2, 1, 0.5) is (20, 30, 3, 4)
	volume = temporal * plane
	for latent.Length
		time = (index / plane).Floor % temporal
		at = ((index / volume).Floor * keep + time) * plane + index % plane
		time < keep then clean(at) * (1 - sigma) + noise(index) * sigma else latent(index)
Remember(path Text, folder Text) Text slow
	Sample.Remember("a.mp4", "missing-folder") is ""
	Sample.Remember("a.mp4", "") is ""
	named = File(folder + Note).Exists then File(folder + Note).ReadLines else List(Text)
	named.Length > 0 and named.First is path.Replace("\\", "/") and File(folder + Last).Exists then folder + Last else ""
Keep(path Text, latent Numbers, shapes Numbers, pixels Number, folder Text) slow
	shape = (H3Format.Channels, shapes(0), shapes(1), shapes(2), shapes(3), pixels)
	Safetensors(folder + Last).Write(("latent", "shape"), (latent, shape))
	File(folder + Note).Write(List(Text) + path.Replace("\\", "/"))
