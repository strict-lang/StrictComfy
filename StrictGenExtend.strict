has logger
has problem = ""
has video Numbers = List(Number)
has audio Numbers = List(Number)
has frames = 0
has sound = 0
has tall = 0
has wide = 0
constant Contexts = (22, 39, 90)
constant None = StrictGenExtend(Logger)
constant Sample = StrictGenExtend(Logger)
constant SampleAudio = 40
constant SampleAudioStart = 11
constant SamplePixels = 44
constant Saved = "/extend/"
constant Unsaved = " has no saved H3 latent (kept since 2026-11-14), H3 Image to Video can start from its last frame"
Total(context Number, added Number) Number
	Sample.Total(22, 24) is 56
	Sample.Total(22, 124) is 158
	Sample.Total(39, 5) is 56
	(((context + added) - 5) / H3Format.FrameGroup).Ceiling * H3Format.FrameGroup + 5
LatentCount(length Number) Number
	Sample.LatentCount(22) is 7
	Sample.LatentCount(39) is 12
	Sample.LatentCount(90) is 27
	((((length - 5) / H3Format.FrameGroup).Ceiling * H3Format.FrameGroup + 5) - 5) / H3Format.FrameGroup * 5 + 2
AudioCount(length Number) Number
	Sample.AudioCount(22) is 37
	Sample.AudioCount(39) is 65
	Sample.AudioCount(90) is 150
	(length / H3Format.FramesPerSecond * H3Format.AudioPerSecond).Round
SoundDrop(context Number) Number
	Sample.SoundDrop(22) is 29333
	(context / H3Format.FramesPerSecond * H3Frames.SampleRate).Round
LatentPath(path Text) Text
	Sample.LatentPath("a.mp4") is "a.latent.safetensors"
	Sample.LatentPath("dir/b.MP4") is "dir/b.latent.safetensors"
	let dot = path.LastIndexOf(".")
	(dot < 0 then path else path.Substring(0, dot)) + ".latent.safetensors"
Ramp(count Number, start Number) Numbers
	Sample.Ramp(3, 1) is (1, 2, 3)
	for count
		start + index
Prepare Text
	Sample.Prepare is "strictgen-tail.latent.safetensors"
	let numbers = Ramp(10, 1) + Ramp(SampleAudio, SampleAudioStart)
	let shape = (1, 10, 1, 1, SampleAudio, SamplePixels)
	Safetensors("strictgen-tail.latent.safetensors").Written(("latent", "shape"), (numbers, shape))
	"strictgen-tail.latent.safetensors"
Tail(values Numbers, temporal Number, keep Number, plane Number) Numbers
	Sample.Tail((1, 2, 3, 4, 5, 6, 7, 8), 4, 2, 1) is (3, 4, 7, 8)
	Sample.Tail((1, 2, 3, 4, 5, 6, 7, 8), 4, 2, 2) is (5, 6, 7, 8)
	let window = keep * plane
	for (values.Length / temporal / plane) * window
		let at = index % plane
		let time = (index / plane).Floor % keep
		values(((index / window).Floor * temporal + temporal - keep + time) * plane + at)
FromLatent(path Text, context Number) StrictGenExtend
	(Sample.Prepare is "strictgen-tail.latent.safetensors") and (Sample.FromLatent(Sample.Prepare, 22).video.Last is 10)
	let data = Safetensors(path, 32)
	let shape = data.Values("shape")
	let kept = LatentCount(context)
	let heard = AudioCount(context)
	if (shape(1).Round < kept) or (shape(4).Round < heard) or (shape(5).Round < context)
		return StrictGenExtend(value, problem = "ShortLatent")
	let count = shape(0).Round * shape(1).Round * shape(2).Round * shape(3).Round
	let latent = data.Values("latent")
	let seen = Tail(latent.Slice(0, count), shape(1).Round, kept, shape(2).Round * shape(3).Round)
	let listened = Tail(latent.Slice(count, latent.Length - count), shape(4).Round, heard, 1)
	StrictGenExtend(logger, "", seen, listened, kept, heard, shape(2).Round, shape(3).Round)
Head(path Text, context Number, height Number, width Number, folder Text = "") StrictGenExtend slow
	Sample.Prepare is "strictgen-tail.latent.safetensors"
	Sample.Head("strictgen-tail.mp4", 22, 16, 16).frames is 7
	Sample.Head("missing-clip.mp4", 22, 16, 16).problem is "missing-clip.mp4" + Unsaved
	let beside = LatentPath(path)
	let stored = Stored(path, folder)
	let saved = File(beside).Exists then beside else (File(stored).Exists then stored else "")
	let missing = StrictGenExtend(value, problem = path + Unsaved)
	saved is "" then missing else Checked(FromLatent(saved, context), path, context, height, width)
Checked(read StrictGenExtend, path Text, context Number, height Number, width Number) StrictGenExtend
	Sample.Checked(Sample, "a.mp4", 22, 0, 0).problem is ""
	Sample.Checked(StrictGenExtend(Logger, "ShortLatent"), "a.mp4", 22, 0, 0).problem is "a.mp4 is shorter than 22 frames"
	Sample.Checked(Sample, "a.mp4", 22, 32, 16).problem is "a.mp4 was made at 0x0, extend it at that size"
	if read.problem is not ""
		return StrictGenExtend(value, problem = path + " is shorter than " + context + " frames")
	let made = path + " was made at " + read.wide * 16 + "x" + read.tall * 16 + ", extend it at that size"
	(read.tall * 16 is height) and (read.wide * 16 is width) then read else StrictGenExtend(value, problem = made)
Starts Numbers
	StrictGenExtend(Sample, frames = 7).Starts is (0, 1, 5, 9, 13, 17, 18)
	None.Starts.Length is 0
	for frames
		4 * index - 3 * ((index + 4) / 5).Floor
Latents List(Numbers)
	StrictGenExtend(Sample, video = Ramp(48, 0), frames = 2, tall = 1, wide = 1).Latents.Length is 2
	StrictGenExtend(Sample, video = Ramp(48, 0), frames = 2, tall = 1, wide = 1).Latents(1)(1) is 3
	for frames
		Latent(index)
Latent(at Number) Numbers
	StrictGenExtend(Sample, video = Ramp(48, 0), frames = 2, tall = 1, wide = 1).Latent(0)(2) is 4
	let plane = tall * wide
	for H3Format.Channels * plane
		video(((index / plane).Floor * frames + at) * plane + index % plane)
Heard StrictGenExtend
	StrictGenExtend(Sample, frames = 7, sound = 3).Heard.frames is 0
	StrictGenExtend(Sample, frames = 7, sound = 3).Heard.sound is 3
	StrictGenExtend(value, frames = 0)
Mixed(latent Numbers, clean Numbers, noise Numbers, temporal Number, keep Number, plane Number, sigma Number) Numbers
	Sample.Mixed((1, 2, 3, 4), (30, 40), (1, 2, 3, 4), 4, 2, 1, 0) is (30, 40, 3, 4)
	let level = sigma > (1 - H3Layout.Pinned) then (1 - H3Layout.Pinned) else sigma
	let volume = temporal * plane
	for latent.Length
		let time = (index / plane).Floor % temporal
		let at = ((index / volume).Floor * keep + time) * plane + index % plane
		time < keep then clean(at) * (1 - level) + noise(index) * level else latent(index)
Stored(path Text, folder Text) Text
	Sample.Stored("output/H3Video0001.mp4", "f") is "f/extend/H3Video0001.latent.safetensors"
	folder + Saved + Path(path).FileName.RemoveExtension.text + ".latent.safetensors"
Kept(path Text, latent Numbers, shapes Numbers, pixels Number, folder Text) slow
	let shape = (H3Format.Channels, shapes(0), shapes(1), shapes(2), shapes(3), pixels)
	Directory.Create(folder + Saved)
	Safetensors(Stored(path, folder)).Written(("latent", "shape"), (latent, shape))
