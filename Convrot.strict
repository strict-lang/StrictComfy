has values Numbers
constant Model = Safetensors("tinymoss.safetensors")
constant Reference = Convrot(Model.Values("reference.x"))
Rotated Numbers
	Reference.Rotated(0).IsNearlyEqual(-0.953136)
	Reference.Rotated(17).IsNearlyEqual(0.91226)
	Reference.Rotated(255).IsNearlyEqual(-0.492392)
	Convrot(Reference.Rotated).Rotated(5).IsNearlyEqual(Reference.values(5))
	let quarter = Stage(Stage(Stage(values, 1), 4), 16)
	for values.Length
		Butterfly(quarter, index, 64)
Applied(rotated Boolean) Numbers
	Reference.Applied(true) is Reference.Rotated
	Reference.Applied(false) is Reference.values
	rotated then Rotated else values
Stage(input Numbers, step Number) Numbers
	Reference.Stage((1, 0, 0, 0), 1) is (0.5, 0.5, 0.5, -0.5)
	Reference.Stage((0, 0, 0, 1, 1, 0, 0, 0), 2) is (0.5, 0.5, -0.5, 0.5, 0.5, -0.5, 0.5, 0.5)
	for input.Length
		Butterfly(input, index, step)
Butterfly(input Numbers, at Number, step Number) Number
	Reference.Butterfly((1, 0, 0, 0), 3, 1) is -0.5
	let digit = (at / step).Floor % 4
	let first = (at / (4 * step)).Floor * 4 * step + at % step
	let low = input(first) * (digit is 3 then -0.5 else 0.5) + input(first + step) * (digit is 2 then -0.5 else 0.5)
	let high = input(first + 2 * step) * (digit is 1 then -0.5 else 0.5)
	low + high + input(first + 3 * step) * (digit is 0 then -0.5 else 0.5)
