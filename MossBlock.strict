has norms List(Numbers)
has attention List(Numbers)
has output List(Numbers)
has expansion List(Numbers)
has reduction List(Numbers)
has rotated = true
has deltas List(MossLora) = List(MossLora)
constant Cap = 25
constant Layers = 41
constant Model = Safetensors("tinymoss.safetensors")
constant Tiny = MossBlock.Loaded(Model, "layers.0.", "")
constant Input = Model.Values("reference.video_embedder") + Model.Values("reference.text_embedder")
constant Modulation = Model.Values("reference.shared_block_modulation")
constant Rotation = MossBlock.Rotations(4, 4, 3, 128)
constant Layered = MossBlock.Tiny.Output(Input, Modulation, Rotation)
Loaded(model Safetensors, prefix Text, loras Text) Slow(MossBlock)
	Tiny.expansion.Length is 512
	MossBlock.Loaded(Model, "layers.0.", "tinylora.safetensors").attention is not Tiny.attention
	let tuning = MossTuning(Safetensors(model.path, 32, prefix + "proj."), loras)
	let tuned = tuning.Deltas
	let projected = tuning.Merged("o", tuned)
	let expanded = tuning.Merged("ffn_up_gate", tuned)
	let reduced = tuning.Merged("ffn_down", tuned)
	MossBlock(Norms(Safetensors(model.path, 32, prefix)), tuning.Qkv(tuned), projected, expanded, reduced, deltas = tuned)
Norms(file Safetensors) Slow(List(Numbers))
	Tiny.Norms(Safetensors(Model.path, 32, "layers.0.")).Length is 4
	for ("norm1", "norm2", "q_norm", "k_norm")
		file.Values(value + ".weight")
Output(input Numbers, modulation Numbers, rotation Numbers) Slow(Numbers)
	Layered(0).IsNearlyEqual(-0.125, 0.03)
	Layered(4095).IsNearlyEqual(-0.9805, 0.03)
	Layered(4863).IsNearlyEqual(0.7109, 0.03)
	MossBlock.Loaded(Model, "layers.1.", "").Output(Layered, Modulation, Rotation)(4863).IsNearlyEqual(0.7969, 0.03)
	MossImage(Logger).Error(Moss.Tiny.Ran(Input, Modulation, Rotation, Moss.Context, 0, 1), Layered) < 0.02
	let width = norms(0).Length
	let attended = Gated(input, Attended(Modulated(input, norms(0), modulation, 0), rotation), modulation, width, 2)
	Gated(attended, FedForward(Modulated(attended, norms(1), modulation, 3)), modulation, width, 5)
Cropped(input Numbers, modulation Numbers, rotation Numbers, kept Number) Slow(Numbers)
	Tiny.Cropped(Input, Modulation, Rotation, 4096) is Safetensors.Part(Layered, 0, 4096, 1)
	let normed = Modulated(input, norms(0), modulation, 0)
	let attended = Gated(input, ImageAttended(normed, rotation, kept), modulation, norms(0).Length, 2)
	Gated(attended, FedForward(Modulated(attended, norms(1), modulation, 3)), modulation, norms(0).Length, 5)
ImageAttended(normed Numbers, rotation Numbers, kept Number) Slow(Numbers)
	Tiny.ImageAttended(Input, Rotation, 4096) is Safetensors.Part(Tiny.Attended(Input, Rotation), 0, 4096, 1)
	let width = norms(0).Length
	let combined = Linear(attention, 0, normed)
	let queries = Safetensors.Part(Rotated(combined, 0, width, norms(2), rotation), 0, kept, 1)
	let keys = Rotated(combined, width, width, norms(3), rotation)
	let size = norms(2).Length
	let heads = width / size
	let merged = Attention(queries, keys, combined, heads, heads, size, 1, false, 2 * width, 3 * width, true).Merged
	Linear(output, 1, merged)
Attended(normed Numbers, rotation Numbers) Slow(Numbers)
	Tiny.Attended(Input, Rotation).Length is 4864
	let merged = Merged(Linear(attention, 0, normed), rotation, norms(2), norms(3))
	Linear(output, 1, merged)
Linear(rows List(Numbers), linear Number, input Numbers) Slow(Numbers)
	Tiny.Linear(Tiny.output, 1, Input).Length is 4864
	let summed = Batch(rows, Layer.Unbiased).Sums(rotated then Convrot(input).Rotated else input)
	MossLora.Applied(deltas, linear, summed, input)
Merged(combined Numbers, rotation Numbers, queries Numbers, keys Numbers) Slow(Numbers)
	MossBlock.Merged((1, 0, 1, 0, 3, 4), (1, 1, 0, 0), (1, 1), (1, 1)) is (3, 4)
	Tiny.Rotated((3, 4, 0, 1, 0, 0), 0, 2, (1, 2), (1, 1, -1, 1)).First.IsNearlyEqual(-1.414214)
	let size = queries.Length
	let width = combined.Length / (rotation.Length / 2 / size) / 3
	let heads = width / size
	let rotatedQueries = Rotated(combined, 0, width, queries, rotation)
	let rotatedKeys = Rotated(combined, width, width, keys, rotation)
	Attention(rotatedQueries, rotatedKeys, combined, heads, heads, size, 1, false, 2 * width, 3 * width, true).Merged
FedForward(normed Numbers) Slow(Numbers)
	Tiny.FedForward(Input).Length is 4864
	let activated = Activated(Linear(expansion, 2, normed), reduction.First.Length)
	Linear(reduction, 3, activated)
Activated(expanded Numbers, width Number) Slow(BFloat16s)
	Tiny.Activated((2, 1, 3, 0), 1) is (MossBlock.Situ(2, 1), 0)
	for expanded.Length / 2
		let first = (index / width).Floor * 2 * width + index % width
		Situ(expanded(first), expanded(first + width))
Modulated(input Numbers, weights Numbers, modulation Numbers, part Number) Slow(BFloat16s)
	Tiny.Modulated((3, 4), (1, 2), (0.5, 0, 1, 1, 0, 0), 0)(1).IsNearlyEqual(4.525483)
	let width = weights.Length
	let scales = Qwen3Block.Scales(input, width, Qwen3Block.Epsilon)
	let shifts = part * width
	let scaling = shifts + width
	for input.Length
		let channel = index % width
		let factor = scales((index / width).Floor) * weights(channel) * (1 + modulation(scaling + channel))
		input(index) * factor + modulation(shifts + channel)
Gated(input Numbers, update Numbers, modulation Numbers, width Number, part Number) Slow(BFloat16s)
	Tiny.Gated((1, 2, 9), (3, 4), (0, 0, 2, 3), 2, 1) is (7, 14)
	let start = part * width
	for update.Length
		input(index) + update(index) * modulation(start + index % width)
Rotations(height Number, width Number, text Number, size Number) Slow(Float32s)
	MossBlock.Rotations(4, 4, 3, 128).Length is 4864
	MossBlock.Rotations(4, 4, 3, 128)(16).IsNearlyEqual(-0.9899925)
	MossBlock.Rotations(4, 4, 3, 128)(144).IsNearlyEqual(-0.14112)
	MossBlock.Rotations(4, 4, 3, 128)(208).IsNearlyEqual(0.14112)
	MossBlock.Rotations(4, 4, 3, 128)(17).IsNearlyEqual(-0.1159661)
	MossBlock.Rotations(4, 4, 3, 128)(17 * 256 + 16).IsNearlyEqual(0.5403023)
	for (height * width + text) * 2 * size
		let at = index % (2 * size)
		let pair = at % (size / 2)
		let position = Position((index / (2 * size)).Floor, (pair / (size / 8)).Floor, height, width, text)
		let angle = Degrees(Radians(position * 10000 ^ (-(pair % (size / 8)) / (size / 8))) to Degrees)
		at < size then angle.Cos else (at < size * 3 / 2 then -angle.Sin else angle.Sin)
Position(token Number, axis Number, height Number, width Number, text Number) Number
	MossBlock.Position(0, 2, 4, 4, 3) is -1.5
	MossBlock.Position(17, 1, 4, 4, 3) is 1
	MossBlock.Position(17, 3, 4, 4, 3) is 0
	MossBlock.Position(6, 3, 4, 4, 3) is 0.5
	let image = token < height * width
	let centered = axis is 2 then (token / width).Floor - (height - 1) / 2 else token % width - (width - 1) / 2
	axis is 1 then (image then text else token - height * width) else (axis is 0 or image is false then 0 else centered)
Situ(hidden Number, gate Number) Number
	MossBlock.Situ(0, 1) is 0
	MossBlock.Situ(1, 0) is 0
	MossBlock.Situ(2, 3).IsNearlyEqual(4.8299123)
	MossBlock.Situ(100, -100).IsNearlyEqual(0)
	let squashed = 4 * (2 / (1 + (-gate / 2).Exponential) - 1) / (1 + (-gate).Exponential)
	squashed * Cap * (2 / (1 + (-hidden * 2 / Cap).Exponential) - 1)
Rotated(combined Numbers, start Number, width Number, weights Numbers, rotation Numbers) BFloat16s
	let size = weights.Length
	let heads = width / size
	let scales = Qwen3Block.HeadScales(combined, start, combined.Length / 3, size, rotation.Length)
	for combined.Length / 3
		let token = ((index / size).Floor / heads).Floor
		let within = index % size
		let first = index - within + token * 2 * width + start
		let partner = (within + size / 2) % size
		let own = combined(first + within) * weights(within) * rotation(token * 2 * size + within)
		let other = combined(first + partner) * weights(partner) * rotation((token * 2 + 1) * size + within)
		(own + other) * scales((index / size).Floor)
