has batch MossBatch
has kept MossResident
has sampling MossSampling
has seeds Numbers
has prompts Texts
has contexts List(Numbers)
has outputs Texts
Images Number slow
	let first = Latents(0, 1)
	if GpuMemory.Available < MossFiles.Spare
		return Saved(first + Latents(1, seeds.Length - 1), 0)
	mutable made = Saved(first, 0)
	for Range(1, seeds.Length)
		made = made + Saved(Latents(value, 1), value)
	made
Saved(latents List(Numbers), start Number) Number slow
	let count = latents.Length
	let texts = prompts.Slice(start, count)
	batch.options.files.Eased
	batch.Decoded(kept, latents, seeds.Slice(start, count), texts, outputs.Slice(start, count)).Length
Latents(start Number, count Number) List(Numbers) slow
	let unique = prompts.Unique
	for Range(start, start + count)
		let label = "Image " + (value + 1) + "/" + seeds.Length + " " + Path(outputs(value)).FileName.text
		let shown = MossSampling(sampling, finale = value < seeds.Length - 1)
		batch.Sampled(kept.mosses.First, shown, seeds(value), contexts(unique.Index(prompts(value))), label)