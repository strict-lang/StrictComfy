has entry H3Conv
has pre H3Conv
has ups List(H3Conv)
has blocks List(H3AudioBlock)
has post H3Snake
has last H3Conv
has means Numbers
has deviations Numbers
constant Tiny = H3Audio.Loaded(H3Conv.Model)
constant Latent = H3Conv.Model.Values("reference.latent")
constant Waveform = Tiny.Decoded(Latent)
constant Rates = (5, 5, 2, 2, 2, 2, 2)
Loaded(model Safetensors) H3Audio slow
	Tiny.ups.Length is 7
	Tiny.blocks.Length is 21
	Tiny.means.Length is 32
	let input = H3Conv.Loaded(model, "dec_in_proj", 1)
	let widened = H3Conv.Loaded(model, "decoder.conv_pre", 1)
	let activation = H3Snake.Loaded(model, "decoder.activation_post.")
	let output = H3Conv.Loaded(model, "decoder.conv_post", 1)
	let centers = model.Values("latents_mean")
	H3Audio(input, widened, Ups(model), Blocks(model), activation, output, centers, model.Values("latents_std"))
Ups(model Safetensors) List(H3Conv) slow
	Tiny.Ups(H3Conv.Model)(6).kernel is 4
	for Rates
		H3Conv.Loaded(model, "decoder.ups." + index + ".0", 1)
Blocks(model Safetensors) List(H3AudioBlock) slow
	Tiny.Blocks(H3Conv.Model)(20).firsts(0).kernel is 11
	for 3 * Rates.Length
		H3AudioBlock.Loaded(model, "decoder.resblocks." + index + ".")
Decoded(latent Numbers) Numbers slow
	Waveform.Length is 6400
	FluxImage(Logger).Psnr(Waveform, H3Conv.Model.Values("reference.waveform")) > 50
	Waveform(5000).IsNearlyEqual(H3Conv.Model.Values("reference.waveform")(5000), 0.01)
	let frames = latent.Length / means.Length / 2
	Channel(latent, 0, frames) + Channel(latent, 1, frames)
Channel(latent Numbers, stereo Number, frames Number) Numbers slow
	Tiny.Channel(Latent, 0, 4).Length is 3200
	mutable state = pre.Output(entry.Output(Denormalized(latent, stereo, frames)))
	for ups
		state = Stage(state, index)
	Clamped(last.Output(post.Output(state)))
Denormalized(latent Numbers, stereo Number, frames Number) Numbers slow
	Tiny.entry.Output(Tiny.Denormalized(Latent, 0, 4))(138).IsNearlyEqual(H3Conv.Entered(138), 0.001)
	let channels = means.Length
	for frames * channels
		let channel = index % channels
		latent((channel * 2 + stereo) * frames + (index / channels).Floor) * deviations(channel) + means(channel)
Stage(signal Numbers, stage Number) Numbers slow
	Tiny.Stage(H3Conv.Raised, 0)(451).IsNearlyEqual(H3Conv.Model.Values("reference.stage.0")(67), 0.001)
	let raised = ups(stage).Upsampled(signal, Rates(stage))
	let first = blocks(3 * stage).Output(raised)
	let second = blocks(3 * stage + 1).Output(raised)
	let third = blocks(3 * stage + 2).Output(raised)
	for first
		(value + second(index) + third(index)) / 3
Clamped(values Numbers) Numbers slow
	Tiny.Clamped((-2, 0.5, 3)) is (-1, 0.5, 1)
	for values
		value.Clamp(-1, 1)
Normalized(waveform Numbers) Numbers slow
	Tiny.Normalized((1, -1, 1, -1))(0).IsNearlyEqual(0.173205)
	Tiny.Normalized(Waveform)(5000).IsNearlyEqual(H3Conv.Model.Values("reference.normalized")(5000), 0.001)
	let mean = waveform.Average
	mutable squares = 0
	for waveform
		squares = squares + (value - mean) * (value - mean)
	let deviation = 5 * (squares / (waveform.Length - 1)).SquareRoot
	let scale = deviation < 1 then 1 else deviation
	for waveform
		value / scale