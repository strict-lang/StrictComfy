has network H3ClipEncoder
has tiling H3Tiles
constant Tiny = H3Clip(H3ClipEncoder.Tiny, H3Tiles.Tiny)
constant ClipLength = 17
constant Finished = 0.999
constant Frame = H3VaeEncoder.Model.Values("reference.image")
Encode(frames List(Numbers), size Numbers) Numbers native
	Tiny.Encode((Frame, Frame), (48, 64)).Length is 288
	Tiny.Encode(List(Numbers) + Frame, (48, 64))(5).IsNearlyEqual(H3Picture.Tiny.Encode(Frame, (48, 64))(5), 0.01)
	boxes = (tiling.Starts(size(0)), tiling.Starts(size(1)))
	started = Process.Elapsed
	mutable latents = List(Numbers)
	for Clips(frames.Length)
		part = frames.Slice(value, (frames.Length - value).Clamp(1, ClipLength))
		latents = latents + Latents(part, size, boxes, (value, frames.Length, started))
	Order(latents)
Clips(count Number) Numbers native
	Tiny.Clips(22) is (0, 17)
	Tiny.Clips(17) is (0)
	for (count / ClipLength).Ceiling
		index * ClipLength
Latents(frames List(Numbers), size Numbers, boxes List(Numbers), progress Numbers) List(Numbers) slow
	picture = H3Picture(network.encoder, tiling)
	tiles = Tiles(frames, size, boxes, progress)
	for tiles.First.Length
		picture.Normalize(Column(tiles, index), boxes(0), boxes(1), size, List(Number))
Tiles(frames List(Numbers), size Numbers, boxes List(Numbers), progress Numbers) List(List(Numbers)) slow
	ys = boxes(0)
	xs = boxes(1)
	count = ys.Length * xs.Length
	step = frames.Length / count / progress(1)
	tall = tiling.Length(size(0))
	wide = tiling.Length(size(1))
	for count
		moments = network.Moments(Pixels(frames, size, (ys((index / xs.Length).Floor), tall, xs(index % xs.Length), wide)))
		Report(progress(0) / progress(1) + (index + 1) * step, step, progress(2))
		moments
Report(fraction Number, step Number, started Number) native
	Tiny.Report(0.3, 0.1, Process.Elapsed) is not Error
	if (fraction * 4).Floor > ((fraction - step) * 4).Floor and fraction < Finished
		elapsed = Process.Elapsed - started
		estimate = elapsed.Round(1) + "s/" + (elapsed / fraction).Round(1) + "s"
		logger.Log("Encoding the video context " + (fraction * 100).Round + "% " + estimate)
Pixels(frames List(Numbers), size Numbers, box Numbers) List(FeatureMap)
	for frames
		network.encoder.Pixels(value, size, box, H3Vae.Mean + H3Vae.Deviation)
Column(tiles List(List(Numbers)), at Number) List(Numbers) native
	Tiny.Column((((1, 2), (3, 4)), ((5, 6), (7, 8))), 1) is ((3, 4), (7, 8))
	for tiles
		value(at)
Order(latents List(Numbers)) Numbers native
	Tiny.Order((StrictGenExtend.Sample.Ramp(24, 0), StrictGenExtend.Sample.Ramp(24, 100)))(1) is 100
	Tiny.Order((StrictGenExtend.Sample.Ramp(24, 0), StrictGenExtend.Sample.Ramp(24, 100)))(2) is 1
	plane = latents.First.Length / H3Format.Channels
	count = latents.Length
	volume = count * plane
	for count * latents.First.Length
		channel = (index / volume).Floor
		latents((index / plane).Floor % count)(channel * plane + index % plane)
Frames(rgb Numbers, count Number, width Number, height Number) List(Numbers) native
	Tiny.Frames((1, 2, 3, 4, 5, 6), 2, 1, 1) is ((1, 2, 3), (4, 5, 6))
	frame = width * height * 3
	for count
		Planar(rgb.Slice(index * frame, frame))
Planar(frame Numbers) Numbers native
	Tiny.Planar((1, 2, 3, 4, 5, 6)) is (1, 4, 2, 5, 3, 6)
	pixels = frame.Length / 3
	for frame.Length
		frame(index % pixels * 3 + (index / pixels).Floor)
