has first Number
has last Number
has residual Numbers = List(Number)
has skipped Boolean = false
has output Numbers = List(Number)
constant Off = H3Span(0, 0)
constant Tiny = H3Span(1, 2)
constant Cached = H3Span.Tiny.Evaluated(H3.Tiny, H3.Model.Values("video"), H3.Model.Values("audio"), 0.75, H3.Prompt, H3Layout.Tiny, List(Number), H3.Turned, true)
constant Skipped = H3Span.Cached.Evaluated(H3.Tiny, H3.Model.Values("video"), H3.Model.Values("audio"), 0.75, H3.Prompt, H3Layout.Tiny, List(Number), H3.Turned, true)
Evaluated(h3 H3, latent Numbers, sound Numbers, sigma Number, text Numbers, layout H3Layout, conditions Numbers, rotation Numbers, allowed Boolean) H3Span slow
	Tensors.RelativeError(Cached.output, H3.Forward) < 0.005
	Skipped.skipped and Tensors.RelativeError(Skipped.output, Cached.output) < 0.00001
	if first is last
		return H3Span(value, output = h3.Output(latent, sound, sigma, text, layout, conditions, rotation))
	curves = h3.Curves(layout.Times(sigma))
	starts = layout.Rows(sigma)
	before = h3.Run(h3.Hidden(latent, sound, text, layout, conditions), curves, starts, rotation, layout, 0, first)
	skipping = allowed and residual.Length > 0 and skipped is false
	middle = Middle(h3, before, curves, starts, rotation, layout, skipping)
	after = h3.Run(middle, curves, starts, rotation, layout, last, h3.blocks.Length)
	finished = h3.final.Output(after, curves, layout, sigma)
	H3Span(value, residual = Keep(skipping, middle, before), skipped = skipping, output = finished)
Middle(h3 H3, before Numbers, curves Numbers, starts Numbers, rotation Numbers, layout H3Layout, skipping Boolean) Numbers slow
	H3Span(Tiny, residual = (5, 6)).Middle(H3.Tiny, (1, 1), (1, 1), (1, 1), (1, 1), H3Layout.Tiny, true) is (6, 7)
	skipping then Tensors.Combine(before, residual, 1) else h3.Run(before, curves, starts, rotation, layout, first, last)
Keep(skipping Boolean, middle Numbers, before Numbers) Numbers
	Tiny.Keep(false, (3, 4), (1, 1)) is (2, 3)
	H3Span(Tiny, residual = (5, 6)).Keep(true, (3, 4), (1, 1)) is (5, 6)
	skipping then residual else Tensors.Combine(middle, before, -1)
