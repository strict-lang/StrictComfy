has encoder H3VaeEncoder
has entry Convolution
has firsts List(Convolution)
has seconds List(Convolution)
has downsamples List(Convolution)
has strides Numbers
has exit Convolution
constant Tiny = H3ClipEncoder.Loaded(H3VaeEncoder.Model)
constant TimeDown = (1, 2, 2, 1, 1, 1)
constant Taps = 3
constant Pair = ((1, 2), (3, 4))
constant Zero = List(Number) + 0
Loaded(model Safetensors) H3ClipEncoder slow
	Tiny.entry.weights.Length is 2592
	Tiny.strides is (1, 2, 2, 1, 1)
	let still = H3VaeEncoder.Loaded(model)
	let names = still.Names(model)
	let befores = Stacks(model, names, "conv1")
	let afters = Stacks(model, names, "conv2")
	let entered = Stacked(model, "encoder.conv_in")
	let exited = Stacked(model, "encoder.conv_out")
	H3ClipEncoder(still, entered, befores, afters, Downsamples(model, names), Strides(names), exited)
Stacks(model Safetensors, names Texts, convolution Text) List(Convolution) slow
	Tiny.Stacks(H3VaeEncoder.Model, List(Text) + "0.block.0", "conv1").First.biases.Length is 32
	for names
		Stacked(model, "encoder.down." + value + "." + convolution)
Downsamples(model Safetensors, names Texts) List(Convolution) slow
	Tiny.downsamples(3).biases.Length is 64
	Tiny.downsamples(4).biases.Length is 0
	for names
		let level = value.Substring(0, value.IndexOf("."))
		let following = index + 1 < names.Length then names(index + 1) else ""
		let name = "encoder.down." + level + ".downsample.conv"
		let present = following.StartsWith(level + ".") is false and model.Entry(name + ".weight") is not ""
		present then Stacked(model, name) else Convolution(List(Number), List(Number))
Strides(names Texts) Numbers
	Tiny.Strides(("0.block.1", "2.block.0")) is (1, 2)
	for names
		TimeDown(value.Substring(0, value.IndexOf(".")) to Number)
Stacked(model Safetensors, name Text) Convolution slow
	Tiny.Stacked(H3VaeEncoder.Model, "encoder.conv_out").biases.Length is 48
	let shape = model.Shape(name + ".weight")
	let spread = Spread(model.Values(name + ".weight"), shape)
	Convolution(Convolution.Rearranged(spread, shape(1) * Taps, 3), model.Values(name + ".bias"))
Spread(values Numbers, shape Numbers) Numbers
	Tiny.Spread((1, 2, 3, 4, 5, 6), (1, 2, 3, 1, 1)) is (1, 4, 2, 5, 3, 6)
	let plane = shape(3) * shape(4)
	let inputs = shape(1)
	let stacked = inputs * Taps
	let volume = plane * stacked
	for values.Length
		let channel = (index / plane).Floor % stacked
		let output = (index / volume).Floor
		values(((output * inputs + channel % inputs) * Taps + (channel / inputs).Floor) * plane + index % plane)
Joined(states List(FeatureMap), at Number) FeatureMap
	Tiny.Joined((FeatureMap((1, 2), 2, 1, Zero), FeatureMap((3, 4), 2, 1, Zero)), 1).values is (0, 1, 3, 0, 2, 4)
	let current = states(at)
	let zeros = Layer.Zeros(current.values.Length)
	let earlier = at < 2 then zeros else states(at - 2).values
	let previous = at < 1 then zeros else states(at - 1).values
	let channels = Taps * current.channels
	let values = Interleaved(earlier, previous, current.values, current.channels)
	FeatureMap(values, current.width, channels, Layer.Zeros(channels))
Interleaved(earlier Numbers, previous Numbers, current Numbers, channels Number) Numbers
	Tiny.Interleaved((1, 2), (3, 4), (5, 6), 1) is (1, 3, 5, 2, 4, 6)
	let stacked = Taps * channels
	for earlier.Length * Taps
		let inner = index % stacked
		let tap = (inner / channels).Floor
		let spot = (index / stacked).Floor * channels + inner % channels
		tap is 0 then earlier(spot) else tap is 1 then previous(spot) else current(spot)
Affines(affines List(Numbers), at Number, channels Number) Numbers
	Tiny.Affines(Pair, 1, 1) is (0, 1, 3, 0, 2, 4)
	Tiny.Affines(Pair, 0, 1) is (0, 0, 1, 0, 0, 2)
	let stacked = Taps * channels
	for 2 * stacked
		let half = (index / stacked).Floor
		let inner = index % stacked
		let frame = at - 2 + (inner / channels).Floor
		frame < 0 then 0 else affines(frame)(half * channels + inner % channels)
Temporal(convolution Convolution, states List(FeatureMap), affines List(Numbers), activation Activation) List(FeatureMap) slow
	for states
		let affine = Affines(affines, index, value.channels)
		encoder.Reflected(convolution, Joined(states, index), affine, activation)
Downsampled(convolution Convolution, states List(FeatureMap), stride Number) List(FeatureMap) slow
	let solid = Solid(states)
	let affines = Identities(solid)
	for ((solid.Length - 1) / stride).Floor + 1
		let joined = Joined(solid, index * stride)
		let affine = Affines(affines, index * stride, solid.First.channels)
		let full = convolution.Applied(encoder.Padded(joined, (1, 1, 1, 1)), affine, Activation.Linear)
		encoder.Strided(full, (2, 2), (joined.Height / 2, joined.width / 2))
Identities(states List(FeatureMap)) List(Numbers)
	Tiny.Identities(List(FeatureMap) + FeatureMap((1, 2), 2, 1, List(Number) + 3)).First is (1, 3)
	for states
		value.Identity
Norms(norm GroupNorm, states List(FeatureMap)) List(Numbers) slow
	for states
		norm.Affine(value)
Solid(states List(FeatureMap)) List(FeatureMap)
	Tiny.Solid(List(FeatureMap) + FeatureMap((1, 2), 2, 1, List(Number) + 3)).First.values is (4, 5)
	for states
		FeatureMap(value.Completed, value.width, value.channels, Layer.Zeros(value.channels))
Block(at Number, states List(FeatureMap)) List(FeatureMap) slow
	let block = encoder.blocks(at)
	let solid = Solid(states)
	let hidden = Solid(Temporal(firsts(at), solid, Norms(block.firstNorm, solid), Activation.Swish))
	for Temporal(seconds(at), hidden, Norms(block.secondNorm, hidden), Activation.Swish)
		let source = solid(index)
		(block.shortcut.biases.Length is 0 then source else block.shortcut.Projected(source)).Plus(value)
Moments(frames List(FeatureMap)) List(Numbers) slow
	Tiny.Moments((H3VaeEncoder.Tile, H3VaeEncoder.Tile)).Length is 1
	Tiny.Moments(List(FeatureMap) + H3VaeEncoder.Tile).First(0).IsNearlyEqual(H3VaeEncoder.Moment(0), 0.01)
	mutable states = Solid(Temporal(entry, frames, Identities(frames), Activation.Linear))
	for encoder.blocks
		states = Block(index, states)
		let downsample = downsamples(index)
		states = downsample.biases.Length is 0 then states else Downsampled(downsample, states, strides(index))
	let solid = Solid(states)
	for Temporal(exit, solid, Norms(encoder.normOut, solid), Activation.Swish)
		encoder.moments.Projected(value).Completed
