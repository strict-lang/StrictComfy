has models Text
constant Cached = " into the file cache in the background"
constant Unparsed = "tinymodels/tinylora.safetensors:0.50"
Folder Text slow
	ModelFiles(".").Folder is "."
	if models is not ""
		return models
	for ("D:/ComfyUI_windows_portable/ComfyUI/models", "C:/ComfyUI_windows_portable/ComfyUI/models")
		if Directory.Exists(value)
			return value
	Error("ModelsFolderNotFound")
Locate(name Text, folder Text) Text slow
	ModelFiles("").Locate("tinymodels/tinymoss.safetensors", "diffusion_models") is "tinymodels/tinymoss.safetensors"
	ModelFiles(".").Locate("x.y", "loras") is Error("FileNotFound:x.y")
	if File(name).Exists
		return name
	inside = Folder + "/" + folder + "/" + name
	File(inside).Exists then inside else Error("FileNotFound:" + name.Replace(" ", "_"))
Has(name Text, folder Text) Boolean slow
	ModelFiles("").Has("tinymodels/tinymoss.safetensors", "diffusion_models")
	ModelFiles(".").Has("x.y", "loras") is false
	Locate(name, folder) is not Error
Decoder(vae Text, fallback Text) Text slow
	ModelFiles(".").Decoder("", "tinymodels/tinyh3vae.safetensors") is "tinymodels/tinyh3vae.safetensors"
	ModelFiles(".").Decoder("missing.safetensors", "a") is Error("FileNotFound:missing.safetensors")
	folder = File(Folder + "/vae_approx/" + vae).Exists then "vae_approx" else "vae"
	Locate(vae is "" then fallback else vae, folder)
VaeEncoder(vae Text, fallback Text) Text slow
	ModelFiles(".").VaeEncoder("tinymodels/tinyh3vae.safetensors", "a") is "tinymodels/tinyh3vae.safetensors"
	ModelFiles(".").VaeEncoder("tinymodels/tinytaeh3.safetensors", "a") is Error("FileNotFound:a")
	decoder = Decoder(vae, fallback)
	decoder is Error or Taeh3Decoder.IsTaeh3(decoder) is false then decoder else Locate(fallback, "vae")
Specs(loras Texts) Texts slow
	ModelFiles("").Specs(List(Text) + "tinymodels/tinylora.safetensors:0.5") is ("tinymodels/tinylora.safetensors=0.5")
	for loras
		Spec(value)
Spec(text Text) Text slow
	ModelFiles("").Spec("tinymodels/tinylora.safetensors") is "tinymodels/tinylora.safetensors=1"
	ModelFiles("").Spec("tinymodels/tinylora.safetensors:0.25") is "tinymodels/tinylora.safetensors=0.25"
	ModelFiles(".").Spec("a:5") is Error("FileNotFound:a:5")
	ModelFiles(".").Spec("a b:5") is Error("FileNotFound:a_b")
	ModelFiles(".").Spec(Unparsed) is Error("FileNotFound:" + Unparsed)
	ModelFiles("tinymodels").Spec("tinyfolderlora.safetensors:0.5") is "tinymodels/loras/tinyfolderlora.safetensors=0.5"
	at = text.LastIndexOf(":")
	strength = at > 1 then text.Substring(at + 1, text.Length - at - 1) else ""
	number = strength to Number
	numeric = number is Error then false else number to Text is strength
	Locate(numeric then text.Substring(0, at) else text, "loras") + "=" + (numeric then strength else "1")
Describe(path Text) Text slow
	ModelFiles("").Describe("tinymodels/tinymoss.safetensors") is "tinymoss.safetensors (0 GB)"
	ModelFiles("").Describe("C:/models/missing.safetensors") is "missing.safetensors"
	name = Path(path).FileName.text
	File(path).Exists then name + " (" + (File(path).Length / 1000000000).Round(1) + " GB)" else name
Prefetching(paths Texts, what Text) Text
	ModelFiles("").Prefetching(List(Text) + "missing.safetensors", "nothing") is ""
	ModelFiles("").Prefetching(List(Text) + "tinymodels/tinyqkvlora.safetensors", "LoRA") is "Reading LoRA (0 GB)" + Cached
	mutable bytes = 0
	for paths
		bytes = bytes + TensorFile.Prefetch(value)
	bytes > 0 then "Reading " + what + " (" + (bytes / 1000000000).Round(1) + " GB)" + Cached else ""
ComfyUI Text slow
	ModelFiles(".").ComfyUI is "./.."
	Folder + "/.."
Workflow(name Text) Text slow
	ModelFiles(".").Workflow("tinymossworkflow.json") is "tinymossworkflow.json"
	ModelFiles(".").Workflow("a.json") is "./../user/default/workflows/a.json"
	File(name).Exists then name else ComfyUI + "/user/default/workflows/" + name
Weights(path Text, bits Number) Safetensors
	ModelFiles.Weights("tinymodels/tinyh3.safetensors", 16).prefix is ""
	ModelFiles.Weights("tinymodels/tinyh3prefixed.safetensors", 16).prefix is "model.diffusion_model."
	prefix = TensorFile.Header(path).IndexOf("\"model.diffusion_model.") < 0 then "" else "model.diffusion_model."
	Safetensors(path, bits, prefix)
