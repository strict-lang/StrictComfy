has stamps Numbers
has times Numbers
has logged = 0
constant Timed = StepTimes((-1, -1, -1), (1, 1.5, 2.25))
constant Pause = 0.002
constant LongestInSeconds = 90
constant Minute = 60
Started StepTimes
	Timed.Started.stamps.Length is 1 and Timed.Started.times.Length is 1
	StepTimes(List(Number) + GpuMemory.Stamped, List(Number) + Process.Elapsed)
Stepped StepTimes
	Timed.Stepped.stamps.Length is 4 and Timed.Stepped.times.Length is 4
	StepTimes(stamps + GpuMemory.Stamped, times + Process.Elapsed, logged)
IsDone(step Number) Boolean
	Timed.IsDone(0)
	StepTimes((0, 1, 2), Timed.times).IsDone(0) is (GpuMemory.Elapse(0, 1) is not -1)
	StepTimes((-1, 0, 1), Timed.times).IsDone(0) is false
	StepTimes((0, 1, -1), Timed.times).IsDone(1)
	stamps(step + 1) < 0 or GpuMemory.Elapse(stamps(step), stamps(step + 1)) is not -1
Took(step Number) Number
	Timed.Took(1) is 0.75
	elapsed = GpuMemory.Elapse(stamps(step), stamps(step + 1))
	elapsed < 0 then times(step + 1) - times(step) else elapsed / 1000
Average(step Number) Number
	Timed.Average(1) is 0.625
	total = GpuMemory.Elapse(stamps(0), stamps(step + 1))
	(total < 0 then times(step + 1) - times(0) else total / 1000) / (step + 1)
Lasting(seconds Number) Text
	StepTimes.Lasting(29.4) is "29 s"
	StepTimes.Lasting(150) is "2.5 min"
	seconds < LongestInSeconds then seconds.Round + " s" else (seconds / Minute).Round(1) + " min"
Budget(vram Number, perGibibyte Number, unknown Number) Number
	StepTimes.Budget(24564 * Backend.Mebibyte, 3750, 90000) is 90000
	StepTimes.Budget(12288 * Backend.Mebibyte, 3750, 90000) is 45000
	StepTimes.Budget(8192 * Backend.Mebibyte, 1500, 36000) is 12000
	StepTimes.Budget(0, 1500, 36000) is 36000
	vram is 0 then unknown else (vram / Backend.Gibibyte * perGibibyte / 1000).Round * 1000
