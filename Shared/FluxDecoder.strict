has means Numbers
has deviations Numbers
has convolutions List(Convolution)
has middle List(FluxResnet)
has attention FluxAttention
has blocks List(FluxResnet)
has upsamples List(Convolution)
has normOut GroupNorm
constant Model = Safetensors("tinymodels/tinyvae.safetensors")
constant Tiny = FluxDecoder.Loaded("tinymodels/tinyvae.safetensors", 4)
constant Latent = Model.Values("latent")
constant Middle = FeatureMap(Model.Values("reference.mid.block_2"), 4, 16, Layer.Zeros(16))
constant Last = Tiny.Upsample(Middle)
constant Ends = ("post_quant_conv", "conv_in", "conv_out")
constant TinyVae = "tinymodels/tinyvae.safetensors"
Loaded(path Text, groups Number) FluxDecoder slow
	Tiny.blocks.Length is 4
	Tiny.upsamples.Length is 1
	Tiny.deviations(0).IsNearlyEqual(0.72663, 0.0001)
	model = Safetensors(path, 32, "decoder.")
	latent = Safetensors(path, 32, "bn.")
	mids = (FluxResnet.Loaded(model, "mid.block_1.", groups), FluxResnet.Loaded(model, "mid.block_2.", groups))
	attended = FluxAttention.Loaded(model, "mid.attn_1.", groups)
	spread = Deviations(latent.Values("running_var"))
	normed = FluxResnet.Norm(model, "norm_out", groups)
	ups = Blocks(model, groups)
	FluxDecoder(latent.Values("running_mean"), spread, Convolutions(model), mids, attended, ups, Upsamples(model), normed)
Deviations(variances Numbers) Numbers
	FluxDecoder.Deviations((0.0399, 3.9999)) is (0.2, 2)
	for variances
		(value + 0.0001).SquareRoot
Convolutions(model Safetensors) List(Convolution) slow
	Tiny.Convolutions(Safetensors("tinymodels/tinyvae.safetensors", 32, "decoder.")).Length is 3
	for Ends
		FluxResnet.Convolve(model, value)
Upsamples(model Safetensors) List(Convolution) slow
	Tiny.Upsamples(Safetensors(TinyVae, 32, "decoder.")).First.biases(0).IsNearlyEqual(0.092754, 0.0001)
	for 8
		if model.Entry("up." + (7 - index) + ".upsample.conv.weight") is not ""
			upsample = FluxResnet.Convolve(model, "up." + (7 - index) + ".upsample.conv")
			Convolution(upsample.Folds, upsample.biases)
Blocks(model Safetensors, groups Number) List(FluxResnet) slow
	Tiny.Blocks(Safetensors("tinymodels/tinyvae.safetensors", 32, "decoder."), 4)(2).shortcut.biases.Length is 8
	levels = Present(model, "up.", ".block.0.conv1.weight")
	perLevel = Present(model, "up.0.block.", ".conv1.weight")
	for levels * perLevel
		FluxResnet.Loaded(model, "up." + (levels - 1 - (index / perLevel).Floor) + ".block." + index % perLevel + ".", groups)
Present(model Safetensors, first Text, last Text) Number slow
	Tiny.Present(Safetensors("tinymodels/tinyvae.safetensors", 32, "decoder."), "up.", ".block.0.conv1.weight") is 2
	for 8
		if model.Entry(first + index + last) is not ""
			1
Denormalize(latent Numbers) Numbers slow
	Tiny.Denormalize(Latent)(0).IsNearlyEqual(1.23467, 0.0001)
	Tiny.Denormalize(Latent)(95).IsNearlyEqual(0.56166, 0.0001)
	size = latent.Length / means.Length
	for latent
		value * deviations((index / size).Floor) + means((index / size).Floor)
Unpatchify(latent Numbers, width Number, channels Number) Numbers slow
	Tiny.Unpatchify(Tiny.Denormalize(Latent), 2, 4)(0).IsNearlyEqual(1.23467, 0.0001)
	Tiny.Unpatchify(Tiny.Denormalize(Latent), 2, 4)(32).IsNearlyEqual(-0.06728, 0.0001)
	Tiny.Unpatchify(Tiny.Denormalize(Latent), 2, 4)(95).IsNearlyEqual(0.56166, 0.0001)
	height = latent.Length / channels / 4 / width
	for latent.Length
		position = (index / channels).Floor
		row = (position / (2 * width)).Floor
		source = (index % channels) * 4 + (row % 2) * 2 + position % 2
		latent((source * height + (row / 2).Floor) * width + ((position % (2 * width)) / 2).Floor)
Enter(latent Numbers, width Number) FeatureMap native
	Tiny.Enter(Latent, 2).Completed(0).IsNearlyEqual(-0.39976, 0.02)
	Tiny.Enter(Latent, 2).Completed(383).IsNearlyEqual(0.4636, 0.02)
	channels = means.Length / 4
	patches = FeatureMap(Unpatchify(Denormalize(latent), width, channels), 2 * width, channels, Layer.Zeros(channels))
	quantized = convolutions(0).Project(patches)
	convolutions(1).Apply(quantized, quantized.Identity, Activation.Linear)
Decode(latent Numbers, width Number) Numbers native
	Tiny.Decode(Latent, 2)(0).IsNearlyEqual(0.7881, 0.02)
	Tiny.Decode(Latent, 2)(96).IsNearlyEqual(0.9225, 0.02)
	Tiny.Decode(Latent, 2)(287).IsNearlyEqual(0.47337, 0.001)
	entered = Enter(latent, width)
	upsampled = Upsample(middle(1).Output(attention.Output(middle(0).Output(entered))))
	for convolutions(2).Apply(upsampled, normOut.Affine(upsampled), Activation.Swish).Completed
		((value + 1) / 2).Clamp
Upsample(map FeatureMap) FeatureMap slow
	Last.Applied(Tiny.normOut.Affine(Last), Activation.Linear).values(0).IsNearlyEqual(0.38452, 0.02)
	Last.Applied(Tiny.normOut.Affine(Last), Activation.Linear).values(767).IsNearlyEqual(-0.17288, 0.02)
	perLevel = blocks.Length / (upsamples.Length + 1)
	mutable state = map
	for blocks
		state = value.Output(state)
		if index % perLevel is perLevel - 1 and index < blocks.Length - 1
			state = upsamples((index / perLevel).Floor).Double(state)
	state