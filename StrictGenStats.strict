has logger
constant Sample = StrictGenStats(Logger)
constant WindowsCpu = "(Get-CimInstance Win32_Processor | Measure-Object -Property LoadPercentage -Average).Average"
constant LinuxCpu = "awk '/^cpu /{print ($2+$4)*100/($2+$4+$5)}' /proc/stat"
constant Blank = "{\"ram\":0,\"ramTotal\":0,\"vram\":0,\"vramTotal\":0,\"gpu\":0,\"cpu\":0}"
Text Slow(Text)
	Sample.Text.IndexOf("\"ram\"") >= 0
	Sample.Text.IndexOf("\"cpu\"") >= 0
	let total = GpuMemory.HostTotal
	let free = GpuMemory.HostAvailable
	let device = MachineUse(logger, "StrictGen", 0, 0).Device
	let vram = device(0) > device(1) then device(0) - device(1) else 0
	let ram = total > free then total - free else 0
	let memory = "{\"ram\":" + ram + ",\"ramTotal\":" + total + ",\"vram\":" + vram + ",\"vramTotal\":" + device(0)
	memory + ",\"gpu\":" + device(2) + ",\"cpu\":" + Processor + "}"
Processor Slow(Number)
	Sample.Processor >= 0
	let windows = Process.OperatingSystem is "Windows"
	let command = windows then WindowsCpu else LinuxCpu
	let tool = windows then "powershell" else "sh"
	let arguments = windows then "-NoProfile -Command \"" + command + "\"" else "-c \"" + command + "\""
	let result = Process.RunTool(tool, arguments)
	if result.Failed
		return 0
	let number = result.Output.Trim to Number
	number is Error then 0 else number.Clamp(0, 100)
Status(queue StrictGenQueue, net StrictGenNet, meters Text) Text
	Sample.Status(StrictGenQueue.Empty, StrictGenNet.Idle, Blank).IndexOf("\"position\":\"run 0") >= 0
	let stats = meters is "" then Blank else meters
	let log = queue.jobLog
	let step = queue.IsBusy and (log is not "") and File(log).Exists then Step(File(log).ReadLines) else ""
	let preview = queue.jobPreview is "" then StrictGen.Preview else queue.jobPreview
	let stamp = (preview is not "") and File(preview).Exists then File(preview).Length else 0
	let head = stats.Substring(0, stats.Length - 1) + ",\"position\":" + queue.Position.Code + ",\"step\":" + step.Code
	let busy = ",\"busy\":" + (queue.IsBusy then "true" else "false") + ",\"preview\":" + preview.Code + ",\"previewStamp\":" + stamp
	let made = ",\"results\":" + Codes(queue.results) + ",\"captions\":" + Codes(queue.captions)
	let running = queue.current < 0 then "" else queue.lines(queue.current)
	let lists = ",\"recent\":" + Codes(queue.Recent) + ",\"running\":" + running.Code + ",\"queued\":" + Codes(Lines(queue, queue.pending)) + ",\"done\":" + Codes(queue.captions)
	let activity = ",\"activity\":" + Activity(queue).Code + ",\"examples\":" + Codes(Examples)
	head + busy + made + lists + ",\"notice\":" + queue.notice.Code + activity + ",\"peers\":" + Peers(net) + "}"
Activity(queue StrictGenQueue) Text
	Sample.Activity(StrictGenQueue.Empty) is "Idle\n"
	Sample.Activity(StrictGenQueue(StrictGenQueue.Empty.Added("image", ("--width", "32"), "fox"), notice = "Run started")).IndexOf("Run started") >= 0
	Sample.Activity(StrictGenQueue(StrictGenQueue.Empty.Added("image", ("--width", "32"), "fox"), notice = "Run started")).IndexOf("Queued") >= 0
	let head = queue.notice is "" then (queue.IsBusy or (queue.pending.Length > 0) then "Run started\n" else "Idle\n") else queue.notice + "\n"
	let running = queue.current < 0 then "" else "Running: " + queue.lines(queue.current) + "\n"
	let queued = queue.pending.Length is 0 then "" else "Queued:\n" + outer.Text.Combine(Lines(queue, queue.pending), "\n") + "\n"
	let done = queue.captions.Length is 0 then "" else "Done:\n" + outer.Text.Combine(queue.captions, "\n") + "\n"
	let log = queue.IsBusy and (queue.jobLog is not "") and File(queue.jobLog).Exists then outer.Text.Combine(File(queue.jobLog).ReadLines, "\n") else ""
	head + running + queued + done + log
Lines(queue StrictGenQueue, ids Numbers) Texts
	for ids
		queue.lines(value)
Examples Texts
	Sample.Examples.Length >= 0
	mutable found = List(Mutable(Text))
	for (1, 2, 3, 4, 5, 6, 7, 8, 9)
		let path = Example(value)
		if path is not ""
			found.Add(path)
	found
Example(number Number) Text
	let name = "MossWebExample" + number + ".jpg"
	let beside = Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text
	for (beside + "/" + name, beside + "/../../" + name, beside + "/../" + name, name)
		if File(value).Exists
			return value
	""
Peers(net StrictGenNet) Text
	Sample.Peers(StrictGenNet.Idle) is "[]"
	mutable items = List(Text)
	for net.Labels
		let parts = value.Split("\t")
		items = items + ("{\"address\":" + parts.First.Code + ",\"label\":" + parts.Last.Code + "}")
	"[" + outer.Text.Combine(items, ",") + "]"
Step(lines Texts) Text
	Sample.Step(("hello", "Step 3/8 in 151 ms")) is "Step 3/8 in 151 ms"
	Sample.Step(List(Text) + "step 1 40 ms") is "step 1 40 ms"
	Sample.Step(List(Text)) is ""
	mutable found = ""
	for lines
		if value.Lower.IndexOf("step ") >= 0
			found = value
	found
Codes(lines Texts) Text
	Sample.Codes(("a", "b")) is "[\"a\",\"b\"]"
	Sample.Codes(List(Text)) is "[]"
	mutable quoted = List(Text)
	for lines
		quoted = quoted + value.Code
	"[" + outer.Text.Combine(quoted, ",") + "]"
Probed(path Text) Text
	Sample.Probed("missing-clip.mp4") is ""
	let line = StrictGenClip(logger).Probe(path)
	if line is ""
		return ""
	let parts = line.Split(",")
	if parts.Length < 2
		return ""
	ComfySize.Plain.Snap(parts(0).Trim to Number, 32) + " " + ComfySize.Plain.Snap(parts(1).Trim to Number, 32)
