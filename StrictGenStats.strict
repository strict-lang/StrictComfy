constant Sample = StrictGenStats
constant WindowsLoad = "(Get-CimInstance Win32_Processor | Measure-Object -Property LoadPercentage -Average).Average, "
constant WindowsHost = "(Get-PSDrive (Get-Location).Drive.Name).Free, [System.Net.Dns]::GetHostName(), "
constant WindowsHeat = "(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits) | Set-Content StrictGenCpu.txt"
constant WindowsCpu = WindowsLoad + WindowsHost + WindowsHeat
constant LinuxCpu = "awk '/^cpu /{print ($2+$4)*100/($2+$4+$5)}' /proc/stat"
constant Measured = "StrictGenCpu.txt"
constant RunsShown = 6
constant Queued = StrictGenQueue(StrictGenQueue.Empty.Added("image", ("--width", "32"), "fox"), notice = "Run started")
constant Blank = "{\"ram\":0,\"ramTotal\":0,\"vram\":0,\"vramTotal\":0,\"gpu\":0,\"cpu\":0}"
Text Text slow
	Sample.Text.IndexOf("\"ram\"") >= 0
	Sample.Text.IndexOf("\"cpu\"") >= 0
	total = GpuMemory.HostTotal
	free = GpuMemory.HostAvailable
	device = MachineUse("StrictGen", 0, 0).Device
	vram = device(0) > device(1) then device(0) - device(1) else 0
	ram = total > free then total - free else 0
	memory = "{\"ram\":" + ram + ",\"ramTotal\":" + total + ",\"vram\":" + vram + ",\"vramTotal\":" + device(0)
	memory + ",\"gpu\":" + device(2) + ",\"cpu\":" + Processor + ",\"drive\":" + StrictGenHost.Number(1) + "}"
Processor Number slow
	Sample.Processor >= 0
	windows = Process.OperatingSystem is "Windows"
	last = windows and File(Measured).Exists then File(Measured).ReadLines else List(outer.Text)
	later = "/c start \"\" /B powershell -NoProfile -Command \"" + WindowsCpu + "\" >nul 2>nul"
	result = Process.RunTool((windows then "cmd" else "sh"), (windows then later else "-c \"" + LinuxCpu + "\""))
	number = ((windows then last else result.Output.Lines) + "0").First.Trim to Number
	result.Failed or number is Error then 0 else number.Clamp(0, 100)
Status(queue StrictGenQueue, net StrictGenNet) Text slow
	Sample.Status(StrictGenQueue.Empty, StrictGenNet.Idle).IndexOf("\"position\":\"queue 0 done 0\"") >= 0
	stats = net.meters is "" then Blank else net.meters
	preview = queue.job.preview is "" then StrictGen.Preview else queue.job.preview
	stamp = preview is not "" and File(preview).Exists then File(preview).Length else 0
	position = ",\"position\":" + Position(queue).Code + ",\"step\":" + Step(queue.job.Logged).Code
	busy = ",\"busy\":" + (queue.IsBusy then "true" else "false") + ",\"preview\":" + preview.Code
	head = stats.Substring(0, stats.Length - 1) + position + busy + ",\"previewStamp\":" + stamp
	upscaler = RtxVideo(H3Options.Parsed(List(Text))).IsAvailable then "true" else "false"
	machine = ",\"name\":" + StrictGenHost.Name.Code + ",\"gpuName\":" + net.gpu.Code + ",\"upscaler\":" + upscaler
	head + machine + ",\"gpuTemp\":" + StrictGenHost.Number(3) + Made(queue) + ",\"peers\":" + Peers(net) + "}"
Made(queue StrictGenQueue) Text slow
	Sample.Made(StrictGenQueue.Empty).StartsWith(",\"results\":[],\"captions\":[],\"recent\":[],\"running\":\"\"")
	made = ",\"results\":" + Codes(queue.results) + ",\"captions\":" + Codes(queue.captions)
	running = queue.job.current < 0 then "" else queue.lines(queue.job.current)
	recent = ",\"recent\":" + Codes(Recent(queue)) + ",\"running\":" + running.Code
	lists = ",\"queued\":" + Codes(Lines(queue, queue.pending)) + ",\"done\":" + Codes(queue.captions)
	activity = ",\"notice\":" + queue.notice.Code + ",\"runs\":" + Runs(queue)
	made + recent + lists + activity + ",\"examples\":" + Codes(Examples)
Runs(queue StrictGenQueue) Text slow
	Sample.Runs(StrictGenQueue.Empty) is "[]"
	Sample.Runs(Queued).IndexOf("\"state\":\"queued\"") > 0
	first = (queue.modes.Length - RunsShown).Clamp(0, queue.modes.Length)
	mutable items = List(outer.Text)
	for Range(first, queue.modes.Length)
		items = items + Run(queue, value)
	"[" + outer.Text.Combine(items, ",") + "]"
Run(queue StrictGenQueue, id Number) Text
	Sample.Run(Queued, 0).StartsWith("{\"id\":1,\"title\":\"fox\"")
	file = "StrictGenJob-" + id + ".timed"
	current = id is queue.job.current
	waiting = id is in queue.pending
	kept = waiting is false and File(file).Exists then File(file).ReadLines else List(outer.Text)
	shown = current then queue.job.Stamped(queue.job.Logged) else kept
	outcome = queue.outcomes.Length > id then queue.outcomes(id) else ""
	ended = outcome.StartsWith("error") then "error" else "done"
	state = current then "running" else (waiting then "queued" else ended)
	head = "{\"id\":" + (id + 1) + ",\"title\":" + queue.lines(id).Code + ",\"state\":" + state.Code
	head + ",\"outcome\":" + outcome.Code + ",\"lines\":" + Codes(shown) + "}"
Joined(lines Texts) Text
	Sample.Joined(("a", "b")) is "a\nb"
	outer.Text.Combine(lines, "\n")
Position(queue StrictGenQueue) Text
	Sample.Position(StrictGenQueue.Empty) is "queue 0 done 0"
	Sample.Position(StrictGenQueue.Empty.Added("image", ("--width", "32"), "Image fox")) is "queue 1 done 0"
	"queue " + queue.pending.Length + " done " + queue.finished
Waiting(queue StrictGenQueue) Texts
	Sample.Waiting(StrictGenQueue.Empty).Length is 0
	Sample.Waiting(StrictGenQueue.Empty.Added("image", ("--width", "32"), "Image fox")) is ("Image fox")
	Lines(queue, (queue.job.current < 0 then queue.pending else List(Number) + queue.job.current + queue.pending))
Recent(queue StrictGenQueue) Texts
	Sample.Recent(StrictGenQueue.Empty).Length is 0
	queue.results.Reverse
Lines(queue StrictGenQueue, ids Numbers) Texts
	for ids
		queue.lines(value)
Examples Texts slow
	Sample.Examples.Length >= 0
	mutable found = List(Mutable(Text))
	for (1, 2, 3, 4, 5, 6, 7, 8, 9)
		path = Example(value)
		if path is not ""
			found.Add(path)
	found
Example(number Number) Text slow
	name = "MossWebExample" + number + ".jpg"
	beside = Path(Process.Current.executable.Replace("\\", "/")).PathOnly.text
	for (beside + "/" + name, beside + "/../../" + name, beside + "/../" + name, name)
		if File(value).Exists
			return value
	""
Peers(net StrictGenNet) Text slow
	Sample.Peers(StrictGenNet.Idle) is "[]"
	mutable items = List(Text)
	for net.Labels
		parts = value.Split("\t")
		named = ",\"name\":" + parts(2).Code + ",\"gpu\":" + parts(3).Code + ",\"vram\":" + parts(4)
		items = items + ("{\"address\":" + parts.First.Code + ",\"label\":" + parts(1).Code + named + "}")
	"[" + outer.Text.Combine(items, ",") + "]"
Step(lines Texts) Text
	Sample.Step(("hello", "Step 3/8 in 151 ms")) is "Step 3/8 in 151 ms"
	Sample.Step(List(Text) + "step 1 40 ms") is "step 1 40 ms"
	Sample.Step(List(Text)) is ""
	mutable found = ""
	for lines
		if value.Lower.IndexOf("step ") >= 0
			found = value
	found
Codes(lines Texts) Text slow
	Sample.Codes(("a", "b")) is "[\"a\",\"b\"]"
	Sample.Codes(List(Text)) is "[]"
	mutable quoted = List(Text)
	for lines
		quoted = quoted + value.Code
	"[" + outer.Text.Combine(quoted, ",") + "]"
Probed(path Text) Text slow
	Sample.Probed("missing-clip.mp4") is ""
	probed = File(path).Exists then StrictGenClip.Probe(path) else ""
	RtxVideo(H3Options.Parsed(List(Text))).Sized(probed)
