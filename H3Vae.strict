has decoder H3Decoder
has tile Number
has overlap Number
constant Model = Safetensors("tinyh3vae.safetensors", 32, "reference.")
constant Tiny = H3Vae(H3Decoder.Tiny, 32, 16)
constant Real = H3Vae(H3Decoder.Tiny, 256, 64)
constant Pixels = Tiny.Decoded(Model.Values("latent"), (12, 3, 4))
constant Mean = (0.485, 0.456, 0.406)
constant Deviation = (0.229, 0.224, 0.225)
constant Tokens = 5
constant Shared = 2
constant Dropped = 3
constant Padding = 3
constant Ratio = 4
constant Blended = 5
Decoded(latent Numbers, shape Numbers) Numbers
	Pixels.Length is 359424
	Pixels(15000).IsNearlyEqual(0.770597, 0.01)
	Pixels(359423).IsNearlyEqual(0.486039, 0.01)
	let latents = decoder.Denormalized(latent)
	mutable frames = List(Number)
	mutable shared = List(Number)
	for (shape(0) + Dropped) / Tokens - 1
		let window = decoder.Cut(latents, shape, (index * Tokens, Tokens + Shared, 0, shape(1), 0, shape(2)))
		let canvas = Canvas(window, shape(1), shape(2))
		frames = frames + Finished(canvas, shared, Padding, Tokens * Ratio - Padding)
		shared = canvas
	frames + Finished(shared, List(Number), Tokens * Ratio + Padding, Blended)
Finished(canvas Numbers, previous Numbers, first Number, count Number) Numbers
	Tiny.Finished(Layer.Zeros(84), List(Number), 0, 1) is Mean
	let raw = (Tokens + Shared) * Ratio
	let plane = canvas.Length / 3 / raw
	for count * plane * 3
		let channel = index % 3
		let frame = (index / 3 / plane).Floor
		let pixel = (index / 3).Floor % plane
		let own = canvas((channel * raw + first + frame) * plane + pixel)
		let older = previous.Length > 0 and frame < Blended
		let before = older then previous((channel * raw + Tokens * Ratio + Padding + frame) * plane + pixel) else own
		let mixed = before + (own - before) * (older then frame / Blended else 1)
		(mixed * Deviation(channel) + Mean(channel)).Clamp
Canvas(window Numbers, height Number, width Number) Numbers
	Tiny.Canvas(H3Decoder.Window, 2, 2).Length is 86016
	let ys = Starts(height * 16)
	let xs = Starts(width * 16)
	let tiles = Tiles(window, ys, xs, (Tokens + Shared, height, width))
	let plane = height * 16 * width * 16
	for 3 * (Tokens + Shared) * Ratio * plane
		let y = (index % plane / (width * 16)).Floor
		Weighted(tiles, ys, xs, (index / plane).Floor, y, index % (width * 16), (Length(height * 16), Length(width * 16)))
Tiles(window Numbers, ys Numbers, xs Numbers, shape Numbers) Numbers
	Tiny.Tiles(H3Decoder.Window, (0), (0), (7, 2, 2)).Length is 86016
	let tall = Length(shape(1) * 16) / 16
	let wide = Length(shape(2) * 16) / 16
	mutable tiles = List(Number)
	for ys.Length * xs.Length
		let box = (0, shape(0), ys((index / xs.Length).Floor) / 16, tall, xs(index % xs.Length) / 16, wide)
		tiles = tiles + decoder.Pixels(decoder.Cut(window, shape, box), shape(0), tall, wide)
	tiles
Weighted(tiles Numbers, ys Numbers, xs Numbers, plane Number, y Number, x Number, size Numbers) Number
	Tiny.Weighted((1, 2, 3, 4), (0), (0), 0, 1, 0, (2, 2)) is 3
	let stride = 3 * (Tokens + Shared) * Ratio * size(0) * size(1)
	let row = Owner(ys, y)
	mutable total = 0
	mutable weight = 1
	for row + 1
		let at = row - index
		let share = Share(ys, at, y, size(0))
		let first = at * xs.Length * stride + (plane * size(0) + y - ys(at)) * size(1)
		total = total + (weight > 0 then weight * share * Rowed(tiles, xs, first, stride, x, size(1)) else 0)
		weight = weight * (1 - share)
	total
Rowed(tiles Numbers, xs Numbers, first Number, stride Number, x Number, wide Number) Number
	Tiny.Rowed((1, 2, 3, 4), (0, 1), 2, 1, 1, 2) is 4
	let column = Owner(xs, x)
	mutable total = 0
	mutable weight = 1
	for column + 1
		let at = column - index
		let share = Share(xs, at, x, wide)
		total = total + (weight > 0 then weight * share * tiles(first + at * stride + x - xs(at)) else 0)
		weight = weight * (1 - share)
	total
Share(starts Numbers, at Number, position Number, size Number) Number
	Tiny.Share((0, 16), 1, 20, 32) is 0.25
	Tiny.Share((0, 16), 1, 40, 32) is 1
	Tiny.Share((0, 16), 0, 4, 32) is 1
	let shared = at > 0 then starts(at - 1) + size - starts(at) else 0
	at > 0 and position - starts(at) < shared then (position - starts(at)) / shared else 1
Owner(starts Numbers, position Number) Number
	Tiny.Owner((0, 16, 32), 20) is 1
	Tiny.Owner((0, 16, 32), 40) is 2
	mutable owner = 0
	for starts
		if value <= position
			owner = index
	owner
Starts(size Number) Numbers
	Real.Starts(480) is (0, 112, 224)
	Real.Starts(832) is (0, 192, 384, 576)
	Tiny.Starts(64) is (0, 16, 32)
	Tiny.Starts(16) is (0)
	if size <= tile
		return List(Number) + 0
	let count = ((size - overlap) / (tile - overlap)).Ceiling
	let spare = ((tile * count - overlap * (count - 1) - size) / 16).Floor
	for count
		let extra = index < spare % (count - 1) then index else spare % (count - 1)
		index * (tile - overlap) - 16 * (index * (spare / (count - 1)).Floor + extra)
Length(size Number) Number
	Tiny.Length(16) is 16
	Tiny.Length(64) is 32
	size <= tile then size else tile