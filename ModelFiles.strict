has models Text
constant Cached = " into the file cache in the background"
Folder Text slow
	ModelFiles(".").Folder is "."
	if models is not ""
		return models
	for ("D:/ComfyUI_windows_portable/ComfyUI/models", "C:/ComfyUI_windows_portable/ComfyUI/models")
		if Directory.Exists(value)
			return value
	Error("ModelsFolderNotFound")
Located(name Text, folder Text) Text slow
	ModelFiles("").Located("tinymoss.safetensors", "diffusion_models") is "tinymoss.safetensors"
	ModelFiles(".").Located("x.y", "loras") is Error("FileNotFound:x.y")
	if File(name).Exists
		return name
	let inside = Folder + "/" + folder + "/" + name
	File(inside).Exists then inside else Error("FileNotFound:" + name.Replace(" ", "_"))
Decoder(vae Text, fallback Text) Text slow
	ModelFiles(".").Decoder("", "tinyh3vae.safetensors") is "tinyh3vae.safetensors"
	ModelFiles(".").Decoder("missing.safetensors", "a") is Error("FileNotFound:missing.safetensors")
	let folder = File(Folder + "/vae_approx/" + vae).Exists then "vae_approx" else "vae"
	Located(vae is "" then fallback else vae, folder)
VaeEncoder(vae Text, fallback Text) Text slow
	ModelFiles(".").VaeEncoder("tinyh3vae.safetensors", "a") is "tinyh3vae.safetensors"
	ModelFiles(".").VaeEncoder("tinytaeh3.safetensors", "a") is Error("FileNotFound:a")
	let decoder = Decoder(vae, fallback)
	(decoder is Error) or (Taeh3Decoder.Is(decoder) is false) then decoder else Located(fallback, "vae")
Specs(loras Texts) Texts slow
	ModelFiles("").Specs(List(Text) + "tinylora.safetensors:0.5") is ("tinylora.safetensors=0.5")
	for loras
		Spec(value)
Spec(text Text) Text slow
	ModelFiles("").Spec("tinylora.safetensors") is "tinylora.safetensors=1"
	ModelFiles("").Spec("tinylora.safetensors:0.25") is "tinylora.safetensors=0.25"
	ModelFiles(".").Spec("a:5") is Error("FileNotFound:a:5")
	ModelFiles(".").Spec("a b:5") is Error("FileNotFound:a_b")
	ModelFiles(".").Spec("tinylora.safetensors:0.50") is Error("FileNotFound:tinylora.safetensors:0.50")
	ModelFiles("tinymodels").Spec("tinyfolderlora.safetensors:0.5") is "tinymodels/loras/tinyfolderlora.safetensors=0.5"
	let at = text.LastIndexOf(":")
	let strength = at > 1 then text.Substring(at + 1, text.Length - at - 1) else ""
	let number = strength to Number
	let numeric = number is Error then false else number to Text is strength
	Located(numeric then text.Substring(0, at) else text, "loras") + "=" + (numeric then strength else "1")
Described(path Text) Text slow
	ModelFiles("").Described("tinymoss.safetensors") is "tinymoss.safetensors (0 GB)"
	ModelFiles("").Described("C:/models/missing.safetensors") is "missing.safetensors"
	let name = Path(path).FileName.text
	File(path).Exists then name + " (" + (File(path).Length / 1000000000).Round(1) + " GB)" else name
Prefetching(paths Texts, what Text) Text
	ModelFiles("").Prefetching(List(Text) + "missing.safetensors", "nothing") is ""
	ModelFiles("").Prefetching(List(Text) + "tinyqkvlora.safetensors", "LoRA") is "Reading LoRA (0 GB)" + Cached
	mutable bytes = 0
	for paths
		bytes = bytes + TensorFile.Prefetched(value)
	bytes > 0 then "Reading " + what + " (" + (bytes / 1000000000).Round(1) + " GB)" + Cached else ""
ComfyUI Text slow
	ModelFiles(".").ComfyUI is "./.."
	Folder + "/.."
Workflow(name Text) Text slow
	ModelFiles(".").Workflow("tinymossworkflow.json") is "tinymossworkflow.json"
	ModelFiles(".").Workflow("a.json") is "./../user/default/workflows/a.json"
	File(name).Exists then name else ComfyUI + "/user/default/workflows/" + name
