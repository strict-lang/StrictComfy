has logger
has width Number
has steps Number = 8
has warmup Number = 8
has period Number = 2
has mode Text = "off"
has history SpectralHistory = SpectralHistory
has output Numbers = List(Number)
has forecasts Number = 0
has cacheBytes Number = 536870912
has span MossSpan = MossSpan.Off
constant Tiny = MossSpectrum(Logger, 4, 8, 5)
constant Words = Moss.Tiny.TextEmbedded(Moss.Context, 3)
constant Primed = MossSpectrum(Tiny, mode = "on", history = SpectralHistory.Pair)
IsActual(step Number) Boolean
	Primed.IsActual(4)
	Primed.IsActual(5) is false
	Primed.IsActual(6)
	Primed.IsActual(7)
	MossSpectrum(Primed, steps = 12, period = 3).IsActual(6) is false
	MossSpectrum(Primed, steps = 12, period = 3).IsActual(7)
	MossSpectrum(Tiny, mode = "on").IsActual(5)
	((step < warmup) or (step >= steps - 1)) or (history.Ready is false) or ((step - warmup) % period is period - 1)
IsSpanning(step Number) Boolean
	Tiny.IsSpanning(1) is false
	Tiny.IsSpanning(2)
	Tiny.IsSpanning(7) is false
	(step > 1) and (step < steps - 1)
Coord(step Number) Number
	Tiny.Coord(0) is -1
	Tiny.Coord(7) is 1
	MossSpectrum(Tiny, steps = 1).Coord(0) is 0
	steps <= 1 then 0 else 2 * step / (steps - 1) - 1
Advanced(moss Moss, latent Numbers, sigma Number, text Numbers, rotation Numbers, step Number) MossSpectrum slow
	Tiny.Advanced(Moss.Tiny, Moss.Model.Values("reference.x"), 0.75, Words, MossBlock.Rotation, 0).output.Length is 256
	let vector = moss.TimeEmbedded(sigma)
	if mode is "off"
		let evaluated = span.Evaluated(moss, latent, text, rotation, vector, IsSpanning(step))
		return MossSpectrum(value, output = moss.Head(evaluated.output, vector), span = evaluated)
	if mode is not in ("on", "shadow")
		return Error("Unknown Spectrum mode")
	if (mode is "on") and (IsActual(step) is false)
		return Forecast(moss, vector, step)
	Measured(moss, latent, text, rotation, vector, step)
Measured(moss Moss, latent Numbers, text Numbers, rotation Numbers, vector Numbers, step Number) MossSpectrum
	let evaluated = span.Evaluated(moss, latent, text, rotation, vector, IsSpanning(step))
	let image = evaluated.output
	let coord = Coord(step)
	Shadowed(image, coord)
	let bytes = image.Length * 2 * history.maximum
	let head = moss.Head(image, vector)
	if (NeedsHistory(step) is false) or (bytes > cacheBytes)
		let updated = bytes > cacheBytes then "off" else mode
		return MossSpectrum(value, output = head, mode = updated, history = SpectralHistory, span = evaluated)
	MossSpectrum(value, output = head, history = history.Remembered(coord, image), span = evaluated)
Shadowed(image Numbers, coord Number) None
	if (mode is "shadow") and history.Ready
		let error = MossImage(logger).RelativeError(history.Predicted(coord), image)
		logger.Log("Spectrum shadow " + coord.Round(4) + " feature error " + error)
Forecast(moss Moss, vector Numbers, step Number) MossSpectrum
	MossSpectrum(value, output = moss.Head(history.Predicted(Coord(step)), vector), forecasts = forecasts + 1)
NeedsHistory(step Number) Boolean slow
	Primed.NeedsHistory(5)
	Primed.NeedsHistory(6) is false
	MossSpectrum(Primed, mode = "shadow").NeedsHistory(6)
	MossSpectrum(Primed, mode = "shadow").NeedsHistory(7) is false
	step < (mode is "shadow" then steps - 1 else steps - 2)