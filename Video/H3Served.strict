has batch H3Batch
Complete(kept H3Resident) H3Resident slow
	problem = H3Inputs(batch.options).Problem
	if problem is not ""
		logger.Log(problem)
		return H3Resident(kept, code = 2)
	started = Process.Elapsed
	plan = Arm(kept.plans.Length is 1 then kept.plans.First else batch.Planned)
	if plan.batch.motion.problem is not ""
		logger.Log(plan.batch.motion.problem)
		return H3Resident(kept, code = 2)
	made = Videos(Context(kept, plan).Sampling(batch.options.Checkpoint, batch.options.Loras), plan)
	logger.Log("Total " + (Process.Elapsed - started).Round(2) + " s for " + plan.seeds.Length + " videos")
	H3Resident(made, plans = List(H3Plan))
Videos(sampling H3Resident, plan H3Plan) H3Resident slow
	options = batch.options
	latents = H3Artifacts(options).Latents(plan.seeds.Length, "")
	conditions = H3Artifacts(options).Read(plan.paths)
	vaes = (options.files.Decoder, options.files.Sound)
	if sampling.decodings.Length is 0
		batch.Prefetch(vaes, "the VAEs")
	plan.batch.RunSampling(sampling.samplers.First, sampling.refiners.First, plan, conditions, latents, true)
	options.files.Freed
	decoding = sampling.Decoding(vaes)
	batch.DecodedWith(decoding.decodings.First, latents, plan.images)
	H3Resident(decoding, code = 0)
Arm(plan H3Plan) H3Plan slow
	H3Plan(plan, batch = plan.batch.Armed)
Context(kept H3Resident, plan H3Plan) H3Resident slow
	missing = H3Artifacts(batch.options).Missing(plan.paths)
	if missing.Length is 0
		logger.Log("Using cached prompt conditioning")
		return kept
	Reading(kept)
	encoding = kept.Encoding(batch.options.files).Tokenizing(batch.options.files)
	if Encode(encoding, plan, missing) is not missing.Length
		logger.Log("The text encoder made fewer contexts than the " + missing.Length + " prompts it was given")
	if kept.isCrowded or batch.options.IsLarge
		GpuMemory.Evict
	GpuMemory.Trim
	kept.isCrowded then H3Resident(encoding, encoders = List(Qwen3), encoderFile = "") else encoding
Reading(kept H3Resident) slow
	if kept.IsSampling(batch.options.Checkpoint, batch.options.Loras) is false
		batch.Prefetch(List(Text) + batch.options.Checkpoint + batch.LoraPaths, "H3 and its LoRAs")
Encode(encoding H3Resident, plan H3Plan, missing Numbers) Number slow
	options = batch.options
	Directory.Create(H3Artifacts(options).Root + "/artifacts")
	Directory.Create(H3Artifacts(options).Folder)
	inputs = H3Inputs(options)
	encoder = H3Encoder(options.files, (options.height, options.width), List(QwenVision), List(Text))
	prompts = inputs.Pick(plan.prompts, missing)
	images = inputs.Pick(plan.images, missing)
	paths = inputs.Pick(plan.paths, missing)
	encoder.EncodedWith(encoding.encoders.First, encoding.tokenizers.First, prompts, images, paths)
