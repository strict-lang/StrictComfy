constant Reference = Safetensors("tinymodels/tinyh3.safetensors", 32, "reference.")
constant Shapes = Safetensors("tinymodels/tinyh3.safetensors", 32)
constant Keyed = Safetensors("tinymodels/tinyh3.safetensors", 32, "reference.i2v.")
constant Tiny = H3Sampling
constant Solved = Solver(1, Euler(4, 12).Sigmas, H3Sampling.Reference.Values("video"))
constant Decoders = H3Sampling.Decoding(List(H3Decoding), ("tinymodels/tinyh3vae.safetensors", "tinymodels/tinyh3audio.safetensors")).First
Decoding(loaded List(H3Decoding), vaes Texts) List(H3Decoding) native
	Tiny.Decoding(List(H3Decoding) + Decoders, ("missing.safetensors", "missing.safetensors")).Length is 1
	Decoders.vae.tiling is H3Tiles.Real
	Decoders.Decode(H3Decoding.Latent, (12, 3, 4))(1)(5000).IsNearlyEqual(H3Decoding.Both(1)(5000), 0.001)
	if loaded.Length > 0
		return loaded
	before = Process.Elapsed
	files = ModelFiles("")
	logger.Log("Loading video VAE " + files.Describe(vaes(0)) + " and audio VAE " + files.Describe(vaes(1)))
	decoding = H3Decoding.Loaded(vaes(0), vaes(1))
	logger.Log("Video and audio VAE loaded in " + (Process.Elapsed - before).Round(1) + " s")
	List(H3Decoding) + decoding
Load(model Text, loras Text) H3 native
	H3Sampling.Load("tinymodels/tinyh3.safetensors", "").blocks.Length is 2
	started = Process.Elapsed
	logger.Log(Loading(model, loras))
	h3 = H3.Loaded(model, loras)
	logger.Log("H3 loaded in " + (Process.Elapsed - started).Round(1) + " s" + LoraFiles(loras).Report)
	h3
Loading(model Text, loras Text) Text slow
	H3Sampling.Loading("tinymodels/tinyh3.safetensors", "") is "Loading H3 tinyh3.safetensors (0 GB) from disk into memory"
	H3Sampling.Loading("tinymodels/tinyh3.safetensors", "a/b.safetensors=1;c=0.5").EndsWith("b.safetensors, c on the GPU")
	loading = "Loading H3 " + ModelFiles("").Describe(model) + " from disk into memory"
	if loras is ""
		return loading
	mutable names = List(Text)
	for loras.Split(";")
		names = names + Path(value.Split("=").First).FileName.text
	loading + " and applying the LoRAs " + Text.Combine(names, ", ") + " on the GPU"
Generate(h3 H3, condition Safetensors, job H3Job, text Numbers, numbers Numbers, dumps Text) Numbers native
	Tiny.Generate(H3.Tiny, Keyed, H3Job.Reference, H3.Prompt, (1, 12, 0, 1, 1, 0, 0, 0, 1, 1), "").Length is 960
	shaped = Layout(job.VideoShape, job.AudioShape, condition)
	keyframes = job.Keyframes(shaped.keyframes)
	layout = H3Layout(shaped, keyframes = keyframes, shift = numbers(1), routing = numbers(5))
	rows = job.Rows(condition)
	if File(dumps + "/step0.safetensors").Exists
		logger.Log("step 0 error " + Compare(h3, Safetensors(dumps + "/step0.safetensors", 32), text, layout, 1))
	count = numbers(0) is 0 then job.Count else numbers(0)
	span = H3Span(numbers(6), numbers(7))
	spectrum = H3Spectrum(count, SpectralFit(numbers(4), 0.1, 0.5), numbers(2), numbers(3), span = span)
	sigmas = Euler(count, numbers(1)).ScheduleSampler(numbers(9), numbers(8))
	Sample(h3, job, text, layout, rows, spectrum, Solver(numbers(8), sigmas, job.Video))
Layout(video Numbers, audio Numbers, condition Safetensors) H3Layout slow
	H3Sampling.Layout(Shapes.Shape("reference.video"), Shapes.Shape("reference.audio"), Keyed).Tokens is 17
	H3Sampling.Layout(Shapes.Shape("reference.video"), Shapes.Shape("reference.audio"), Keyed).tags(1) is 0
	keyframes = condition.Entry("keyframes") is "" then List(Number) else condition.Values("keyframes")
	H3Layout(condition.Values("tags"), keyframes, audio.Last, video(1), Size(video(3), video(2)))
Compare(h3 H3, first Safetensors, text Numbers, layout H3Layout, sigma Number) Number native
	H3Sampling.Compare(H3.Tiny, Reference, H3.Prompt, H3Layout.Tiny, 0.75) < 0.05
	curves = h3.Curves(layout.Times(sigma))
	named = first.Entry("text") is "" then "token_refiner" else "text"
	logger.Log("refined text error " + Tensors.RelativeError(text, first.Values(named)))
	logger.Log("curve rows error " + Tensors.RelativeError(curves, first.Values("t_emb")))
	Layer(h3, first, curves, layout, sigma)
Layer(h3 H3, first Safetensors, curves Numbers, layout H3Layout, sigma Number) Number native
	H3Sampling.Layer(H3.Tiny, Reference, Reference.Values("t_emb"), H3Layout.Tiny, 0.75) < 0.05
	rotation = h3.Rotation(layout)
	starts = layout.Rows(sigma)
	mutable state = first.Values("blocks.0.input")
	mutable error = 0
	for h3.blocks
		state = value.Output(state, curves, starts, rotation, h3.Route(layout.routing, index), h3.Leading(layout))
		name = "blocks." + index
		if first.Entry(name) is not ""
			error = Tensors.RelativeError(state, first.Values(name))
			logger.Log("block " + index + " error " + error)
	error
Sample(h3 H3, job H3Job, text Numbers, layout H3Layout, conditions Numbers, spectrum H3Spectrum, solver Solver) Numbers native
	Tiny.Sample(H3.Tiny, H3Job.Reference, H3.Prompt, H3Layout.Tiny, List(Number), H3Spectrum.Tiny, Solved).Length is 960
	rotation = h3.Rotation(layout)
	mutable seen = job.HeldVideo(solver, 0)
	mutable heard = job.HeldAudio(Solver(seen, sigmas = layout.AudioSigmas(seen.sigmas), latent = job.Audio), 0)
	mutable state = spectrum
	mutable steps = H3StepLog(job).Started
	for spectrum.steps
		state = state.Advanced(h3, seen.latent, heard.latent, solver.sigmas(index), text, layout, conditions, rotation, index)
		seen = job.HeldVideo(state.Step(seen, index, job), index + 1)
		heard = job.HeldAudio(heard.Stepped(state.output, index, seen.latent.Length, job.Noise("audio", index)), index + 1)
		steps = steps.Stepped(index, state, seen, heard.latent)
	seen.latent + heard.latent
